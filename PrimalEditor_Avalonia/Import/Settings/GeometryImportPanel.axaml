<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PrimalEditor_Avalonia.Import.Settings"
             x:Class="PrimalEditor_Avalonia.Import.Settings.GeometryImportPanel"
             x:DataType="vm:GeometryImportPanelViewModel">
  <ScrollViewer>
    <StackPanel Spacing="8">

      <!-- ===== Stage 1: FBX / OBJ source parse (legacy geo_settings) ===== -->
      <TextBlock Text="FBX / OBJ Import" FontWeight="SemiBold"/>

      <TextBlock Text="LOD Mode (runtime distance thresholds)"/>
      <ComboBox ItemsSource="{Binding AvailableLodModes}"
                SelectedItem="{Binding LodMode}"
                HorizontalAlignment="Stretch"/>
      <Grid ColumnDefinitions="*,*">
        <TextBox Grid.Column="0" Watermark="LOD 0 distance" Text="{Binding Lod0Threshold}"/>
        <TextBox Grid.Column="1" Watermark="LOD 1 distance" Text="{Binding Lod1Threshold}"/>
      </Grid>
      <TextBox Watermark="LOD 2 distance" Text="{Binding Lod2Threshold}"/>
      <CheckBox Content="Generate Tangent Space" IsChecked="{Binding GenerateTangentSpace}"/>
      <CheckBox Content="Recalculate Normals" IsChecked="{Binding RecalculateNormals}"/>
      <CheckBox Content="Force Single LOD" IsChecked="{Binding ForceSingleLod}"/>
      <TextBlock Text="Compression"/>
      <ComboBox ItemsSource="{Binding AvailableCompressions}"
                SelectedItem="{Binding Compression}"
                HorizontalAlignment="Stretch"/>

      <TextBlock Text="Cook Mesh With Settings — parser-side parameters"
                 FontWeight="SemiBold" Margin="0,10,0,4"/>
      <TextBlock Text="Smoothing Angle (degrees)"/>
      <TextBox Text="{Binding SmoothingAngle}"/>
      <CheckBox Content="Calculate Normals" IsChecked="{Binding CalculateNormals}"/>
      <CheckBox Content="Calculate Tangents" IsChecked="{Binding CalculateTangents}"/>
      <CheckBox Content="Reverse Handedness" IsChecked="{Binding ReverseHandedness}"/>
      <CheckBox Content="Import Embedded Textures" IsChecked="{Binding ImportEmbeddedTextures}"/>
      <CheckBox Content="Import Animations" IsChecked="{Binding ImportAnimations}"/>
      <CheckBox Content="Coalesce Meshes" IsChecked="{Binding CoalesceMeshes}"/>

      <!-- ===== Stage 2: AssetPipeline (Phase 2 M13) ===== -->
      <TextBlock Text="Asset Pipeline" FontWeight="SemiBold" Margin="0,16,0,0"/>
      <TextBlock TextWrapping="Wrap"
                 Foreground="Gray"
                 Text="Post-process the parsed mesh through ContentTools' modular pipeline. With all flags OFF, output is byte-identical to legacy import. Defaults below match pipeline::Config: LOD, Meshlet, Remesh, UV Atlas, and SDF are ON."/>

      <Panel IsVisible="{Binding !PipelineAvailable}">
        <TextBlock TextWrapping="Wrap"
                   Foreground="OrangeRed"
                   Text="Note: pipeline modules only run on .fbx and .obj source files. Other formats (.gltf, .glb, .dae, .blend) use the legacy import path and ignore the flags below."/>
      </Panel>

      <CheckBox Content="Show advanced per-module parameters"
                IsChecked="{Binding ShowAdvanced}"
                Margin="0,4,0,0"/>

      <!-- ===== Repair module ===== -->
      <Expander Header="Repair (PMP mesh cleanup)" IsExpanded="False">
        <StackPanel Spacing="4">
          <CheckBox Content="Enable Repair" IsChecked="{Binding EnableRepair}"/>
          <TextBlock Text="Operations bitfield (0x0F = All: degenerate/stitch/holes/orient-outward)"
                     IsVisible="{Binding ShowAdvanced}"
                     FontSize="11" Foreground="Gray"/>
          <TextBox Watermark="Ops bitfield (0-255)" Text="{Binding RepairOps}" IsVisible="{Binding ShowAdvanced}"/>
          <TextBlock Text="Stitch distance (model units)" IsVisible="{Binding ShowAdvanced}" FontSize="11" Foreground="Gray"/>
          <TextBox Text="{Binding RepairStitchDistance}" IsVisible="{Binding ShowAdvanced}"/>
          <TextBlock Text="Max hole size (skip holes larger than N edges)"
                     IsVisible="{Binding ShowAdvanced}" FontSize="11" Foreground="Gray"/>
          <TextBox Text="{Binding RepairMaxHoleSize}" IsVisible="{Binding ShowAdvanced}"/>
          <CheckBox Content="Orient Outward" IsChecked="{Binding RepairOrientOutward}" IsVisible="{Binding ShowAdvanced}"/>
        </StackPanel>
      </Expander>

      <!-- ===== Remesh module ===== -->
      <Expander Header="Remesh (uniform / adaptive / decimate)" IsExpanded="False">
        <StackPanel Spacing="4">
          <CheckBox Content="Enable Remesh" IsChecked="{Binding EnableRemesh}"/>
          <TextBlock Text="Mode" IsVisible="{Binding ShowAdvanced}" FontSize="11" Foreground="Gray"/>
          <ComboBox ItemsSource="{Binding AvailableRemeshModes}"
                    SelectedItem="{Binding RemeshMode}"
                    IsVisible="{Binding ShowAdvanced}"
                    HorizontalAlignment="Stretch"/>
          <TextBlock Text="Target edge length (0 = AUTO from bbox diagonal)"/>
          <TextBox Text="{Binding TargetEdgeLength}"/>
          <TextBlock Text="Iterations" IsVisible="{Binding ShowAdvanced}" FontSize="11" Foreground="Gray"/>
          <TextBox Text="{Binding RemeshIterations}" IsVisible="{Binding ShowAdvanced}"/>
          <TextBlock Text="AUTO mode subdivisor (1=keep density, 2=double density)"
                     IsVisible="{Binding ShowAdvanced}" FontSize="11" Foreground="Gray"/>
          <TextBox Text="{Binding RemeshAutoSubdiv}" IsVisible="{Binding ShowAdvanced}"/>
          <TextBlock Text="Adaptive approx error" IsVisible="{Binding ShowAdvanced}" FontSize="11" Foreground="Gray"/>
          <TextBox Text="{Binding RemeshAdaptiveApproxError}" IsVisible="{Binding ShowAdvanced}"/>
          <TextBlock Text="Decimate ratio (target = source * ratio)"
                     IsVisible="{Binding ShowAdvanced}" FontSize="11" Foreground="Gray"/>
          <TextBox Text="{Binding RemeshRatio}" IsVisible="{Binding ShowAdvanced}"/>
          <CheckBox Content="Use projection (back-project to original surface)"
                    IsChecked="{Binding RemeshUseProjection}"
                    IsVisible="{Binding ShowAdvanced}"/>
        </StackPanel>
      </Expander>

      <!-- ===== Subdivide module ===== -->
      <Expander Header="Subdivide (Loop / CatmullClark)" IsExpanded="False">
        <StackPanel Spacing="4">
          <CheckBox Content="Enable Subdivide" IsChecked="{Binding EnableSubdivide}"/>
          <TextBlock Text="Scheme" IsVisible="{Binding ShowAdvanced}" FontSize="11" Foreground="Gray"/>
          <ComboBox ItemsSource="{Binding AvailableSubdivideSchemes}"
                    SelectedItem="{Binding SubdivideScheme}"
                    IsVisible="{Binding ShowAdvanced}"
                    HorizontalAlignment="Stretch"/>
          <TextBlock Text="Levels (each level ~4× triangle count for Loop)"/>
          <TextBox Text="{Binding SubdivideLevels}"/>
          <CheckBox Content="Auto-derive normals/tangents after subdivide"
                    IsChecked="{Binding AutoDeriveAfterSubdivide}"/>
        </StackPanel>
      </Expander>

      <!-- ===== Derive module ===== -->
      <Expander Header="Derive (recompute normals / tangents)" IsExpanded="False">
        <StackPanel Spacing="4">
          <CheckBox Content="Enable Derive (standalone, independent of subdivide)"
                    IsChecked="{Binding EnableDerive}"/>
          <TextBlock Text="Normal Mode" IsVisible="{Binding ShowAdvanced}" FontSize="11" Foreground="Gray"/>
          <ComboBox ItemsSource="{Binding AvailableDeriveNormalModes}"
                    SelectedItem="{Binding DeriveNormalMode}"
                    IsVisible="{Binding ShowAdvanced}"
                    HorizontalAlignment="Stretch"/>
          <TextBlock Text="Faceted angle (degrees) — only used by Faceted mode"/>
          <TextBox Text="{Binding DeriveFacetedAngleDeg}"/>
          <TextBlock Text="Tangent Mode"/>
          <ComboBox ItemsSource="{Binding AvailableDeriveTangentModes}"
                    SelectedItem="{Binding DeriveTangentMode}"
                    HorizontalAlignment="Stretch"/>
        </StackPanel>
      </Expander>

      <!-- ===== UV Atlas module ===== -->
      <Expander Header="UV Atlas (xatlas UV generation)" IsExpanded="False">
        <StackPanel Spacing="4">
          <CheckBox Content="Enable UV Atlas" IsChecked="{Binding EnableUvatlas}"/>
          <TextBlock Text="Target UV set purpose"/>
          <ComboBox ItemsSource="{Binding AvailableUvatlasPurposes}"
                    SelectedItem="{Binding UvatlasTargetPurpose}"
                    HorizontalAlignment="Stretch"/>
          <TextBlock Text="Max chart count (0 = unlimited)"/>
          <TextBox Text="{Binding UvatlasMaxChartCount}"/>
          <TextBlock Text="Gutter (texels between charts)"/>
          <TextBox Text="{Binding UvatlasGutter}"/>
          <TextBlock Text="Resolution hint (0 = let xatlas estimate from texels/unit)"/>
          <TextBox Text="{Binding UvatlasResolutionHint}"/>
          <TextBlock Text="Texels per unit" IsVisible="{Binding ShowAdvanced}" FontSize="11" Foreground="Gray"/>
          <TextBox Text="{Binding UvatlasTexelsPerUnit}" IsVisible="{Binding ShowAdvanced}"/>
          <CheckBox Content="Stretch optimization" IsChecked="{Binding UvatlasStretchOptimization}" IsVisible="{Binding ShowAdvanced}"/>
          <CheckBox Content="Strict unique pack (required for Lightmap UVs)"
                    IsChecked="{Binding UvatlasStrictUniquePack}" IsVisible="{Binding ShowAdvanced}"/>
          <CheckBox Content="Use input UVs as chart hint"
                    IsChecked="{Binding UvatlasUseInputUvsAsHint}" IsVisible="{Binding ShowAdvanced}"/>
        </StackPanel>
      </Expander>

      <!-- ===== LOD module ===== -->
      <Expander Header="LOD (level-of-detail generation)" IsExpanded="True">
        <StackPanel Spacing="4">
          <CheckBox Content="Enable LOD" IsChecked="{Binding EnableLod}"/>
          <TextBlock Text="Simplify ratio (each level = ratio × previous index count)"/>
          <TextBox Text="{Binding LodRatio}"/>
          <TextBlock Text="Min vertices for LOD generation (smaller meshes skip LOD)"/>
          <TextBox Text="{Binding MinVerticesForLod}"/>
          <TextBlock Text="Target error (meshopt_simplify normalized deviation)"
                     IsVisible="{Binding ShowAdvanced}" FontSize="11" Foreground="Gray"/>
          <TextBox Text="{Binding LodTargetError}" IsVisible="{Binding ShowAdvanced}"/>
          <TextBlock Text="Max levels" IsVisible="{Binding ShowAdvanced}" FontSize="11" Foreground="Gray"/>
          <TextBox Text="{Binding LodMaxLevels}" IsVisible="{Binding ShowAdvanced}"/>
          <CheckBox Content="Lock borders (prevent edge seam movement)"
                    IsChecked="{Binding LodLockBorders}" IsVisible="{Binding ShowAdvanced}"/>
          <CheckBox Content="Optimize vertex cache after each level"
                    IsChecked="{Binding LodOptimizeVcache}" IsVisible="{Binding ShowAdvanced}"/>
        </StackPanel>
      </Expander>

      <!-- ===== Meshlet module ===== -->
      <Expander Header="Meshlet (meshopt_buildMeshlets)" IsExpanded="False">
        <StackPanel Spacing="4">
          <CheckBox Content="Enable Meshlet" IsChecked="{Binding EnableMeshlet}"/>
          <TextBlock Text="Max vertices per meshlet (runtime cap is 256)"/>
          <TextBox Text="{Binding MeshletMaxVertices}"/>
          <TextBlock Text="Max triangles per meshlet (runtime cap is 128)"/>
          <TextBox Text="{Binding MeshletMaxTriangles}"/>
          <TextBlock Text="Cone weight (0=no culling opt, 1=aggressive)"
                     IsVisible="{Binding ShowAdvanced}" FontSize="11" Foreground="Gray"/>
          <TextBox Text="{Binding MeshletConeWeight}" IsVisible="{Binding ShowAdvanced}"/>
          <CheckBox Content="Optimize vertex cache before build"
                    IsChecked="{Binding MeshletOptimizeVcache}" IsVisible="{Binding ShowAdvanced}"/>
          <CheckBox Content="Compute bounds (needed for GPU culling)"
                    IsChecked="{Binding MeshletComputeBounds}" IsVisible="{Binding ShowAdvanced}"/>
        </StackPanel>
      </Expander>

      <!-- ===== Collision module ===== -->
      <Expander Header="Collision (VHACD convex decomposition)" IsExpanded="False">
        <StackPanel Spacing="4">
          <CheckBox Content="Enable Collision" IsChecked="{Binding EnableCollision}"/>
          <TextBlock Text="Max convex hulls"/>
          <TextBox Text="{Binding CollisionMaxHulls}"/>
          <TextBlock Text="Voxel resolution" IsVisible="{Binding ShowAdvanced}" FontSize="11" Foreground="Gray"/>
          <TextBox Text="{Binding CollisionVoxelResolution}" IsVisible="{Binding ShowAdvanced}"/>
          <CheckBox Content="Auto resolution (scale voxel grid by triangle count)"
                    IsChecked="{Binding CollisionAutoResolution}" IsVisible="{Binding ShowAdvanced}"/>
          <TextBlock Text="Max concavity (lower = more aggressive splitting)"
                     IsVisible="{Binding ShowAdvanced}" FontSize="11" Foreground="Gray"/>
          <TextBox Text="{Binding CollisionMaxConcavity}" IsVisible="{Binding ShowAdvanced}"/>
          <TextBlock Text="Max vertices per hull" IsVisible="{Binding ShowAdvanced}" FontSize="11" Foreground="Gray"/>
          <TextBox Text="{Binding CollisionMaxVerticesPerHull}" IsVisible="{Binding ShowAdvanced}"/>
          <CheckBox Content="PCA preprocessing" IsChecked="{Binding CollisionPca}" IsVisible="{Binding ShowAdvanced}"/>
          <TextBlock Text="Plane downsampling" IsVisible="{Binding ShowAdvanced}" FontSize="11" Foreground="Gray"/>
          <TextBox Text="{Binding CollisionPlaneDownsampling}" IsVisible="{Binding ShowAdvanced}"/>
          <TextBlock Text="Convex hull downsampling" IsVisible="{Binding ShowAdvanced}" FontSize="11" Foreground="Gray"/>
          <TextBox Text="{Binding CollisionConvexhullDownsampling}" IsVisible="{Binding ShowAdvanced}"/>
        </StackPanel>
      </Expander>

      <!-- ===== SDF ===== -->
      <Expander Header="SDF (signed distance field, baked into .mesh)" IsExpanded="False">
        <StackPanel Spacing="4">
          <CheckBox Content="Enable SDF" IsChecked="{Binding EnableSdf}"/>
          <TextBlock TextWrapping="Wrap" Foreground="Gray"
                     Text="Slow path for large meshes. SDF data is consumed by GPU-side surface cache / Nanite. Disable for prototype iteration."/>
        </StackPanel>
      </Expander>

    </StackPanel>
  </ScrollViewer>
</UserControl>
