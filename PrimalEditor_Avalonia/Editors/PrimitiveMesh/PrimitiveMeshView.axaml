<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PrimalEditor_Avalonia.Editors.PrimitiveMesh"
        xmlns:ctrl="using:PrimalEditor_Avalonia.Controls"
        x:Class="PrimalEditor_Avalonia.Editors.PrimitiveMesh.PrimitiveMeshView"
        x:DataType="vm:PrimitiveMeshViewModel"
        Title="Create Primitive Mesh"
        Width="560" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource VoidBrush}">

  <Border Classes="floating" Margin="10">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto,Auto">

      <StackPanel Grid.Row="0" Spacing="6">
        <TextBlock Text="GEOMETRY TYPE"
                   FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"
                   FontSize="11" LetterSpacing="2"
                   Foreground="{DynamicResource ElectricBlueBrush}"/>
        <ComboBox ItemsSource="{Binding AllTypes}" SelectedItem="{Binding Type}"
                  HorizontalAlignment="Stretch"/>
      </StackPanel>

      <ScrollViewer Grid.Row="1" Margin="0,12">
        <StackPanel Spacing="10">
          <StackPanel>
            <TextBlock Text="SEGMENTS"
                       FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"
                       FontSize="11" LetterSpacing="2"
                       Foreground="{DynamicResource ElectricBlueBrush}"
                       Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ctrl:NumberBox Value="{Binding SegmentsX, Mode=TwoWay}" Kind="Int" Width="110"/>
              <ctrl:NumberBox Value="{Binding SegmentsY, Mode=TwoWay}" Kind="Int" Width="110"/>
              <ctrl:NumberBox Value="{Binding SegmentsZ, Mode=TwoWay}" Kind="Int" Width="110"/>
            </StackPanel>
          </StackPanel>

          <StackPanel>
            <TextBlock Text="SIZE"
                       FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"
                       FontSize="11" LetterSpacing="2"
                       Foreground="{DynamicResource ElectricBlueBrush}"
                       Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ctrl:NumberBox Value="{Binding SizeX, Mode=TwoWay}" Kind="Float" Width="110"/>
              <ctrl:NumberBox Value="{Binding SizeY, Mode=TwoWay}" Kind="Float" Width="110"/>
              <ctrl:NumberBox Value="{Binding SizeZ, Mode=TwoWay}" Kind="Float" Width="110"/>
            </StackPanel>
          </StackPanel>

          <StackPanel>
            <TextBlock Text="LOD"
                       FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"
                       FontSize="11" LetterSpacing="2"
                       Foreground="{DynamicResource ElectricBlueBrush}"
                       Margin="0,0,0,4"/>
            <ctrl:NumberBox Value="{Binding LOD, Mode=TwoWay}" Kind="Int" Width="110"/>
          </StackPanel>

          <StackPanel>
            <TextBlock Text="SMOOTHING ANGLE (DEGREES)"
                       FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"
                       FontSize="11" LetterSpacing="2"
                       Foreground="{DynamicResource ElectricBlueBrush}"
                       Margin="0,0,0,4"/>
            <ctrl:NumberBox Value="{Binding SmoothingAngle, Mode=TwoWay}" Kind="Float" Width="110"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,0">
        <TextBlock Text="OUTPUT FILE NAME"
                   FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"
                   FontSize="11" LetterSpacing="2"
                   Foreground="{DynamicResource ElectricBlueBrush}"/>
        <TextBox Text="{Binding OutputName, Mode=TwoWay}"/>
      </StackPanel>

      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,16,0,0">
        <Button Content="Cancel" Click="OnCancelClick" Width="90"/>
        <Button Name="ReimportButton" Content="Re-cook" Click="OnReimportClick" Width="100"
                IsVisible="{Binding HasAsset}"/>
        <Button Content="Create" Click="OnCreateClick" Width="90" IsDefault="True"
                Classes="accent"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
