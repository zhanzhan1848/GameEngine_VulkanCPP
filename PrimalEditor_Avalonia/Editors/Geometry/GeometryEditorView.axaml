<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PrimalEditor_Avalonia.Editors.Geometry"
             x:Class="PrimalEditor_Avalonia.Editors.Geometry.GeometryEditorView"
             x:DataType="vm:GeometryEditorViewModel"
             Background="{DynamicResource VoidBrush}">

  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource VoidBrush}">

    <Border Grid.Row="0" Classes="floating" Margin="6,6,6,2">
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="8,4">
        <TextBlock Text="LOD:"
                   FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"
                   FontSize="11" LetterSpacing="2"
                   Foreground="{DynamicResource ElectricBlueBrush}"
                   VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding LODList}" SelectedItem="{Binding LODIndex}"/>
        <CheckBox Content="Auto LOD" IsChecked="{Binding AutoLOD}"
                  Foreground="{DynamicResource PrimaryTextBrush}"/>
        <Separator Margin="6,0"/>
        <TextBlock Text="Verts:" VerticalAlignment="Center"
                   FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"
                   FontSize="11" LetterSpacing="2"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <TextBlock Text="{Binding VertexCount}" VerticalAlignment="Center"
                   FontFamily="{DynamicResource FontMono}"/>
        <TextBlock Text="Tris:" VerticalAlignment="Center"
                   FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"
                   FontSize="11" LetterSpacing="2"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <TextBlock Text="{Binding TriangleCount}" VerticalAlignment="Center"
                   FontFamily="{DynamicResource FontMono}"/>
        <TextBlock Text="Submeshes:" VerticalAlignment="Center"
                   FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"
                   FontSize="11" LetterSpacing="2"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
        <TextBlock Text="{Binding SubmeshCount}" VerticalAlignment="Center"
                   FontFamily="{DynamicResource FontMono}"/>
        <Separator Margin="6,0"/>
        <TextBlock Text="{Binding BoundsSummary}" VerticalAlignment="Center"
                   FontFamily="{DynamicResource FontMono}"
                   Foreground="{DynamicResource MutedTextBrush}"/>
        <Separator Margin="6,0"/>
        <TextBlock Text="(drag to orbit)" VerticalAlignment="Center"
                   FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"
                   FontSize="11" LetterSpacing="2"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Classes="floating" Margin="6,2">
      <Panel x:Name="RenderPanel" Background="{DynamicResource VoidBrush}"
             PointerPressed="OnPointerPressed"
             PointerMoved="OnPointerMoved"
             PointerReleased="OnPointerReleased"/>
    </Border>

    <Border Grid.Row="2" Classes="floating" Margin="6,2,6,6">
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,4" HorizontalAlignment="Right">
        <Button Content="Discard" Click="OnDiscardClick" IsEnabled="{Binding IsDirty}"/>
        <Button Content="Reimport" Click="OnReimportClick"/>
        <Button Content="Save" Click="OnSaveClick" IsEnabled="{Binding CanSave}" Classes="accent"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
