<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PrimalEditor_Avalonia.Editors.Prefab"
             x:DataType="vm:PrefabInspectorViewModel"
             x:Class="PrimalEditor_Avalonia.Editors.Prefab.PrefabInspectorView">
    <Grid RowDefinitions="Auto,*" Margin="8">
        <TextBlock Grid.Row="0" Text="{Binding Summary}" TextWrapping="Wrap"
                   FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Components}" FontSize="11" Opacity="0.75"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
