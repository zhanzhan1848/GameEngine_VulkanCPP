<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PrimalEditor_Avalonia.Editors.AssetEditorStatusBar"
             x:DataType="vm:AssetEditorViewModel"
             xmlns:vm="using:PrimalEditor_Avalonia.Editors">
  <Border Background="{DynamicResource VoidBrush}"
          BorderBrush="{DynamicResource ElectricBlueBrush}"
          BorderThickness="0,1,0,0" Padding="10,5">
    <Grid ColumnDefinitions="*,Auto,Auto">
      <TextBlock Grid.Column="0" Name="AssetPathText"
                 FontFamily="{DynamicResource FontMono}" FontSize="11"
                 Foreground="{DynamicResource SecondaryTextBrush}"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <Border Grid.Column="1" Margin="8,0" Padding="10,3" CornerRadius="0"
              BorderBrush="{DynamicResource ElectricBlueBrush}" BorderThickness="1"
              Background="{DynamicResource BlueTint12}"
              VerticalAlignment="Center">
        <TextBlock Name="StateText"
                   FontFamily="{DynamicResource FontDisplay}"
                   FontWeight="SemiBold" FontSize="10" LetterSpacing="2"
                   Foreground="{DynamicResource ElectricBlueBrush}"/>
      </Border>
      <TextBlock Grid.Column="2" Margin="10,0,0,0" Name="DirtyText"
                 FontFamily="{DynamicResource FontDisplay}"
                 FontWeight="SemiBold" FontSize="12"
                 Foreground="{DynamicResource AmberBrush}"
                 VerticalAlignment="Center"/>
    </Grid>
  </Border>
</UserControl>
