<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:PrimalEditor_Avalonia.Controls">

  <Design.PreviewWith>
    <Border Padding="20" Background="{StaticResource VoidBrush}">
      <StackPanel Spacing="8">
        <ctrl:NumberBox Value="0.000" Width="120"/>
        <ctrl:NumberBox Value="42" Width="120"/>
        <ctrl:NumberBox Value="-3.14" Width="120"/>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <Style Selector="ctrl|NumberBox">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{StaticResource VoidBrush}" BorderBrush="{StaticResource ElectricBlueBrush}" BorderThickness="1"
                CornerRadius="4" Padding="0">
          <Panel>
            <!-- Magic parts preserved for NumberBox.cs logic -->
            <TextBlock Name="PART_TextBlock"
                       Text="{TemplateBinding Value}"
                       Foreground="{StaticResource ElectricBlueBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Stretch"
                       Padding="8,0"
                       TextAlignment="Right"
                       FontFamily="avares://PrimalEditor_Avalonia/Assets/Fonts/#JetBrains Mono"
                       FontSize="12"/>
            <TextBox Name="PART_TextBox"
                     Text="{TemplateBinding Value, Mode=TwoWay}"
                     Background="{StaticResource VoidBrush}"
                     Foreground="{StaticResource ElectricBlueBrush}"
                     CaretBrush="{StaticResource ElectricBlueBrush}"
                     SelectionBrush="{StaticResource BlueTint25}"
                     BorderThickness="0"
                     Padding="8,0"
                     TextAlignment="Right"
                     FontFamily="avares://PrimalEditor_Avalonia/Assets/Fonts/#JetBrains Mono"
                     FontSize="12"/>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- NumberBox is a TemplatedControl; focus glow handled by its inner Border in the template above. -->


</Styles>
