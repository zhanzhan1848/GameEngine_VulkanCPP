<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PrimalEditor_Avalonia.Views.NewScriptDialog"
        Title="New Script"
        Width="400" Height="260"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource VoidBrush}">
  <Border Classes="floating" Margin="10">
    <StackPanel Margin="24" Spacing="10">
      <TextBlock Text="SCRIPT NAME"
                 FontFamily="{StaticResource FontDisplay}"
                 FontWeight="SemiBold" FontSize="11" LetterSpacing="2"
                 Foreground="{StaticResource ElectricBlueBrush}"/>
      <TextBox Name="NameBox" Text="NewScript"/>
      <TextBlock Text="LANGUAGE"
                 FontFamily="{StaticResource FontDisplay}"
                 FontWeight="SemiBold" FontSize="11" LetterSpacing="2"
                 Foreground="{StaticResource ElectricBlueBrush}"/>
      <ComboBox Name="LanguageBox" SelectedIndex="0" HorizontalAlignment="Stretch">
        <ComboBoxItem Content="Python (.py)"/>
        <ComboBoxItem Content="Lua (.lua)"/>
      </ComboBox>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
        <Button Content="Cancel" Click="OnCancelClick" Width="90"/>
        <Button Content="Create" Click="OnCreateClick" Width="90" IsDefault="True" Classes="accent"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
