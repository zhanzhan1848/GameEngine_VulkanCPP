<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PrimalEditor_Avalonia.Views.NewScriptDialog"
        Title="New Script"
        Width="380" Height="220"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="Name:"/>
    <TextBox Name="NameBox" Text="NewScript"/>
    <TextBlock Text="Language:"/>
    <ComboBox Name="LanguageBox" SelectedIndex="0" HorizontalAlignment="Stretch">
      <ComboBoxItem Content="Python (.py)"/>
      <ComboBoxItem Content="Lua (.lua)"/>
    </ComboBox>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,12,0,0">
      <Button Content="Cancel" Click="OnCancelClick" Width="80"/>
      <Button Content="Create" Click="OnCreateClick" Width="80" IsDefault="True" Classes="accent"/>
    </StackPanel>
  </StackPanel>
</Window>
