<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PrimalEditor_Avalonia.Views.TextInputDialog"
        Title="Input"
        Width="420" Height="190"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource VoidBrush}">
  <Border Classes="floating" Margin="10">
    <StackPanel Margin="24" Spacing="10">
      <TextBlock Name="PromptText"
                 FontFamily="{DynamicResource FontUI}"
                 Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
      <TextBox Name="InputBox"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
        <Button Content="Cancel" Click="OnCancelClick" Width="90"/>
        <Button Content="OK" Click="OnOkClick" Width="90" IsDefault="True" Classes="accent"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
