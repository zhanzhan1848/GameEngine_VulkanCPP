<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PrimalEditor_Avalonia.ViewModels"
             x:Class="PrimalEditor_Avalonia.Views.OpenProjectView"
             x:DataType="vm:OpenProjectViewModel">

    <Grid Margin="20" RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto">

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="OPEN PROJECT"
                   FontFamily="{DynamicResource FontDisplay}"
                   FontWeight="SemiBold" FontSize="16" LetterSpacing="1"
                   Foreground="{DynamicResource ElectricBlueBrush}"
                   Margin="0,0,0,20">
        </TextBlock>

        <ListBox Grid.Row="1" Grid.Column="0"
                 ItemsSource="{Binding RecentProjects}"
                 SelectedItem="{Binding SelectedProject}"
                 DoubleTapped="OnProjectDoubleClick"
                 Margin="0,0,0,12"
                 Background="{DynamicResource VoidBrush}"
                 BorderBrush="{DynamicResource ElectricBlueBrush}"
                 BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}"
                                   FontFamily="{DynamicResource FontDisplay}"
                                   FontWeight="SemiBold" FontSize="14" LetterSpacing="2"
                                   Foreground="{DynamicResource ElectricBlueBrush}"/>
                        <TextBlock Text="{Binding Path}" FontSize="11"
                                   Classes="mono dim"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
            <Button Content="Browse..." Click="OnBrowseClick" Width="110" Margin="0,0,0,6"/>
            <Button Content="Remove" Click="OnRemoveClick" Width="110" Margin="0,0,0,6" Classes="danger"
                    IsEnabled="{Binding HasSelection}"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                   Text="{Binding ErrorMessage}"
                   FontFamily="{DynamicResource FontMono}"
                   Foreground="{DynamicResource CoralDeepBrush}"
                   IsVisible="{Binding HasError}" Margin="0,10,0,0"/>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,40,0,0">
            <Button Content="Cancel" Click="OnCancelClick" Margin="0,0,10,0" Width="90"/>
            <Button Content="Open" Click="OnOpenClick" Width="90"
                    IsDefault="True" IsEnabled="{Binding HasSelection}" Classes="accent"/>
        </StackPanel>
    </Grid>
</UserControl>
