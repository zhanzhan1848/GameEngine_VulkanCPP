<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PrimalEditor_Avalonia.Views.ConfirmDialog"
        Title="Confirm"
        Width="440" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource VoidBrush}">

    <Border Classes="floating" Margin="10">
        <StackPanel Margin="24" Spacing="10">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13"
                       FontFamily="{StaticResource FontUI}"
                       Foreground="{StaticResource PrimaryTextBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
                <Button Content="Cancel" Click="OnCancelClick" Width="90" IsCancel="True"/>
                <Button Content="Don't Save" Click="OnDiscardClick" Width="110" Classes="danger"/>
                <Button Content="Save..." Click="OnSaveClick" Width="90" IsDefault="True" Classes="accent"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
