<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PrimalEditor_Avalonia.Views.ConfirmDialog"
        Title="Confirm"
        Width="420" Height="180"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,15,0,0">
            <Button Content="Cancel" Click="OnCancelClick" Width="80" IsCancel="True"/>
            <Button Content="Don't Save" Click="OnDiscardClick" Width="90"/>
            <Button Content="Save..." Click="OnSaveClick" Width="80" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
