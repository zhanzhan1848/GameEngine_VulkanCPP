<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PrimalEditor_Avalonia.Views.RenameEntityDialog"
        Title="Rename Entity"
        Width="400" Height="150"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20" RowDefinitions="Auto,*,Auto" ColumnDefinitions="*">

        <TextBlock Grid.Row="0" Text="New name:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" x:Name="NameTextBox" Margin="0,10"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Click="OnCancel" Width="80" Margin="0,0,10,0"/>
            <Button Content="OK" Click="OnOK" Width="80" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>