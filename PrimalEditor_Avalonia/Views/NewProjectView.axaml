<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PrimalEditor_Avalonia.ViewModels"
        x:Class="PrimalEditor_Avalonia.Views.NewProjectView"
        x:DataType="vm:NewProjectViewModel"
        Title="New Project"
        Width="600" Height="500"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*">

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Create New Project"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <ListBox Grid.Row="1" Grid.ColumnSpan="2"
                 ItemsSource="{Binding Templates}"
                 SelectedItem="{Binding SelectedTemplate}"
                 Margin="0,0,0,20">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="Gray"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Project Name:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ProjectName}" Margin="0,5"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Project Path:" VerticalAlignment="Center"/>
        <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,5">
            <TextBox Grid.Column="0" Text="{Binding ProjectPath}"/>
            <Button Grid.Column="1" Content="Browse..." Click="OnBrowseClick" Margin="5,0,0,0"/>
        </Grid>

        <TextBlock Grid.Row="4" Grid.ColumnSpan="2"
                   Text="{Binding ErrorMessage}" Foreground="Red"
                   IsVisible="{Binding HasError}" Margin="0,10"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Click="OnCancelClick" Margin="0,0,10,0" Width="80"/>
            <Button Content="Create" Click="OnCreateClick" Width="80"
                    IsDefault="True" IsEnabled="{Binding CanCreate}"/>
        </StackPanel>
    </Grid>
</Window>