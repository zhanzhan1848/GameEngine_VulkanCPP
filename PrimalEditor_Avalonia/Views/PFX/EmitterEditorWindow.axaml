<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PrimalEditor_Avalonia.ViewModels.PFX"
        x:Class="PrimalEditor_Avalonia.Views.PFX.EmitterEditorWindow"
        x:DataType="vm:PfxEditorWindowViewModel"
        Title="PFX Emitter Editor" Width="960" Height="640" MinWidth="720" MinHeight="480">
  <DockPanel Margin="8">

    <!-- 顶部工具栏 -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
      <Button Content="Save" Command="{Binding SaveCommand}" Padding="10,4"/>
      <Button Content="Undo" Command="{Binding UndoCommand}" Padding="10,4"/>
      <Button Content="Redo" Command="{Binding RedoCommand}" Padding="10,4"/>
      <Button Content="Hot Preview" Command="{Binding HotPreviewCommand}" Padding="10,4"/>
      <TextBlock Text="{Binding AssetPath}" VerticalAlignment="Center" Margin="12,0,0,0"
                 Foreground="Gray" FontSize="12"/>
      <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,0,0"
                 Foreground="Green" FontSize="12"/>
    </StackPanel>

    <!-- 三列结构化编辑 -->
    <Grid ColumnDefinitions="180,8,1*">

      <!-- 左列：阶段选择器 + 模块列表 -->
      <StackPanel Grid.Column="0">
        <TextBlock Text="Stage" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
        <ComboBox ItemsSource="{Binding StageNames}"
                  SelectedItem="{Binding SelectedStage, Mode=TwoWay}"
                  Width="160" Margin="0,0,0,8"/>
        <TextBlock Text="Modules" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
        <ListBox ItemsSource="{Binding VisibleModules}"
                 SelectedItem="{Binding SelectedModule, Mode=TwoWay}"
                 MinHeight="200">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" Margin="4,2"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>

      <!-- 右列：选中模块的参数编辑面板（schema 驱动） -->
      <ScrollViewer Grid.Column="2">
        <StackPanel Spacing="6">
          <TextBlock Text="Module Parameters" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
          <ItemsControl ItemsSource="{Binding SelectedModuleParams}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="120,*" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"/>
                  <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" FontSize="12"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

    </Grid>
  </DockPanel>
</Window>
