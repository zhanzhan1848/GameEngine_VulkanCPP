<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PrimalEditor_Avalonia.ViewModels"
             xmlns:views="using:PrimalEditor_Avalonia.Views"
             xmlns:seq="using:PrimalEditor_Avalonia.Views.Sequencer"
             xmlns:views3d="using:PrimalEditor_Avalonia.Views.Engine3D"
             xmlns:entities="using:PrimalEditor_Avalonia.Entities"
             xmlns:conv="using:PrimalEditor_Avalonia.Converters"
             xmlns:self="using:PrimalEditor_Avalonia.Views"
             xmlns:ctrl="using:PrimalEditor_Avalonia.Themes.Controls"
             x:Class="PrimalEditor_Avalonia.Views.WorldEditorView"
             x:DataType="vm:WorldEditorViewModel"
             Background="{DynamicResource VoidBrush}">

    <Grid Name="WorkspaceGrid" Background="{DynamicResource VoidBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="280"/>
        </Grid.RowDefinitions>

        <!-- =========== ROW 0: Toolbar (floating glass) =========== -->
        <!-- 功能按簇分组放进 WrapPanel：每簇是不可拆分的逻辑组，窗口不够宽时
             整组换行而不是水平裁切/滚动——任何窗口宽度下所有功能保持可见。 -->
        <ctrl:TextureFrame Grid.Row="0" Classes="floating tex-strip" Margin="6,6,6,2">
            <WrapPanel Orientation="Horizontal" Margin="8,3">

                <!-- Build：构建配置 + Build/Rebuild/Run/Stop -->
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,12,2">
                    <TextBlock Text="BUILD" FontFamily="{DynamicResource FontDisplay}"
                               FontWeight="SemiBold" FontSize="9" LetterSpacing="1"
                               Foreground="{DynamicResource ElectricBlueBrush}"
                               VerticalAlignment="Center" Margin="0,0,2,0"/>
                    <ComboBox Width="110"
                              ItemsSource="{Binding BuildConfigurations}"
                              SelectedItem="{Binding Project.BuildConfigName}"/>
                    <Button Content="Build" Click="OnBuildClick" Padding="10,2"
                            IsEnabled="{Binding IsBuilding, RelativeSource={RelativeSource AncestorType=self:WorldEditorView}, Converter={x:Static conv:CommonConverters.InvertBool}}"/>
                    <Button Content="Rebuild" Click="OnRebuildClick" Padding="10,2"
                            IsEnabled="{Binding IsBuilding, RelativeSource={RelativeSource AncestorType=self:WorldEditorView}, Converter={x:Static conv:CommonConverters.InvertBool}}"/>
                    <Button Content="Run" Click="OnRunClick" Padding="10,2" Classes="accent"
                            IsEnabled="{Binding IsBuilding, RelativeSource={RelativeSource AncestorType=self:WorldEditorView}, Converter={x:Static conv:CommonConverters.InvertBool}}"/>
                    <Button Name="StopBuild" Content="Stop" Click="OnBuildStopClick" Padding="10,2" Classes="danger"
                            IsEnabled="{Binding IsBuilding, RelativeSource={RelativeSource AncestorType=self:WorldEditorView}}"/>
                </StackPanel>

                <!-- Render：视口管线模式 + Run 目标图形 API。
                     Viewport render mode (plan §6.1 B3): Forward / Deferred /
                     +Shadow+AO / +Shadow+AO+GI. Runs live in the render surface. -->
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,12,2">
                    <TextBlock Text="RENDER" FontFamily="{DynamicResource FontDisplay}"
                               FontWeight="SemiBold" FontSize="9" LetterSpacing="1"
                               Foreground="{DynamicResource ElectricBlueBrush}"
                               VerticalAlignment="Center" Margin="0,0,2,0"/>
                    <ComboBox Width="150"
                              ItemsSource="{Binding RenderModeOptions}"
                              SelectedIndex="{Binding EditorRenderModeIndex}"
                              ToolTip.Tip="Viewport pipeline mode (applies live to the render surface)"/>
                    <!-- Run target graphics API (plan §Run/Stop): Metal → Darwin/Debug|Release,
                         Vulkan → Darwin/DebugVulkan tree. -->
                    <TextBlock Text="API" FontFamily="{DynamicResource FontDisplay}"
                               FontWeight="SemiBold" FontSize="9" LetterSpacing="1"
                               Foreground="{DynamicResource ElectricBlueBrush}"
                               VerticalAlignment="Center" Margin="4,0,2,0"/>
                    <ComboBox Width="75"
                              ItemsSource="{Binding TargetGraphicsApis}"
                              SelectedIndex="{Binding TargetGraphicsApiIndex}"
                              ToolTip.Tip="Graphics API for the Run button's PrimalPlayer host"/>
                </StackPanel>

                <!-- Run：路线三选一 + 固定分辨率宽高 + 录制。
                     独立窗口（原路线 PrimalPlayer）/ 固定分辨率（PrimalPlayer
                     width/height/fixed 参数）/ 渲染表面（不开外部进程，内嵌
                     surface 切 runtime 渲染路径 + 场景相机取景）。 -->
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,12,2">
                    <TextBlock Text="RUN" FontFamily="{DynamicResource FontDisplay}"
                               FontWeight="SemiBold" FontSize="9" LetterSpacing="1"
                               Foreground="{DynamicResource ElectricBlueBrush}"
                               VerticalAlignment="Center" Margin="0,0,2,0"/>
                    <ComboBox Width="110"
                              ItemsSource="{Binding RunModeOptions}"
                              SelectedIndex="{Binding RunModeIndex}"
                              ToolTip.Tip="Run 路线：Player Window=外部 PrimalPlayer 默认窗口；Fixed Resolution=固定分辨率窗口（确定性录制）；Render Surface=编辑器内嵌渲染表面直接跑 runtime 渲染路径（Stop 退出）"/>
                    <TextBox Width="50" Height="24" Text="{Binding RunWidth}"
                             IsVisible="{Binding IsFixedResolutionMode}"
                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                             ToolTip.Tip="固定分辨率宽度（像素）"/>
                    <TextBox Width="50" Height="24" Text="{Binding RunHeight}"
                             IsVisible="{Binding IsFixedResolutionMode}"
                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                             ToolTip.Tip="固定分辨率高度（像素）"/>
                    <!-- Run 录制（Part B）：player 进程内逐帧 PNG 捕获（渲染帧与捕获帧
                         1:1，无丢帧），录满帧数自动退出；产物在 <project>/Captures/。 -->
                    <CheckBox Name="RecCheck" Content="Rec" VerticalAlignment="Center" Margin="6,0,0,0"
                              IsChecked="{Binding RecordOnRun}"
                              ToolTip.Tip="Run 时录制：PrimalPlayer 逐帧 PNG（渲染帧与捕获帧 1:1，无丢帧），录满自动退出"/>
                    <TextBox Name="RecordFramesBox" Width="50" Height="24" Text="{Binding RecordFrames}"
                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                             ToolTip.Tip="录制帧数上限（捕获帧数；0 = 跟随窗口关闭）"/>
                </StackPanel>

                <!-- View：着色模式 + AABB 显示 + 正交投影。
                     Viewport view mode (plan §6.3 A7): Shaded / Wireframe.
                     Orthogonal to RENDER (pass combos); applies per-frame. -->
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,12,2">
                    <TextBlock Text="VIEW" FontFamily="{DynamicResource FontDisplay}"
                               FontWeight="SemiBold" FontSize="9" LetterSpacing="1"
                               Foreground="{DynamicResource ElectricBlueBrush}"
                               VerticalAlignment="Center" Margin="0,0,2,0"/>
                    <ComboBox Name="ViewModeCombo" Width="90"
                              ItemsSource="{Binding ViewModeOptions}"
                              SelectedIndex="{Binding ViewModeIndex}"
                              ToolTip.Tip="Viewport shading mode (Shaded / Wireframe; Unlit 预留)"/>
                    <CheckBox Name="BoundsToggle" Content="Bounds" VerticalAlignment="Center" Margin="6,0,0,0"
                              IsChecked="{Binding ShowAllBounds}"
                              ToolTip.Tip="A7: 显示全部带网格实体的 AABB 线框"/>
                    <CheckBox Name="OrthoToggle" Content="Ortho" VerticalAlignment="Center" Margin="6,0,0,0"
                              Click="OnOrthoToggleClick"/>
                </StackPanel>

                <!-- Tools：图元网格 / 阵列 / 源码控制（Sequencer 已改为
                     View 菜单开关的独立标签页） -->
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,12,2">
                    <Button Content="Primitive Mesh…" Click="OnCreatePrimitiveMeshClick" Padding="10,2"
                            ToolTip.Tip="创建图元网格实体（Sphere/Box/Plane 等）"/>
                    <Button Content="Array…" Click="OnArrayDuplicateClick" Padding="10,2"
                            ToolTip.Tip="把选中实体沿轴深拷 N 份（A5 批量布设）"/>
                    <Button Content="SCM…" Click="OnSourceControlClick" Padding="10,2"
                            ToolTip.Tip="A8 源码控制：git 状态列表 + 提交面板"/>
                </StackPanel>

                <!-- Sim：物理/碰撞模拟播放（粒子 vs 世界静态碰撞、刚体验证的 UI 入口） -->
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,12,2">
                    <TextBlock Text="SIM" FontFamily="{DynamicResource FontDisplay}"
                               FontWeight="SemiBold" FontSize="9" LetterSpacing="1"
                               Foreground="{DynamicResource ElectricBlueBrush}"
                               VerticalAlignment="Center" Margin="0,0,2,0"/>
                    <Button Content="▶ Play" Click="OnSimPlayClick" Padding="10,2"
                            ToolTip.Tip="初始化并启动物理模拟（视口每帧 PipelineTick 推进；粒子 PhysicsCollision 与刚体在此验证）"/>
                    <Button Content="⏸ Pause" Click="OnSimPauseClick" Padding="10,2"
                            ToolTip.Tip="暂停物理模拟（保留当前状态）"/>
                </StackPanel>

                <!-- Gizmo：变换手柄模式 -->
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,2">
                    <Button Content="W Move" Click="OnTranslateModeClick" Padding="8,2" ToolTip.Tip="Translate gizmo (W)"/>
                    <Button Content="E Rotate" Click="OnRotateModeClick" Padding="8,2" ToolTip.Tip="Rotate gizmo (R)"/>
                    <Button Content="R Scale" Click="OnScaleModeClick" Padding="8,2" ToolTip.Tip="Scale gizmo (R)"/>
                </StackPanel>
            </WrapPanel>
        </ctrl:TextureFrame>

        <!-- =========== ROW 1: Hierarchy | Viewport | Inspector =========== -->
        <Grid Grid.Row="1" ColumnDefinitions="260,*,320" Background="Transparent">

            <!-- Hierarchy panel (single, no TabControl) -->
            <ctrl:TextureFrame Grid.Column="0" Classes="floating tex-panel" Margin="6,2,4,2">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="8,8,8,4">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="SCENES"
                                           FontFamily="{DynamicResource FontDisplay}"
                                           FontWeight="SemiBold" FontSize="11" LetterSpacing="2"
                                           Foreground="{DynamicResource ElectricBlueBrush}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="+" Click="OnAddSceneClick"
                                        Width="24" Height="20" Padding="0" Margin="2,0"
                                        ToolTip.Tip="Add Scene"/>
                                <Button Grid.Column="2" Content="×" Click="OnDeleteSceneClick"
                                        Width="24" Height="20" Padding="0" Margin="2,0,0,0"
                                        ToolTip.Tip="Remove Scene"/>
                            </Grid>
                            <ComboBox ItemsSource="{Binding Scenes}"
                                      SelectedItem="{Binding ActiveScene}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- 实体工厂：图标按钮 + WrapPanel，面板太窄时换行，
                                 不再横向滚动/裁切；名称与说明放 tooltip。 -->
                            <ItemsControl ItemsSource="{Binding EntityFactoryItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="entities:EntityFactoryDescriptor">
                                        <Button Tag="{Binding}"
                                                Click="OnAddEntityKindClick"
                                                Width="30" Height="24" Padding="0" Margin="0,0,4,4">
                                            <ToolTip.Tip>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Tooltip}"/>
                                                </StackPanel>
                                            </ToolTip.Tip>
                                            <TextBlock Text="{Binding IconGlyph}" TextAlignment="Center"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="HIERARCHY"
                                           FontFamily="{DynamicResource FontDisplay}"
                                           FontWeight="SemiBold" FontSize="11" LetterSpacing="2"
                                           Foreground="{DynamicResource ElectricBlueBrush}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="+" Click="OnAddEntityClick"
                                        Width="28" Height="22" Padding="0" Margin="2,0"
                                        ToolTip.Tip="Add Entity"/>
                                <Button Grid.Column="2" Content="×" Click="OnDeleteEntityClick"
                                        Width="28" Height="22" Padding="0" Margin="2,0,0,0"
                                        ToolTip.Tip="Delete Selected"/>
                            </Grid>
                            <TextBox x:Name="HierarchyFilter"
                                     Watermark="Filter entities..."
                                     TextChanged="OnHierarchyFilterChanged"/>
                        </StackPanel>
                    </Border>

                    <TreeView x:Name="HierarchyTree"
                              ItemsSource="{Binding Entities}"
                              SelectionMode="Multiple"
                              SelectionChanged="OnTreeSelectionChanged"
                              DoubleTapped="OnEntityDoubleClick"
                              DragDrop.AllowDrop="True"
                              DragDrop.Drop="OnHierarchyDrop"
                              DragDrop.DragOver="OnHierarchyDragOver"
                              Margin="4,0,4,8"
                              Background="Transparent"
                              BorderThickness="0">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Create Prefab…" Click="OnCreatePrefabClick"
                                          ToolTip.Tip="把选中实体（含子级）存为 .prefab 资产"/>
                                <MenuItem Header="Array Duplicate…" Click="OnArrayDuplicateClick"
                                          ToolTip.Tip="把选中实体沿轴深拷 N 份"/>
                                <MenuItem Header="Add Environment" Click="OnAddEnvironmentClick"
                                          ToolTip.Tip="挂 Environment 组件——属性面板由此显示雾/probe/GI 环境控制"/>
                                <MenuItem Header="Add Particle FX (PFX Emitter)" Click="OnAddParticleFxClick"
                                          ToolTip.Tip="给选中实体挂新粒子系统 ParticleFX 组件；之后把 .pfx_emitter 资产拖进 Inspector 的 Asset 槽，或在 PFX 编辑器里 Bind"/>
                                <MenuItem Header="Add Particle Emitter (Legacy)" Click="OnAddParticleEmitterClick"
                                          ToolTip.Tip="旧粒子系统（内置 fire 预设起步）。新粒子系统请用 Add Particle FX"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Name}"/>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </ctrl:TextureFrame>

            <!-- Viewport panel -->
            <Border Grid.Column="1" Classes="floating" Margin="2,2,2,2"
                    DragDrop.AllowDrop="True"
                    DragDrop.Drop="OnAssetDrop"
                    DragDrop.DragOver="OnDragOver">
                <Grid>
                    <views3d:EngineViewport3D Name="WorldViewport" MinHeight="200" MinWidth="200"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              Background="#FF000000"/>
                    <!-- SIM 未运行提示：粒子碰撞/刚体静默失效的可见化 -->
                    <Border x:Name="SimInactiveHint" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,8,0,0" Padding="10,4" CornerRadius="3"
                            Background="#CC302020" IsHitTestVisible="False" IsVisible="False">
                        <TextBlock Text="⚠ SIM 未运行 — 粒子碰撞/刚体停用，点击 ▶ Play 启动物理"
                                   Foreground="#FFD0A0" FontSize="12"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Inspector panel -->
            <ctrl:TextureFrame Grid.Column="2" Classes="floating tex-panel" Margin="4,2,6,2">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="INSPECTOR"
                               FontFamily="{DynamicResource FontDisplay}"
                               FontWeight="SemiBold" FontSize="11" LetterSpacing="2"
                               Foreground="{DynamicResource ElectricBlueBrush}"
                               Padding="10,10,8,4"/>
                    <views:PropertiesView DataContext="{Binding Properties}" Margin="4,0,4,8"/>
                </DockPanel>
            </ctrl:TextureFrame>
        </Grid>

        <!-- =========== ROW 2: Content Browser | Build Log / Logger tab =========== -->
        <TabControl Name="BottomPanelTabs" Grid.Row="2" Margin="6,2,6,6"
                    SelectedIndex="{Binding BottomPanelIndex, Mode=TwoWay}"
                    Background="Transparent" Padding="0">
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Content &amp; Logs" FontSize="12"/>
                </TabItem.Header>
        <Grid Name="AssetAndLogPanel" ColumnDefinitions="*,*" Margin="6,2,6,6">
            <!-- LEFT: Content Browser -->
            <ctrl:TextureFrame Grid.Column="0" Classes="floating tex-panel" Margin="0,0,3,0">
                <views:ContentBrowserView Name="ContentBrowserBottomView"/>
            </ctrl:TextureFrame>
            <!-- RIGHT: Build Log + Logger tab -->
            <ctrl:TextureFrame Grid.Column="1" Classes="floating tex-panel" Margin="3,0,0,0">
                <TabControl SelectedIndex="1" Background="Transparent" Padding="0">
                    <TabItem>
                        <TabItem.Header>
                            <TextBlock Text="BUILD LOG" FontFamily="{DynamicResource FontDisplay}"
                                       FontWeight="SemiBold" FontSize="10" LetterSpacing="2"
                                       Margin="6,0"/>
                        </TabItem.Header>
                        <views:BuildLogView/>
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <TextBlock Text="LOGGER" FontFamily="{DynamicResource FontDisplay}"
                                       FontWeight="SemiBold" FontSize="10" LetterSpacing="2"
                                       Margin="6,0"/>
                        </TabItem.Header>
                        <views:LoggerView Name="LoggerTabView"/>
                    </TabItem>
                </TabControl>
            </ctrl:TextureFrame>
        </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Sequencer" FontSize="12"/>
                </TabItem.Header>
                <seq:SequencerPanel/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
