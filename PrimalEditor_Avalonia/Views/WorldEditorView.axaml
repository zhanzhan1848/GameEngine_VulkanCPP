<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PrimalEditor_Avalonia.ViewModels"
             xmlns:views="using:PrimalEditor_Avalonia.Views"
             xmlns:views3d="using:PrimalEditor_Avalonia.Views.Engine3D"
             xmlns:conv="using:PrimalEditor_Avalonia.Converters"
             xmlns:self="using:PrimalEditor_Avalonia.Views"
             x:Class="PrimalEditor_Avalonia.Views.WorldEditorView"
             x:DataType="vm:WorldEditorViewModel"
             Background="#01000000">

    <Grid Background="#FF1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <!-- Row 0 (Auto): toolbar (single owner) -->
        <Border Grid.Row="0" Background="#FF2D2D30" Padding="5">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Build:" Foreground="#FFEEEEEE" VerticalAlignment="Center"/>
                <ComboBox Width="140"
                          ItemsSource="{Binding BuildConfigurations}"
                          SelectedItem="{Binding Project.BuildConfigName}"/>
                <Button Content="Build" Click="OnBuildClick" Padding="10,2"
                        IsEnabled="{Binding IsBuilding, RelativeSource={RelativeSource AncestorType=self:WorldEditorView}, Converter={x:Static conv:CommonConverters.InvertBool}}"/>
                <Button Content="Rebuild" Click="OnRebuildClick" Padding="10,2"
                        IsEnabled="{Binding IsBuilding, RelativeSource={RelativeSource AncestorType=self:WorldEditorView}, Converter={x:Static conv:CommonConverters.InvertBool}}"/>
                <Button Content="Run" Click="OnRunClick" Padding="10,2"
                        IsEnabled="{Binding IsBuilding, RelativeSource={RelativeSource AncestorType=self:WorldEditorView}, Converter={x:Static conv:CommonConverters.InvertBool}}"/>
                <Button Name="StopBuild" Content="Stop" Click="OnBuildStopClick" Padding="10,2"
                        IsEnabled="{Binding IsBuilding, RelativeSource={RelativeSource AncestorType=self:WorldEditorView}}"/>
                <Separator Margin="6,0"/>
                <Button Content="Primitive Mesh…" Click="OnCreatePrimitiveMeshClick" Padding="10,2"/>
                <Separator Margin="6,0"/>
                <CheckBox Name="OrthoToggle" Content="Ortho" VerticalAlignment="Center"
                          Click="OnOrthoToggleClick"/>
            </StackPanel>
        </Border>

        <!-- Row 1 (*): main editor area (Hierarchy | Viewport | Inspector) -->
        <Grid Grid.Row="1" ColumnDefinitions="250,*,300" Background="#FF1E1E1E">
            <DockPanel Grid.Column="0" Background="#FF1E1E1E">
                <Border DockPanel.Dock="Top" BorderBrush="LightGray" BorderThickness="0,0,0,1" Background="#FF2D2D30">
                    <StackPanel Margin="5,5,5,3">
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,3">
                            <TextBlock Grid.Column="0" Text="Scenes" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="+" Click="OnAddSceneClick"
                                    Width="24" Height="20" Padding="0" Margin="2,0"
                                    ToolTip.Tip="Add Scene"/>
                            <Button Grid.Column="2" Content="🗑" Click="OnDeleteSceneClick"
                                    Width="24" Height="20" Padding="0" Margin="2,0,0,0"
                                    ToolTip.Tip="Remove Scene"/>
                        </Grid>
                        <ComboBox ItemsSource="{Binding Scenes}"
                                  SelectedItem="{Binding ActiveScene}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="5,5,5,0">
                    <TextBlock Grid.Column="0" Text="Hierarchy" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="+" Click="OnAddEntityClick"
                            Width="28" Height="24" Padding="0" Margin="2,0"
                            ToolTip.Tip="Add Child Entity"/>
                    <Button Grid.Column="2" Content="🗑" Click="OnDeleteEntityClick"
                            Width="28" Height="24" Padding="0" Margin="2,0,0,0"
                            ToolTip.Tip="Delete Selected"/>
                </Grid>
                <TextBox DockPanel.Dock="Top" x:Name="HierarchyFilter"
                         Watermark="Filter entities..."
                         Margin="5,2,5,2"
                         TextChanged="OnHierarchyFilterChanged"/>
                <TreeView x:Name="HierarchyTree"
                          ItemsSource="{Binding Entities}"
                          SelectionMode="Multiple"
                          SelectionChanged="OnTreeSelectionChanged"
                          DoubleTapped="OnEntityDoubleClick">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}"/>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1,0" Background="#FF1E1E1E"
                    DragDrop.AllowDrop="True"
                    DragDrop.Drop="OnAssetDrop"
                    DragDrop.DragOver="OnDragOver">
                <views3d:EngineViewport3D Name="WorldViewport" MinHeight="200" MinWidth="200"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            Background="#FF000000"/>
            </Border>

            <DockPanel Grid.Column="2" Background="#FF1E1E1E">
                <TextBlock DockPanel.Dock="Top" Text="Inspector" FontWeight="Bold" Padding="5"/>
                <views:PropertiesView DataContext="{Binding Properties}"/>
            </DockPanel>
        </Grid>

        <!-- Row 2 (Auto): status / debug bar -->
        <TextBlock Grid.Row="2"
                   Text="{Binding DebugMessage}"
                   Background="LightGray" Padding="5"/>

        <!-- Row 3: build log -->
        <Border Grid.Row="3" Background="#FF1E1E1E" BorderBrush="#FF444444" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Build Log" FontWeight="Bold"
                           Foreground="#FFEEEEEE" Padding="5,2"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBox Name="BuildLogText" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="Consolas,Menlo,monospace" FontSize="11"
                             Background="#FF202020" Foreground="#FFCCCC"
                             DoubleTapped="OnBuildLogDoubleClick"
                             Padding="5"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
