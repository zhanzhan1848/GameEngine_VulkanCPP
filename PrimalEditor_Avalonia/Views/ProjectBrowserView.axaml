<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PrimalEditor_Avalonia.ViewModels"
        xmlns:views="using:PrimalEditor_Avalonia.Views"
        x:Class="PrimalEditor_Avalonia.Views.ProjectBrowserView"
        x:DataType="vm:ProjectBrowserViewModel"
        Title="PRIMAL EDITOR — Project Browser"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="{StaticResource VoidBrush}">

    <DockPanel Margin="24">

        <!-- HEADER -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,30" HorizontalAlignment="Center">
            <TextBlock Text="PRIMAL EDITOR"
                       FontFamily="{StaticResource FontDisplay}"
                       FontWeight="SemiBold" FontSize="24" LetterSpacing="1"
                       Foreground="{StaticResource ElectricBlueBrush}"
                       HorizontalAlignment="Center">
            </TextBlock>
            <TextBlock Text="A GAME EDITOR · AVALONIA 11 · C# 12"
                       FontFamily="{StaticResource FontDisplay}"
                       FontWeight="SemiBold" FontSize="10" LetterSpacing="1"
                       Foreground="{StaticResource CoralBrush}"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <Border Background="{StaticResource ElectricBlueBrush}" Height="1" Opacity="0.45"
                    Width="320" Margin="0,12,0,0"/>
        </StackPanel>

        <!-- TAB TOGGLE -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16">
            <ToggleButton Content="OPEN PROJECT"
                          x:Name="openProjectButton"
                          Margin="0,0,32,0"
                          IsChecked="True"
                          Click="OnOpenTabClick"
                          FontFamily="{StaticResource FontDisplay}"
                          FontSize="12"/>
            <ToggleButton Content="CREATE PROJECT"
                          x:Name="createProjectButton"
                          Click="OnCreateTabClick"
                          FontFamily="{StaticResource FontDisplay}"
                          FontSize="12"/>
        </StackPanel>

        <Border BorderBrush="{StaticResource ElectricBlueBrush}" BorderThickness="0,1,0,0"
                Padding="0,10,0,0">
            <Grid>
                <views:OpenProjectView x:Name="openPanel"/>
                <views:NewProjectView x:Name="newPanel" IsVisible="False"/>
            </Grid>
        </Border>
    </DockPanel>
</Window>
