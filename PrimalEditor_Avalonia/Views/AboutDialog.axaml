<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PrimalEditor_Avalonia.Views.AboutDialog"
        Title="About PrimalEditor"
        Width="460" Height="380"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource VoidBrush}">

    <Border Classes="floating" Margin="10">
        <StackPanel Margin="22" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="PRIMAL EDITOR"
                       FontFamily="{DynamicResource FontDisplay}"
                       FontWeight="SemiBold" FontSize="18" LetterSpacing="1"
                       Foreground="{DynamicResource ElectricBlueBrush}"
                       HorizontalAlignment="Center">
            </TextBlock>
            <TextBlock Text="AVALONIA · PHASE 1 · PURE C# BACKEND"
                       FontFamily="{DynamicResource FontDisplay}"
                       FontWeight="SemiBold" FontSize="10" LetterSpacing="1"
                       Foreground="{DynamicResource CoralBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <Border Background="{DynamicResource ElectricBlueBrush}" Height="1" Opacity="0.5" Margin="0,0,0,12"/>

            <TextBlock Text="A cross-platform game editor built with Avalonia 11 and C#."
                       TextWrapping="Wrap" HorizontalAlignment="Center" Classes="dim"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <TextBlock Text=".NET Runtime: " Classes="dim" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock x:Name="RuntimeVersion" FontFamily="{DynamicResource FontMono}"
                           Foreground="{DynamicResource ElectricBlueBrush}" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Avalonia: " Classes="dim" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Text="11.3.0" FontFamily="{DynamicResource FontMono}"
                           Foreground="{DynamicResource ElectricBlueBrush}" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="C# Version: " Classes="dim" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Text="12.0" FontFamily="{DynamicResource FontMono}"
                           Foreground="{DynamicResource ElectricBlueBrush}" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="OS: " Classes="dim" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock x:Name="OsVersion" FontFamily="{DynamicResource FontMono}"
                           Foreground="{DynamicResource ElectricBlueBrush}" FontWeight="SemiBold"/>
            </StackPanel>

            <TextBlock Text="FEATURES"
                       FontFamily="{DynamicResource FontDisplay}"
                       FontWeight="SemiBold" FontSize="11" LetterSpacing="1"
                       Foreground="{DynamicResource ElectricBlueBrush}"
                       Margin="0,16,0,6" HorizontalAlignment="Center"/>
            <TextBlock Text="• Project / Scene / Entity management"
                       FontFamily="{DynamicResource FontMono}"
                       HorizontalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <TextBlock Text="• JSON serialization with schema versioning"
                       FontFamily="{DynamicResource FontMono}"
                       HorizontalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <TextBlock Text="• Undo / Redo for all entity operations"
                       FontFamily="{DynamicResource FontMono}"
                       HorizontalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <TextBlock Text="• Properties panel with multi-select"
                       FontFamily="{DynamicResource FontMono}"
                       HorizontalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <TextBlock Text="• Content browser with file system navigation"
                       FontFamily="{DynamicResource FontMono}"
                       HorizontalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <TextBlock Text="• 5 project templates"
                       FontFamily="{DynamicResource FontMono}"
                       HorizontalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>

            <TextBlock Text="Deferred to Phase 2/3: 3D rendering, asset import, C++ engine integration"
                       FontSize="10" Classes="mono muted"
                       Foreground="{DynamicResource MutedTextBrush}"
                       HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/>

            <Button Content="OK" Click="OnOkClick" Width="90" HorizontalAlignment="Center"
                    Classes="accent" Margin="0,16,0,0"/>
        </StackPanel>
    </Border>
</Window>
