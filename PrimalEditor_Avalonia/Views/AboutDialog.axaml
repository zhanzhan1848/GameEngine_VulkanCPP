<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PrimalEditor_Avalonia.Views.AboutDialog"
        Title="About PrimalEditor"
        Width="450" Height="350"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="20" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="PrimalEditor Avalonia" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="Phase 1 - Pure C# Editor Backend" FontSize="12" Foreground="Gray" HorizontalAlignment="Center"/>
        <Separator Margin="0,10"/>

        <TextBlock Text="A cross-platform game editor built with Avalonia 11 and C#." TextWrapping="Wrap" HorizontalAlignment="Center"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <TextBlock Text=".NET Runtime: "/>
            <TextBlock x:Name="RuntimeVersion" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Avalonia: "/>
            <TextBlock Text="11.3.0" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="C# Version: "/>
            <TextBlock Text="12.0" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="OS: "/>
            <TextBlock x:Name="OsVersion" FontWeight="SemiBold"/>
        </StackPanel>

        <TextBlock Text="Features (Phase 1):" FontWeight="SemiBold" Margin="0,15,0,5" HorizontalAlignment="Center"/>
        <TextBlock Text="• Project / Scene / Entity management" HorizontalAlignment="Center" FontSize="11"/>
        <TextBlock Text="• JSON serialization with schema versioning" HorizontalAlignment="Center" FontSize="11"/>
        <TextBlock Text="• Undo/Redo for all entity operations" HorizontalAlignment="Center" FontSize="11"/>
        <TextBlock Text="• Properties panel with multi-select" HorizontalAlignment="Center" FontSize="11"/>
        <TextBlock Text="• Content browser with file system navigation" HorizontalAlignment="Center" FontSize="11"/>
        <TextBlock Text="• 5 project templates" HorizontalAlignment="Center" FontSize="11"/>

        <TextBlock Text="Deferred to Phase 2/3: 3D rendering, asset import, C++ engine integration"
                   FontSize="10" Foreground="Gray" HorizontalAlignment="Center" Margin="0,10,0,0"
                   TextWrapping="Wrap"/>

        <Button Content="OK" Click="OnOkClick" Width="80" HorizontalAlignment="Center" Margin="0,15,0,0"/>
    </StackPanel>
</Window>