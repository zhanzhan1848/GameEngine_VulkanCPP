<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PrimalEditor_Avalonia.ViewModels"
             x:Class="PrimalEditor_Avalonia.Views.EnvironmentView"
             x:DataType="vm:SceneEnvironmentViewModel"
             Background="{DynamicResource VoidBrush}">

    <ScrollViewer>
        <StackPanel Margin="12" Spacing="6" IsEnabled="{Binding HasScene}">

            <TextBlock Text="SCENE ENVIRONMENT"
                       FontFamily="{DynamicResource FontDisplay}"
                       FontWeight="SemiBold" FontSize="13" LetterSpacing="1"
                       Foreground="{DynamicResource ElectricBlueBrush}"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Persisted with the scene (.scene JSON). Edits are pushed to the native renderer on every change."
                       FontFamily="{DynamicResource FontMono}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,0,8"/>

            <TextBlock Text="AMBIENT LIGHT"
                       FontFamily="{DynamicResource FontDisplay}"
                       FontWeight="SemiBold" FontSize="12" LetterSpacing="1"
                       Foreground="{DynamicResource CoralBrush}"
                       Margin="0,8,0,4"/>
            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,2">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Color RGB" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <TextBox Text="{Binding AmbientR, Mode=TwoWay}" Width="60"/>
                    <TextBox Text="{Binding AmbientG, Mode=TwoWay}" Width="60"/>
                    <TextBox Text="{Binding AmbientB, Mode=TwoWay}" Width="60"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Intensity" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding AmbientIntensity, Mode=TwoWay}"/>
            </Grid>

            <TextBlock Text="FOG"
                       FontFamily="{DynamicResource FontDisplay}"
                       FontWeight="SemiBold" FontSize="12" LetterSpacing="1"
                       Foreground="{DynamicResource CoralBrush}"
                       Margin="0,12,0,4"/>
            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,2">
                <CheckBox Grid.Row="0" Grid.Column="1" Content="Enabled"
                          IsChecked="{Binding FogEnabled, Mode=TwoWay}"
                          Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Color RGB" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <TextBox Text="{Binding FogR, Mode=TwoWay}" Width="60"/>
                    <TextBox Text="{Binding FogG, Mode=TwoWay}" Width="60"/>
                    <TextBox Text="{Binding FogB, Mode=TwoWay}" Width="60"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Near / Far" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <TextBox Text="{Binding FogNear, Mode=TwoWay}" Width="80"/>
                    <TextBox Text="{Binding FogFar, Mode=TwoWay}" Width="80"/>
                </StackPanel>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Density" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <TextBox Text="{Binding FogDensity, Mode=TwoWay}" Width="80"/>
                    <Button Content="Fog Shader…" Click="OnFogShaderClick" Padding="8,2"
                            VerticalAlignment="Center"
                            ToolTip.Tip="B2: 编辑 Froxel 雾 MSL 源，保存即 off→on 热更"/>
                </StackPanel>
                <!-- 静态场景 GI 冻结（plan §2 A10）：烘焙 warm-start 后冻结 probe 更新。 -->
                <CheckBox Grid.Row="4" Grid.Column="1" Content="Static scene (freeze GI)"
                          IsChecked="{Binding StaticGIFrozen, Mode=TwoWay}"
                          ToolTip.Tip="烘焙 GI 并冻结 probe 更新；冻结期动态光/移动物体的 GI 不更新"
                          Margin="0,4,0,0"/>
            </Grid>

            <!-- ======== GI VOLUMES (plan §6.2 B1 L1)：管线级 DDGI 体积编辑 ======== -->
            <TextBlock Text="GI VOLUMES"
                       FontFamily="{DynamicResource FontDisplay}"
                       FontWeight="SemiBold" FontSize="12" LetterSpacing="1"
                       Foreground="{DynamicResource CoralBrush}"
                       Margin="0,14,0,4"/>
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2">
                <ComboBox Width="150" ItemsSource="{Binding GiVolumes.VolumeOptions}"
                          SelectedIndex="{Binding GiVolumes.SelectedIndexOption}"
                          IsEnabled="{Binding GiVolumes.HasVolumes}"/>
                <Button Content="Refresh" Click="OnGiVolumesRefreshClick" Padding="8,2"/>
                <Button Content="Append" Click="OnGiVolumesAppendClick" Padding="8,2"/>
                <Button Content="Remove" Click="OnGiVolumesRemoveClick" Padding="8,2"/>
                <Button Content="Materialize" Click="OnGiVolumesMaterializeClick" Padding="8,2"
                        ToolTip.Tip="把派生的近场/远场体积物化为可编辑条目"/>
            </StackPanel>
            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,4"
                  IsEnabled="{Binding GiVolumes.HasVolumes}">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Counts X/Y/Z" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <TextBox Text="{Binding GiVolumes.CountX, Mode=TwoWay}" Width="50"/>
                    <TextBox Text="{Binding GiVolumes.CountY, Mode=TwoWay}" Width="50"/>
                    <TextBox Text="{Binding GiVolumes.CountZ, Mode=TwoWay}" Width="50"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Spacing (m)" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GiVolumes.Spacing, Mode=TwoWay}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Rays / Probe" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding GiVolumes.RaysPerProbe, Mode=TwoWay}"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Ray Max Dist" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding GiVolumes.MaxDistance, Mode=TwoWay}"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Origin X/Y/Z" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <TextBox Text="{Binding GiVolumes.OriginX, Mode=TwoWay}" Width="60"/>
                    <TextBox Text="{Binding GiVolumes.OriginY, Mode=TwoWay}" Width="60"/>
                    <TextBox Text="{Binding GiVolumes.OriginZ, Mode=TwoWay}" Width="60"/>
                    <CheckBox Content="Use" IsChecked="{Binding GiVolumes.UseOriginOverride, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                    <Button Content="Apply" Click="OnGiVolumesApplyClick" Padding="12,2" Classes="accent"/>
                    <TextBlock Text="Apply 触发下帧管线重建" VerticalAlignment="Center" FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="120,*" Margin="0,8,0,0">
                <TextBlock Grid.Column="0" Text="PROBE DEBUG" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <ComboBox Width="180" ItemsSource="{Binding GiVolumes.ProbeVisOptions}"
                              SelectedIndex="{Binding GiVolumes.ProbeVisIndex}"
                              ToolTip.Tip="probe 调试可视化（数据面当前接线 Vulkan GIGather）"/>
                    <CheckBox Content="Show Probes" IsChecked="{Binding GiVolumes.ShowProbes, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="视口绘制 DDGI probe 格点（CPU 解析计算，编辑 Applies 后生效）"/>
                    <CheckBox Content="Probe Spheres" IsChecked="{Binding GiVolumes.ShowProbeSpheres, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="B1 L3: GPU probe 球 overlay（SH9 irradiance 采样 + 遮挡）"/>
                    <Button Content="Inspector…" Click="OnProbeInspectorClick" Padding="8,2"
                            ToolTip.Tip="B1 L2: probe 数值检查器（SH9 色板 + confidence）"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="SKYBOX"
                       FontFamily="{DynamicResource FontDisplay}"
                       FontWeight="SemiBold" FontSize="12" LetterSpacing="1"
                       Foreground="{DynamicResource CoralBrush}"
                       Margin="0,12,0,4"/>
            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" Margin="0,2">
                <CheckBox Grid.Row="0" Grid.Column="1" Content="Enabled"
                          IsChecked="{Binding SkyboxEnabled, Mode=TwoWay}"
                          Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Color RGB" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <TextBox Text="{Binding SkyR, Mode=TwoWay}" Width="60"/>
                    <TextBox Text="{Binding SkyG, Mode=TwoWay}" Width="60"/>
                    <TextBox Text="{Binding SkyB, Mode=TwoWay}" Width="60"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="HDR Env Map" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <Border Grid.Row="2" Grid.Column="1" x:Name="EnvMapDropZone"
                        Background="#1A000000" BorderBrush="#3A3F4B" BorderThickness="1"
                        CornerRadius="4" Padding="8,5"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragOver="OnEnvMapDragOver"
                        DragDrop.DragLeave="OnEnvMapDragLeave"
                        DragDrop.Drop="OnEnvMapDrop">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                        <TextBlock Grid.Column="0" Text="☁" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SecondaryTextBrush}">
                            <TextBlock.Text>
                                <Binding Path="EnvMapPath" Mode="OneWay"
                                         TargetNullValue="Drop .hdr / .texture here, or browse"/>
                            </TextBlock.Text>
                        </TextBlock>
                        <Button Grid.Column="2" Content="…" Click="OnBrowseEnvMapClick"
                                ToolTip.Tip="Pick an equirectangular .hdr / .texture environment map"/>
                        <Button Grid.Column="3" Content="✕" Click="OnClearEnvMapClick"
                                ToolTip.Tip="Clear the environment map"/>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Text="TONE MAPPING"
                       FontFamily="{DynamicResource FontDisplay}"
                       FontWeight="SemiBold" FontSize="12" LetterSpacing="1"
                       Foreground="{DynamicResource CoralBrush}"
                       Margin="0,12,0,4"/>
            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" Margin="0,2">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding ToneMappingOptions}"
                          SelectedItem="{Binding ToneMapping}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Exposure" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding Exposure, Mode=TwoWay}"/>
            </Grid>

            <TextBlock Text="STATUS"
                       FontFamily="{DynamicResource FontDisplay}"
                       FontWeight="SemiBold" FontSize="12" LetterSpacing="1"
                       Foreground="{DynamicResource CoralBrush}"
                       Margin="0,12,0,4"/>
            <TextBlock Text="{Binding StatusMessage}"
                       FontFamily="{DynamicResource FontMono}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AmberBrush}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>