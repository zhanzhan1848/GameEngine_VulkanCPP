<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:views="using:PrimalEditor_Avalonia.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PrimalEditor_Avalonia.ViewModels"
             xmlns:components="using:PrimalEditor_Avalonia.Components"
             x:Class="PrimalEditor_Avalonia.Views.PropertiesView"
             x:DataType="vm:PropertiesViewModel"
             Background="{DynamicResource VoidBrush}">

    <ScrollViewer>
        <StackPanel Margin="12" Spacing="6" IsEnabled="{Binding HasSelection}">

            <TextBlock Text="PROPERTIES"
                       FontFamily="{DynamicResource FontDisplay}"
                       FontWeight="SemiBold" FontSize="13" LetterSpacing="1"
                       Foreground="{DynamicResource ElectricBlueBrush}"
                       Margin="0,0,0,12">
            </TextBlock>

            <TextBlock Text="NAME"
                       FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"
                       FontSize="11" LetterSpacing="2"
                       Foreground="{DynamicResource ElectricBlueBrush}"/>
            <TextBox Text="{Binding EntityName, Mode=TwoWay}" Margin="0,2,0,4"/>

            <CheckBox Content="Is Enabled"
                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                      Margin="0,4,0,8"/>

            <Separator Margin="0,8"/>

            <TextBlock Text="TRANSFORM"
                       FontFamily="{DynamicResource FontDisplay}"
                       FontWeight="SemiBold" FontSize="12" LetterSpacing="1"
                       Foreground="{DynamicResource CoralBrush}"
                       Margin="0,0,0,6"/>

            <TextBlock Text="Position"
                       FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"
                       FontSize="10" LetterSpacing="2"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,4,0,0"/>
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,3">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center"
                           Foreground="{DynamicResource ElectricBlueBrush}"
                           FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"/>
                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding PosX, Mode=TwoWay}" KeyDown="OnTransformTextBoxKeyDown" Margin="0,0,2,0"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Y" VerticalAlignment="Center"
                           Foreground="{DynamicResource ElectricBlueBrush}"
                           FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PosY, Mode=TwoWay}" KeyDown="OnTransformTextBoxKeyDown" Margin="2,0"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Z" VerticalAlignment="Center"
                           Foreground="{DynamicResource ElectricBlueBrush}"
                           FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"/>
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding PosZ, Mode=TwoWay}" KeyDown="OnTransformTextBoxKeyDown" Margin="2,0,0,0"/>
            </Grid>

            <TextBlock Text="Rotation"
                       FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"
                       FontSize="10" LetterSpacing="2"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,4,0,0"/>
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" Margin="0,3">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center"
                           Foreground="{DynamicResource ElectricBlueBrush}"
                           FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"/>
                <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding RotX, Mode=TwoWay}" KeyDown="OnTransformTextBoxKeyDown" Margin="0,0,2,0"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Y" VerticalAlignment="Center"
                           Foreground="{DynamicResource ElectricBlueBrush}"
                           FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RotY, Mode=TwoWay}" KeyDown="OnTransformTextBoxKeyDown" Margin="2,0"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Z" VerticalAlignment="Center"
                           Foreground="{DynamicResource ElectricBlueBrush}"
                           FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"/>
                <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding RotZ, Mode=TwoWay}" KeyDown="OnTransformTextBoxKeyDown" Margin="2,0,0,0"/>
            </Grid>

            <TextBlock Text="Scale"
                       FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"
                       FontSize="10" LetterSpacing="2"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,4,0,0"/>
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto" Margin="0,3">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center"
                           Foreground="{DynamicResource ElectricBlueBrush}"
                           FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"/>
                <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding ScaleX, Mode=TwoWay}" KeyDown="OnTransformTextBoxKeyDown" Margin="0,0,2,0"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Y" VerticalAlignment="Center"
                           Foreground="{DynamicResource ElectricBlueBrush}"
                           FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ScaleY, Mode=TwoWay}" KeyDown="OnTransformTextBoxKeyDown" Margin="2,0"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Z" VerticalAlignment="Center"
                           Foreground="{DynamicResource ElectricBlueBrush}"
                           FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold"/>
                <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding ScaleZ, Mode=TwoWay}" KeyDown="OnTransformTextBoxKeyDown" Margin="2,0,0,0"/>
            </Grid>

            <!-- ===== COLLIDER（M2-D） ===== -->
            <StackPanel IsVisible="{Binding HasColliderComponent}" Spacing="6">
                <Separator Margin="0,12"/>

                <TextBlock Text="COLLIDER"
                       FontFamily="{DynamicResource FontDisplay}"
                       FontWeight="SemiBold" FontSize="12" LetterSpacing="1"
                       Foreground="{DynamicResource CoralBrush}"
                       Margin="0,0,0,6"/>
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,3">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Shape" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding ColliderShapeOptions}"
                              SelectedIndex="{Binding ColliderShapeIndex, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Half Size" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <TextBox Text="{Binding ColliderHalfX, Mode=TwoWay}" Width="60"/>
                        <TextBox Text="{Binding ColliderHalfY, Mode=TwoWay}" Width="60"/>
                        <TextBox Text="{Binding ColliderHalfZ, Mode=TwoWay}" Width="60"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Layer" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding ColliderLayer, Mode=TwoWay}"/>

                    <CheckBox Grid.Row="3" Grid.Column="1"
                              Content="Is Trigger"
                              IsChecked="{Binding ColliderIsTrigger, Mode=TwoWay}"
                              Margin="0,4,0,0"/>
                </Grid>
            </StackPanel>

            <!-- ===== RIGID BODY（M2-D） ===== -->
            <StackPanel IsVisible="{Binding HasRigidBodyComponent}" Spacing="6">
                <Separator Margin="0,12"/>

                <TextBlock Text="RIGID BODY"
                       FontFamily="{DynamicResource FontDisplay}"
                       FontWeight="SemiBold" FontSize="12" LetterSpacing="1"
                       Foreground="{DynamicResource CoralBrush}"
                       Margin="0,0,0,6"/>
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,3">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding RigidBodyModeOptions}"
                              SelectedIndex="{Binding RigidBodyModeIndex, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Mass" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding RigidBodyMass, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Restitution" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding RigidBodyRestitution, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Friction" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox  Grid.Row="3" Grid.Column="1" Text="{Binding RigidBodyFriction, Mode=TwoWay}"/>
                </Grid>
            </StackPanel>

            <StackPanel IsVisible="{Binding HasLightComponent}" Spacing="6">
                <Separator Margin="0,12"/>

                <TextBlock Text="LIGHT"
                       FontFamily="{DynamicResource FontDisplay}"
                       FontWeight="SemiBold" FontSize="12" LetterSpacing="1"
                       Foreground="{DynamicResource CoralBrush}"
                       Margin="0,0,0,6"/>
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,3">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Type" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding LightTypeOptions}"
                          SelectedItem="{Binding Light.LightType, Mode=TwoWay}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Intensity" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding Light.Intensity, Mode=TwoWay}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Range" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding Light.Range, Mode=TwoWay}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Umbra" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBox  Grid.Row="3" Grid.Column="1" Text="{Binding Light.UmbraAngle, Mode=TwoWay}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Penumbra" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBox  Grid.Row="4" Grid.Column="1" Text="{Binding Light.PenumbraAngle, Mode=TwoWay}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Color RGB" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <TextBox Text="{Binding Light.ColorR, Mode=TwoWay}" Width="60"/>
                    <TextBox Text="{Binding Light.ColorG, Mode=TwoWay}" Width="60"/>
                    <TextBox Text="{Binding Light.ColorB, Mode=TwoWay}" Width="60"/>
                </StackPanel>

                <CheckBox Grid.Row="6" Grid.Column="1"
                          Content="Cast Shadow"
                          IsChecked="{Binding Light.CastShadow, Mode=TwoWay}"
                          Margin="0,4,0,0"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="HDR Env Map" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <Border Grid.Row="7" Grid.Column="1" x:Name="LightEnvMapDropZone"
                        Background="#1A000000" BorderBrush="#3A3F4B" BorderThickness="1"
                        CornerRadius="4" Padding="8,5"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragOver="OnLightEnvMapDragOver"
                        DragDrop.DragLeave="OnLightEnvMapDragLeave"
                        DragDrop.Drop="OnLightEnvMapDrop">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                        <TextBlock Grid.Column="0" Text="☁" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SecondaryTextBrush}">
                            <TextBlock.Text>
                                <Binding Path="EnvMapPath" Mode="OneWay"
                                         TargetNullValue="Drop .hdr / .texture here, or browse"/>
                            </TextBlock.Text>
                        </TextBlock>
                        <Button Grid.Column="2" Content="…" Click="OnBrowseLightEnvMapClick"
                                ToolTip.Tip="Pick an equirectangular .hdr / .texture environment map"/>
                        <Button Grid.Column="3" Content="✕" Click="OnClearLightEnvMapClick"
                                ToolTip.Tip="Clear the environment map"/>
                    </Grid>
                </Border>

                <CheckBox Grid.Row="8" Grid.Column="1"
                          Content="Show Skybox"
                          IsChecked="{Binding SkyboxEnabled, Mode=TwoWay}"
                          Margin="0,4,0,0"/>
                </Grid>

                <!-- Environment light: selecting an Env Light entity swaps the
                     inspector to the scene environment panel. -->
                <StackPanel IsVisible="{Binding HasEnvironmentComponent}" Margin="0,10,0,0">
                    <TextBlock Text="ENVIRONMENT"
                               FontFamily="{DynamicResource FontDisplay}"
                               FontWeight="SemiBold" FontSize="12" LetterSpacing="1"
                               Foreground="{DynamicResource CoralBrush}"
                               Margin="0,0,0,6"/>
                    <views:EnvironmentView DataContext="{Binding EnvironmentVM}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel IsVisible="{Binding HasCameraComponent}" Spacing="6">
                <Separator Margin="0,12"/>

                <TextBlock Text="CAMERA"
                       FontFamily="{DynamicResource FontDisplay}"
                       FontWeight="SemiBold" FontSize="12" LetterSpacing="1"
                       Foreground="{DynamicResource CoralBrush}"
                       Margin="0,0,0,6"/>
            <!-- Look-through-this-camera button. Visible only when a Camera
                 entity is selected. Clicking routes the viewport to render
                 through THIS scene Camera instead of the editor camera.
                 The same button (with a different label) is shown when
                 the viewport is already looking through this camera so
                 the user can switch back. -->
                <Button Content="{Binding LookThroughButtonLabel}"
                    Click="OnLookThroughCameraClick"
                    IsVisible="{Binding HasCameraComponent}"
                    Margin="0,0,0,8" Padding="10,2"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Classes="accent"/>
                <Button Content="{Binding MainCameraButtonLabel}"
                    Click="OnSetMainCameraClick"
                    IsVisible="{Binding HasCameraComponent}"
                    Margin="0,0,0,8" Padding="10,2"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"/>
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,3">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Projection" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <ComboBox Grid.Row="0" Grid.Column="1"
                          SelectedItem="{Binding Camera.Projection, Mode=TwoWay}">
                    <ComboBoxItem>Perspective</ComboBoxItem>
                    <ComboBoxItem>Orthographic</ComboBoxItem>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="FOV (°)" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding Camera.Fov, Mode=TwoWay}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Near / Far" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <TextBox Text="{Binding Camera.NearPlane, Mode=TwoWay}" Width="80"/>
                    <TextBox Text="{Binding Camera.FarPlane, Mode=TwoWay}" Width="80"/>
                </StackPanel>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Clear Color" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <TextBox Text="{Binding Camera.ClearColorR, Mode=TwoWay}" Width="50"/>
                    <TextBox Text="{Binding Camera.ClearColorG, Mode=TwoWay}" Width="50"/>
                    <TextBox Text="{Binding Camera.ClearColorB, Mode=TwoWay}" Width="50"/>
                    <TextBox Text="{Binding Camera.ClearColorA, Mode=TwoWay}" Width="50"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Ortho Size" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBox  Grid.Row="4" Grid.Column="1" Text="{Binding Camera.OrthoSize, Mode=TwoWay}"/>
                </Grid>
            </StackPanel>

            <!-- 粒子发射器（plan §6.3 B4 P2） -->
            <StackPanel IsVisible="{Binding HasParticleComponent}" Spacing="6">
                <Separator Margin="0,12"/>
                <TextBlock Text="PARTICLE EMITTER" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid ColumnDefinitions="90,*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Text="Preset" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ParticlePresetOptions}"
                              SelectedItem="{Binding ParticlePresetName}"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="Save…" Command="{Binding ParticleSavePresetCommand}"
                            Margin="6,0,0,0" Padding="8,2"
                            ToolTip.Tip="把当前预设另存为项目根下的 .particle.json"/>
                    <TextBlock Grid.Row="1" Text="Spawn Rate" VerticalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ParticleSpawnRate, Mode=TwoWay}" Margin="0,4,0,0"/>
                    <CheckBox Grid.Row="2" Grid.Column="1" Content="Enabled" IsChecked="{Binding ParticleEnabled, Mode=TwoWay}" Margin="0,4,0,0"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                    <Button Content="Curves…" Click="OnOpenCurveEditorClick"
                            Padding="8,2"
                            ToolTip.Tip="B4 P3: 编辑选中实体发射器的 Scale/Alpha/Color/Velocity/Force/Rotation 六条 over-life 曲线"/>
                    <Button Content="Open Editor…" Command="{Binding ParticleOpenEditorCommand}"
                            Padding="8,2"
                            ToolTip.Tip="在独立的粒子编辑器窗口中编辑当前预设（材质编辑器同款；内置预设首次打开会先导出为项目根下的 .particle.json）"/>
                </StackPanel>
            </StackPanel>

            <!-- Particle FX（PFX 可编程粒子框架，N1 基础表单 + N6 暴露参数编辑） -->
            <StackPanel IsVisible="{Binding HasParticleFXComponent}" Spacing="6">
                <Separator Margin="0,12"/>
                <TextBlock Text="PARTICLE FX" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Text="Asset" VerticalAlignment="Center"
                               ToolTip.Tip=".pfx_emitter JSON 资产路径"/>
                    <Border Grid.Row="0" Grid.Column="1" Background="#22FFFFFF" Padding="4,2"
                            DragDrop.AllowDrop="True"
                            DragDrop.DragOver="OnPfxAssetDragOver"
                            DragDrop.DragLeave="OnPfxAssetDragLeave"
                            DragDrop.Drop="OnPfxAssetDrop"
                            ToolTip.Tip="从 Content Browser 拖入 .pfx_emitter 资产；换绑立即重建发射器">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding ParticleFXAssetPath, Mode=TwoWay}"
                                 Watermark="拖入 .pfx_emitter 资产（或手输路径）" FontSize="11"/>
                        <Button Grid.Column="1" Content="✕" Padding="4,0" Margin="4,0,0,0"
                                Click="OnPfxAssetClearClick"
                                ToolTip.Tip="清除绑定（场景发射器随之销毁）"/>
                      </Grid>
                    </Border>
                    <CheckBox Grid.Row="1" Grid.Column="1" Content="Enabled" IsChecked="{Binding ParticleFXEnabled, Mode=TwoWay}" Margin="0,4,0,0"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="Sync Params → Engine"
                            Command="{Binding PfxSyncParamsCommand}" Margin="0,6,0,0" Padding="8,2"
                            HorizontalAlignment="Left"
                            ToolTip.Tip="推送 ExposedParams 到引擎发射器"/>
                </Grid>
                <Button Content="Open Editor…" Command="{Binding PfxOpenEditorCommand}"
                        HorizontalAlignment="Left" Padding="8,2" Margin="0,6,0,0"
                        ToolTip.Tip="在 PFX 模块堆栈编辑器窗口中打开该资产（spawn/init/update 模块 + 曲线 + 热预览）"/>
                <TextBlock Text="Exposed Params" FontSize="11" Margin="0,8,0,2"/>
                <ItemsControl ItemsSource="{Binding PfxParamRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,70" Margin="0,1">
                                <TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" IsReadOnly="True"/>
                                <TextBox Grid.Column="1" Text="{Binding ValueStr, Mode=TwoWay}" Margin="4,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Sync Params → Engine" Command="{Binding PfxSyncParamsCommand}"
                        Padding="8,2" Margin="0,4,0,0" HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- Lua Script（scripting S1 收官：参数编辑段；应用语义 = script.set-param CLI） -->
            <StackPanel IsVisible="{Binding HasLuaScriptComponent}" Spacing="6">
                <Separator Margin="0,12"/>
                <TextBlock Text="LUA SCRIPT" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid ColumnDefinitions="90,*">
                    <TextBlock Grid.Column="0" Text="Asset" VerticalAlignment="Center"
                               ToolTip.Tip="绑定到实体的 .lua 资产；换绑 = 从 Content Browser 把 .lua 拖到实体上"/>
                    <TextBox Grid.Column="1" Text="{Binding LuaScriptAssetName, Mode=OneWay}" IsReadOnly="True"
                             FontSize="11" Watermark="(未绑定)"/>
                </Grid>
                <TextBlock Text="Params" FontSize="11" Margin="0,8,0,2"
                           ToolTip.Tip="params.&lt;key&gt;（字符串值，Lua 算术自然转型）；应用后引擎实例销毁重建，begin_play 以新参数重放"/>
                <ItemsControl ItemsSource="{Binding LuaParamRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,*,26" Margin="0,1">
                                <TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" IsReadOnly="True" FontSize="11"/>
                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" Margin="4,0,0,0" FontSize="11"
                                         ToolTip.Tip="字符串值（数字/true/false 按需填；键含空格会在应用时被拒）"/>
                                <Button Grid.Column="2" Content="✕" Padding="0" Margin="4,0,0,0" FontSize="10"
                                        Click="OnLuaParamRemoveClick" Tag="{Binding}"
                                        ToolTip.Tip="删除该参数行（应用后生效）"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,*,Auto" Margin="0,2,0,0">
                    <TextBox Grid.Column="0" Text="{Binding LuaNewParamName, Mode=TwoWay}" FontSize="11"
                             Watermark="新参数名" ToolTip.Tip="键规则：非空、不含空格、不与现有键重复"/>
                    <TextBox Grid.Column="1" Text="{Binding LuaNewParamValue, Mode=TwoWay}" Margin="4,0,0,0" FontSize="11"
                             Watermark="值（字符串）"/>
                    <Button Grid.Column="2" Content="＋" Padding="6,0" Margin="4,0,0,0"
                            Command="{Binding LuaAddParamCommand}" ToolTip.Tip="添加参数行（应用后生效）"/>
                </Grid>
                <Button Content="应用参数（销毁重建实例）" Command="{Binding LuaApplyParamsCommand}"
                        Padding="8,2" HorizontalAlignment="Left"
                        ToolTip.Tip="把行集写回组件 Parameters（唯一事实源，可 Undo），并销毁重建引擎脚本实例"/>
            </StackPanel>

            <!-- 玩法规则（gameplay S1-S4）：契约 JSON 编辑段；应用 = 替换组件（文档模型+Undo） -->
            <StackPanel IsVisible="{Binding HasGameplayRulesComponent}" Spacing="6">
                <Separator Margin="0,12"/>
                <TextBlock Text="GAMEPLAY RULES" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"
                           ToolTip.Tip="L0 契约（状态机/触发器/任务）；JSON 与场景序列化同一 schema——AI 可读可 diff，人改数值全程 Undo"/>
                <TextBox Text="{Binding GameplayRulesJsonEditor, Mode=TwoWay}" FontSize="11"
                         FontFamily="Menlo,Consolas,monospace" MinHeight="140" AcceptsReturn="True"
                         TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Watermark="InitialState / States / Transitions / Triggers / Tasks（JSON）"/>
                <TextBlock Text="{Binding GameplayJsonError}" FontSize="10" Foreground="IndianRed"
                           TextWrapping="Wrap" IsVisible="{Binding GameplayJsonError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <Button Content="应用契约（文档模型+Undo）" Command="{Binding GameplayApplyJsonCommand}"
                        Padding="8,2" HorizontalAlignment="Left"
                        ToolTip.Tip="解析 JSON → 替换 GameplayRulesComponent（可 editor.undo 回滚）；非法 JSON 拒绝且组件不动"/>
            </StackPanel>

            <StackPanel IsVisible="{Binding HasMeshRendererComponent}" Spacing="6">
                <Separator Margin="0,12"/>

                <TextBlock Text="MESH RENDERER"                       FontFamily="{DynamicResource FontDisplay}"
                       FontWeight="SemiBold" FontSize="12" LetterSpacing="1"
                       Foreground="{DynamicResource CoralBrush}"
                       Margin="0,0,0,6"/>
                <Grid ColumnDefinitions="80,*,30,30" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,3">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mesh" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <Border Grid.Row="0" Grid.Column="1"
                        MinHeight="42" Padding="9,5" CornerRadius="4"
                        BorderThickness="1" BorderBrush="{DynamicResource HairlineBrush}"
                        Background="{DynamicResource PanelBrush}"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragOver="OnMeshAssetDragOver"
                        DragDrop.Drop="OnMeshAssetDrop">
                    <StackPanel Spacing="1">
                        <TextBlock Text="{Binding MeshAsset.DisplayName}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding MeshAsset.PathDisplay}"
                                   FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Button Grid.Row="0" Grid.Column="2" Content="…" Margin="3,0,0,0"
                        ToolTip.Tip="Choose Mesh asset" Click="OnPickMesh"/>
                <Button Grid.Row="0" Grid.Column="3" Content="×" Margin="3,0,0,0"
                        ToolTip.Tip="Clear Mesh reference" Click="OnClearMesh"/>

                <Button Grid.Row="1" Grid.Column="1" Content="Locate in Content Browser"
                        HorizontalAlignment="Left" Margin="0,3,0,2" Padding="8,1"
                        IsEnabled="{Binding MeshAsset.HasAsset}"
                        Click="OnRevealMesh"/>

                <CheckBox Grid.Row="2" Grid.Column="1"
                          Content="Cast Shadow"
                          IsChecked="{Binding MeshRenderer.CastShadow, Mode=TwoWay}"/>
                <CheckBox Grid.Row="3" Grid.Column="1"
                          Content="Receive Shadow"
                          IsChecked="{Binding MeshRenderer.ReceiveShadow, Mode=TwoWay}"/>
                </Grid>

                <Expander Header="Debug asset reference" Margin="80,2,0,2">
                    <Grid ColumnDefinitions="55,*" RowDefinitions="Auto">
                        <TextBlock Grid.Column="0" Text="GUID" FontSize="9"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBox Grid.Column="1" Text="{Binding MeshAsset.GuidDisplay}"
                                 IsReadOnly="True" FontSize="9"/>
                    </Grid>
                </Expander>

                <TextBlock Text="MATERIALS"
                           FontFamily="{DynamicResource FontDisplay}"
                           FontWeight="SemiBold" FontSize="10" LetterSpacing="2"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,8,0,0"/>
                <ItemsControl ItemsSource="{Binding MeshMaterials}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:MeshMaterialSlotViewModel">
                            <Grid ColumnDefinitions="80,*,30" Margin="0,3">
                                <TextBlock Grid.Column="0" Text="{Binding SlotName}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <Border Grid.Column="1"
                                        MinHeight="38" Padding="9,5"
                                        CornerRadius="4"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource HairlineBrush}"
                                        Background="{DynamicResource PanelBrush}"
                                        DragDrop.AllowDrop="True"
                                        DragDrop.DragOver="OnMeshMaterialDragOver"
                                        DragDrop.Drop="OnMeshMaterialDrop">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Drag a Material asset here"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Button Grid.Column="2" Content="…" Margin="3,0,0,0"
                                        Click="OnPickMaterial"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel IsVisible="{Binding HasMaterialOverrideComponent}" Spacing="6">
                <TextBlock Text="MATERIAL OVERRIDE"
                       FontFamily="{DynamicResource FontDisplay}"
                       FontWeight="SemiBold" FontSize="12" LetterSpacing="1"
                       Foreground="{DynamicResource CoralBrush}"
                       Margin="0,12,0,6"/>
                <ItemsControl ItemsSource="{Binding MaterialOverrides}" Margin="4,3,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="components:MaterialOverrideViewModel">
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto" Margin="0,3">
                            <TextBlock Grid.Column="0" Text="{Binding SlotName}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                <TextBox Text="{Binding MaterialGuid, Mode=TwoWay}" Width="220"/>
                                <Button Content="…" Width="28" Click="OnPickMaterial"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Text="{Binding MixedValueMessage}"
                       FontFamily="{DynamicResource FontMono}"
                       FontStyle="Italic"
                       Foreground="{DynamicResource AmberBrush}"
                       IsVisible="{Binding HasMixedValues}"
                       Margin="0,12,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
