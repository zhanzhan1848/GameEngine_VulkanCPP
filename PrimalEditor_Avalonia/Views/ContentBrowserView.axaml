<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PrimalEditor_Avalonia.ViewModels"
             xmlns:conv="using:PrimalEditor_Avalonia.Converters"
             xmlns:views="using:PrimalEditor_Avalonia.Views"
             x:Class="PrimalEditor_Avalonia.Views.ContentBrowserView"
             x:DataType="vm:ContentBrowserViewModel"
             Background="{StaticResource VoidBrush}">

    <UserControl.Resources>
        <SolidColorBrush x:Key="DropHighlightBrush" Color="#4000F0FF"/>

        <StreamGeometry x:Key="MeshIconGeometry">M0,0 L40,0 L40,40 L0,40 Z M10,10 L30,10 L20,30 Z</StreamGeometry>
        <StreamGeometry x:Key="TextureIconGeometry">M0,0 L40,0 L40,40 L0,40 Z M5,5 L35,5 L35,35 L5,35 Z M5,5 L20,20 L35,5 M5,35 L20,20 L35,35</StreamGeometry>
        <StreamGeometry x:Key="AudioIconGeometry">M0,0 L40,0 L40,40 L0,40 Z M10,5 L10,35 M20,10 L20,30 M30,15 L30,25</StreamGeometry>
        <StreamGeometry x:Key="ScriptIconGeometry">M0,0 L40,0 L40,40 L0,40 Z M10,5 L30,5 M10,15 L30,15 M10,25 L25,25 M10,35 L20,35</StreamGeometry>
        <StreamGeometry x:Key="FileIconGeometry">M0,0 L25,0 L40,15 L40,40 L0,40 Z M25,0 L25,15 L40,15</StreamGeometry>
    </UserControl.Resources>

    <Grid ColumnDefinitions="220,*,280">

        <!-- =========== LEFT: folder tree (floating) =========== -->
        <Border Grid.Column="0" Classes="floating" Margin="6,6,3,6">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="8,8,8,4">
                    <TextBlock Text="FOLDERS"
                               FontFamily="{StaticResource FontDisplay}"
                               FontWeight="SemiBold" FontSize="11" LetterSpacing="2"
                               Foreground="{StaticResource ElectricBlueBrush}"/>
                </Border>
                <TreeView ItemsSource="{Binding Folders}"
                          SelectedItem="{Binding SelectedFolder}"
                          DoubleTapped="OnFolderDoubleClick"
                          DragDrop.AllowDrop="True"
                          Margin="2,0,2,6"
                          Background="Transparent"
                          BorderThickness="0">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Subfolders}">
                            <TextBlock Text="{Binding Name}"/>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- =========== RIGHT: file area =========== -->
        <Panel Grid.Column="1"
               DragDrop.AllowDrop="True"
               DragDrop.DragEnter="OnDragEnter"
               DragDrop.DragLeave="OnDragLeave"
               DragDrop.DragOver="OnDragOver"
               DragDrop.Drop="OnFileDrop"
               Margin="3,6,6,6">

            <Border Classes="floating">
                <DockPanel>

                    <Border DockPanel.Dock="Top" Padding="8,8,8,4">
                        <Grid RowDefinitions="Auto,Auto" Margin="0">
                            <ItemsControl Grid.Row="0" ItemsSource="{Binding Breadcrumbs}"
                                          IsVisible="{Binding HasBreadcrumbs}"
                                          Margin="0,0,0,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button Content="{Binding Name}"
                                                    Click="OnBreadcrumbClick"
                                                    Tag="{Binding}"
                                                    Padding="6,1"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontFamily="{StaticResource FontMono}"/>
                                            <TextBlock Text="›" VerticalAlignment="Center"
                                                       Foreground="{StaticResource ElectricBlueBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="FILES"
                                           FontFamily="{StaticResource FontDisplay}"
                                           FontWeight="SemiBold" FontSize="11" LetterSpacing="2"
                                           Foreground="{StaticResource ElectricBlueBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Name="SearchBox"
                                         Watermark="Search..."
                                         Text="{Binding SearchQuery, Mode=TwoWay}"
                                         Width="180"
                                         Margin="8,0,4,0"
                                         KeyDown="OnSearchKeyDown"/>
                                <Button Grid.Column="2" Content="×"
                                        Click="OnClearSearchClick"
                                        IsVisible="{Binding HasActiveSearch}"
                                        ToolTip.Tip="Clear search"
                                        Width="28" Margin="0,0,4,0" Padding="0"/>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding ResultCountDisplay}"
                                           Classes="mono"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                <Button Grid.Column="4" Content="+ Folder" Click="OnNewFolderClick" Width="80" Margin="0,0,4,0"/>
                                <Button Grid.Column="5" Content="Rename" Click="OnRenameClick" Width="70" Margin="0,0,4,0"/>
                                <Button Grid.Column="6" Content="Delete" Click="OnDeleteClick" Width="64" Margin="0,0,4,0" Classes="danger"/>
                                <ToggleButton Grid.Column="7"
                                              IsChecked="{Binding ViewMode, Converter={x:Static conv:FileViewModeConverters.ToThumbnails}, Mode=TwoWay}"
                                              ToolTip.Tip="Toggle thumbnails view"
                                              Margin="0,0,4,0"
                                              Padding="8,4">
                                    <Panel>
                                        <TextBlock Text="☰" FontSize="14"/>
                                        <TextBlock Text="▦" FontSize="14" IsVisible="{Binding $parent[ToggleButton].IsChecked}"/>
                                    </Panel>
                                </ToggleButton>
                                <Button Grid.Column="8" Content="Import..." Click="OnImportClick" Width="80"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel DockPanel.Dock="Bottom" Margin="6,2"
                                IsVisible="{Binding IsImporting}">
                        <TextBlock Text="{Binding ImportingStatus}" Margin="0,0,0,4"
                                   Foreground="{StaticResource AmberBrush}"/>
                        <ProgressBar IsIndeterminate="True" Height="3"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom"
                               Text="{Binding StatusMessage}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               IsVisible="{Binding HasStatus}" Padding="8,6"/>

                    <!-- List view -->
                    <ListBox ItemsSource="{Binding FilteredFiles}"
                             SelectedItem="{Binding SelectedFile}"
                             DoubleTapped="OnFileDoubleClick"
                             IsVisible="{Binding ViewMode, Converter={x:Static conv:FileViewModeConverters.IsList}}"
                             Background="Transparent" BorderThickness="0" Padding="6">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="40,*,100" Margin="2">
                                    <Path Grid.Column="0" Width="22" Height="22" Stretch="Uniform"
                                          Data="{Binding Type, Converter={x:Static conv:FileTypeConverters.ToIcon}}"
                                          Fill="{StaticResource ElectricBlueBrush}"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                               VerticalAlignment="Center" Margin="6,0"
                                               Classes="mono"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}"
                                               VerticalAlignment="Center"
                                               Classes="mono dim"
                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Thumbnail view -->
                    <ListBox ItemsSource="{Binding FilteredFiles}"
                             SelectedItem="{Binding SelectedFile}"
                             DoubleTapped="OnFileDoubleClick"
                             IsVisible="{Binding ViewMode, Converter={x:Static conv:FileViewModeConverters.IsThumbnails}}"
                             Background="Transparent" BorderThickness="0" Padding="6">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Width" Value="110"/>
                                <Setter Property="Height" Value="124"/>
                                <Setter Property="Padding" Value="4"/>
                                <Setter Property="Margin" Value="2"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="64" Height="64"
                                            BorderBrush="{StaticResource ElectricBlueBrush}" BorderThickness="1"
                                            Background="{StaticResource VoidBrush}"
                                            ClipToBounds="True">
                                        <Panel>
                                            <Image Source="{Binding, Converter={x:Static conv:FileTypeConverters.ToThumbnailSource}}" Stretch="Uniform"
                                                   IsVisible="{Binding IsImage}"/>
                                            <Path Width="40" Height="40" Stretch="Uniform"
                                                  Data="{Binding Type, Converter={x:Static conv:FileTypeConverters.ToIcon}}"
                                                  Fill="{StaticResource ElectricBlueBrush}"
                                                  IsVisible="{Binding !IsImage}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Panel>
                                    </Border>
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                               MaxWidth="100" TextAlignment="Center"
                                               Classes="mono"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"
                                               ToolTip.Tip="{Binding FullPath}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </DockPanel>
            </Border>

            <!-- Drag overlay -->
            <Border x:Name="DropOverlay"
                    IsVisible="False"
                    Background="{StaticResource DropHighlightBrush}"
                    BorderBrush="{StaticResource ElectricBlueBrush}"
                    BorderThickness="2"
                    IsHitTestVisible="False">
                <TextBlock Text="› DROP FILES TO IMPORT"
                           FontFamily="{StaticResource FontDisplay}"
                           FontWeight="SemiBold" FontSize="16" LetterSpacing="1"
                           Foreground="{StaticResource ElectricBlueBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Panel>

        <!-- =========== RIGHT-RIGHT: preview pane =========== -->
        <views:ContentBrowserPreviewView Grid.Column="2"
                                         DataContext="{Binding PreviewViewModel}"/>
    </Grid>
</UserControl>
