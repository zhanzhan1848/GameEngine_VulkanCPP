<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PrimalEditor_Avalonia.App"
             xmlns:local="using:PrimalEditor_Avalonia"
             xmlns:dockTheme="using:Dock.Avalonia.Themes.Fluent"
             xmlns:dock="using:Dock.Avalonia.Controls"
             xmlns:ctrl="using:PrimalEditor_Avalonia.Themes.Controls"
             xmlns:th="using:Avalonia.Styling"
             RequestedThemeVariant="{x:Static th:ThemeVariant.Dark}">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <!-- Global token resources (colors/brushes/fonts/shadow presets).
         App boots with the DEFAULT theme (Warcraft, 见 EditorThemeRegistry);
         ThemeManager.Initialize() swaps in the persisted theme and the View
         menu can switch at runtime (see Themes/ThemeManager.cs).
         注意: 这两个 Include 必须与 DefaultThemeId 保持一致,否则启动时
         会闪切一次主题。 -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PrimalEditor_Avalonia/Themes/Warcraft/WarcraftTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <dockTheme:DockFluentTheme />
        <!-- 覆盖 Dock 的 DocumentContentControl 模板（同步呈现文档内容），
             必须排在 DockFluentTheme 之后。原因见该文件内注释。 -->
        <StyleInclude Source="avares://PrimalEditor_Avalonia/Themes/Controls/DocumentContentControlOverride.axaml" />
        <StyleInclude Source="avares://NodifyM.Avalonia/Styles/ControlStyles.axaml" />
        <StyleInclude Source="avares://PrimalEditor_Avalonia/Themes/Warcraft/WarcraftTheme.Styles.axaml" />
        <StyleInclude Source="avares://PrimalEditor_Avalonia/Themes/Controls/CyberCorner.axaml" />
    </Application.Styles>
</Application>
