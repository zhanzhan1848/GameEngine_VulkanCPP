<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PrimalEditor_Avalonia.App"
             xmlns:local="using:PrimalEditor_Avalonia"
             xmlns:dockTheme="using:Dock.Avalonia.Themes.Fluent"
             xmlns:ctrl="using:PrimalEditor_Avalonia.Themes.Controls"
             xmlns:th="using:Avalonia.Styling"
             RequestedThemeVariant="{x:Static th:ThemeVariant.Dark}">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <!-- Global token resources (colors/brushes/fonts/shadow presets).
         App boots with the default theme; ThemeManager.Initialize()
         swaps in the persisted theme and the View menu can switch
         at runtime (see Themes/ThemeManager.cs). -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PrimalEditor_Avalonia/Themes/Cyberpunk/CyberpunkTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <dockTheme:DockFluentTheme />
        <StyleInclude Source="avares://NodifyM.Avalonia/Styles/ControlStyles.axaml" />
        <StyleInclude Source="avares://PrimalEditor_Avalonia/Themes/Cyberpunk/CyberpunkTheme.Styles.axaml" />
        <StyleInclude Source="avares://PrimalEditor_Avalonia/Themes/Controls/CyberCorner.axaml" />
    </Application.Styles>
</Application>
