<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:PrimalEditor_Avalonia.Themes.Controls">

  <!-- =========================================================== -->
  <!-- "Iron & Gold of Azeroth" — Warcraft skin, palette adapted    -->
  <!-- from warcraftcn-ui (MIT). Selector set mirrors               -->
  <!-- CyberpunkTheme.Styles.axaml 1:1 so both skins style the      -->
  <!-- same UI surface; only the look differs. Transitions stay in  -->
  <!-- the 120-220ms band.                                          -->
  <!-- =========================================================== -->

  <!-- =========================================================== -->
  <!-- GLOBAL TEXT — parchment on iron                              -->
  <!-- =========================================================== -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="LetterSpacing" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource ElectricBlueBrush}"/>
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{StaticResource CoralBrush}"/>
  </Style>

  <!-- =========================================================== -->
  <!-- WINDOW                                                       -->
  <!-- =========================================================== -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource VoidBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
  </Style>

  <!-- =========================================================== -->
  <!-- BUTTON — forged metal plate (9-slice texture, warcraftcn     -->
  <!-- button-bg, hue-shifted to brass). States swap the frame      -->
  <!-- source; text recolors come from the setters below.           -->
  <!-- =========================================================== -->
  <Style Selector="Button">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="LetterSpacing" Value="0.4"/>
    <Setter Property="Padding" Value="14,6"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <!-- FluentTheme 的默认焦点框是亮色实心块,与金属按钮不搭;焦点视觉
         由下面 :focus-visible 的九宫格贴图承担 -->
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ctrl:NineSliceImage Name="PART_Frame"
                               Source="avares://PrimalEditor_Avalonia/Assets/Textures/Warcraft/button-normal.png"
                               Slice="5" Scale="4.4"/>
          <ContentPresenter Name="PART_WcContent"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
  </Style>
  <Style Selector="Button:pointerover /template/ ctrl|NineSliceImage#PART_Frame">
    <Setter Property="Source" Value="avares://PrimalEditor_Avalonia/Assets/Textures/Warcraft/button-hover.png"/>
  </Style>
  <Style Selector="Button:pressed /template/ ctrl|NineSliceImage#PART_Frame">
    <Setter Property="Source" Value="avares://PrimalEditor_Avalonia/Assets/Textures/Warcraft/button-pressed.png"/>
  </Style>
  <Style Selector="Button:focus-visible /template/ ctrl|NineSliceImage#PART_Frame">
    <Setter Property="Source" Value="avares://PrimalEditor_Avalonia/Assets/Textures/Warcraft/button-focus.png"/>
    <Setter Property="Slice" Value="8"/>
    <Setter Property="Scale" Value="4.4"/>
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.5"/>
  </Style>
  <!-- Buttons with Classes="accent" wear the ornate notched frame;
       FluentTheme's :accent setters can't reach them, the art IS the look. -->
  <Style Selector="Button.accent /template/ ctrl|NineSliceImage#PART_Frame">
    <Setter Property="Source" Value="avares://PrimalEditor_Avalonia/Assets/Textures/Warcraft/button-accent.png"/>
    <Setter Property="Slice" Value="14"/>
    <Setter Property="Scale" Value="8.5"/>
  </Style>
  <Style Selector="Button.accent:focus-visible /template/ ctrl|NineSliceImage#PART_Frame">
    <Setter Property="Source" Value="avares://PrimalEditor_Avalonia/Assets/Textures/Warcraft/button-accent-focus.png"/>
    <Setter Property="Slice" Value="10"/>
    <Setter Property="Scale" Value="8.5"/>
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ctrl|NineSliceImage#PART_Frame">
    <Setter Property="Source" Value="avares://PrimalEditor_Avalonia/Assets/Textures/Warcraft/button-accent-hover.png"/>
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{StaticResource CoralBrush}"/>
  </Style>

  <!-- =========================================================== -->
  <!-- TOGGLE BUTTON                                                -->
  <!-- =========================================================== -->
  <Style Selector="ToggleButton">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="14,6"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18"/>
        <BrushTransition Property="Foreground" Duration="0:0:0.18"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ToggleButton:pointerover">
    <Setter Property="Background" Value="{StaticResource PanelHoverBrush}"/>
  </Style>
  <Style Selector="ToggleButton:checked">
    <Setter Property="Background" Value="{StaticResource BlueTint25}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ElectricBlueBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource ElectricBlueBrush}"/>
  </Style>

  <!-- =========================================================== -->
  <!-- TEXTBOX — sunken dark well, gold focus ring                  -->
  <!-- =========================================================== -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource SlateBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="CaretBrush" Value="{StaticResource ElectricBlueBrush}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource BlueTint25}"/>
    <Setter Property="SelectionForegroundBrush" Value="{StaticResource AmberBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18"/>
        <BrushTransition Property="Foreground" Duration="0:0:0.18"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{StaticResource ElectricBlueBrush}"/>
  </Style>
  <Style Selector="TextBox:pointerover">
    <Setter Property="BorderBrush" Value="{StaticResource ElectricBlueDeepBrush}"/>
  </Style>
  <Style Selector="TextBox:disabled">
    <Setter Property="Opacity" Value="0.4"/>
  </Style>

  <!-- =========================================================== -->
  <!-- COMBOBOX                                                     -->
  <!-- =========================================================== -->
  <Style Selector="ComboBox">
    <Setter Property="Background"     Value="{StaticResource SlateBrush}"/>
    <Setter Property="Foreground"     Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="BorderBrush"    Value="{StaticResource HairlineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"   Value="2"/>
    <Setter Property="FontFamily"     Value="{StaticResource FontUI}"/>
    <Setter Property="FontSize"       Value="12"/>
    <Setter Property="MinHeight"      Value="26"/>
    <Setter Property="Padding"        Value="8,2"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18"/>
        <BrushTransition Property="Foreground" Duration="0:0:0.18"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ComboBox:focus">
    <Setter Property="BorderBrush" Value="{StaticResource ElectricBlueBrush}"/>
  </Style>
  <Style Selector="ComboBox:pointerover">
    <Setter Property="BorderBrush" Value="{StaticResource ElectricBlueDeepBrush}"/>
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Background" Value="{StaticResource SlateBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>
  <Style Selector="ComboBoxItem:pointerover">
    <Setter Property="Background" Value="{StaticResource BlueTint12}"/>
  </Style>
  <Style Selector="ComboBoxItem:selected">
    <Setter Property="Background" Value="{StaticResource BlueTint25}"/>
    <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
  </Style>

  <!-- =========================================================== -->
  <!-- CHECKBOX                                                     -->
  <!-- =========================================================== -->
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>

  <!-- =========================================================== -->
  <!-- LISTBOX — transparent wells so the wood panel grain of the   -->
  <!-- surrounding TextureFrame shows through                       -->
  <!-- =========================================================== -->
  <Style Selector="ListBox">
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="Foreground"      Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="BorderBrush"     Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius"    Value="2"/>
    <Setter Property="Padding"         Value="2"/>
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
    <Setter Property="FontSize"   Value="12"/>
    <Setter Property="Padding"    Value="10,5"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="2"/>
  </Style>
  <Style Selector="ListBoxItem:pointerover">
    <Setter Property="Background" Value="{StaticResource BlueTint12}"/>
  </Style>
  <Style Selector="ListBoxItem:selected">
    <Setter Property="Background" Value="{StaticResource BlueTint25}"/>
    <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
  </Style>

  <!-- =========================================================== -->
  <!-- TREEVIEW                                                     -->
  <!-- =========================================================== -->
  <Style Selector="TreeView">
    <Setter Property="Background"  Value="Transparent"/>
    <Setter Property="Foreground"  Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Padding"     Value="2"/>
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
    <Setter Property="FontSize"   Value="11"/>
    <Setter Property="Padding"    Value="2,1"/>
  </Style>
  <Style Selector="TreeViewItem:pointerover">
    <Setter Property="Background" Value="{StaticResource BlueTint12}"/>
  </Style>
  <Style Selector="TreeViewItem:selected">
    <Setter Property="Background" Value="{StaticResource BlueTint25}"/>
    <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
  </Style>

  <!-- =========================================================== -->
  <!-- MENU / MENUITEM                                              -->
  <!-- =========================================================== -->
  <Style Selector="Menu">
    <Setter Property="Background"  Value="{StaticResource SlateBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize"   Value="12"/>
    <Setter Property="Padding"    Value="12,6"/>
  </Style>
  <Style Selector="MenuItem:pointerover">
    <Setter Property="Background" Value="{StaticResource BlueTint12}"/>
    <Setter Property="Foreground" Value="{StaticResource ElectricBlueBrush}"/>
  </Style>

  <!-- =========================================================== -->
  <!-- GRIDSPLITTER — thin bronze line                              -->
  <!-- =========================================================== -->
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{StaticResource HairlineBrush}"/>
  </Style>
  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="{StaticResource ElectricBlueBrush}"/>
  </Style>

  <!-- =========================================================== -->
  <!-- PROGRESSBAR — molten gold fill                               -->
  <!-- =========================================================== -->
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource ElectricBlueBrush}"/>
    <Setter Property="Background" Value="{StaticResource SlateBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <!-- =========================================================== -->
  <!-- SCROLLBAR                                                    -->
  <!-- =========================================================== -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource HairlineBrush}"/>
  </Style>
  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="10"/>
  </Style>
  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="10"/>
  </Style>

  <!-- =========================================================== -->
  <!-- SEPARATOR                                                    -->
  <!-- =========================================================== -->
  <Style Selector="Separator">
    <Setter Property="Background" Value="{StaticResource HairlineBrush}"/>
  </Style>

  <!-- =========================================================== -->
  <!-- BORDER helper classes — squarer WC frames with bronze rims   -->
  <!-- .glass     — translucent gold-tinted surface                 -->
  <!-- .panel     — iron panel with bronze hairline                 -->
  <!-- .floating  — lifted iron card                                -->
  <!-- =========================================================== -->
  <Style Selector="Border.glass">
    <Setter Property="Background" Value="{StaticResource BlueTint12}"/>
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.floating">
    <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
      </Transitions>
    </Setter>
  </Style>

  <!-- =========================================================== -->
  <!-- EXPANDER — iron header, gold hover                           -->
  <!-- =========================================================== -->
  <Style Selector="Expander">
    <Setter Property="Background" Value="{StaticResource SlateBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="Padding" Value="10,8,10,8"/>
    <Setter Property="Margin" Value="0,4,0,0"/>
    <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18"/>
        <BrushTransition Property="Foreground" Duration="0:0:0.18"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover">
    <Setter Property="Background" Value="{StaticResource PanelHoverBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource ElectricBlueBrush}"/>
  </Style>
  <Style Selector="Expander /template/ Border#ExpanderContent">
    <Setter Property="Background" Value="{StaticResource SlateBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
    <Setter Property="BorderThickness" Value="1,0,1,1"/>
    <Setter Property="CornerRadius" Value="0,0,2,2"/>
  </Style>

  <!-- =========================================================== -->
  <!-- TEXTURE FRAMES — 9-slice art (warcraftcn assets, regraded).  -->
  <!-- Views keep the theme-neutral Classes="floating" hook; the    -->
  <!-- tex-* class picks the artwork. Under themes that ship no     -->
  <!-- art (Cyberpunk) the elements render as plain Borders.        -->
  <!-- =========================================================== -->
  <Style Selector="ctrl|TextureFrame.tex-strip">
    <Setter Property="Source" Value="avares://PrimalEditor_Avalonia/Assets/Textures/Warcraft/frame-strip.png"/>
    <Setter Property="Slice" Value="7.5"/>
    <Setter Property="Scale" Value="5"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="ctrl|TextureFrame.tex-chip">
    <Setter Property="Source" Value="avares://PrimalEditor_Avalonia/Assets/Textures/Warcraft/frame-strip.png"/>
    <Setter Property="Slice" Value="4.6"/>
    <Setter Property="Scale" Value="8"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="ctrl|TextureFrame.tex-panel">
    <Setter Property="Source" Value="avares://PrimalEditor_Avalonia/Assets/Textures/Warcraft/frame-panel.png"/>
    <Setter Property="Slice" Value="13"/>
    <Setter Property="Scale" Value="2.5"/>
    <!-- Keep content inside the art's frame: padding >= frame thickness. -->
    <Setter Property="Padding" Value="15,15,15,15"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

</Styles>
