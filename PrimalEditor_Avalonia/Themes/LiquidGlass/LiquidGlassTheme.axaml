<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- COLOR TOKENS
       "Liquid Glass" — iOS 26 液态玻璃的编辑器演绎:
       极光粉紫蓝的浅色底板上的半透明白玻璃, 高光渐变描边模拟镜面折射,
       强调色走年轻化路线(鲜紫/热粉/薄荷/橙)。
       Key schema is identical to CyberpunkTheme (every key here must
       exist there too) so views can stay theme-agnostic. -->

  <!-- VoidBrush 在本皮肤里是渐变(而非纯色): 它同时是 Window/视图的
       底板与输入控件内芯,柔和平缓的粉紫蓝过渡让整个前台读作"玻璃"。
       注意: 不要把标准 key 换成不可动画的类型以外的东西;
       PanelBrush/PrimaryTextBrush 必须保持 SolidColorBrush
       (ThemeManagerHeadlessTests 会取 .Color)。 -->
  <LinearGradientBrush x:Key="VoidBrush" StartPoint="0%,0%" EndPoint="85%,100%">
    <GradientStop Color="#BFE5FF" Offset="0"/>
    <GradientStop Color="#C3B8FF" Offset="0.22"/>
    <GradientStop Color="#EBB8FF" Offset="0.45"/>
    <GradientStop Color="#FFAFD9" Offset="0.66"/>
    <GradientStop Color="#FFC4A3" Offset="0.84"/>
    <GradientStop Color="#FFE3A1" Offset="1"/>
  </LinearGradientBrush>
  <Color x:Key="VoidColor">#E9EEF9</Color>
  <Color x:Key="SlateColor">#CCF2F5FE</Color>
  <Color x:Key="PanelColor">#A6FFFFFF</Color>
  <Color x:Key="PanelHoverColor">#CCFFFFFF</Color>
  <Color x:Key="ElectricBlueColor">#7C5CFF</Color>
  <Color x:Key="ElectricBlueDeepColor">#5B3DE8</Color>
  <Color x:Key="CoralColor">#FF4D9D</Color>
  <Color x:Key="CoralDeepColor">#E63A87</Color>
  <Color x:Key="MintColor">#22D3AE</Color>
  <Color x:Key="AmberColor">#FFAA2E</Color>
  <Color x:Key="PrimaryTextColor">#212A4E</Color>
  <Color x:Key="SecondaryTextColor">#4F5A85</Color>
  <Color x:Key="MutedTextColor">#8892B6</Color>
  <Color x:Key="HairlineColor">#CBD5EE</Color>

  <!-- BRUSHES -->
  <SolidColorBrush x:Key="SlateBrush"          Color="{StaticResource SlateColor}"/>
  <SolidColorBrush x:Key="PanelBrush"          Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="PanelHoverBrush"     Color="{StaticResource PanelHoverColor}"/>
  <SolidColorBrush x:Key="ElectricBlueBrush"   Color="{StaticResource ElectricBlueColor}"/>
  <SolidColorBrush x:Key="ElectricBlueDeepBrush" Color="{StaticResource ElectricBlueDeepColor}"/>
  <SolidColorBrush x:Key="CoralBrush"          Color="{StaticResource CoralColor}"/>
  <SolidColorBrush x:Key="CoralDeepBrush"      Color="{StaticResource CoralDeepColor}"/>
  <SolidColorBrush x:Key="MintBrush"           Color="{StaticResource MintColor}"/>
  <SolidColorBrush x:Key="AmberBrush"          Color="{StaticResource AmberColor}"/>
  <SolidColorBrush x:Key="PrimaryTextBrush"    Color="{StaticResource PrimaryTextColor}"/>
  <SolidColorBrush x:Key="SecondaryTextBrush"  Color="{StaticResource SecondaryTextColor}"/>
  <SolidColorBrush x:Key="MutedTextBrush"      Color="{StaticResource MutedTextColor}"/>
  <SolidColorBrush x:Key="HairlineBrush"       Color="{StaticResource HairlineColor}"/>

  <!-- GLASS MATERIAL — 液态玻璃的三个物质层: 半透明填充 / 高光边缘 /
       强调渐变。供 Styles 与视图的 glass 面板直接引用。 -->
  <LinearGradientBrush x:Key="GlassFillBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Color="#D9FFFFFF" Offset="0"/>
    <GradientStop Color="#B3FFFFFF" Offset="0.5"/>
    <GradientStop Color="#8FFFFFFF" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassFillHoverBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Color="#EBFFFFFF" Offset="0"/>
    <GradientStop Color="#C2FFFFFF" Offset="1"/>
  </LinearGradientBrush>
  <!-- 镜面高光: 上缘亮白向下衰减,叠在 1px 描边上读作玻璃折边 -->
  <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Color="#FFFFFFFF" Offset="0"/>
    <GradientStop Color="#99FFFFFF" Offset="0.4"/>
    <GradientStop Color="#38FFFFFF" Offset="1"/>
  </LinearGradientBrush>
  <!-- 输入控件内芯: 磨砂半透明白,压在玻璃面板上读作"下沉的磨砂层" -->
  <SolidColorBrush x:Key="GlassInputBrush" Color="#B3FFFFFF"/>
  <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#7C5CFF" Offset="0"/>
    <GradientStop Color="#FF4D9D" Offset="1"/>
  </LinearGradientBrush>

  <!-- Translucent overlays (selection/hover tints in violet + hot pink) -->
  <SolidColorBrush x:Key="BlueTint12"          Color="#1F7C5CFF"/>
  <SolidColorBrush x:Key="BlueTint25"          Color="#407C5CFF"/>
  <SolidColorBrush x:Key="CoralTint12"         Color="#1FFF4D9D"/>

  <!-- FluentTheme system accent, retinted per skin. FluentTheme's nested
       control-theme styles (Buttons with Classes="accent", check ticks,
       selection handles...) consume these directly and beat app-level
       style setters, so retinting the accent look has to go through them. -->
  <Color x:Key="SystemAccentColor">#7C5CFF</Color>
  <Color x:Key="SystemAccentColorDark">#5B3DE8</Color>
  <Color x:Key="SystemAccentColorLight">#BBA9FF</Color>

  <!-- SHADOW PRESETS — 玻璃的落地感: 紫粉调的柔和彩色投影 -->
  <sys:String x:Key="SoftShadow">0 2 12 0 #247C5CFF,0 10 30 0 #16FF6EC9</sys:String>
  <sys:String x:Key="LiftShadow">0 1 3 0 #2E807CFF,0 6 16 0 #14FF6EC9</sys:String>
  <sys:String x:Key="SoftBlueGlow">0 0 12 2 #667C5CFF</sys:String>
  <sys:String x:Key="SoftCoralGlow">0 0 12 2 #66FF4D9D</sys:String>

  <!-- NodifyM.Avalonia 节点画布(材质编辑器)换肤:键名来自
       NodifyM ControlStyles, 令牌字典里覆写即可全局生效。
       浅色玻璃画布: 玻璃节点 + 紫色连线。 -->
  <SolidColorBrush x:Key="BackgroundBrush"              Color="#F1F4FD"/>
  <SolidColorBrush x:Key="NodeBrush"                    Color="#CCFFFFFF"/>
  <SolidColorBrush x:Key="NodeBorderBrush"              Color="#D8E1F5"/>
  <SolidColorBrush x:Key="HeaderBrush"                  Color="#7C5CFF"/>
  <SolidColorBrush x:Key="HeaderForegroundBrush"        Color="#FFFFFF"/>
  <SolidColorBrush x:Key="ContentBrush"                 Color="#F5F8FE"/>
  <SolidColorBrush x:Key="FooterBrush"                  Color="#EDF2FC"/>
  <SolidColorBrush x:Key="StrokeBrush"                  Color="#8B6CFF"/>
  <SolidColorBrush x:Key="TextBrush"                    Color="#212A4E"/>
  <SolidColorBrush x:Key="SelectedBrush"                Color="#337C5CFF"/>
  <SolidColorBrush x:Key="HighlightBrush"               Color="#7C5CFF"/>
  <SolidColorBrush x:Key="SelectionRectangleBackgroundBrush" Color="#1F7C5CFF"/>
  <SolidColorBrush x:Key="SelectionRectangleColor"      Color="#7C5CFF"/>
  <SolidColorBrush x:Key="SelectionRectangleStrokeBrush" Color="#7C5CFF"/>
  <SolidColorBrush x:Key="AlignmentLineBrush"           Color="#667C5CFF"/>
  <SolidColorBrush x:Key="MapBorderBrush"               Color="#CBD5EE"/>
  <SolidColorBrush x:Key="ViewportBrush"                Color="#337C5CFF"/>
  <SolidColorBrush x:Key="ViewportBorderBrush"          Color="#7C5CFF"/>
  <Color x:Key="GridLinesColor">#DEE6F6</Color>

  <!-- 节点标题条头像徽章开关(非 Warcraft 主题关闭) -->
  <sys:Boolean x:Key="NodeAvatarVisible">False</sys:Boolean>

  <!-- FONT FAMILIES — 液态玻璃走 iOS 式的中性无衬线(系统栈,含中文回退),
       等宽保留 JetBrains Mono(OFL)。 -->
  <FontFamily x:Key="FontDisplay">Helvetica Neue, Segoe UI, PingFang SC, Hiragino Sans GB, Microsoft YaHei, Arial</FontFamily>
  <FontFamily x:Key="FontUI">Helvetica Neue, Segoe UI, PingFang SC, Hiragino Sans GB, Microsoft YaHei, Arial</FontFamily>
  <FontFamily x:Key="FontMono">avares://PrimalEditor_Avalonia/Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>

</ResourceDictionary>
