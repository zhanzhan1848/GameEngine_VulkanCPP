<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:PrimalEditor_Avalonia.Themes.Controls">

  <!-- =========================================================== -->
  <!-- LIQUID GLASS — 控件样式                                       -->
  <!-- 物质语言: 半透明白玻璃填充(GlassFillBrush) + 上缘高光描边      -->
  <!-- (GlassEdgeBrush) + 紫粉彩色投影 + 大圆角。选择器覆盖面与       -->
  <!-- CyberpunkTheme.Styles.axaml 完全一致(视图契约)。              -->
  <!-- Transitions 必须内联在各自样式里(XAML 无法解析脱离 Control    -->
  <!-- 作用域的 Transitions 资源),时长保持在 120–220ms。             -->
  <!-- =========================================================== -->

  <!-- =========================================================== -->
  <!-- GLOBAL TEXT                                                  -->
  <!-- =========================================================== -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="LetterSpacing" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource ElectricBlueBrush}"/>
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{StaticResource CoralBrush}"/>
  </Style>

  <!-- =========================================================== -->
  <!-- WINDOW — 极光渐变底板,玻璃面板在其上成立                      -->
  <!-- =========================================================== -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource VoidBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
  </Style>

  <!-- =========================================================== -->
  <!-- BUTTON — 玻璃胶囊:半透明填充 + 高光描边 + 悬停提亮            -->
  <!-- =========================================================== -->
  <Style Selector="Button">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="Background" Value="{StaticResource GlassFillBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource GlassEdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="16,7"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18"/>
        <BrushTransition Property="Foreground" Duration="0:0:0.18"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{StaticResource GlassFillHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ElectricBlueDeepBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource ElectricBlueDeepBrush}"/>
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="Background" Value="{StaticResource BlueTint25}"/>
  </Style>
  <!-- Buttons with Classes="accent" are tinted by the SystemAccentColor
       tokens in LiquidGlassTheme.axaml: FluentTheme's nested control-theme
       styles for :accent win over app-level style setters, so Background
       setters here would never take effect. -->
  <Style Selector="Button.danger">
    <Setter Property="BorderBrush" Value="{StaticResource CoralBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource CoralDeepBrush}"/>
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.5"/>
  </Style>

  <!-- =========================================================== -->
  <!-- TOGGLE BUTTON                                                -->
  <!-- =========================================================== -->
  <Style Selector="ToggleButton">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="Background" Value="{StaticResource GlassFillBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource GlassEdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="16,7"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18"/>
        <BrushTransition Property="Foreground" Duration="0:0:0.18"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ToggleButton:pointerover">
    <Setter Property="Background" Value="{StaticResource GlassFillHoverBrush}"/>
  </Style>
  <Style Selector="ToggleButton:checked">
    <Setter Property="Background" Value="{StaticResource BlueTint25}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ElectricBlueBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource ElectricBlueDeepBrush}"/>
  </Style>

  <!-- =========================================================== -->
  <!-- TEXTBOX — 内芯沿用 VoidBrush 渐变,聚焦时紫色描边              -->
  <!-- =========================================================== -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource GlassInputBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="CaretBrush" Value="{StaticResource ElectricBlueBrush}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource BlueTint25}"/>
    <Setter Property="SelectionForegroundBrush" Value="{StaticResource ElectricBlueDeepBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource GlassEdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18"/>
        <BrushTransition Property="Foreground" Duration="0:0:0.18"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{StaticResource ElectricBlueBrush}"/>
  </Style>
  <Style Selector="TextBox:pointerover">
    <Setter Property="BorderBrush" Value="{StaticResource ElectricBlueDeepBrush}"/>
  </Style>
  <Style Selector="TextBox:disabled">
    <Setter Property="Opacity" Value="0.4"/>
  </Style>

  <!-- =========================================================== -->
  <!-- COMBOBOX                                                     -->
  <!-- =========================================================== -->
  <Style Selector="ComboBox">
    <Setter Property="Background"     Value="{StaticResource GlassInputBrush}"/>
    <Setter Property="Foreground"     Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="BorderBrush"    Value="{StaticResource GlassEdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"   Value="8"/>
    <Setter Property="FontFamily"     Value="{StaticResource FontUI}"/>
    <Setter Property="FontSize"       Value="12"/>
    <Setter Property="MinHeight"      Value="26"/>
    <Setter Property="Padding"        Value="8,2"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18"/>
        <BrushTransition Property="Foreground" Duration="0:0:0.18"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ComboBox:focus">
    <Setter Property="BorderBrush" Value="{StaticResource ElectricBlueBrush}"/>
  </Style>
  <Style Selector="ComboBox:pointerover">
    <Setter Property="BorderBrush" Value="{StaticResource ElectricBlueDeepBrush}"/>
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Background" Value="{StaticResource SlateBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>
  <Style Selector="ComboBoxItem:pointerover">
    <Setter Property="Background" Value="{StaticResource BlueTint12}"/>
  </Style>
  <Style Selector="ComboBoxItem:selected">
    <Setter Property="Background" Value="{StaticResource BlueTint25}"/>
    <Setter Property="Foreground" Value="{StaticResource ElectricBlueDeepBrush}"/>
  </Style>

  <!-- =========================================================== -->
  <!-- CHECKBOX — 勾选态由 SystemAccentColor 三件套着色(Light 变体)  -->
  <!-- =========================================================== -->
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>

  <!-- =========================================================== -->
  <!-- LISTBOX — 玻璃卡片容器                                       -->
  <!-- =========================================================== -->
  <Style Selector="ListBox">
    <Setter Property="Background"      Value="{StaticResource GlassFillBrush}"/>
    <Setter Property="Foreground"      Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="BorderBrush"     Value="{StaticResource GlassEdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"    Value="10"/>
    <Setter Property="Padding"         Value="2"/>
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
    <Setter Property="FontSize"   Value="12"/>
    <Setter Property="Padding"    Value="10,5"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
  </Style>
  <Style Selector="ListBoxItem:pointerover">
    <Setter Property="Background" Value="{StaticResource BlueTint12}"/>
  </Style>
  <Style Selector="ListBoxItem:selected">
    <Setter Property="Background" Value="{StaticResource BlueTint25}"/>
    <Setter Property="Foreground" Value="{StaticResource ElectricBlueDeepBrush}"/>
  </Style>

  <!-- =========================================================== -->
  <!-- TREEVIEW — 层级面板保持实底浅色,长列表更易读                  -->
  <!-- =========================================================== -->
  <Style Selector="TreeView">
    <Setter Property="Background"  Value="{StaticResource SlateBrush}"/>
    <Setter Property="Foreground"  Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Padding"     Value="2"/>
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
    <Setter Property="FontSize"   Value="11"/>
    <Setter Property="Padding"    Value="2,1"/>
  </Style>
  <Style Selector="TreeViewItem:pointerover">
    <Setter Property="Background" Value="{StaticResource BlueTint12}"/>
  </Style>
  <Style Selector="TreeViewItem:selected">
    <Setter Property="Background" Value="{StaticResource BlueTint25}"/>
    <Setter Property="Foreground" Value="{StaticResource ElectricBlueDeepBrush}"/>
  </Style>

  <!-- =========================================================== -->
  <!-- MENU / MENUITEM — 顶部玻璃条                                  -->
  <!-- =========================================================== -->
  <Style Selector="Menu">
    <Setter Property="Background"  Value="#B8FFFFFF"/>
    <Setter Property="Foreground"  Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize"   Value="12"/>
    <Setter Property="Padding"    Value="12,6"/>
  </Style>
  <Style Selector="MenuItem:pointerover">
    <Setter Property="Background" Value="{StaticResource BlueTint12}"/>
    <Setter Property="Foreground" Value="{StaticResource ElectricBlueDeepBrush}"/>
  </Style>

  <!-- =========================================================== -->
  <!-- GRIDSPLITTER — 细分隔线,悬停亮紫                              -->
  <!-- =========================================================== -->
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{StaticResource HairlineBrush}"/>
  </Style>
  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="{StaticResource ElectricBlueBrush}"/>
  </Style>

  <!-- =========================================================== -->
  <!-- PROGRESSBAR — 紫→粉渐变进度,圆角胶囊轨道                      -->
  <!-- =========================================================== -->
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource AccentGradientBrush}"/>
    <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="MinHeight" Value="6"/>
  </Style>

  <!-- =========================================================== -->
  <!-- SCROLLBAR — 细而透明                                         -->
  <!-- =========================================================== -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource HairlineBrush}"/>
  </Style>
  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="10"/>
  </Style>
  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="10"/>
  </Style>

  <!-- =========================================================== -->
  <!-- SEPARATOR                                                    -->
  <!-- =========================================================== -->
  <Style Selector="Separator">
    <Setter Property="Background" Value="{StaticResource HairlineBrush}"/>
  </Style>

  <!-- =========================================================== -->
  <!-- BORDER helper classes                                        -->
  <!-- .glass     — 玻璃面板:半透明填充 + 高光边缘                    -->
  <!-- .panel     — 标准半透明白面板 + 发丝线                         -->
  <!-- .floating  — 悬浮玻璃卡:玻璃 + 彩色软投影                     -->
  <!-- =========================================================== -->
  <Style Selector="Border.glass">
    <Setter Property="Background" Value="{StaticResource GlassFillBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource GlassEdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.floating">
    <Setter Property="Background" Value="{StaticResource GlassFillBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource GlassEdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="BoxShadow" Value="0 2 12 0 #247C5CFF,0 10 30 0 #16FF6EC9"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
      </Transitions>
    </Setter>
  </Style>
  <!-- Views may host chrome as TextureFrame (a Border that themes can
       paint with 9-slice art). This skin ships no frame art, so those
       elements fall back to the exact Border.floating look above. -->
  <Style Selector="ctrl|TextureFrame.floating">
    <Setter Property="Source" Value="{x:Null}"/>
    <Setter Property="Background" Value="{StaticResource GlassFillBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource GlassEdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="BoxShadow" Value="0 2 12 0 #247C5CFF,0 10 30 0 #16FF6EC9"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
      </Transitions>
    </Setter>
  </Style>

  <!-- =========================================================== -->
  <!-- EXPANDER — 玻璃折叠卡                                        -->
  <!-- =========================================================== -->
  <Style Selector="Expander">
    <Setter Property="Background" Value="{StaticResource GlassFillBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource GlassEdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="10,8,10,8"/>
    <Setter Property="Margin" Value="0,4,0,0"/>
    <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18"/>
        <BrushTransition Property="Foreground" Duration="0:0:0.18"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover">
    <Setter Property="Background" Value="{StaticResource BlueTint12}"/>
    <Setter Property="Foreground" Value="{StaticResource ElectricBlueDeepBrush}"/>
  </Style>
  <Style Selector="Expander /template/ Border#ExpanderContent">
    <Setter Property="Background" Value="{StaticResource SlateBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
    <Setter Property="BorderThickness" Value="1,0,1,1"/>
    <Setter Property="CornerRadius" Value="0,0,10,10"/>
  </Style>

</Styles>
