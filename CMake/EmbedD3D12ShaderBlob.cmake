# EmbedD3D12ShaderBlob.cmake — R13/T2：.cso 字节 → 嵌入式 C++ 头。
#
# 用法（script mode，由 Engine/CMakeLists.txt 的 custom command 调用）：
#   cmake -DVS_BLOB=<mipgen vs .cso> -DPS_BLOB=<mipgen ps .cso>
#         -DOUT=<生成头路径> -DSRC=<hlsl 源路径> -P EmbedD3D12ShaderBlob.cmake
#
# 生成内容（单头双数组）：
#   primal::graphics::rhi::d3d12 命名空间的 constexpr unsigned char 数组
#   kMipGenVsBytes/kMipGenPsBytes + 尺寸常量。blob 缺失（探针没找到
# dxc/fxc 时 custom command 传空路径过来）→ 生成零长数组，运行期
# GenerateMipmaps 保持 NOT-IMPLEMENTED Error 日志（显式降级，不静默）。
#
# 选 CMake script 而非 Python：与 build_engine_shader_blob.py（Metal 链）
# 不同，本步只是字节转写，无编译器调度；纯 CMake 零新增构建依赖。
if(NOT DEFINED OUT)
    message(FATAL_ERROR "EmbedD3D12ShaderBlob: -DOUT=<header path> required")
endif()

function(_embed_array VAR_NAME BLOB_PATH CONTENT OUTVAR)
    if(NOT BLOB_PATH OR NOT EXISTS "${BLOB_PATH}")
        # 零长数组非 ISO C++（MSVC 不保证接受）——哨兵占位 + size 常量由
        # 调用方写 0 表达"不可用"（消费方只看 size 常量，不读数组）。
        set(${OUTVAR} "constexpr unsigned char ${VAR_NAME}[] = {0};" PARENT_SCOPE)
        return()
    endif()
    file(READ "${BLOB_PATH}" _hex HEX)
    string(REGEX MATCHALL "[0-9a-f][0-9a-f]" _pairs "${_hex}")
    set(_body "")
    set(_sep "")
    foreach(_p IN LISTS _pairs)
        string(APPEND _body "${_sep}0x${_p}")
        set(_sep ",")
    endforeach()
    set(${OUTVAR} "constexpr unsigned char ${VAR_NAME}[] = {${_body}};" PARENT_SCOPE)
endfunction()

_embed_array(kMipGenVsBytes "${VS_BLOB}" _vs _vs_decl)
_embed_array(kMipGenPsBytes "${PS_BLOB}" _ps _ps_decl)

set(_vs_size 0)
if(VS_BLOB AND EXISTS "${VS_BLOB}")
    file(SIZE "${VS_BLOB}" _vs_size)
endif()
set(_ps_size 0)
if(PS_BLOB AND EXISTS "${PS_BLOB}")
    file(SIZE "${PS_BLOB}" _ps_size)
endif()

file(WRITE "${OUT}" "// Generated by CMake/EmbedD3D12ShaderBlob.cmake — do not edit.\n\
// Source shader: ${SRC}\n\
// VS bytes: ${_vs_size}, PS bytes: ${_ps_size} (0 = HLSL compiler unavailable at build time;\n\
// arrays hold a sentinel byte and GenerateMipmaps degrades to its NOT-IMPLEMENTED\n\
// error log at runtime).\n\
#pragma once\n\
#include <cstddef>\n\
namespace primal::graphics::rhi::d3d12 {\n\
${_vs_decl}\n\
constexpr std::size_t kMipGenVsSize = ${_vs_size};\n\
${_ps_decl}\n\
constexpr std::size_t kMipGenPsSize = ${_ps_size};\n\
} // namespace primal::graphics::rhi::d3d12\n")
message(STATUS "EmbedD3D12ShaderBlob: wrote ${OUT} (vs=${_vs_size}B ps=${_ps_size}B)")
