#version 450 core

// Vulkan authority for IBLPrecomputer's IBL_SpecularPrefilter.spv, cs_main.
// Keep the existing 16-byte PrefilterParams and four descriptor bindings.
// Metal/Dawn retain their own sources; this module does not modify them.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform textureCube envMap;
layout(set = 0, binding = 1, rgba16f) writeonly uniform image2DArray outputCube;
layout(set = 0, binding = 2) uniform sampler smp;
layout(set = 0, binding = 3, std140) uniform PrefilterParams {
    uint faceSize;
    uint _pad0;
    float roughness;
    float srcResolution;
} params;

const float PI = 3.141592653589793;
const uint SAMPLE_COUNT = 1024u;

vec2 hammersley(uint i) {
    return vec2(float(i) / float(SAMPLE_COUNT),
                float(bitfieldReverse(i)) * 2.3283064365386963e-10);
}

// Returns TANGENT-SPACE H. It is rotated once by the orthonormal frame below.
vec3 importanceSampleGGXTangent(vec2 xi, float roughness) {
    float a = roughness * roughness;
    float phi = 2.0 * PI * xi.x;
    float cosTheta = sqrt(clamp((1.0 - xi.y) / (1.0 + (a * a - 1.0) * xi.y), 0.0, 1.0));
    float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));
    return vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
}

// Preserve the existing Vulkan prefilter's NDF/PDF convention in this fix.
float distributionGGX(vec3 n, vec3 h, float roughness) {
    float a2 = roughness * roughness;
    float NdotH = max(dot(n, h), 0.0);
    float d = NdotH * NdotH * (a2 - 1.0) + 1.0;
    return a2 / (PI * d * d + 0.0001);
}

void main() {
    uvec3 gid = gl_GlobalInvocationID;
    if (gid.x >= params.faceSize || gid.y >= params.faceSize || gid.z >= 6u) return;

    vec2 uv = (vec2(gid.xy) + 0.5) / float(params.faceSize);
    float u = 2.0 * uv.x - 1.0;
    float v = -(2.0 * uv.y - 1.0);
    vec3 N;
    switch (gid.z) {
        case 0u: N = vec3(1.0, v, -u); break;
        case 1u: N = vec3(-1.0, v, u); break;
        case 2u: N = vec3(u, 1.0, -v); break;
        case 3u: N = vec3(u, -1.0, v); break;
        case 4u: N = vec3(u, v, 1.0); break;
        default: N = vec3(-u, v, -1.0); break;
    }
    N = normalize(N);
    vec3 V = N;

    // Choose the axis which cannot be parallel to N. WGSL select's operands
    // were reversed in the old Vulkan module: four 1x1 face centres produced
    // cross(up,N)==0, then NaN directions and totalWeight==0. Repair the frame
    // itself instead of hiding the resulting NaNs with an output-zero clamp.
    vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangentX = normalize(cross(up, N));
    vec3 tangentY = cross(N, tangentX);
    float roughness = clamp(params.roughness, 0.0, 1.0);
    float totalWeight = 0.0;
    vec3 prefilteredColor = vec3(0.0);
    for (uint i = 0u; i < SAMPLE_COUNT; ++i) {
        vec3 h = importanceSampleGGXTangent(hammersley(i), roughness);
        vec3 H = normalize(tangentX * h.x + tangentY * h.y + N * h.z);
        vec3 L = normalize(2.0 * dot(V, H) * H - V);
        float NdotL = max(dot(N, L), 0.0);
        if (NdotL > 0.0) {
            float d = distributionGGX(N, H, roughness);
            float NdotH = max(dot(N, H), 0.0);
            float HdotV = max(dot(H, V), 0.0);
            float pdf = d * NdotH / (4.0 * HdotV + 0.0001);
            float saTexel = 4.0 * PI / (6.0 * params.srcResolution * params.srcResolution);
            float saSample = 1.0 / (float(SAMPLE_COUNT) * pdf + 0.0001);
            float mipLevel = roughness > 0.0 ? 0.5 * log2(saSample / saTexel) : 0.0;
            prefilteredColor += textureLod(samplerCube(envMap, smp), L, mipLevel).rgb * NdotL;
            totalWeight += NdotL;
        }
    }
    // Sample0 has xi=(0,0), H=N and L=N, hence NdotL=1 for every valid
    // normalized face direction. A valid frame guarantees nonzero weight.
    imageStore(outputCube, ivec3(gid), vec4(prefilteredColor / totalWeight, 1.0));
}
