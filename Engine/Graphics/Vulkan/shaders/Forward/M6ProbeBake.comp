#version 450 core

// M6 Probe Bake (D3D12 M6 F6-2/F6-3) — GI 资源机制表征（GICharacterization）
// 探针辐照 3D 网格烘焙 compute。非真实场景 GI：解析天空梯度 + 方向光泛光
// 的确定性合成函数（uint 哈希注入 ±2% texel 抖动以证明整数数学确定性），
// 只承诺 3D 纹理/UAV store 的资源机制等价，不冒充 Lumen/SurfaceCache 物理
// 输出（阶段文档 §3：逐位一致不是 GI 数值目标，结构性等价先于数值等价）。
//
// 资源形态镜像生产 SPGI RadianceCascade 更新链（ScreenProbeGIPass.cpp
// CreateRadianceCascade：out = storage image3D / prev = sampled 3D / params
// UBO），本 pass 只做 bake 段（writeonly image3D；typed UAV *load* 由
// M6ProbeAccum 的 readonly image3D 覆盖）。
//
// 网格：8x8x8 RGBA16F，world 盒由宿主 GIParams 定义（bake 侧只需 texel
// 指标 + 光参数——无场景依赖、无时变项；光参数由轨迹 keyframes 步进求值，
// 确定性纪律同 M4）。
//
// 绑定布局（set0 单 set；反射契约冻结）：
//   set 0 binding 0 = outGrid（rgba16f writeonly image3D = 类型化 UAV store）
//   set 0 binding 1 = BakeParams UBO（32B：dirAndIntensity + lightColor）
// dispatch：local 4x4x4 → 2x2x2（512 texel 全覆盖，单线程单 texel 写——
// 无原子、无跨线程依赖，双跑逐位确定）。

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0, rgba16f) writeonly uniform image3D outGrid;

layout(set = 0, binding = 1) uniform BakeParams {
    vec4 dirAndIntensity;   // xyz = 表面指向光源（同 LightData 约定），w = 强度
    vec4 lightColor;        // rgb = 光色，w = 未用
} params;

// 确定性 uint 哈希（PCG 单轮；纯整数运算，逐位确定）。
uint pcg1d(uint v) {
    v = v * 747796405u + 2891336453u;
    uint w = ((v >> ((v >> 28u) + 4u)) ^ v) * 277803737u;
    return (w >> 22u) ^ w;
}

void main() {
    ivec3 c = ivec3(gl_GlobalInvocationID);

    // 解析部分（IEEE 浮点，同 GPU/同二进制逐位确定）：
    //   sky   = 垂直梯度（texel y / 7）
    //   flood = 方向光泛光（从网格中心出发的 texel 方向与光照方向的
    //           lambert^2 泛光瓣；光 keyframe 切档 → bake 目标阶跃 →
    //           下游 EMA/重置语义可观测）
    vec3 dir = normalize(vec3(c) - vec3(3.5));
    float t = float(c.y) / 7.0;
    vec3 sky = mix(vec3(0.10, 0.13, 0.22), vec3(0.38, 0.48, 0.68), t);

    vec3 L = normalize(params.dirAndIntensity.xyz);
    float ndl = max(dot(dir, L), 0.0);
    vec3 flood = params.lightColor.rgb * params.dirAndIntensity.w
                 * (0.25 + 0.75 * ndl * ndl);

    // uint 数学确定性证明项：PCG(texel) 高 4 位 → [0,1] 抖动 ×0.02。
    uint h = pcg1d(uint(c.x) * 4096u + uint(c.y) * 64u + uint(c.z));
    float dither = float(h >> 28) * (0.02 / 15.0);

    vec3 val = sky + flood + vec3(dither);
    imageStore(outGrid, c, vec4(val, 1.0));
}
