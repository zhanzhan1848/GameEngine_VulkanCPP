// T4.6.5 part 40 — ShadowFilter compute port (Metal → GLSL).
//
// Half-res compute pass producing a visibility texture that DeferredLighting
// samples (1 tap) instead of running multi-tap PCF in the lighting pass. This
// mirrors EngineTest/shaders/ShadowFilter.metal:94-148 — same params struct,
// same cascade selection logic, same PCF kernel.
//
// Bindings (Vulkan, separate texture + sampler):
//   0: UBO Params (inv_view_proj, shadow_vp[2], light_dir, texel sizes, ...,
//      cascade_params[2])
//   1: texture2D shadowMap0 (R32_Float, manual compare)
//   2: texture2D shadowMap1 (R32_Float, manual compare)
//   3: image2D visibilityOut (R8_UNorm, write-only)
//   4: texture2D normalTex (GBuffer RT1 rgb = world normal * 0.5 + 0.5)
//   5: texture2D depthTex  (GBuffer depth, for world reconstruction)
//   6: sampler linearSampler (shared across all texture samples)
//
// Metal bindings: buffer(0)=params, texture(0..4)=depth/sm0/sm1/out/normal.
// Vulkan can't overlap UBO + SampledImage at the same binding (the previous
// ShadowMapModule layout had binding 0 declared twice — bug). Shadow maps use
// manual depth compare (no sampler2DShadow / comparison sampler needed); keeps
// descriptor setup simple and matches the existing linear sampler pattern.
//
// Workgroup: 8x8x1 (matches ShadowMapModule.cpp:95 threadGroupSize + 2D
// shared-memory IGN noise pattern).
//
// B17 (2026-09-11) thin-occluder leak fix — arch soffit "fake GI" warm light:
//   The old constant bias = 0.003 NDC translated to world depth as
//   0.003 * depthSpan (0.12-0.21 wu at the measured spans) — LARGER than the
//   light-space depth gap a thin arch ring (0.15-0.3 wu wall) produces, so
//   receivers under thin occluders compared as lit. Together with the raster
//   side's +0.001 clip.z occluder bias (ShadowDepth.wgsl) the total window
//   was ~0.004 NDC. Fix: per-cascade world-scale params (cascade_params:
//   x=texel world size, y=depth span) drive
//     * slope-scaled normal-offset along the world normal — puts the lookup
//       point strictly in front of its own surface by texel*(1+2*slope)/cos
//       (kills acne) and, for back-facing receivers (N·L<0: arch soffits),
//       pushes the receiver AWAY from the light (kills the thin-gap leak);
//     * world-unit depth bias (0.5 + 2*slope texels → NDC by the cascade
//       span) — replaces the constant 0.003 (≈5 texels of cascade 0!).
//   slope = tan(angle between N and L), clamped to 4. The quality-5 hard
//   sentinel shares this exact projection+bias so PRIMAL_SHADOW_DBG_HARD
//   measures the production compare.
//   Diagnostics (ShadowMapModule.cpp maps the envs): quality 3 = shadow-map
//   depth at the OFFSET lookup, 4 = raw receiver sc0.z (no offset), 5 = hard
//   compare (production bias+offset), 6 = PCSS blocker-hit density,
//   7 = NdotL normal-space sentinel (bright = facing the light; the sun band
//   must read bright and the arch soffit dark — proves normalTex is world
//   space and correctly oriented vs the reconstructed worldPos).

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Constants mirroring RHIShaderConstants.metal. Kept inline to match the
// single-file pattern of other Vulkan shaders in this directory.
const float TWO_PI = 6.28318530718;
const vec3 IGN_MAGIC = vec3(0.7548776662, 0.5698402909, 0.2659582193);

const vec2 POISSON_DISK_16[16] = vec2[16](
    vec2(-0.5274373, -0.7259060),
    vec2( 0.8218882, -0.1694079),
    vec2(-0.7959683,  0.5603005),
    vec2( 0.5697909,  0.7113788),
    vec2(-0.1583544, -0.8058264),
    vec2( 0.7826165,  0.5406202),
    vec2(-0.6480213, -0.1694079),
    vec2( 0.5500000, -0.4500000),
    vec2(-0.3000000,  0.7000000),
    vec2( 0.7000000, -0.7000000),
    vec2(-0.7000000,  0.3000000),
    vec2( 0.3000000,  0.8000000),
    vec2(-0.6000000, -0.5000000),
    vec2( 0.8500000,  0.4000000),
    vec2(-0.2000000,  0.9000000),
    vec2( 0.4000000, -0.3000000)
);

// Match ShadowMapModule.cpp Params struct exactly. std140 layout:
// m4x4 (64B) + m4x4×2 (128B) + v4 (16B) + v2+v2 (16B) + u32×3 + f32 + pad
// (16B) + v4×2 cascade_params (32B).
layout(set = 0, binding = 0, std140) uniform Params {
    mat4 inv_view_proj;
    mat4 shadow_vp[4];   // P4.2: 4 级联
    vec4 light_dir;
    vec2 texel_size;          // 1.0 / 2048.0
    vec2 depth_texel_size;    // 1.0 / (render_width, render_height)
    uint shadow_quality;      // 0=Hard, 1=PCF, 2=PCSS, 3-7=debug sentinels
    uint render_width;
    uint render_height;
    float sun_tan_half_angle; // sun-audit §5.3: tan(角直径/2)；0 = 旧固定 0.012
    vec4 cascade_params[4];   // P4.2: x=texel_world, y=depth_span(wu per NDC z), z=extent, w=_
};

layout(set = 0, binding = 1) uniform texture2D shadowMap0;
layout(set = 0, binding = 2) uniform texture2D shadowMap1;
// P4.2: 级联 2/3（binding 7/8 与 C++ 布局对齐）
layout(set = 0, binding = 7) uniform texture2D shadowMap2;
layout(set = 0, binding = 8) uniform texture2D shadowMap3;
// P4.1: 布帘透光强度（r8）= exp(-厚度世界单位×1.5) × max(-NdotL,0) × (1-vis)
layout(set = 0, binding = 9, r8) writeonly uniform image2D translucentOut;
layout(set = 0, binding = 3, r8) uniform writeonly image2D visibilityOut;
layout(set = 0, binding = 4) uniform texture2D normalTex;
layout(set = 0, binding = 5) uniform texture2D depthTex;
layout(set = 0, binding = 6) uniform sampler linearSampler;

// --- Shadow sampling (manual compare; matches Metal's plain .sample path) ---

float pcfShadow(texture2D<float> sm, vec3 sc, vec2 screenPos,
                float filterRadius, float bias) {
    float shadow = 0.0;
    float noise = fract(IGN_MAGIC.z * fract(dot(screenPos, IGN_MAGIC.xy)));
    float angle = noise * TWO_PI;
    float sa = sin(angle), ca = cos(angle);

    for (int i = 0; i < 8; ++i) {
        vec2 offset = POISSON_DISK_16[i];
        vec2 rotated = vec2(offset.x * ca - offset.y * sa,
                            offset.x * sa + offset.y * ca);
        vec2 uv = sc.xy + rotated * filterRadius;
        float d = texture(sampler2D(sm, linearSampler), uv).r;
        shadow += (sc.z - bias > d) ? 0.0 : 1.0;
    }
    return shadow / 8.0;
}

float pcssShadow(texture2D<float> sm, vec3 sc, vec2 screenPos,
                 vec2 texSize, float bias, float lightSizeUV) {
    // Blocker search (8 taps)
    float blockerSum = 0.0;
    float blockerCount = 0.0;
    float noise = fract(IGN_MAGIC.z * fract(dot(screenPos, IGN_MAGIC.xy)));
    float angle = noise * TWO_PI;
    float sa = sin(angle), ca = cos(angle);

    for (int i = 0; i < 8; ++i) {
        vec2 offset = POISSON_DISK_16[i];
        vec2 rotated = vec2(offset.x * ca - offset.y * sa,
                            offset.x * sa + offset.y * ca);
        vec2 uv = sc.xy + rotated * lightSizeUV;
        float d = texture(sampler2D(sm, linearSampler), uv).r;
        if (d < sc.z - bias) {
            blockerSum += d;
            blockerCount += 1.0;
        }
    }
    if (blockerCount < 0.5) return 1.0;

    float penumbraRatio = (sc.z - blockerSum / blockerCount) / max(sc.z, 1e-4);
    float filterRadius = clamp(penumbraRatio * lightSizeUV,
                               texSize.x * 2.0, lightSizeUV * 4.0);

    float shadow = 0.0;
    for (int i = 0; i < 16; ++i) {
        vec2 offset = POISSON_DISK_16[i];
        vec2 rotated = vec2(offset.x * ca - offset.y * sa,
                            offset.x * sa + offset.y * ca);
        vec2 uv = sc.xy + rotated * filterRadius;
        float d = texture(sampler2D(sm, linearSampler), uv).r;
        shadow += (sc.z - bias > d) ? 0.0 : 1.0;
    }
    return shadow / 16.0;
}

float sampleShadowMap(texture2D<float> sm, vec3 sc, vec2 screenPos,
                      vec2 texSize, float bias, uint quality,
                      float lightSizeUV) {
    if (quality == 0u) {
        float d = texture(sampler2D(sm, linearSampler), sc.xy).r;
        return (sc.z - bias > d) ? 0.0 : 1.0;
    } else if (quality == 1u) {
        return pcfShadow(sm, sc, screenPos, 2.0 * texSize.x, bias);
    } else {
        // T8.13: light size 0.005 → 0.012 — penumbra widening was too
        // conservative (shadow edges read near-hard at nave distances).
        // 2026-09-09 V1: 0.05 是 9526281c 时代的笔误档（注释写 0.012、代码写
        // 0.05，且当时该分支是死代码）——0.05 UV ≈ 3wu"太阳"（物理太阳
        // ≈0.0087 UV），把 PCSS 激活为默认后光池带被人为半影化（vis 0.4-0.7）。
        // 0.012 ≈ 1.4× 物理太阳角径，与 T8.13 记录一致。
        // sun-audit §5.3: 0.012 固定值不随级联世界跨度缩放——同一世界点在
        // 级联切换时软硬会突变。现在由调用方传入按级联换算的物理 UV 值；
        // sun_tan_half_angle<=0（角直径关档）时调用方回退本常量。
        return pcssShadow(sm, sc, screenPos, texSize, bias, lightSizeUV);
    }
}

// sun-audit §5.3: 物理半影换算。正交方向光下，沿光轴深度 z（NDC）到级联
// 近面的世界距离 = z * cascade_params.y（depth_span）；太阳角直径 θ 的
// 半影半径世界值 ≈ 距离 * tan(θ/2)；再除级联世界宽度（2*extent，级联
// 正交半宽在 cascade_params.z）得 UV 半径。同一世界点在四级联下得到
// 一致的软硬，遮挡板离接收面越远半影自然越宽。
float physicalLightSizeUV(uint c, float ndcZ) {
    float span = max(cascade_params[c].y, 1e-3);
    float worldWidth = max(cascade_params[c].z * 2.0, 1e-3);
    return ndcZ * span * sun_tan_half_angle / worldWidth;
}

// PCSS 的 lightSizeUV：角直径开启时用物理值（夹到 ≥1 纹素、≤0.05 UV
// ——0.05 即 2026-09-09 V1 记录的"3wu 假太阳"上限，防止调参失手退化）；
// 关档（0）回退 T8.13 的固定 0.012 以保留旧行为 A/B。
float pcssLightSizeUV(uint c, vec3 sc, vec2 texSize) {
    if (sun_tan_half_angle <= 0.0) return 0.012;
    return clamp(physicalLightSizeUV(c, sc.z), texSize.x, 0.05);
}

// --- B17 world-scale bias / normal-offset helpers ---

// Project world position to a cascade's shadow-map UVZ (with the T4.6.5
// part 40.1 Y-flip matching naga's OpFNegate in ShadowDepth.wgsl).
vec3 projectToCascade(mat4 vp, vec3 worldPos) {
    vec4 clip = vp * vec4(worldPos, 1.0);
    vec3 sc = clip.xyz / max(clip.w, 1e-6);
    sc.x = sc.x * 0.5 + 0.5;
    sc.y = 0.5 - sc.y * 0.5;
    return sc;
}

bool scInBounds(vec3 sc) {
    return sc.x >= 0.0 && sc.x <= 1.0 && sc.y >= 0.0 && sc.y <= 1.0;
}

// Slope-scaled depth bias in NDC: (0.5 + 2*tan) texels of world depth,
// converted through the cascade's NDC z→world span. Replaces the constant
// 0.003 NDC (which was ≈0.12-0.21 wu — bigger than a thin arch wall's gap).
// B17.2: front-face slope clamps at 3 (bias ≤3.5 texels — under the old
// flat-0.003's ≈5 texels, so silhouette margins never exceed the old leak
// profile); backfaces clamp at 4 (they can never be direct-lit).
float cascadeBiasNDC(uint c, float slope, float ndl) {
    float texelWorld = cascade_params[c].x;
    float spanW = max(cascade_params[c].y, 1e-3);
    float s = ndl > 0.0 ? min(slope, 3.0) : min(slope, 4.0);
    return texelWorld * (0.5 + 2.0 * s) / spanW;
}

// Normal-offset magnitude: front-facing receivers project in front of their
// own surface (kills acne); back-facing receivers (arch soffits) push AWAY
// from the light (kills the thin-occluder leak). Both directions are safe —
// see the B17 header note.
// B17.2: front-face reach is capped tighter (slope ≤3, 1+slope texels ≤4)
// — the earlier (1+2·slope, clamp 4) reach (≤9 texels ≈0.26wu lateral) let
// grazing lookups cross occluder silhouettes and grew the arcade sun
// patches (reference direct/interior 5.6→3.36). Backfaces keep the strong
// push: they can never be direct-lit, so over-shadowing there is free.
vec3 cascadeNormalOffset(uint c, vec3 N, float slope, float ndl) {
    float k = ndl > 0.0 ? min(1.0 + slope, 4.0) : (1.0 + 2.0 * min(slope, 4.0));
    return N * (cascade_params[c].x * k);
}

void main() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    uvec2 outSize = imageSize(visibilityOut);
    if (any(greaterThanEqual(gid, outSize))) return;

    // Half-res visibility — sample full-res depth at gid*2+0.5 mapped to [0,1].
    vec2 fullUV = (vec2(gid) * 2.0 + 1.0) / vec2(render_width, render_height);

    // PRIMAL_SHADOW_WHITE (quality 255): write all-white vis (no shadows).
    // The Metal kernel has had this sentinel at ShadowFilter.metal:107 since
    // T8.x; the Vulkan port silently fell through to PCSS, so the env was a
    // no-op on Vulkan until B17.3. Needed for direct-light-isolation A/Bs.
    if (shadow_quality == 255u) {
        imageStore(visibilityOut, ivec2(gid), vec4(1.0));
        return;
    }

    float depth = texture(sampler2D(depthTex, linearSampler), fullUV).r;
    if (depth >= 1.0) {
        imageStore(visibilityOut, ivec2(gid), vec4(1.0));
        return;
    }

    // T4.6.5 part 40.2: flip Y in NDC to match naga's auto-inserted
    // OpFNegate on gl_Position.y in GBuffer.wgsl vertex shader. After
    // naga Y-negate, framebuffer pixel (0,0) [Vulkan BOTTOM] contains world
    // Y+ content. fullUV.y=0 → samples world Y+ depth → must reconstruct
    // world Y+ → needs ndc.y=+1. Old formula `fullUV.y*2-1` gave -1 →
    // reconstructed world Y- → wrong cascade lookup → shadows tracked
    // camera movement. Reference: Dawn CommonFunction.wgsl:51.
    vec2 ndc = vec2(fullUV.x * 2.0 - 1.0, 1.0 - fullUV.y * 2.0);
    vec4 clipPos = vec4(ndc, depth, 1.0);
    vec4 worldPos4 = inv_view_proj * clipPos;
    vec3 worldPos = worldPos4.xyz / max(worldPos4.w, 1e-6);

    // B17: world normal (GBuffer RT1, *0.5+0.5 stored) + receiver slope.
    // light_dir is the propagation direction (Y down) — surface-to-light is
    // its negation.
    vec3 N = texture(sampler2D(normalTex, linearSampler), fullUV).rgb * 2.0 - 1.0;
    if (dot(N, N) < 1e-4) N = vec3(0.0, -1.0, 0.0);
    N = normalize(N);
    vec3 LtoLight = -normalize(light_dir.xyz);
    float NdotL = dot(N, LtoLight);
    // tan(theta) with a |NdotL| floor of 0.25 (tan ≤ 3.88) — keeps grazing
    // surfaces bounded without a discontinuity at silhouettes.
    float slope = clamp(sqrt(max(0.0, 1.0 - NdotL * NdotL)) / max(abs(NdotL), 0.25),
                        0.0, 4.0);

    vec2 screenPos = vec2(gid);
    float visibility = 1.0;
    float transmission = 0.0;  // P4.1

    vec3 offset0 = cascadeNormalOffset(0u, N, slope, NdotL);
    float bias0 = cascadeBiasNDC(0u, slope, NdotL);
    vec3 sc0 = projectToCascade(shadow_vp[0], worldPos + offset0);

    // PRIMAL_SHADOW_DEBUG sentinels (quality 3-7): 3 = shadow-map depth at
    // the production (offset) lookup, 4 = raw receiver depth (no offset),
    // 5 = hard compare with the production bias/offset, 6 = PCSS blocker-hit
    // density, 7 = NdotL normal-space sentinel.
    if (shadow_quality >= 3u && shadow_quality <= 7u) {
        float outV = 0.0;
        if (shadow_quality == 7u) {
            outV = clamp(NdotL * 0.5 + 0.5, 0.0, 1.0);
        } else if (shadow_quality == 4u) {
            vec3 raw0 = projectToCascade(shadow_vp[0], worldPos);
            outV = clamp(raw0.z, 0.0, 1.0);
        } else if (shadow_quality == 5u) {
            if (scInBounds(sc0) && sc0.z >= 0.0 && sc0.z <= 1.0) {
                float d = texture(sampler2D(shadowMap0, linearSampler), sc0.xy).r;
                outV = (sc0.z - bias0 > d) ? 0.0 : 1.0;
            }
        } else if (shadow_quality == 6u) {
            if (scInBounds(sc0) && sc0.z >= 0.0 && sc0.z <= 1.0) {
                // blocker-hit density over the PCSS search disk (÷8, amplified
                // ×4 so small counts stay visible through the ×0.26 passthrough)
                float cnt = 0.0;
                for (int i = 0; i < 8; ++i) {
                    vec2 uv = sc0.xy + POISSON_DISK_16[i] * 0.05;
                    float d = texture(sampler2D(shadowMap0, linearSampler), uv).r;
                    if (d < sc0.z - bias0) cnt += 1.0;
                }
                outV = clamp(cnt / 8.0 * 4.0, 0.0, 1.0);
            }
        } else if (scInBounds(sc0) && sc0.z >= 0.0 && sc0.z <= 1.0) {
            outV = texture(sampler2D(shadowMap0, linearSampler), sc0.xy).r;
        }
        imageStore(visibilityOut, ivec2(gid), vec4(outV));
        return;
    }

    // P4.2: 4 级联由近到远逐级选取（texel 密度随 extent 递减）
    {
        vec3 offset = cascadeNormalOffset(0u, N, slope, NdotL);
        float bias = cascadeBiasNDC(0u, slope, NdotL);
        vec3 sc = projectToCascade(shadow_vp[0], worldPos + offset);
        bool inCascade = scInBounds(sc) && sc.z >= 0.0 && sc.z <= 1.0;
        if (inCascade) {
            visibility = sampleShadowMap(shadowMap0, sc, screenPos,
                                         texel_size, bias, shadow_quality,
                                         pcssLightSizeUV(0u, sc, texel_size));
            float occ = texture(sampler2D(shadowMap0, linearSampler), sc.xy).r;
            // P2-B（audit §4.7）: 厚度方向修正。遮挡判断约定是
            // `receiverDepth - bias > blockerDepth` = 阴影，故光线路径上
            // 遮挡物到接收面的 NDC 深度差 = (sc.z - bias) - occ。旧表达式
            // `occ - (sc.z - bias)` 只在“未被遮挡”时为正，透光项实际恒 0，
            // exp(-thW*1.5) 无法随厚度衰减。
            float thW = max((sc.z - bias) - occ, 0.0) * cascade_params[0].y;
            transmission = exp(-thW * 1.5) * max(-NdotL, 0.0) * (1.0 - visibility);
        } else {
            offset = cascadeNormalOffset(1u, N, slope, NdotL);
            bias = cascadeBiasNDC(1u, slope, NdotL);
            sc = projectToCascade(shadow_vp[1], worldPos + offset);
            inCascade = scInBounds(sc) && sc.z >= 0.0 && sc.z <= 1.0;
            if (inCascade) {
                visibility = sampleShadowMap(shadowMap1, sc, screenPos,
                                             texel_size, bias, shadow_quality,
                                             pcssLightSizeUV(1u, sc, texel_size));
                float occ1 = texture(sampler2D(shadowMap1, linearSampler), sc.xy).r;
                float thW1 = max((sc.z - bias) - occ1, 0.0) * cascade_params[1].y;
                transmission = exp(-thW1 * 1.5) * max(-NdotL, 0.0) * (1.0 - visibility);
            } else {
                offset = cascadeNormalOffset(2u, N, slope, NdotL);
                bias = cascadeBiasNDC(2u, slope, NdotL);
                sc = projectToCascade(shadow_vp[2], worldPos + offset);
                inCascade = scInBounds(sc) && sc.z >= 0.0 && sc.z <= 1.0;
                if (inCascade) {
                    visibility = sampleShadowMap(shadowMap2, sc, screenPos,
                                                 texel_size, bias, shadow_quality,
                                                 pcssLightSizeUV(2u, sc, texel_size));
                    float occ2 = texture(sampler2D(shadowMap2, linearSampler), sc.xy).r;
                    float thW2 = max((sc.z - bias) - occ2, 0.0) * cascade_params[2].y;
                    transmission = exp(-thW2 * 1.5) * max(-NdotL, 0.0) * (1.0 - visibility);
                } else {
                    offset = cascadeNormalOffset(3u, N, slope, NdotL);
                    bias = cascadeBiasNDC(3u, slope, NdotL);
                    sc = projectToCascade(shadow_vp[3], worldPos + offset);
                    if (scInBounds(sc) && sc.z >= 0.0 && sc.z <= 1.0) {
                        visibility = sampleShadowMap(shadowMap3, sc, screenPos,
                                                     texel_size, bias, shadow_quality,
                                                     pcssLightSizeUV(3u, sc, texel_size));
                        float occ3 = texture(sampler2D(shadowMap3, linearSampler), sc.xy).r;
                        float thW3 = max((sc.z - bias) - occ3, 0.0) * cascade_params[3].y;
                        transmission = exp(-thW3 * 1.5) * max(-NdotL, 0.0) * (1.0 - visibility);
                    }
                    // 全部越界：无级联覆盖 —— 保持 lit（1.0）
                }
            }
        }
    }

    imageStore(visibilityOut, ivec2(gid), vec4(visibility));
    imageStore(translucentOut, ivec2(gid), vec4(clamp(transmission, 0.0, 1.0)));
}
