// FroxelDensityInject.comp — P2.1 (2026-09-15): GLSL 移植自
// Metal/shaders/Volume/FroxelDensityInject.metal（路线图 Phase 2）。
// 每线程一个 froxel：重建世界坐标，采样密度（噪声 + SDF 遮蔽），写 R 通道。
// 绑定与 C++ FroxelFogPass 重编号后布局一致（UBO=6，扁平命名空间）。
// WP5 (2026-09-30): 云原语——局部云体密度源。球形包络 × FBM 基底 ×
// Worley 细节，云底压扁（积云轮廓）；绕过 SDF/高度门（云悬空于开放空域，
// SDF carve 只应清零几何内部的霾，不该吃掉云体）；在 max() 语义下与霾
// 叠加（云区域内云密度占主导）。

#version 450 core
#extension GL_GOOGLE_include_directive : require
#define FROXEL_PARAMS_BINDING 6
#include "FroxelCommon.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0, r16f) writeonly uniform image3D froxel_density;
layout(set = 0, binding = 1) uniform texture3D noise_tex;
layout(set = 0, binding = 2) uniform texture3D sdf_cascade_0;
layout(set = 0, binding = 3) uniform texture3D sdf_cascade_1;
layout(set = 0, binding = 4) uniform texture3D sdf_cascade_2;
layout(set = 0, binding = 5) uniform texture2D depth_buffer;
// WP5 云原语（3D 纹理路线）: CPU 预烘焙积云体积（96³ R8, 密度 0-1）
layout(set = 0, binding = 7) uniform texture3D cloud_volume;

void main() {
    ivec3 gid = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 dims = imageSize(froxel_density);
    if (gid.x >= dims.x || gid.y >= dims.y || gid.z >= dims.z) return;

    // 契约：froxelToWorld 的参数整数 = 单元中心（旧式调用方 +0.5 与 helper
    // 内 +0.5 叠加，把中心采样成了角点——audit V2）。
    vec3 worldPos = froxelToWorld(vec3(gid));

    // 场景几何之后的 froxel 置零。取本 froxel 屏幕足迹 4 象限的最小深度
    // （最近表面）——单点采样会漏掉细柱/栏杆，让光束穿缝。
    bool cleared = false;
    {
        vec2 pixPerFroxel = params.ScreenParams.xy / params.FroxelDims.xy;
        vec2 centerPix = (vec2(gid.xy) + 0.5) * pixPerFroxel;
        vec2 halfPix = pixPerFroxel * 0.5;
        for (int q = 0; q < 4; ++q) {
            vec2 off = vec2((q & 1) != 0 ? halfPix.x : -halfPix.x,
                            (q & 2) != 0 ? halfPix.y : -halfPix.y);
            ivec2 depthPixel = clamp(ivec2(centerPix + off), ivec2(0),
                                     ivec2(params.ScreenParams.xy) - ivec2(1));
            float sceneDepth = texelFetch(depth_buffer, depthPixel, 0).x;
            if (sceneDepth > 0.0 && sceneDepth < 1.0) {
                float sceneZ = ndcToViewZ(sceneDepth);
                // 切片后边界越过最近表面即清零（保守：光束不被表面后方雾污染）
                float froxelZFar = froxelZToDepth(float(gid.z) + 0.5);
                if (froxelZFar > sceneZ) { cleared = true; break; }
            }
        }
    }
    if (cleared) {
        imageStore(froxel_density, gid, vec4(0.0));
        return;
    }

    // 常量介质模式：绕过噪声/SDF，直接写满（几何清零已处理）
    if (params.FrustumParams2.z > 0.0) {
        imageStore(froxel_density, gid, vec4(params.FrustumParams2.z));
        return;
    }

    vec3 noiseDims = vec3(textureSize(noise_tex, 0));
    // 全场景基础霾（噪声霾+高度雾）始终保留；WP5 云体在下方 max() 叠加为
    // 独立的局部云块（用户定调：全场景雾霾 + 中间一小块独立云体）。
    float density = froxelSampleDensity(worldPos, noise_tex, noiseDims,
                                        sdf_cascade_0, sdf_cascade_1, sdf_cascade_2);

    // WP5 云原语（3D 纹理路线）：云 AABB(center ± radius) 内采样预烘焙
    // 云体积（CPU 生成的三尺度积云），max() 叠加在基础霾上。uvw 出界 =
    // 云外，不采样。
    if (params.CloudA.x > 0.5) {
        vec3 cuvw = (worldPos - params.CloudB.xyz) / (2.0 * params.CloudA.y) + 0.5;
        if (cuvw.x > 0.0 && cuvw.x < 1.0 &&
            cuvw.y > 0.0 && cuvw.y < 1.0 &&
            cuvw.z > 0.0 && cuvw.z < 1.0) {
            float cd = froxelTrilinearClamp(cloud_volume, cuvw, vec3(96.0));
            density = max(density, params.CloudA.z * cd);
        }
    }

    if (density < params.VolumeParams1.z) density = 0.0;

    imageStore(froxel_density, gid, vec4(density));
}
