#version 450 core
#extension GL_GOOGLE_include_directive : require
// ============================================================================
// SurfaceCacheStaticComposite — SC per-mesh 计划 P2：离线静态表面页 → SC atlas
// 一次性合成（SurfaceCachePass 在分配纪元变化时 dispatch 一次）。
//
// 计划：Docs/2026-09-30-sc-per-mesh-surface-bake-and-lookup-plan.md §3.2/§4/P2。
// 静态卡的表面数据只能来自 owner mesh 的离线页（本 shader 是唯一写入者），
// 合成后 SurfaceCachePass 对静态卡跳过 capture 与 CardFill——外来几何结构上
// 无法进入静态表面（§3.2 生产约束，非诊断开关）。
//
// 每 thread = 一张静态卡的一个 atlas texel：
//   1. texel → 世界平面点（cardTexelToWorld 查询约定，depth=0）
//   2. 逆实例线性变换 → mesh 局部 → 页 UV（离线页 = 卡局部帧烘焙）
//   3. 读页 albedo/normal/depth；mask=0 写显式无效（depth=-1，查询契约）
//   4. normal 局部→世界（列变换）+ 朝卡眼翻转（capture 同约定）；
//      depth 局部轴向距离 → 世界轴向距离
//
// Dispatch: 1D, Σ(card_res²) threads。Threadgroup (256,1,1)。
//
// Flat bindings:
//   0 = StorageImage(rgba8)         albedo_atlas (write)
//   1 = StorageImage(rg16f)         normal_atlas (write)
//   2 = StorageImage(r32f)          depth_atlas  (write)
//   3 = readonly buffer             StaticCompositeInfo[] (std430)
//   4 = readonly buffer             uint pool_words[] (std430) — 页平面字节池
//       （每卡 [albedo res²·4B][normal res²·4B][depth res²·4B]；res 为 32 的
//        倍数 → 全部 4 字节对齐，按 uint word 寻址）
// ============================================================================

#include "SurfaceCacheData.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) writeonly uniform image2D albedo_atlas;
layout(set = 0, binding = 1, rg16f) writeonly uniform image2D normal_atlas;
layout(set = 0, binding = 2, r32f)  writeonly uniform image2D depth_atlas;
layout(set = 0, binding = 5, rgba16f) writeonly uniform image2D emissive_atlas;

// 与 C++ StaticCompositeInfo（SurfaceCacheTypes.h）逐字节镜像，144 B = 9×16B。
struct StaticCompositeInfo {
    uvec4 meta0;   // atlas_offset_x, atlas_offset_y, card_res, page_res
    uvec4 meta1;   // texel_offset, static_count (first record), world_axis_dir, local_axis_dir
    uvec4 meta2;   // pool_albedo_word, pool_normal_word, pool_depth_word, pool_triangle_word
    vec4  center_w;   // xyz = 世界卡中心
    vec4  mcol0;      // 世界矩阵线性列 0（w=0）
    vec4  mcol1;
    vec4  mcol2;
    vec4  local0;     // xyz = emissive RGB, w = local extent.x
    vec4  local1;     // xy = local extent.yz, zw reserved
};

layout(set = 0, binding = 3, std430) readonly buffer CompositeInfoBuf {
    StaticCompositeInfo infos[];
} ci;

layout(set = 0, binding = 4, std430) readonly buffer PoolBuf {
    uint pool_words[];
} pb;

vec3 mat3_from_cols(vec4 c0, vec4 c1, vec4 c2, vec3 v) {
    return c0.xyz * v.x + c1.xyz * v.y + c2.xyz * v.z;
}

vec3 inv_mat3_vec(vec4 c0, vec4 c1, vec4 c2, vec3 v) {
    // 3×3 行列式 + 伴随求逆（列向量布局）。
    vec3 r0 = vec3(c0.x, c1.x, c2.x);
    vec3 r1 = vec3(c0.y, c1.y, c2.y);
    vec3 r2 = vec3(c0.z, c1.z, c2.z);
    float det = dot(cross(r0, r1), r2);
    if (abs(det) < 1e-12) return v;
    float inv = 1.0 / det;
    return vec3(
        dot(cross(r1, r2), v) * inv,
        dot(cross(r2, r0), v) * inv,
        dot(cross(r0, r1), v) * inv);
}

layout(set=0,binding=6,std430) buffer AtlasTriangles { uint data[]; } atlasTriangles;

void surface_cache_static_composite() {
    uint tid = gl_GlobalInvocationID.x;
    // 二分查找：texel_offset 前缀和定位卡片（static_count 存于首条 meta1.y）。
    uint lo = 0u;
    uint hi = ci.infos[0].meta1.y;   // static_count 存于首条的 meta1.y
    StaticCompositeInfo info;
    bool found = false;
    while (lo < hi) {
        uint mid = (lo + hi) >> 1u;
        StaticCompositeInfo m = ci.infos[mid];
        if (m.meta1.x + m.meta0.z * m.meta0.z <= tid) lo = mid + 1u;
        else hi = mid;
    }
    if (lo < ci.infos[0].meta1.y) {
        info = ci.infos[lo];
        found = (tid >= info.meta1.x) &&
                (tid < info.meta1.x + info.meta0.z * info.meta0.z);
    }
    if (!found) return;

    uint res = info.meta0.z;
    uint page_res = info.meta0.w;
    uint local_texel = tid - info.meta1.x;
    uint lx = local_texel % res;
    uint ly = local_texel / res;
    ivec2 atlas_uv = ivec2(int(info.meta0.x + lx), int(info.meta0.y + ly));

    imageStore(emissive_atlas, atlas_uv, vec4(0.0));
    uint identityAt=uint(atlas_uv.y)*uint(imageSize(depth_atlas).x)+uint(atlas_uv.x);
    atlasTriangles.data[identityAt]=0xffffffffu;

    // ---- 页 UV：texel → 世界平面点 → 局部帧 ----
    float u = (float(lx) + 0.5) / float(res);
    float v = (float(ly) + 0.5) / float(res);
    uint axis = info.meta1.z & 0xFFu;
    uint dir  = (info.meta1.z >> 8u) & 0xFFu;

    // 世界半尺寸（RegisterMeshBaked 的 |columns|·局部半尺寸 投影）。
    vec3 e_w;
    e_w.x = abs(info.mcol0.x) * info.local0.w + abs(info.mcol1.x) * info.local1.x + abs(info.mcol2.x) * info.local1.y;
    e_w.y = abs(info.mcol0.y) * info.local0.w + abs(info.mcol1.y) * info.local1.x + abs(info.mcol2.y) * info.local1.y;
    e_w.z = abs(info.mcol0.z) * info.local0.w + abs(info.mcol1.z) * info.local1.x + abs(info.mcol2.z) * info.local1.y;

    // 世界平面点（查询约定：axis0→(y,z) u/v，axis1→(x,z)，axis2→(x,y)）。
    vec3 q_w = info.center_w.xyz;
    if (axis == 0u)      q_w += vec3(0.0, (u - 0.5) * e_w.y * 2.0, (v - 0.5) * e_w.z * 2.0);
    else if (axis == 1u) q_w += vec3((u - 0.5) * e_w.x * 2.0, 0.0, (v - 0.5) * e_w.z * 2.0);
    else                 q_w += vec3((u - 0.5) * e_w.x * 2.0, (v - 0.5) * e_w.y * 2.0, 0.0);

    vec3 dl = inverse(mat3(info.mcol0.xyz, info.mcol1.xyz, info.mcol2.xyz)) * (q_w - info.center_w.xyz);

    uint local_axis = info.meta1.w & 0xFFu;
    uint local_dir = (info.meta1.w >> 8u) & 0xFFu;
    vec3 extent_l = vec3(info.local0.w, info.local1.x, info.local1.y);
    float eu = extent_l[local_axis == 0u ? 1u : 0u];
    float ev = extent_l[local_axis == 2u ? 1u : 2u];
    float u_l, v_l;
    if (axis == 0u)      { u_l = dl.y / (eu * 2.0) + 0.5; v_l = dl.z / (ev * 2.0) + 0.5; }
    else if (axis == 1u) { u_l = dl.x / (eu * 2.0) + 0.5; v_l = dl.z / (ev * 2.0) + 0.5; }
    else                 { u_l = dl.x / (eu * 2.0) + 0.5; v_l = dl.y / (ev * 2.0) + 0.5; }

    // 越出页域（旋转/缩放下卡投影超页矩形）→ 显式无效。
    int px = int(floor(u_l * float(page_res)));
    int py = int(floor(v_l * float(page_res)));
    if (px < 0 || py < 0 || px >= int(page_res) || py >= int(page_res)) {
        imageStore(albedo_atlas, atlas_uv, vec4(0.0));
        imageStore(normal_atlas, atlas_uv, vec4(0.5, 0.5, 0.0, 1.0));
        imageStore(depth_atlas,  atlas_uv, vec4(-1.0, 0.0, 0.0, 1.0));
        return;
    }
    uint ptex = uint(py) * page_res + uint(px);
    uint base = info.meta2.x + ptex;   // albedo 平面 word 基址

    uint albedo_word = pb.pool_words[base];
    float coverage = float((albedo_word >> 24u) & 0xFFu) / 255.0;
    if (coverage < 0.5) {
        // 无真实覆盖：显式无效（§3.2 禁止伪有效 texel）。
        imageStore(albedo_atlas, atlas_uv, vec4(0.0));
        imageStore(normal_atlas, atlas_uv, vec4(0.5, 0.5, 0.0, 1.0));
        imageStore(depth_atlas,  atlas_uv, vec4(-1.0, 0.0, 0.0, 1.0));
        return;
    }

    atlasTriangles.data[identityAt]=pb.pool_words[info.meta2.w+ptex];
    imageStore(emissive_atlas, atlas_uv, vec4(info.local0.xyz, 1.0));

    // ---- albedo（线性 RGBA8；alpha 携 capture 传输契约 bit7=valid）----
    float r = float(albedo_word & 0xFFu) / 255.0;
    float g = float((albedo_word >> 8u) & 0xFFu) / 255.0;
    float b = float((albedo_word >> 16u) & 0xFFu) / 255.0;
    imageStore(albedo_atlas, atlas_uv, vec4(r, g, b, 128.0 / 255.0));

    // ---- normal：页 oct([0,1] f16 对) → 局部 → 世界（朝卡眼翻转）----
    // rg16f = 低/高 16 位各一个 f16，unpackHalf2x16 一次解出。
    vec2 e = unpackHalf2x16(pb.pool_words[info.meta2.y + ptex]);
    vec3 n_l = octDecode(e);
    vec3 n_w = normalize(transpose(inverse(mat3(info.mcol0.xyz, info.mcol1.xyz, info.mcol2.xyz))) * n_l);
    vec3 f_w = (axis == 0u) ? vec3(dir > 0u ? 1.0 : -1.0, 0.0, 0.0)
             : (axis == 1u) ? vec3(0.0, dir > 0u ? 1.0 : -1.0, 0.0)
                            : vec3(0.0, 0.0, dir > 0u ? 1.0 : -1.0);
    if (dot(n_w, f_w) > 0.0) n_w = -n_w;
    imageStore(normal_atlas, atlas_uv, vec4(octEncode(n_w), 0.0, 1.0));

    // ---- depth：页局部轴向距离 → 世界轴向距离 ----
    float d_l = uintBitsToFloat(pb.pool_words[info.meta2.z + ptex]);
    vec3 f_l = vec3(0.0);
    f_l[local_axis] = local_dir > 0u ? 1.0 : -1.0;
    // 局部表面偏移 = u/v 平面偏移 + 法向 d_l（局部中心已在 dl 中扣除）。
    vec3 off_l;
    if (local_axis == 0u)      off_l = vec3(f_l.x * d_l, (u_l - 0.5) * eu * 2.0, (v_l - 0.5) * ev * 2.0);
    else if (local_axis == 1u) off_l = vec3((u_l - 0.5) * eu * 2.0, f_l.y * d_l, (v_l - 0.5) * ev * 2.0);
    else                 off_l = vec3((u_l - 0.5) * eu * 2.0, (v_l - 0.5) * ev * 2.0, f_l.z * d_l);
    vec3 p_w = info.center_w.xyz + mat3_from_cols(info.mcol0, info.mcol1, info.mcol2, off_l);
    float d_w = dot(p_w - info.center_w.xyz, f_w);
    imageStore(depth_atlas, atlas_uv, vec4(d_w, 0.0, 0.0, 1.0));
}
