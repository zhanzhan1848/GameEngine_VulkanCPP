#version 450 core
// Vulkan Lumen Screen Probe GI — SH2 (L0+L1) accumulation with multi-factor
// confidence. Hand-written GLSL port of ScreenProbeAverage.metal
// (entry: screen_probe_average).
//
// Each threadgroup handles one probe. Each thread reads 1 ray, recomputes its
// ray direction (Fibonacci + orientAroundNormal), evaluates 4 SH basis
// functions, and accumulates into shared memory via parallel reduction.
//
//   Confidence = hitRatio * radianceConsistency
//     hitRatio            = fraction of rays carrying radiance (geometry hits
//                           plus DDGI-fallback misses, which have cosTheta > 0)
//     radianceConsistency = mix(0.55, 1.0, exp(-4*variance_of_luminance)) —
//                           variance only shades confidence; it no longer
//                           collapses it in high-contrast lighting
//
// Output: 4 vec4 per probe (interleaved [sh0, sh1, sh2, sh3]).
//   sh[0].w = confidence,  sh[1..3].w = 1.0 (validity flag)
//
// REQUIREMENT: ThreadGroupSize is 64; raysPerProbe is in [1, 64].
// Dispatch: totalProbes, 1, 1  (one threadgroup per probe).
//
// Flat descriptor bindings:
//   binding 0 = SSBO read   rayRadiance[]  (per-ray: xyz=radiance, w=cosTheta, neg=miss)
//   binding 1 = SSBO write  probeSHOut[]   (4 vec4 per probe)
//   binding 2 = UBO         { uint totalProbes; uint raysPerProbe; } (16B)
//   binding 3 = SSBO read   probeNormals[]

#extension GL_EXT_samplerless_texture_functions : enable
#extension GL_GOOGLE_include_directive : require

// X1 shared direction library + F5 (M7) per-frame jitter rotation. The local
// fibonacciDirection/orientAroundNormal copies were removed — EncodeLib's
// orientAroundNormalTBN is byte-for-byte the old local body.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// --------------------------------------------------------------------------------
// Bindings (flat)
// --------------------------------------------------------------------------------
layout(set = 0, binding = 0, std430) readonly buffer RayRadianceBlock {
    vec4 data[];
} rayRadiance;

layout(set = 0, binding = 1, std430) buffer ProbeSHOutBlock {
    vec4 data[];
} probeSHOut;

layout(set = 0, binding = 2, std140) uniform AvgConstantsBlock {
    uint totalProbes;
    uint raysPerProbe;
    float frameSeed;   // F5: same value as camera_position.w (< 0 disables)
    float isMode;      // F2: importance resampling on/off (matches cache_params.y)
    // P2/P4 tail (std140 pads the block to 48B):
    uint tier3Mode;    // 1 = slot layout + compacted radiance indirection
    uint tierRaysMode; // 1 = respect per-slot ray tier (normals.w)
    uint sh2CheckMode; // [P4] 1 = 写 SH2 重建误差统计（binding 6）
    uint pad0;
    // [②K-4 2026-09-21] 纯天空探针 confidence 地板（根治 Phase 3 条目 4）：
    // hitRatio≈0 的探针 SH 全是解析天空/回退辐射（非测量 bounce），gather
    // 权重按此地板降档——天空能量不再与几何命中探针同权隔墙渗透。
    // env PRIMAL_GI_SKY_CONF_FLOOR（默认 0.18；0.35 = 旧地板）。
    float skyConfFloor;
    float pad1;
} constants;

layout(set = 0, binding = 3, std430) readonly buffer ProbeNormalsBlock {
    vec4 data[];
} probeNormals;

// F2 (M7): previous frame's final probe SH — importance-resampling proposal
// (direction regeneration MUST match the trace kernels exactly).
layout(set = 0, binding = 4, std430) readonly buffer ImportanceSHBlock {
    vec4 data[];
} importanceSH;

// P2 (tier3): slot → compacted radiance id (0xFFFFFFFF = inactive/over-cap).
layout(set = 0, binding = 5, std430) readonly buffer SlotToCompactBlock {
    uint data[];
} slotToCompact;

// [P4 2026-09-21 probe-repr-plan] SH2 重建误差检查（env PRIMAL_SPGI_SH2_CHECK=1
// 时分配绑定，否则 dummy）：每探针 vec4 {Σ|Δ|lum·w, Σw, activeCount, 0}。
// Δ = SH2(rayDir) 重代入求值 vs 逐射线亮度（重代入 = 重建误差下界代理；
// 严格留一需 64 次去一重投影，计划 §P4 的"SH2 积分 vs 射线加权 |Δ|"取此口径）。
// CPU 读回后按探针取均值出 P50/P95——回答"SPGI SH2 够不够"（评审 #7）。
layout(set = 0, binding = 6, std430) buffer Sh2CheckBlock {
    vec4 data[];
} sh2Check;

// [②K-4 2026-09-21 显式 V(x,ω) 切片] 每探针天空可见性统计：x = miss 占比
//（=天空/回退射线占比——finalize 侧 miss 全部落到解析天空或级联兜底），
// y = 几何命中占比。显式 V 的空间差异化：探针场"哪里看得见天"从隐式
// （SH 内容）提升为显式统计，诊断与下游分类加权共用。
layout(set = 0, binding = 7, std430) buffer ProbeOpenSkyBlock {
    vec4 data[];
} probeOpenSky;

#include "ShaderLib/EncodeLib.glsl"

// --------------------------------------------------------------------------------
// Constants
// --------------------------------------------------------------------------------
const uint  AVG_TG_SIZE  = 64u;

// fibonacciDirection / orientAroundNormalTBN / spgiJitterRotation live in
// ShaderLib/EncodeLib.glsl (included after the bindings below) — the
// direction set MUST match the trace kernels byte-for-byte (rayRadiance is
// indexed by ray).

// SH basis (L0 + L1, 4 coefficients)
vec4 shBasis(vec3 d) {
    return vec4(
        0.282095,                // Y0 (L0)
        -0.488603 * d.y,          // Y1 (L1, y)
        0.488603 * d.z,          // Y2 (L1, z)
        -0.488603 * d.x           // Y3 (L1, x)
    );
}

// --------------------------------------------------------------------------------
// Shared memory for parallel reduction
// --------------------------------------------------------------------------------
shared vec3 sharedSH[4][AVG_TG_SIZE];   // 4 SH bands
shared float sharedWeight[AVG_TG_SIZE]; // cosTheta sum
shared float sharedLum[AVG_TG_SIZE];    // luminance sum for variance
shared float sharedLumSq[AVG_TG_SIZE];  // luminance^2 sum for variance
shared float sharedHit[AVG_TG_SIZE];    // 1.0 if geometry hit, 0.0 if miss/inactive (B5)
shared float sharedActive[AVG_TG_SIZE]; // 1.0 if the lane carries a ray (B5: variance divisor)
// [P4] SH2 重建误差检查的逐射线数据 + 误差归约。
shared vec3  sharedRayDir[AVG_TG_SIZE];
shared vec3  sharedRayRad[AVG_TG_SIZE];
shared vec3  sharedErrSum[AVG_TG_SIZE];  // |Δ|lum 加权累计（归约）

// --------------------------------------------------------------------------------
// Main
// --------------------------------------------------------------------------------
void screen_probe_average() {
    uint tid     = gl_LocalInvocationID.x;
    uint group_id = gl_WorkGroupID.x;

    if (group_id >= constants.totalProbes) return;

    // P2/P4: group_id is the SLOT index under tier3; the rays live at the
    // slot's compacted radiance id and only the leading tier rays exist.
    // NOTE: the compact-invalid check is workgroup-uniform (whole group
    // exits); the tier gate below must NOT return early — every lane has to
    // reach the reduction barriers, so gated lanes simply contribute zero.
    uint radianceBase = group_id * constants.raysPerProbe;
    float tierRays = float(constants.raysPerProbe);
    if (constants.tier3Mode > 0u) {
        uint compact = slotToCompact.data[group_id];
        if (compact == 0xFFFFFFFFu) {
            if (tid == 0u) {
                uint base = group_id * 4u;
                probeSHOut.data[base + 0u] = vec4(0.0);
                probeSHOut.data[base + 1u] = vec4(0.0);
                probeSHOut.data[base + 2u] = vec4(0.0);
                probeSHOut.data[base + 3u] = vec4(0.0);
            }
            return;
        }
        radianceBase = compact * constants.raysPerProbe;   // compacted layout: stride = rays/probe
        if (constants.tierRaysMode > 0u) {
            tierRays = probeNormals.data[group_id].w;
        }
    }

    // Each thread reads exactly 1 ray (tier-gated lanes read nothing and
    // fall through as miss lanes — the reduction below requires all 64).
    uint rayIdx = radianceBase + tid;
    vec4 rayData = vec4(0.0, 0.0, 0.0, 0.0);
    if (float(tid) < tierRays && tid < constants.raysPerProbe) {
        rayData = rayRadiance.data[rayIdx];
    }

    // B5: sign encodes geometry hit (positive) vs miss→sky / inactive (≤ 0).
    // Integration uses the magnitude; hit count requires w > 0.
    if (rayData.w != 0.0) {
        // HDR safety bound, matching the SC radiance range. The old 5.0
        // ceiling clipped ordinary sunlit bounce before projection.
        const float MAX_RAY_RADIANCE = 64.0;
        float rayLum = dot(rayData.rgb, vec3(0.2126, 0.7152, 0.0722));
        if (rayLum > MAX_RAY_RADIANCE) {
            rayData.rgb *= MAX_RAY_RADIANCE / rayLum;
        }

        // Hit: compute SH basis and accumulate
        vec4 normData = probeNormals.data[group_id];
        vec3 probeNormal = normalize(normData.xyz);

        vec3 rayDir;
        float invNq = 1.0; // discrete candidate PDF correction, regenerated with the ray
        if (constants.isMode > 0.5) {
            uint hb = group_id * 4u;
            vec4 h0 = importanceSH.data[hb + 0u];
            vec4 h1 = importanceSH.data[hb + 1u];
            vec4 h2 = importanceSH.data[hb + 2u];
            vec4 h3 = importanceSH.data[hb + 3u];
            rayDir = spgiImportanceDirection(tid, constants.raysPerProbe, group_id,
                                             constants.frameSeed, probeNormal,
                                             h0.rgb, h1.rgb, h2.rgb, h3.rgb, invNq);
            rayDir = orientAroundNormalTBN(rayDir, probeNormal);
        } else {
            vec3 localDir = fibonacciDirection(tid, constants.raysPerProbe);
            localDir = spgiJitterRotation(group_id, constants.frameSeed) * localDir;
            rayDir = orientAroundNormalTBN(localDir, probeNormal);
        }

        vec4 Y = shBasis(rayDir);

        float rayWeight = abs(rayData.w);   // B5: sign is a flag, not a weight
        // Project radiance, not cosine-weighted irradiance. The candidate
        // set covers 4pi; invNq=1/(candidateCount*q) corrects resampling.
        // rayData.w supplies validity/hit classification only. Gather applies
        // the cosine convolution once, after the SH projection.
        float projWeight = invNq;
        vec3 weightedRadiance = rayData.rgb * projWeight;
        sharedSH[0][tid] = weightedRadiance * Y.x;
        sharedSH[1][tid] = weightedRadiance * Y.y;
        sharedSH[2][tid] = weightedRadiance * Y.z;
        sharedSH[3][tid] = weightedRadiance * Y.w;
        sharedWeight[tid] = rayWeight;
        sharedHit[tid] = (rayData.w > 0.0) ? 1.0 : 0.0;
        sharedActive[tid] = 1.0;

        // Luminance for variance computation
        float lum = dot(rayData.rgb, vec3(0.2126, 0.7152, 0.0722));
        sharedLum[tid] = lum;
        sharedLumSq[tid] = lum * lum;
        // [P4] 存逐射线数据供归约后的 SH2 重建误差评估。
        sharedRayDir[tid] = rayDir;
        sharedRayRad[tid] = rayData.rgb;
    } else {
        // Miss: contribute nothing
        sharedSH[0][tid] = vec3(0.0);
        sharedSH[1][tid] = vec3(0.0);
        sharedSH[2][tid] = vec3(0.0);
        sharedSH[3][tid] = vec3(0.0);
        sharedWeight[tid] = 0.0;
        sharedLum[tid] = 0.0;
        sharedLumSq[tid] = 0.0;
        sharedHit[tid] = 0.0;
        sharedActive[tid] = 0.0;
        sharedRayDir[tid] = vec3(0.0);
        sharedRayRad[tid] = vec3(0.0);
        sharedErrSum[tid] = vec3(0.0);
    }

    barrier();

    // Parallel reduction (log2(64) = 6 steps)
    for (uint stride = AVG_TG_SIZE >> 1; stride > 0u; stride >>= 1u) {
        if (tid < stride) {
            sharedSH[0][tid] += sharedSH[0][tid + stride];
            sharedSH[1][tid] += sharedSH[1][tid + stride];
            sharedSH[2][tid] += sharedSH[2][tid + stride];
            sharedSH[3][tid] += sharedSH[3][tid + stride];
            sharedWeight[tid] += sharedWeight[tid + stride];
            sharedLum[tid]    += sharedLum[tid + stride];
            sharedLumSq[tid]  += sharedLumSq[tid + stride];
            sharedHit[tid]    += sharedHit[tid + stride];
            sharedActive[tid] += sharedActive[tid + stride];
        }
        barrier();
    }

    // [P4 2026-09-21] SH2 重建误差（重代入代理）：SH 归约完成后，每条射线
    // 用最终 SH2 沿自身方向重建亮度，与射线亮度取 |Δ| 等权累计。SH 归一化
    // 与 tid==0 写出路径一致（sumScale 同式重算）。
    if (constants.sh2CheckMode > 0u) {
        const float effRaysC =
            (constants.tier3Mode > 0u && constants.tierRaysMode > 0u)
                ? max(sharedActive[0], 1.0) : float(constants.raysPerProbe);
        const float sumScaleC = 12.566370614 / effRaysC;
        const vec4 Yc = shBasis(sharedRayDir[tid]);
        const vec3 recon = (sharedSH[0][0] * Yc.x + sharedSH[1][0] * Yc.y
                         + sharedSH[2][0] * Yc.z + sharedSH[3][0] * Yc.w) * sumScaleC;
        const float dLumRaw = abs(dot(recon, vec3(0.2126, 0.7152, 0.0722))
                                - dot(sharedRayRad[tid], vec3(0.2126, 0.7152, 0.0722)));
        // [P4 实测修正 2026-09-21] WRC 逃逸/回退腿可产出 NaN radiance
        //（max(NaN,0) 不消毒）——统计里把非有限差计 0（NaN 污染本身已由
        // far-cache meanLum 3390/NaN P95 记录在案，根治属 radiance 卫生专项）。
        const float dLum = (isnan(dLumRaw) || isinf(dLumRaw)) ? 0.0 : dLumRaw;
        sharedErrSum[tid] = (sharedActive[tid] > 0.0) ? vec3(dLum, 1.0, 0.0) : vec3(0.0);
        barrier();
        for (uint stride = AVG_TG_SIZE >> 1; stride > 0u; stride >>= 1u) {
            if (tid < stride) sharedErrSum[tid] += sharedErrSum[tid + stride];
            barrier();
        }
    }

    // Thread 0 writes the final SH coefficients + multi-factor confidence
    if (tid == 0u) {
        uint base = group_id * 4u;
        float hitCount = sharedHit[0];
        float totalWeight = sharedWeight[0];
        const float activeCount = sharedActive[0];

        // 2026-09-17 P1（probe-selection-density-audit §6.3）：valid 与几何命中
        // 解耦。旧门 totalWeight>0 && hitCount>0 会把"全部射线 miss 几何但拿到
        // 合法天空/回退辐射"的探针整格清零（w≠0 的 miss 样本本就已进下面的
        // SH 累加器）。有效性 = 存在任一已分类样本（activeCount）；几何命中
        // 比例降级为 confidence 的来源可靠性因子——见下。
        if (totalWeight > 0.0 && activeCount > 0.0) {
            // Both modes store canonical radiance SH. No division by the
            // observed cosine-weight sum: that destroys the integral scale.
            // P4: tier-gated slots trace only the leading rays, so the 4π/N
            // factor uses the participating lane count there; the default
            // path keeps the exact raysPerProbe divisor (bit-identical).
            float effRays = float(constants.raysPerProbe);
            if (constants.tier3Mode > 0u && constants.tierRaysMode > 0u) {
                effRays = max(activeCount, 1.0);
            }
            const float sumScale = 12.566370614 / effRays;

            // Geometry-hit ratio: how many rays hit geometry directly (the
            // rest carry sky or DDGI-fallback radiance — valid but borrowed).
            float hitRatio = hitCount / effRays;

            // Radiance variance: Var(X) = E[X^2] - E[X]^2
            float avgLum = (activeCount > 0.0) ? (sharedLum[0] / activeCount) : 0.0;
            float avgLumSq = (activeCount > 0.0) ? (sharedLumSq[0] / activeCount) : 0.0;
            float lumVariance = max(avgLumSq - avgLum * avgLum, 0.0);

            // Multi-factor confidence. The old exp(-4*variance) collapsed to
            // ~0 exactly where incoming light VARIES (windows, emitters,
            // colour-bleeding gradients), handing those pixels back to the
            // coarser DDGI and erasing SPGI's sharpest contributions. Variance
            // now only shades the confidence between 0.55 and 1.0.
            float radianceConsistency = mix(0.55, 1.0, exp(-lumVariance * 4.0));

            // 来源可靠性分级：几何命中线性抬升到 1；纯 fallback（天空解析/
            // DDGI 借来辐射）地板 = constants.skyConfFloor（[②K-4] 默认
            // 0.18，旧 0.35）——非零才能通过 Gather 的 sh0w>0 门；降档后
            // 纯天空探针在 gather 混合中让位给几何命中探针（能量所有权：
            // 天空 fill 只在确实看得见天的邻域起主导）。
            float confidence = mix(constants.skyConfFloor, 1.0, hitRatio) * radianceConsistency;

            probeSHOut.data[base + 0u] = vec4(sharedSH[0][0] * sumScale, confidence);
            probeSHOut.data[base + 1u] = vec4(sharedSH[1][0] * sumScale, 1.0);
            probeSHOut.data[base + 2u] = vec4(sharedSH[2][0] * sumScale, 1.0);
            probeSHOut.data[base + 3u] = vec4(sharedSH[3][0] * sumScale, 1.0);
        } else {
            probeSHOut.data[base + 0u] = vec4(0.0, 0.0, 0.0, 0.0);
            probeSHOut.data[base + 1u] = vec4(0.0, 0.0, 0.0, 0.0);
            probeSHOut.data[base + 2u] = vec4(0.0, 0.0, 0.0, 0.0);
            probeSHOut.data[base + 3u] = vec4(0.0, 0.0, 0.0, 0.0);
        }
        // [P4] 误差统计写出（{Σ|Δ|, 样本数, active, 0}；disabled 时缓冲为
        // dummy，不写）。
        if (constants.sh2CheckMode > 0u) {
            sh2Check.data[group_id] = vec4(sharedErrSum[0].x, sharedErrSum[0].y,
                                           sharedActive[0], 0.0);
        }
        // [②K-4] 每探针天空可见性：miss 占比（天空/回退）+ 命中占比。
        {
            const float activeC = sharedActive[0];
            const float hitC = sharedHit[0];
            const float missC = max(activeC - hitC, 0.0);
            const float denom = max(activeC, 1.0);
            probeOpenSky.data[group_id] = vec4(missC / denom, hitC / denom, 0.0, 1.0);
        }
    }
}
