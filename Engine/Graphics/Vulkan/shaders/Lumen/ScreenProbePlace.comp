#version 450 core
// Vulkan Lumen Screen Probe GI — Place. Hand-written GLSL port of
// ScreenProbePlace.metal (entry: screen_probe_place).
//
// Places probes on a uniform screen-space grid. Each probe samples the
// GBuffer depth/normal at its center to determine its world position. Sky
// pixels (depth ~0 or very far) are marked inactive (w = 0).
//
// ThreadGroupSize: (64, 1, 1), 1D dispatch.
//
// Flat descriptor bindings (Vulkan — no overlapping Metal namespaces):
//   binding 0 = texture2D   depthTexture  (sampled, texelFetch nearest)
//   binding 1 = texture2D   normalTexture (sampled, texelFetch nearest)
//   binding 2 = SSBO write  probePositions[]
//   binding 3 = SSBO write  probeNormals[]
//   binding 4 = UBO         ScreenProbeGlobalData (352B, inline)
//
// Metal buffer mapping note: Metal uses buffer(0)/buffer(1) for positions/
// normals, buffer(3) for global (skips buffer(2)). Vulkan flat layout:
// depth=0, normal=1, positions=2, normals=3, global=4.

#extension GL_EXT_samplerless_texture_functions : enable
#extension GL_GOOGLE_include_directive : require

// F5 (M7): per-probe jitter helpers (spgiJitterOffset01).
#include "ShaderLib/EncodeLib.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// --------------------------------------------------------------------------------
// Bindings (flat)
// --------------------------------------------------------------------------------
layout(set = 0, binding = 0) uniform texture2D depthTexture;
layout(set = 0, binding = 1) uniform texture2D normalTexture;

layout(set = 0, binding = 2, std430) writeonly buffer ProbePositionsBlock {
    vec4 data[];
} probePositions;

layout(set = 0, binding = 3, std430) writeonly buffer ProbeNormalsBlock {
    vec4 data[];
} probeNormals;

// ScreenProbeGlobalData UBO — 352 bytes, mirrors C++ struct.
// Declared inline per established pattern (see SSAOTrace.comp).
layout(set = 0, binding = 4, std140) uniform GlobalBlock {
    mat4 view_projection;
    mat4 inv_view_projection;
    vec4 camera_position;
    vec4 grid_params;            // x=gridW, y=gridH, z=downsample, w=raysPerProbe
    vec4 trace_params;           // x=maxRayDist, y=gatherRadius, z=renderW, w=renderH
    vec4 sdf_origins[3];
    vec4 sdf_voxel_sizes[3];
    vec4 sdf_extents[3];
    uvec4 sdf_resolutions;       // xyz=res0/1/2, w=cascadeCount
    vec4 surface_cache_params;   // x=atlasSize, y=cardCount, z=available, w=jitter_max_world (F5)
    vec4 hzb_params;             // declared for offset parity (unused here)
    vec4 cache_params;           // F4: z = adaptive_pos_error threshold (0 → legacy variance test)
} global;

// --------------------------------------------------------------------------------
// Helper: reconstruct world position from depth + invViewProj
// (ported from ScreenProbePlace.metal:reconstructWorldPos)
// --------------------------------------------------------------------------------
vec3 reconstructWorldPos(vec2 uv, float depth, mat4 invVP) {
    // NDC coordinates [-1, 1]
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    vec4 clipPos = vec4(ndc, depth, 1.0);
    vec4 worldPos = invVP * clipPos;
    return worldPos.xyz / worldPos.w;
}

// --------------------------------------------------------------------------------
// Main
// --------------------------------------------------------------------------------
void screen_probe_place() {
    uint global_id = gl_GlobalInvocationID.x;

    uint gridW = uint(global.grid_params.x);
    uint gridH = uint(global.grid_params.y);
    uint totalProbes = gridW * gridH;

    if (global_id >= totalProbes) return;

    // Compute 2D grid coordinates from 1D index
    uint gx = global_id % gridW;
    uint gy = global_id / gridW;

    float downsample = global.grid_params.z;
    float renderW = global.trace_params.z;
    float renderH = global.trace_params.w;

    uint probeIdx = global_id;

    // Screen-space center of this probe
    vec2 pixelCenter = vec2(gx * downsample + downsample * 0.5,
                            gy * downsample + downsample * 0.5);

    // ------------------------------------------------------------------
    // F5 (M7) per-frame position jitter: quarter-cell screen offset,
    // world-space clamped so the Temporal pass's position-consistency gate
    // (posThreshold) never rejects a probe solely because it moved by the
    // jitter. camera_position.w = frame seed (< 0 disables);
    // surface_cache_params.w = jitter_max_world (<= 0 disables).
    // Read budget: +1 depth (center) + up to +1 resampled depth on the rare
    // clamp path — worst case 13 device reads/thread, within the 32 cap.
    // ------------------------------------------------------------------
    float frameSeed = global.camera_position.w;
    float jitterMaxWorld = global.surface_cache_params.w;
    vec2 jitterPx = (frameSeed >= 0.0 && jitterMaxWorld > 0.0)
        ? spgiJitterOffset01(probeIdx, frameSeed) * (downsample * 0.25)
        : vec2(0.0);

    vec2 pixel = pixelCenter + jitterPx;

    // UV coordinates [0, 1]
    vec2 uv = pixel / vec2(renderW, renderH);

    // Sample depth with POINT filtering — linear interpolation on depth
    // produces ghost values at object edges, creating floating probes.
    ivec2 depthTexel = ivec2(clamp(uv * vec2(renderW, renderH),
                                   vec2(0.0), vec2(renderW - 1.0, renderH - 1.0)));
    float depth = texelFetch(depthTexture, depthTexel, 0).r;

    // World-space amplitude clamp: nearby surfaces turn a few pixels of
    // screen offset into a large world offset — shrink the jitter (and
    // re-sample) so it stays under the temporal gate budget.
    if (jitterPx != vec2(0.0)) {
        ivec2 centerTexel = ivec2(clamp(pixelCenter,
                                        vec2(0.0), vec2(renderW - 1.0, renderH - 1.0)));
        float depthC = texelFetch(depthTexture, centerTexel, 0).r;
        vec3 worldC = reconstructWorldPos(pixelCenter / vec2(renderW, renderH),
                                          depthC, global.inv_view_projection);
        vec3 worldJ = reconstructWorldPos(uv, depth, global.inv_view_projection);
        float delta = distance(worldC, worldJ);
        if (delta > jitterMaxWorld) {
            pixel = pixelCenter + jitterPx * (jitterMaxWorld / max(delta, 1e-5));
            uv = pixel / vec2(renderW, renderH);
            depthTexel = ivec2(clamp(pixel,
                                     vec2(0.0), vec2(renderW - 1.0, renderH - 1.0)));
            depth = texelFetch(depthTexture, depthTexel, 0).r;
        }
    }

    // Check for sky / far plane ('active' is a GLSL reserved word -> use isActive)
    bool isActive = (depth > 0.0001 && depth < 0.999);

    // ------------------------------------------------------------------
    // T5.3 two-level adaptive grid + F4 (M7) refinement: checkerboard
    // coarse tier always active; fine-tier activation driven by the UE-style
    // interpolation-failure test — reconstruct the center's world position
    // by bilinear blend of the 4 edge-neighbor COARSE probes' depth-
    // reprojected positions; a large error means the bilinear Gather
    // reconstruction would be wrong here. cache_params.z <= 0 falls back to
    // the T5.3 depth/normal variance heuristic.
    // Read budget: F4 path 4 depth fetches (legacy path: 8) — worst case
    // with jitter 13 device reads/thread, within the 32 cap.
    // ------------------------------------------------------------------
    if (isActive && ((gx + gy) & 1u) != 0u) {
        bool highVariance;
        float posErrThresh = global.cache_params.z;
        if (posErrThresh > 0.0) {
            vec3 posC = reconstructWorldPos(uv, depth, global.inv_view_projection);
            ivec2 maxTexel = ivec2(int(renderW) - 1, int(renderH) - 1);
            ivec2 ncell[4] = ivec2[4](ivec2(gx - 1, gy), ivec2(gx + 1, gy),
                                      ivec2(gx, gy - 1), ivec2(gx, gy + 1));
            bool interpFailed = false;
            vec3 acc = vec3(0.0);
            float wsum = 0.0;
            for (int i = 0; i < 4; ++i) {
                ivec2 cc = ncell[i];
                if (cc.x < 0 || cc.y < 0 || cc.x >= int(gridW) || cc.y >= int(gridH)) continue;
                ivec2 tex = clamp(ivec2(cc.x * int(downsample) + int(downsample) / 2,
                                        cc.y * int(downsample) + int(downsample) / 2),
                                  ivec2(0), maxTexel);
                float d = texelFetch(depthTexture, tex, 0).r;
                if (d <= 0.0001 || d >= 0.999) {
                    // Sky/invalid coarse neighbor — interpolation cannot be
                    // trusted across a depth discontinuity: activate.
                    interpFailed = true;
                    break;
                }
                vec2 uvN = (vec2(tex) + 0.5) / vec2(renderW, renderH);
                acc += reconstructWorldPos(uvN, d, global.inv_view_projection) * 0.25;
                wsum += 0.25;
            }
            if (!interpFailed && wsum > 0.0) {
                // Partial neighborhoods (screen edge) loosen the threshold
                // proportionally to the missing weight.
                float scale = 1.0 + (1.0 - wsum);
                interpFailed = distance(acc / wsum, posC) > posErrThresh * scale;
            }
            highVariance = interpFailed || (wsum <= 0.0);
        } else {
            vec3 nC = texelFetch(normalTexture, depthTexel, 0).rgb;
            nC = normalize(nC * 2.0 - 1.0);
            float dMin = depth, dMax = depth;
            float minNDot = 1.0;
            ivec2 halfBlock = ivec2(int(downsample) / 2);
            ivec2 cardinals[4] = ivec2[4](
                depthTexel + ivec2(halfBlock.x, 0),
                depthTexel - ivec2(halfBlock.x, 0),
                depthTexel + ivec2(0, halfBlock.y),
                depthTexel - ivec2(0, halfBlock.y));
            ivec2 maxTexel = ivec2(int(renderW) - 1, int(renderH) - 1);
            for (int i = 0; i < 4; ++i) {
                ivec2 t = clamp(cardinals[i], ivec2(0), maxTexel);
                float d = texelFetch(depthTexture, t, 0).r;
                dMin = min(dMin, d); dMax = max(dMax, d);
                vec3 n = texelFetch(normalTexture, t, 0).rgb;
                n = normalize(n * 2.0 - 1.0);
                minNDot = min(minNDot, dot(nC, n));
            }
            // Depth range in [0,1] NDC + normal deviation drive the fine tier.
            highVariance = (dMax - dMin > 0.0015) || (minNDot < 0.8);
        }
        if (!highVariance) isActive = false;
    }

    if (!isActive) {
        // Mark as inactive: position = (0,0,0,0), normal = (0,0,0,0)
        probePositions.data[probeIdx] = vec4(0.0, 0.0, 0.0, 0.0);
        probeNormals.data[probeIdx]   = vec4(0.0, 0.0, 0.0, 0.0);
        return;
    }

    // Reconstruct world position
    vec3 worldPos = reconstructWorldPos(uv, depth, global.inv_view_projection);

    // Sample normal (world-space, encoded as N*0.5+0.5). Metal used a linear
    // sampler; texelFetch nearest is acceptable for normals here.
    vec3 normal = texelFetch(normalTexture, depthTexel, 0).rgb;
    normal = normalize(normal * 2.0 - 1.0);

    // Write outputs: w = 1.0 = active flag
    probePositions.data[probeIdx] = vec4(worldPos, 1.0);
    probeNormals.data[probeIdx]   = vec4(normal, 1.0);
}
