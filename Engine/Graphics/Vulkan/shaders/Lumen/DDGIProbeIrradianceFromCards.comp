#version 450 core
// Vulkan Lumen DDGI Probe Irradiance From Cards — GLSL port of
// DDGIProbeIrradianceFromCards.metal. Entry point: ddgi_probe_irradiance_from_cards
//   (glslangValidator --source-entrypoint main -e ddgi_probe_irradiance_from_cards)
//
// Projects pre-computed card radiance contributions onto DDGI probe SH.
//
// Reads per-probe contribution lists (pre-computed on CPU) containing card
// indices and SH projection weights, then multiplies by per-card radiance (from
// DDGICardRadianceAvg) to produce updated probe irradiance SH coefficients.
//
// SC-first hierarchy (Lumen-like sparse cache): the surface-cache projection
// is the PRIMARY feed for probe irradiance; the SDF ray trace result (Path A,
// already in the output buffer) fills in proportionally to how thin the SC
// coverage is. Coverage = assigned-card count × per-card atlas validity.
//
// All 9 SH bands (L0-L2) are projected and written; projection signs match
// DDGIUpdateIrradiance's basis.
//
// Dispatch: (ProbeCountTotal, 1, 1), threadGroupSize = (64, 1, 1)
//
// Flat bindings (Vulkan forbids Metal's overlapping texture/buffer namespaces):
//   binding 0 = UniformBuffer       DDGIVolumeData (336 bytes, inline)
//   binding 1 = readonly buffer     ProbeContribRange ranges[]
//   binding 2 = readonly buffer     ProbeCardContrib contribs[]
//   binding 3 = readonly buffer     vec4 card_radiance[] (per card block;
//                                                        16 blocks/card)
//   binding 4 = readonly buffer     vec4 irradiance_history[] (9 vec4/probe)
//   binding 5 = buffer vec4         irradiance_output[] (9 vec4/probe, write)
//   binding 6 = readonly buffer     vec4 probe_confidence[] (Phase 3 置信门)
//   binding 7 = UniformBuffer        ScInjectParams（注入模式，Phase 3 二轮）

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// --------------------------------------------------------------------------------
// DDGIVolumeData UBO — byte-for-byte match with C++ LumenDDGIPass.h
// DDGIVolumeData (336 bytes). Copied inline from DDGITraceRays.comp (the WGSL
// struct has array<vec4,3> fields that naga emits as spvUnsafeArray, which
// MoltenVK rejects — so all DDGI GLSL ports declare the struct inline).
// std140: vec4 = 16B, float/uint/int = 4B, vec4[3] = 48B (no per-element pad).
// --------------------------------------------------------------------------------
layout(set = 0, binding = 0, std140) uniform DDGIVolumeData {
    vec4  ProbeOrigin;              //   0
    float ProbeSpacing;             //  16
    float _pad_before_counts_0;     //  20
    float _pad_before_counts_1;     //  24
    float _pad_before_counts_2;     //  28
    uvec4 ProbeCounts;              //  32
    uint  RaysPerProbe;             //  48
    uint  ProbeCountTotal;          //  52
    float IrradianceBlurSigma;      //  56
    float DepthBlurSigma;           //  60
    float DeltaTime;                //  64
    uint  FrameIndex;               //  68
    float RayMaxDistance;           //  72
    float ProbeHysteresis;          //  76
    float TemporalAlpha;            //  80
    uint  ProbeUpdateCount;         //  84
    uint  SCLookupCount;            //  88  (Surface Cache card lookup count)
    uint  SCAtlasSize;              //  92  (Surface Cache lighting atlas size)
    int   ProbeRelocationShiftX;    //  96
    int   ProbeRelocationShiftY;    // 100
    int   ProbeRelocationShiftZ;    // 104
    float _pad_to_sdf;              // 108
    vec4  SdfOrigins[3];            // 112
    vec4  SdfVoxelSizes[3];         // 160
    vec4  SdfExtents[3];            // 208
    uvec4 SdfResolutionsAndCount;   // 256
    vec4  LightDirection;           // 272
    vec4  LightColor;               // 288  (.w = intensity)
    vec4  SkyColor;                 // 304  (Mode 11)
    vec4  Albedo;                   // 320  (Mode 11)
} volume;

// --------------------------------------------------------------------------------
// SSBO structs (std430). The Lumen surface-cache module is currently a stub on
// the C++ side, so these layouts are the canonical Vulkan contract: padded to
// 16/32 bytes per std430 rules for array element alignment.
// --------------------------------------------------------------------------------

// ProbeContribRange — 8 bytes. In std430 a scalar-only struct has 4-byte
// alignment, so the array stride matches the C++ {u32 start,u32 count} ABI.
struct ProbeContribRange {
    uint start;
    uint count;
};

// ProbeCardContrib — 40 bytes tight: card_index + 9 SH weights, all scalars so
// the std430 array stride is exactly 40B. This matches the C++
// SCProbeCardContrib byte-for-byte (the previous 32B-padded declaration
// desynced from the 20B C++ struct and misread every element after the first).
struct ProbeCardContrib {
    uint  card_index;   //  0
    float w[9];         //  4..39  (4 + 36 = 40 bytes total, no tail pad)
};

layout(set = 0, binding = 1, std430) readonly buffer RangeBuffer {
    ProbeContribRange ranges[];
};

layout(set = 0, binding = 2, std430) readonly buffer ContribBuffer {
    ProbeCardContrib contribs[];
};

// Per-block radiance from DDGICardRadianceAvg (xyz = radiance, w = coverage).
layout(set = 0, binding = 3, std430) readonly buffer CardRadianceBuffer {
    vec4 card_radiance[];
};

// Previous-frame probe irradiance SH (9 vec4 per probe: L0 + L1 + L2).
layout(set = 0, binding = 4, std430) readonly buffer IrradianceHistoryBuffer {
    vec4 irradiance_history[];
};

// Output probe irradiance SH (9 vec4 per probe). Path A (SDF ray trace) already
// wrote this frame's L0+L1+L2 here; this shader rewrites L0+L1 only.
layout(set = 0, binding = 5, std430) buffer IrradianceOutputBuffer {
    vec4 irradiance_output[];
};

// Phase 3（GI 能量所有权修复 P2）: per-probe confidence（float4：hitRatio/
// stability/visibility/convergence）。[3] = convergence 0→1 ramp（每次更新
// +1/30，UpdateIrradiance 写）——注入置信门的置信源。C++ 端 env 回滚或
// DDGI confidence 无效时绑零 stand-in（settled=0 = 旧式恒档）。
layout(set = 0, binding = 6, std430) readonly buffer ConfidenceBuffer {
    vec4 probe_confidence[];
};

// 能量所有权修复（P2 二轮，2026-09-18 消融后）: 注入模式（CPU 经 env 下发）。
//   x = 0 legacy45（Phase 3 前恒 0.45）| 1 gate（Phase 3：settled→0.15 档）
//     | 2 coldstart（默认，见下方权重块）——注入定位收缩为初始化/恢复。
//   yzw 保留。std140 float4。
layout(set = 0, binding = 7, std140) uniform ScInjectParams {
    vec4 sc_inject;
};

// --------------------------------------------------------------------------------
// Main
// --------------------------------------------------------------------------------
void ddgi_probe_irradiance_from_cards() {
    uint probeIdx = gl_GlobalInvocationID.x;
    if (probeIdx >= volume.ProbeCountTotal) return;

    ProbeContribRange range = ranges[probeIdx];

    // Accumulate full L0-L2 SH from card contributions.
    vec3 sh[9];
    for (uint i = 0u; i < 9u; ++i) sh[i] = vec3(0.0);

    uint n = min(range.count, 12u);
    float validSum = 0.0;
    uint validCount = 0u;
    for (uint i = 0u; i < n; ++i) {
        ProbeCardContrib c = contribs[range.start + i];
        vec4 cr = card_radiance[c.card_index];
        // Reject blocks with no captured texels; CPU block selection alone is
        // not evidence that this portion of the card carries transport.
        if (cr.w <= 0.0) continue;
        validCount += 1u;
        vec3 radiance = cr.xyz;
        validSum += cr.w;   // per-card atlas coverage (0..1, from CardRadianceAvg)
        for (uint b = 0u; b < 9u; ++b)
            sh[b] += c.w[b] * radiance;
    }

    uint base = probeIdx * 9u;
    float alpha = volume.ProbeHysteresis;
    // CPU weights already integrate capped solid angle (no extra 4pi).
    // Match the trace path's SH L0 safety range; the legacy gate at 4
    // clipped legitimate HDR cards and permanently discarded their scale.
    const float SC_L0_GATE = 64.0;
    {
        float l0mag = length(sh[0]);
        if (l0mag > SC_L0_GATE) {
            float s = SC_L0_GATE / l0mag;
            for (uint i = 0u; i < 9u; ++i) sh[i] *= s;
        }
    }
    vec3 sh0 = sh[0];
    float l1Limit = max(length(sh0) * 3.0, 0.1);
    float l2Limit = max(length(sh0) * 2.0, 0.1);

    // Step 1: SC-filtered results — temporal blend with history + energy
    // clamps mirroring DDGIUpdateIrradiance (L0 <= 64, L1 <= 3|L0|, L2 <= 2|L0|).
    vec3 scResult[9];
    for (uint i = 0u; i < 9u; ++i) {
        vec3 history = irradiance_history[base + i].xyz;
        uvec3 bits = floatBitsToUint(history);
        if (((bits.x | bits.y | bits.z) & 0x7F800000u) == 0x7F800000u)
            history = vec3(0.0);

        vec3 filtered = mix(history, sh[i], alpha);
        float limit = (i == 0u) ? 64.0 : ((i < 4u) ? l1Limit : l2Limit);
        float mag = length(filtered);
        if (mag > limit) filtered *= limit / mag;
        scResult[i] = filtered;
    }

    // Step 2: Path A result (SDF ray trace already wrote to output this frame).
    vec3 pathA[9];
    for (uint i = 0u; i < 9u; ++i) {
        pathA[i] = irradiance_output[base + i].xyz;
    }

    // Step 3: trace-first blend. The card-average path is occlusion-unaware
    // and low-frequency (one radiance per whole card, solid-angle weighted
    // with no visibility) — at the old 0.85 takeover it washed the field
    // flat (measured: 326/407 cards converging to a uniform ~1.0, killing
    // the sun-patch/shade contrast). Path A samples the SC lighting atlas
    // per hit texel through the high-res offline SDF, so it keeps authority;
    // the card average now only stabilizes the low-frequency floor (cap 0.45)
    // and still fills where SC coverage is thin (countCoverage).
    float countCoverage = clamp(float(validCount) / 6.0, 0.0, 1.0);
    float validCoverage = (validCount > 0u) ? clamp(validSum / float(validCount), 0.0, 1.0) : 0.0;
    float scLum = dot(scResult[0], vec3(0.2126, 0.7152, 0.0722));
    // 2026-09-18 消融（quality-issues-diagnosis.md）: pathA 的原始亮度（未
    // 夹 1e-4）另存——coldstart 模式用"pathA 是否存在供给"判恢复档。
    float rawPathLum = dot(pathA[0], vec3(0.2126, 0.7152, 0.0722));
    float pathLum = max(rawPathLum, 1e-4);
    float agree = smoothstep(0.0, 1.0, scLum / pathLum);
    // SC 注入 = initialization / low-confidence recovery，不是常开供给。
    // 模式（sc_inject.x，CPU 下发）:
    //   legacy45 — Phase 3 前恒 0.45（env 回滚 PRIMAL_SC_INJECT_SETTLED=0）；
    //   gate     — Phase 3：已收敛降 0.15 档；
    //   coldstart（默认）— 已收敛探针注入归零（E2 逐射线采样拥有收敛场；
    //       消融证明常开注入的 occlusion-unaware 卡片均值会把阴影区探针
    //       钉死在穿墙能量上，且非本帧 traced 探针的 0.85/0.15 重混会让
    //       全场漂向卡片均值），仅 rawPathLum≈0（pathA 无供给）时保留
    //       0.15 低频恢复；未收敛探针保留 0.45 初始化档。
    const float SC_TAKEOVER_MAX = 0.45;
    const float SC_SETTLED_FLOOR = 0.15;
    float convergence = probe_confidence[gl_GlobalInvocationID.x][3];
    float settled = smoothstep(0.5, 1.0, convergence);
    const float injectBase = countCoverage * validCoverage;
    float scWeight;
    if (sc_inject.x < 0.5) {
        scWeight = injectBase * SC_TAKEOVER_MAX * agree;
    } else if (sc_inject.x < 1.5) {
        scWeight = injectBase * agree * mix(SC_TAKEOVER_MAX, SC_SETTLED_FLOOR, settled);
    } else {
        float settledWeight = (rawPathLum <= 1e-3) ? SC_SETTLED_FLOOR : 0.0;
        scWeight = injectBase * agree * mix(SC_TAKEOVER_MAX, settledWeight, settled);
    }

    for (uint i = 0u; i < 9u; ++i) {
        vec3 blended = mix(pathA[i], scResult[i], scWeight);
        vec4 prev = irradiance_output[base + i];
        irradiance_output[base + i] = vec4(blended, prev.w);
    }
}
