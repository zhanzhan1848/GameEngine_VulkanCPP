// fibonacciDirection / orientAroundNormalTBN (was orientAroundNormal) moved
// to ShaderLib/EncodeLib.glsl (axis refactor X1) — identical body, so the
// finalize kernel still reconstructs the exact same per-ray directions.

// ============================================================================
// [WRC] A3: 世界空间 radiance cache 消费（UE WSRC 语义：空间低分辨率 × 方向
// 高分辨率）。方向性保留到消费端——cos 加权 radiance 积分（lobe 指数 24
// ≈ 15° 有效瓣宽，覆盖 K=64 Fibonacci 格的 ~25° 方向间距）。
// 近邻探针采样（远场低频：空间插值的增益小于逐方向成本的代价）。
// 消费计数原子累加——A5 需求驱动预算的优先级数据源（探针 state 的
// bits[16..31] 语义在 WRC 侧独立维护，这里只 bump 独立计数缓冲）。
// ============================================================================
vec3 wrcSampleRadiance(vec3 stopPos, vec3 dir, out bool ok) {
    ok = false;
    if (global.wrc_fb[1].w <= 0.5) return vec3(0.0);
    const uint K = 64u;                     // kWRCDirsPerProbe
    const uint radStride = K * 2u;          // kWRCProbeRadianceStrideU32 [P2 SoA]
    vec3 org = global.wrc_fb[0].xyz;
    float spacing = max(global.wrc_fb[0].w, 0.01);
    ivec3 counts = ivec3(global.wrc_fb[1].xyz);
    vec3 gp = (stopPos - org) / spacing;
    vec3 gridMax = vec3(counts - ivec3(1));
    if (any(lessThan(gp, vec3(0.0))) || any(greaterThan(gp, gridMax))) return vec3(0.0);
    ivec3 c0 = clamp(ivec3(round(gp)), ivec3(0), counts - ivec3(1));
    uint pidx = uint(c0.x) + uint(counts.x) * (uint(c0.y) + uint(counts.y) * uint(c0.z));
    // [P2 SoA]: metaBase = probeTotal × K×2；meta 条目 +2 = state。
    const uint rbase = pidx * radStride;
    const uint metaBase = uint(counts.x) * uint(counts.y) * uint(counts.z) * radStride
                        + pidx * 4u;
    uint state = wrc_probe_data[metaBase + 2u];
    if ((state & 1u) == 0u || (state & 2u) != 0u) return vec3(0.0);   // 未收敛 / 入几何

    vec3 acc = vec3(0.0);
    float wSum = 0.0;
    for (uint k = 0u; k < K; ++k) {
        float y = 1.0 - 2.0 * (float(k) + 0.5) / float(K);
        float r = sqrt(max(1.0 - y * y, 0.0));
        float a = 2.399963229728653 * float(k);
        vec3 wk = vec3(cos(a) * r, y, sin(a) * r);
        float c = dot(wk, dir);
        if (c <= 0.25) continue;
        float w = c * c * c * c * c * c;    // c^6：K=64 的紧凑瓣（≈35° 有效带宽）
        uvec2 p = uvec2(wrc_probe_data[rbase + k * 2u], wrc_probe_data[rbase + k * 2u + 1u]);
        vec2 lo = unpackHalf2x16(p.x);
        vec2 hi = unpackHalf2x16(p.y);
        acc += vec3(lo.x, lo.y, hi.x) * w;
        wSum += w;
    }
    if (wSum <= 0.0) return vec3(0.0);
    vec3 r = acc / wSum;
    // [③radiance 卫生 2026-09-21] half 解码可产出 NaN/Inf（max(NaN,0) 不
    // 消毒，向下游 SH/ Average 传播）；同时 64 上限对齐 WRCUpdateRadiance
    // 的混合钳制（far-cache maxLum 3390 溯源）。
    if (any(isnan(r)) || any(isinf(r))) return vec3(0.0);
    ok = true;
    atomicAdd(wrc_consume[pidx], 1u);
    return min(r, vec3(64.0));
}


vec3 sampleBilinearRGB(texture2D tex, vec2 uv) {
    vec2 size = vec2(textureSize(tex, 0));
    vec2 px = uv * size - 0.5;
    ivec2 p0 = ivec2(floor(px));
    vec2 f = fract(px);

    ivec2 c00 = clamp(p0,               ivec2(0), ivec2(size) - 1);
    ivec2 c10 = clamp(p0 + ivec2(1, 0), ivec2(0), ivec2(size) - 1);
    ivec2 c01 = clamp(p0 + ivec2(0, 1), ivec2(0), ivec2(size) - 1);
    ivec2 c11 = clamp(p0 + ivec2(1, 1), ivec2(0), ivec2(size) - 1);

    vec3 s00 = texelFetch(tex, c00, 0).rgb;
    vec3 s10 = texelFetch(tex, c10, 0).rgb;
    vec3 s01 = texelFetch(tex, c01, 0).rgb;
    vec3 s11 = texelFetch(tex, c11, 0).rgb;

    vec3 a = mix(s00, s10, f.x);
    vec3 b = mix(s01, s11, f.x);
    return mix(a, b, f.y);
}

vec3 samplePrevFrameColorAt(vec2 uv) {
    return sampleBilinearRGB(prevFrameColor, uv);
}

vec3 samplePrevFrameColor(vec3 worldPos) {
    vec4 clipPos = global.view_projection * vec4(worldPos, 1.0);
    if (clipPos.w <= 0.0) return vec3(0.0);
    vec2 ndc = clipPos.xy / clipPos.w;
    vec2 uv = vec2(ndc.x * 0.5 + 0.5, 1.0 - ndc.y * 0.5 - 0.5);
    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) return vec3(0.0);
    return sampleBilinearRGB(prevFrameColor, uv);
}

// P1: 记录一条已完成分支处理的射线（diag mode 才执行）。
void spgiStatRecord(uint probeIdx, uint branch, vec3 radiance, float cosTheta) {
    if (global.diag_params.x < 0.5) return;
    uint gridW = max(uint(global.grid_params.x), 1u);
    uint gridH = max(uint(global.grid_params.y), 1u);
    float lum = dot(radiance, vec3(0.2126, 0.7152, 0.0722));
    uint lumQ = uint(clamp(lum, 0.0, 65535.0) * 64.0);
    uint cosQ = branch == 6u
        ? uint(clamp(cosTheta, 0.0, 4.0) * 16.0)
        : uint(clamp(cosTheta, 0.0, 1.0) * 32.0);
    uint col = min((probeIdx % gridW) * 4u / gridW, 3u);
    uint row = min((probeIdx / gridW) * 4u / gridH, 3u);
    uint bucket = 1u + col + row * 4u;   // bucket1 = 屏幕左上（拱顶热点 ROI）
    atomicAdd(spgi_stats[branch][0u].x, 1u);
    atomicAdd(spgi_stats[branch][0u].y, lumQ);
    atomicMax(spgi_stats[branch][0u].z, lumQ);
    atomicAdd(spgi_stats[branch][0u].w, cosQ);
    atomicAdd(spgi_stats[branch][bucket].x, 1u);
    atomicAdd(spgi_stats[branch][bucket].y, lumQ);
    atomicMax(spgi_stats[branch][bucket].z, lumQ);
    atomicAdd(spgi_stats[branch][bucket].w, cosQ);
}

void screen_probe_trace_finalize() {
    uint global_id = gl_GlobalInvocationID.x;
    uint gridW = uint(global.grid_params.x);
    uint gridH = uint(global.grid_params.y);
    uint raysPerProbe = uint(global.grid_params.w);

    // P2/P4: compacted slot indirection + per-slot tier gate (see HZB).
    // Tier-gated rays are zero-filled here (Average treats w == 0 as an
    // inactive lane); their hit_buffer entries are never consumed.
    uint probeIdx;
    uint rayIdx;
    if (global.tier_params.x > 0.5) {
        probeIdx = compactList.data[global_id / raysPerProbe];
        if (probeIdx == 0xFFFFFFFFu) {
            probeRadiance.data[global_id] = vec4(0.0, 0.0, 0.0, -1.0);
            return;
        }
        rayIdx = global_id % raysPerProbe;
        if (global.tier_params.w > 0.5 &&
            float(rayIdx) >= probeNormals.data[probeIdx].w) {
            probeRadiance.data[global_id] = vec4(0.0, 0.0, 0.0, 0.0);
            return;
        }
    } else {
        uint totalRays = gridW * gridH * raysPerProbe;
        if (global_id >= totalRays) return;
        probeIdx = global_id / raysPerProbe;
        rayIdx = global_id % raysPerProbe;
    }

    const uint zeroFlags=uint(global.surface_cache_params.w);
    vec4 posData = probePositions.data[probeIdx];
    vec4 normData = probeNormals.data[probeIdx];
    if (posData.w <= 0.0) {
        probeRadiance.data[global_id] = vec4(0.0, 0.0, 0.0, -1.0);
        return;
    }

    vec3 probePos = posData.xyz;
    vec3 probeNormal = normalize(normData.xyz);
    vec3 rayDir;
    float invNq = 1.0;   // F2 importance weight: cosθ/(N·q), 1 when disabled
    if (global.cache_params.y > 0.5) {
        // F2 (M7) 形态 c: importance resampling (see ScreenProbeTraceSDF.comp).
        uint hb = probeIdx * 4u;
        vec4 h0 = importanceSH.data[hb + 0u];
        vec4 h1 = importanceSH.data[hb + 1u];
        vec4 h2 = importanceSH.data[hb + 2u];
        vec4 h3 = importanceSH.data[hb + 3u];
        rayDir = spgiImportanceDirection(rayIdx, raysPerProbe, probeIdx,
                                         global.camera_position.w, probeNormal,
                                         h0.rgb, h1.rgb, h2.rgb, h3.rgb, invNq);
        rayDir = orientAroundNormalTBN(rayDir, probeNormal);
    } else {
        rayDir = fibonacciDirection(rayIdx, raysPerProbe);
        rayDir = spgiJitterRotation(probeIdx, global.camera_position.w) * rayDir;
        rayDir = orientAroundNormalTBN(rayDir, probeNormal);
    }
    // Keep this exactly in lockstep with ScreenProbeTraceSDF: the hit
    // distance is measured from the biased origin, so a mismatch would move
    // every SDF/SC hit during finalization.
    vec3 origin = probePos + probeNormal * global.sdf_voxel_sizes[0].x * 0.25;

    vec4 hit = hit_buffer.data[global_id];
    vec3 radiance = vec3(0.0);
    float cosTheta = 0.0;
    bool useWorldFallback = false;
    uint scRejectReason = 5u; // no validation path / unknown
    uint auditEvalCount = 0u, auditBounds = 0u, auditOrient = 0u, auditDepth = 0u;
    uint auditCardSlot = 0xFFFFFFFFu;
    if (global.diag_params.x > 5.5 && global.diag_params.x < 6.5) {
        uint px = probeIdx % gridW, py = probeIdx / gridW;
        uint sx = px == 260u ? 0u : (px == 285u ? 1u : (px == 310u ? 2u : 3u));
        uint sy = py == 82u ? 0u : (py == 112u ? 1u : (py == 138u ? 2u : 3u));
        if (global.hint_params.y > 0.5) {
            sx = px == 110u ? 0u : (px == 160u ? 1u : (px == 210u ? 2u : 3u));
            sy = py == 160u ? 0u : (py == 168u ? 1u : (py == 176u ? 2u : 3u));
        }
        uint sr = rayIdx == 0u ? 0u : (rayIdx == 12u ? 1u : (rayIdx == 24u ? 2u : (rayIdx == 36u ? 3u : 4u)));
        if (sx < 3u && sy < 3u && sr < 4u) auditCardSlot = (sy * 3u + sx) * 4u + sr;
    }
    // P1: 逐射线分支归因（0=HZB, 1=SC, 2=far-cache, 3=fallback/miss）
    uint statBranch = 3u;

    if (hit.w == 1.0) {
        // HZB near-field hit — sharp screen-space radiance at the hit UV.
        radiance = samplePrevFrameColorAt(hit.yz);
        if (any(isnan(radiance)) || any(isinf(radiance))) radiance = vec3(0.0);
        // P1-A: prev-frame color is the lit HDR scene color — it contains the
        // direct sun term (DIRECT_INTENSITY-scaled). Feeding it unattenuated
        // into probe radiance double-counts direct light and paints warm
        // blobs on probe vertices near sunlit geometry (the "yellow arch"
        // artifact). Apply the same bright penalty SSGITrace.comp uses for
        // its screen-space hits so indirect stays indirect.
        float hzbHitLum = dot(radiance, vec3(0.2126, 0.7152, 0.0722));
        // P1（reaudit §4.2）: diag mode 2 = HZB 去惩罚（raw 对照，量化该
        // 经验钳制对热点/整图的贡献）。0/1/3 维持默认。
        // [E0-B 2026-09-21] 亮度惩罚退役为 firefly 软限幅：膝点从 1.0 抬到
        // global.tier_counts.y（CPU env PRIMAL_SPGI_PENALTY_KNEE，默认 8.0）
        // ——lum<8 的合法中亮反弹（白地面→墙，L_o 2-8）全额通过，只有
        // lum>8 的 firefly/直射峰值被压。回滚 knee=1.0 即旧语义。
        if (global.diag_params.x < 1.5 || global.diag_params.x > 2.5) {
            radiance *= 1.0 / (1.0 + max(hzbHitLum - global.tier_counts.y, 0.0) * 2.0);
        }
        cosTheta = max(dot(probeNormal, rayDir), 0.0);
        statBranch = 0u;
    } else if (hit.w == 2.0) {
        // Coarse SDF hit: validate the surface-cache texel's captured position.
        vec3 hitPos = origin + rayDir * hit.x;
        // G2（2026-09-16）: 2b 在 hit_buffer.y 编码了命中点 SDF 梯度法线
        // （octEncode + packSnorm2x16；八面体编码返回 [0,1]²，snorm 域映射
        // 回 [-1,1]）。长度 <0.5 = 退化（级联外），不启朝向门。
        // diag_params.y = 门阈值（PRIMAL_SPGI_FACE_GATE：<0 关门；
        // 0.5 默认 / 0.0 仅拒异面）。
        vec3 hitNormalHint = vec3(0.0);
        {
            vec2 octS = unpackSnorm2x16(floatBitsToUint(hit.y));
            vec3 decoded = octDecode(clamp(octS * 0.5 + 0.5, vec2(0.0), vec2(1.0)));
            if (dot(decoded, decoded) > 0.25) hitNormalHint = decoded;
        }
        const float faceGate = global.diag_params.y;
        bool usedSurfaceCache = false;
        uint zeroOwner=0xffffffffu,zeroPrimitive=0xffffffffu;
        vec3 zeroN=vec3(0),zeroA=vec3(0),zeroE1=vec3(0),zeroE2=vec3(0);
        uint zeroStatus=0u;
        float firstT=-1.0;
        for(uint zeroAttempt=0u;zeroAttempt<3u;++zeroAttempt) {
        if(zeroAttempt==1u) {
            if(usedSurfaceCache || (zeroFlags&1u)==0u || hit.x!=0.0)break;
            zeroStatus=1u;
            int first=geometryFirstHit(origin,rayDir,0.00002,global.trace_params.x,firstT,zeroOwner,zeroPrimitive,zeroN,zeroA,zeroE1,zeroE2);
            zeroStatus=first<0?2u:(first==0?3u:4u);
            // Opaque first surfaces must face the incoming ray. Back faces and
            // uncertain winding keep the original estimate; do not skip them.
            if(first!=1 || dot(zeroN,zeroN)<0.5 || dot(zeroN,rayDir)>=0.0 || zeroOwner>=zeroOwners.data.length())break;
            uvec4 own=zeroOwners.data[zeroOwner];
            if(own.y!=1u || own.z!=zeroOwner || own.w!=uint(global.camera_position.w) || own.x>=zeroMaterials.data.length()/3u) {zeroStatus=5u;break;}
            if(zeroMaterials.data[own.x*3u+2u].w!=0u) {zeroStatus=6u;break;}
            if(global.cache_params.x>0. && firstT>global.cache_params.x) {zeroStatus=7u;break;}
            hitPos=origin+rayDir*firstT;hitNormalHint=zeroN;zeroStatus=8u;
        }


        if(zeroAttempt==2u) {
            if(usedSurfaceCache || zeroStatus!=8u || (zeroFlags&4u)==0u)break;
            if(zeroOwner>=cardLookup.data.length()/12u) {zeroStatus=12u;break;}
            uint db=cardLookup.data[zeroOwner*12u+10u],de=cardLookup.data[zeroOwner*12u+11u];
            if(db>de || de>cards.data.length() || de>uint(global.surface_cache_params.y)) {zeroStatus=12u;break;}
            zeroStatus=10u;
        }

        // A card projection only proves UV coverage, not surface identity.
        // Validate against captured geometry and choose the closest matching
        // surface, rather than the first card in the spatial bucket.
        if (global.surface_cache_params.z > 0.5 && (textureSize(surface_cache_depth, 0) == textureSize(surface_cache_lighting, 0))) {
            uvec4 gh0 = uvec4(scgo.sc_grid_offsets[0], scgo.sc_grid_offsets[1], scgo.sc_grid_offsets[2], scgo.sc_grid_offsets[3]);
            uvec4 gh1 = uvec4(scgo.sc_grid_offsets[4], scgo.sc_grid_offsets[5], scgo.sc_grid_offsets[6], scgo.sc_grid_offsets[7]);
            uvec4 gh2 = uvec4(scgo.sc_grid_offsets[8], scgo.sc_grid_offsets[9], scgo.sc_grid_offsets[10], scgo.sc_grid_offsets[11]);
            SCGridParams gp = scGridDecode(gh0, gh1, gh2);
            uint cell = scGridCellIndex(gp, hitPos);
            // C (plan §三.C): unified query contract (shared helper) — adds
            // the side-orientation test (captured face must front the incoming
            // ray; the old texel-error loop could flip between the two cards
            // of a two-sided wall) and decomposed along/perp tolerances to the
            // existing depth + min-error scheme. Valid black stays accepted.
            float bestKey = 1e30;
            // [①治理 2026-09-21] 逐射线结果分类（fail_stats[8..15]）：
            // 区分"候选级拒绝率"（受卡密度/单元格大小影响）与"射线级失败率"
            // （真正决定 transport 送达）。
            bool anyAccept = false, anyOrient = false, anyBounds = false, anyDepth = false;
            uint evalCount = 0u;
            const bool ownerRetry=zeroAttempt==2u;
            if (ownerRetry || cell != 0xFFFFFFFFu) {
                uint begin = ownerRetry?cardLookup.data[zeroOwner*12u+10u]:scgo.sc_grid_offsets[16u + cell];
                uint end = ownerRetry?cardLookup.data[zeroOwner*12u+11u]:scgo.sc_grid_offsets[17u + cell];
                for (uint gi = begin; gi < end; ++gi) {
                    uint ci = ownerRetry?gi:scgc.sc_grid_cards[gi];
                    vec3 candidate; float key;
                // 门阈值经 hint 缩放实现（SurfaceCacheData 的硬编码门
                // 是 n_true·hint < 0.5 拒绝）：k=0.5/T 使有效阈值=T。
                // T<0 → 零向量（门关）。[①治理] hint 错位软键惩罚：
                // tier_counts.z>0.5 时放行错位候选（key 加罚、码 7 计数），
                // 否则回旧硬拒绝语义（PRIMAL_SPGI_HINT_SOFT 默认关——
                // 软罚放大 found 3× 后与 SC↔probe 双稳态边界相互作用，
                // 780 帧间歇发散，见完工文档；单变量重开验证后再定默认）。
                vec3 hintForQuery = (faceGate < 0.0) ? vec3(0.0)
                                    : hitNormalHint * (0.5 / max(faceGate, 1e-3));
                const bool hintSoft = global.tier_counts.z > 0.5;
                    uint scReject = 0u;
                    atomicAdd(fail_stats[0], 1u);
                    ++evalCount;
                    SurfaceCacheCard queryCard = cards.data[ci];
                    if(zeroAttempt>=1u && queryCard.mesh_instance_id!=zeroOwner)continue;
                    const float queryTol = max(0.15, global.sdf_voxel_sizes[0].x * 1.25);
                    // Expand only the UV discovery domain.  The shared query
                    // still requires captured-depth along/perp agreement, so
                    // a clamped edge texel cannot validate unrelated geometry.
                    const float queryPad = min(queryTol, 0.45);

                    vec3 queryFacing = -rayDir;
                    float backsideTransport = 1.0;
                    bool transmissiveBackface = false;
                    if (dot(scCardFaceNormal(queryCard), queryFacing) >= 0.0) {
                        vec2 materialUV;
                        if (worldToCardUVMarginPad(hitPos, queryCard, materialUV,
                                1.0 / float(max(queryCard.resolution, 1u)), queryPad)) {
                            uvec2 materialTexel = uvec2(clamp(materialUV, vec2(0.0),
                                vec2(queryCard.atlas_offset_x + queryCard.resolution - 1u,
                                     queryCard.atlas_offset_y + queryCard.resolution - 1u)));
                            uint transportBits = uint(round(clamp(
                                texelFetch(surface_cache_albedo, ivec2(materialTexel), 0).a,
                                0.0, 1.0) * 255.0));
                            float transmission = float((transportBits >> 3u) & 0xFu) / 15.0;
                            float thickness = float(transportBits & 0x7u) / 7.0;
                            backsideTransport = transmission * exp(-2.0 * thickness);
                            transmissiveBackface = (transportBits & 0x80u) != 0u &&
                                                   backsideTransport > (1.0 / 255.0);
                        }
                        if (transmissiveBackface) queryFacing = rayDir;
                    }

                    bool candidateAccepted=scQueryCardCandidateDbg(queryCard,hitPos,queryFacing,queryTol,queryPad,surface_cache_depth,surface_cache_lighting,hintForQuery,candidate,key,scReject);
                    if (auditCardSlot != 0xFFFFFFFFu && gi - begin < 8u) {
                        audit_candidates[auditCardSlot][gi - begin] =
                            uvec4(ci, scReject, queryCard.mesh_instance_id,
                                  queryCard.axis_direction | (candidateAccepted ? 0x10000u : 0u));
                        vec4 metrics = vec4(-1.0);
                        vec2 auditUV;
                        if (worldToCardUVMarginPad(hitPos, queryCard, auditUV,
                                1.0 / float(max(queryCard.resolution, 1u)), queryPad)) {
                            uvec2 auditTexel = uvec2(clamp(auditUV, vec2(0.0),
                                vec2(queryCard.atlas_offset_x + queryCard.resolution - 1u,
                                     queryCard.atlas_offset_y + queryCard.resolution - 1u)));
                            float capturedDepth = texelFetch(surface_cache_depth,
                                ivec2(auditTexel), 0).r;
                            if (!isnan(capturedDepth) && !isinf(capturedDepth) && capturedDepth >= 0.0) {
                                vec3 delta = cardTexelToWorld(auditTexel, capturedDepth, queryCard) - hitPos;
                                vec3 face = scCardFaceNormal(queryCard);
                                float along = dot(delta, face);
                                float footprint = length(queryCard.extent.xyz) /
                                    float(max(queryCard.resolution, 1u));
                                metrics = vec4(capturedDepth, along,
                                               length(delta - face * along), queryTol + footprint);
                            }
                        }
                        audit_candidate_metrics[auditCardSlot][gi - begin] = metrics;
                    }
                    if(candidateAccepted && zeroAttempt>=1u) {
                        vec2 uv;candidateAccepted=worldToCardUVMarginPad(hitPos,queryCard,uv,1.0/float(max(queryCard.resolution,1u)),queryPad);
                        if(candidateAccepted) {
                            ivec2 px=ivec2(clamp(uv,vec2(0),vec2(queryCard.atlas_offset_x+queryCard.resolution-1u,queryCard.atlas_offset_y+queryCard.resolution-1u)));
                            float d=texelFetch(surface_cache_depth,px,0).r;
                            vec3 p=cardTexelToWorld(uvec2(px),d,queryCard);
                            uint transport=uint(round(clamp(texelFetch(surface_cache_albedo,px,0).a,0.,1.)*255.));
                            candidateAccepted=(transport&0x80u)!=0u && ((transport>>3u)&15u)==0u && !transmissiveBackface && zeroTrianglePoint(p,zeroA,zeroE1,zeroE2,zeroN);
                        }
                    }
                    if (candidateAccepted) {
                        // The atlas is spatial rather than directional.  A
                        // back-face read therefore gets an explicit material
                        // attenuation so front-side radiance cannot leak
                        // through a weakly transmissive cloth.
                        if (transmissiveBackface) candidate *= backsideTransport;
                        if (transmissiveBackface) atomicAdd(fail_stats[8], 1u);
                        // [①治理] 软罚候选被接受时 outReject 保留 7。
                        if (scReject == 7u) {
                            atomicAdd(fail_stats[7], 1u);
                            if (!hintSoft) {
                                // 硬模式（回滚位）：等价旧 G2 门——直接拒绝。
                                atomicAdd(fail_stats[2], 1u);
                                anyOrient = true;
                                ++auditOrient;
                                continue;
                            }
                        }
                        if (key < bestKey) {
                            bestKey = key;
                            radiance = candidate;
                            usedSurfaceCache = true;
                            if(zeroAttempt!=0u)zeroStatus=zeroAttempt==2u?11u:9u;
                        }
                    } else if (scReject == 1u) {
                        atomicAdd(fail_stats[1], 1u);
                        anyBounds = true;
                        ++auditBounds;
                    } else if (scReject == 2u) {
                        atomicAdd(fail_stats[2], 1u);
                        anyOrient = true;
                        ++auditOrient;
                    } else if (scReject == 7u) {
                        atomicAdd(fail_stats[7], 1u);   // hint 软罚计数（旧硬门会拒）
                        anyOrient = true;
                        ++auditOrient;
                    } else if (scReject >= 3u) {
                        atomicAdd(fail_stats[3], 1u);
                        anyDepth = true;
                        ++auditDepth;
                    }
                }
                auditEvalCount = evalCount;
                if (evalCount == 0u) atomicAdd(fail_stats[11], 1u);   // 空 cell
            } else {
                atomicAdd(fail_stats[11], 1u);   // cell 无效
            }
            if (usedSurfaceCache) {
                scRejectReason = 0u;
                atomicAdd(fail_stats[4], 1u);
                atomicAdd(fail_stats[9], 1u);    // 射线级 found
            } else if (evalCount > 0u) {
                // 射线级失败分类（优先级 orient > bounds > depth）
                if (anyOrient)      { atomicAdd(fail_stats[10], 1u); scRejectReason = 1u; }
                else if (anyBounds) { atomicAdd(fail_stats[13], 1u); scRejectReason = 2u; }
                else if (anyDepth)  { atomicAdd(fail_stats[14], 1u); scRejectReason = 3u; }
                else scRejectReason = 5u;
            } else {
                scRejectReason = 4u; // grid cell has no card candidate
            }
        }
        } // retry only after the original query failed
        if (!usedSurfaceCache) {
            // A coarse SDF hit has no matching raster-depth proof. Projecting
            // it into screen color can borrow sunlight from an occluder.
            // Use the existing world-probe estimate until a validated screen
            // hit (HZB) or a surface-cache card supplies this ray.
            useWorldFallback = true;
            if (global.diag_params.x > 0.5) {
                atomicAdd(fail_stats[hit.x <= global.sdf_voxel_sizes[0].x * 0.5 ? 12u : 15u], 1u);
            }
        }
        // [F2 2026-09-20 能量不对称修复 A3] SC 命中惩罚默认开——与 HZB 分支
        // 同式同阈（惩罚对称性）。三跑实测（配方 frame≤350，25 帧窗）：
        // SC 分支 meanLum 1.212（无惩罚）→ 0.182（惩罚），max 47.6→0.98，
        // 与 HZB 惩罚后 0.141 对称；全桶均匀 ~5-10× 压制（无选择性——
        // 压的是整体 SC 泵入）。回滚：PRIMAL_SPGI_SC_NOPENALTY=1（CPU 置
        // diag_params.w=1）。原 diag-only 语义（mode>2.5）作废。
        // [E0-B 2026-09-21] 惩罚退役为 firefly 软限幅（膝点 tier_counts.y，
        // 默认 8）：SC 直射随 nodirect atlas 分离（E0-B 主根治）后，此处的
        // 职责只剩压 firefly 峰；膝点 8 以下合法反弹全额通过。三重回滚：
        // NOPENALTY=1（全关）/ PRIMAL_SPGI_SC_NODIRECT=0（回混合 atlas，
        // 此时膝点建议同时回 1.0）/ knee env=1.0（旧语义）。
        if (global.diag_params.w < 0.5) {
            float scLum = dot(radiance, vec3(0.2126, 0.7152, 0.0722));
            radiance *= 1.0 / (1.0 + max(scLum - global.tier_counts.y, 0.0) * 2.0);
        }
        if (any(isnan(radiance)) || any(isinf(radiance))) radiance = vec3(0.0);
        cosTheta = max(dot(probeNormal, rayDir), 0.0);
        statBranch = usedSurfaceCache ? 1u : 3u;
    } else if (hit.w == 3.0) {
        statBranch = 2u;
        // F1 (M7) far-cache: the SDF march stopped at far_cache_start —
        // query the radiance cache at the stop point (UE world-probe
        // semantics). T3.5 + SH-L1: the 32³ cascade serves the query with
        // FOUR texel reads evaluated along rayDir (cache_params.w gates the
        // fast path); the legacy 4-probe tetrahedral × L0+L1 = 16 buffer
        // reads stays as fallback.
        vec3 stopPos = origin + rayDir * max(hit.x, 0.0);
        bool ddgiOk = false;
        // [WRC] A3 优先消费（fallback_spgi_to_wrc）：WRC 有效 → 远场由
        // WRC 供给（High/Ultra 世界缓存角色）；无效/网外 → 冻结边
        // fallback_spgi_to_ddgi 保留作为回退（级联 → SH → 天空，原链不变）。
        {
            bool wrcOk = false;
            vec3 wrcRad = wrcSampleRadiance(stopPos, rayDir, wrcOk);
            if (wrcOk) {
                radiance = max(wrcRad, vec3(0.0));
                cosTheta = max(dot(probeNormal, rayDir), 0.0);
                ddgiOk = true;
            }
        }
        if (!ddgiOk && global.cache_params.w > 0.5 && global.ddgi_fb[1].w > 0.5) {
            // Extent derivation — must match DispatchCascadeUpdate:
            // extent = max(counts)×spacing×2, origin = ddgi_origin − extent×0.25.
            float ddgiSpan = max(max(global.ddgi_fb[1].x, global.ddgi_fb[1].y),
                                 global.ddgi_fb[1].z) * global.ddgi_fb[0].w;
            float cExtent = max(ddgiSpan * 2.0, 1.0);
            vec3 cOrg = global.ddgi_fb[0].xyz - vec3(cExtent * 0.25);
            float cSpacing = cExtent / 32.0;
            vec3 cgp = (stopPos - cOrg) / cSpacing;
            if (all(greaterThanEqual(cgp, vec3(0.0))) && all(lessThan(cgp, vec3(32.0)))) {
                ivec3 ct = clamp(ivec3(floor(cgp)), ivec3(0), ivec3(31));
                vec4 cL0  = texelFetch(radianceCascadeL0,  ct, 0);
                vec3 cL1x = texelFetch(radianceCascadeL1x, ct, 0).rgb;
                vec3 cL1y = texelFetch(radianceCascadeL1y, ct, 0).rgb;
                vec3 cL1z = texelFetch(radianceCascadeL1z, ct, 0).rgb;
                // Validity: A = written-by-cascade, L0 nonzero (a disabled
                // cascade writes zeros). L1 coefficients are legitimately
                // negative — never gate on their sign.
                if (cL0.a > 0.5 && any(greaterThan(cL0.rgb, vec3(0.0)))) {
                    // Canonical DDGI L0+L1 basis, same as the fallback below.
                    vec3 irr = 0.282095 * cL0.rgb
                             - 0.488603 * cL1x * rayDir.y
                             + 0.488603 * cL1y * rayDir.z
                             - 0.488603 * cL1z * rayDir.x;
                    // [③卫生] 级联值域消毒（NaN→0，上限 64 对齐 Average）。
                    if (any(isnan(irr)) || any(isinf(irr))) irr = vec3(0.0);
                    radiance = min(max(irr, vec3(0.0)), vec3(64.0));
                    cosTheta = max(dot(probeNormal, rayDir), 0.0);
                    ddgiOk = true;
                }
            }
        }
        if (!ddgiOk && global.ddgi_fb[1].w > 0.5) {
            vec3 org = global.ddgi_fb[0].xyz;
            float spacing = max(global.ddgi_fb[0].w, 0.01);
            ivec3 counts = ivec3(global.ddgi_fb[1].xyz);
            vec3 gp = (stopPos - org) / spacing;
            vec3 gridMax = vec3(counts - ivec3(1));
            if (all(greaterThanEqual(gp, vec3(0.0))) && all(lessThanEqual(gp, gridMax))) {
                vec3 f = clamp(fract(gp), vec3(0.0), vec3(1.0));
                ivec3 b0 = clamp(ivec3(floor(gp)), ivec3(0), counts - ivec3(1));

                // Sort the three axes by descending fractional part.
                int ax = (f.x >= f.y && f.x >= f.z) ? 0 : ((f.y >= f.z) ? 1 : 2);
                int ay;
                if (ax == 0)      ay = (f.y >= f.z) ? 1 : 2;
                else if (ax == 1) ay = (f.x >= f.z) ? 0 : 2;
                else              ay = (f.x >= f.y) ? 0 : 1;
                int az = 3 - ax - ay;
                float fa = f[ax], fb = f[ay], fc = f[az];

                ivec3 c0 = b0;
                ivec3 c1 = min(b0 + ivec3(equal(ivec3(ax), ivec3(0, 1, 2))), counts - ivec3(1));
                ivec3 c2 = min(c1 + ivec3(equal(ivec3(ay), ivec3(0, 1, 2))), counts - ivec3(1));
                ivec3 c3 = min(c2 + ivec3(equal(ivec3(az), ivec3(0, 1, 2))), counts - ivec3(1));
                float w0 = 1.0 - fa, w1 = fa - fb, w2 = fb - fc, w3 = fc;

                ivec3 cn[4] = ivec3[4](c0, c1, c2, c3);
                float wn[4] = float[4](w0, w1, w2, w3);

                vec3 acc = vec3(0.0);
                float wsum = 0.0;
                for (int i = 0; i < 4; ++i) {
                    if (wn[i] <= 0.0) continue;
                    uint pidx = uint(cn[i].x)
                              + uint(counts.x) * (uint(cn[i].y) + uint(counts.y) * uint(cn[i].z));
                    // L0 + L1 only (4 reads), canonical DDGI basis. KNOWN
                    // DOWNGRADE (deliberate): DDGI stores full SH L2 (9
                    // coefficients); this fallback truncates to L1 to keep
                    // 4 reads/probe. The T3.5 cascade now carries L1 too, so
                    // no link in the far-field chain loses direction below
                    // L1; reading coeffs 4..8 here is a possible future
                    // quality step (5 extra buffer reads/ray).
                    vec3 sh0 = ddgiIrr.ddgi_irradiance_vec4[pidx * 9u + 0u].xyz;
                    vec3 sh1 = ddgiIrr.ddgi_irradiance_vec4[pidx * 9u + 1u].xyz;
                    vec3 sh2 = ddgiIrr.ddgi_irradiance_vec4[pidx * 9u + 2u].xyz;
                    vec3 sh3 = ddgiIrr.ddgi_irradiance_vec4[pidx * 9u + 3u].xyz;
                    vec3 irr = 0.282095 * sh0
                             - 0.488603 * sh1 * rayDir.y
                             + 0.488603 * sh2 * rayDir.z
                             - 0.488603 * sh3 * rayDir.x;
                    acc += max(irr, vec3(0.0)) * wn[i];
                    wsum += wn[i];
                }
                if (wsum > 0.0) {
                    radiance = acc / wsum;
                    // [③卫生] NaN/Inf 消毒 + 64 上限。
                    if (any(isnan(radiance)) || any(isinf(radiance))) radiance = vec3(0.0);
                    radiance = min(radiance, vec3(64.0));
                    cosTheta = max(dot(probeNormal, rayDir), 0.0);
                    ddgiOk = true;
                }
            }
        }
        if (!ddgiOk) {
            // DDGI unavailable / stop point outside the volume → sky.
            // P1.1: 第三套硬编码渐变(0.15-0.65) → 共享 EvaluateSkyBase，
            // 与可见天空/DDGI miss 同源同色。
            // Phase 1.3（R3）: 补 SkyColor 档位门——旧实现无门控，far-cache
            // 回退注入 ~3.0 全额天空（DDGI 同源只有 ×0.4 档），是"室内=中庭"
            // 的次通道。与 DDGITraceFinalize 逃逸分支同门同值。
            float skyWeight = max(dot(probeNormal, rayDir), 0.0);
            if (skyWeight > 0.0) {
                radiance = EvaluateSkyBase(rayDir) * global.sky_params.xyz;
                cosTheta = skyWeight;
            } else {
                // [F1-a 2026-09-20 能量不对称修复] 失败射线低频有界回退：
                // 下行射线无天空门——全部回退腿（WRC/级联/DDGI）耗尽后落黑，
                // 与邻近亮回退（天空 9-12）拼出空间二值化。以 RadianceCascade
                // 32³ 低频场填充（真实测量的低频近似，不编造卡片辐射），上限
                // min(级联值, 天空×k)，k = sky_params.w
                //（PRIMAL_GI_FALLBACK_CLAMP，默认 0.3；0 = 回旧黑语义）。
                // [E0-I K-3] served=false = 下行失败且无兜底（黑区面积的直接
                // 计量）；served=true = F1-a 级联兜底服务。
                bool servedF1a = false;
                if (global.sky_params.w > 0.0 && global.ddgi_fb[1].w > 0.5 && global.cache_params.w > 0.5) {
                    float ddgiSpanF = max(max(global.ddgi_fb[1].x, global.ddgi_fb[1].y),
                                          global.ddgi_fb[1].z) * global.ddgi_fb[0].w;
                    float cExtentF = max(ddgiSpanF * 2.0, 1.0);
                    vec3 cOrgF = global.ddgi_fb[0].xyz - vec3(cExtentF * 0.25);
                    vec3 cgpF = (probePos - cOrgF) / (cExtentF / 32.0);
                    if (all(greaterThanEqual(cgpF, vec3(0.0))) && all(lessThan(cgpF, vec3(32.0)))) {
                        ivec3 ctF = clamp(ivec3(floor(cgpF)), ivec3(0), ivec3(31));
                        vec4 cL0F = texelFetch(radianceCascadeL0, ctF, 0);
                        if (cL0F.a > 0.5 && any(greaterThan(cL0F.rgb, vec3(0.0)))) {
                            vec3 fb = 0.282095 * cL0F.rgb;
                            if (any(isnan(fb)) || any(isinf(fb))) fb = vec3(0.0);   // [③卫生]
                            vec3 cap = EvaluateSkyBase(rayDir) * global.sky_params.xyz * global.sky_params.w;
                            radiance = min(fb, cap);
                            cosTheta = max(dot(probeNormal, rayDir), 0.0);
                            servedF1a = true;
                        }
                    }
                }
                atomicAdd(fail_stats[servedF1a ? 6u : 5u], 1u);
            }
        }
    }
    if (useWorldFallback || (hit.w != 1.0 && hit.w != 2.0 && hit.w != 3.0)) {
        // Miss → DDGI world-probe fallback (T2.2): 8-probe trilinear of the
        // full L0-L2 SH (upgraded from nearest-probe L0+L1, which produced
        // probe-grid seams); the sky gradient only fires when DDGI is
        // unavailable or the probe lies outside the volume.
        bool ddgiOk = false;
        if (global.ddgi_fb[1].w > 0.5) {
            vec3 org = global.ddgi_fb[0].xyz;
            float spacing = max(global.ddgi_fb[0].w, 0.01);
            ivec3 counts = ivec3(global.ddgi_fb[1].xyz);
            vec3 gp = (probePos - org) / spacing;
            vec3 gridMax = vec3(counts - ivec3(1));
            if (all(greaterThanEqual(gp, vec3(0.0))) && all(lessThanEqual(gp, gridMax))) {
                ivec3 b0 = clamp(ivec3(floor(gp)), ivec3(0), counts - ivec3(1));
                ivec3 b1 = min(b0 + ivec3(1), counts - ivec3(1));
                vec3 fr = clamp(fract(gp), vec3(0.0), vec3(1.0));

                vec3 acc = vec3(0.0);
                float wsum = 0.0;
                float unoccludedWsum = 0.0;
                for (int z = 0; z < 2; ++z)
                for (int y = 0; y < 2; ++y)
                for (int x = 0; x < 2; ++x) {
                    float tw = mix(1.0 - fr.x, fr.x, float(x))
                             * mix(1.0 - fr.y, fr.y, float(y))
                             * mix(1.0 - fr.z, fr.z, float(z));
                    if (tw <= 0.0) continue;
                    ivec3 pc = ivec3(mix(b0, b1, ivec3(x, y, z)));
                    uint pidx = uint(pc.x) + uint(counts.x) * (uint(pc.y) + uint(counts.y) * uint(pc.z));
                    vec3 toProbe = normalize((org + vec3(pc) * spacing) - probePos);
                    // Soft directional preference: probes lying along the ray
                    // carry the bounce this ray is looking for.
                    float dirW = 0.25 + 0.75 * clamp(dot(toProbe, rayDir) * 0.5 + 0.5, 0.0, 1.0);
                    float w = tw * dirW;
                    unoccludedWsum += w;
                    if (global.hint_params.w > 0.5) {
                        vec4 relocated = ddgiOrigins.values[pidx];
                        vec3 anchor = relocated.w > 0.0 ? relocated.xyz : org + vec3(pc) * spacing;
                        vec3 delta = probePos - anchor;
                        float distanceToProbe = length(delta);
                        vec3 direction = delta / max(distanceToProbe, 0.0001);
                        vec2 oct = direction.xy / max(dot(abs(direction), vec3(1.0)), 0.0001);
                        if (direction.z < 0.0)
                            oct = (1.0 - abs(oct.yx)) * mix(vec2(-1.0), vec2(1.0), greaterThanEqual(oct, vec2(0.0)));
                        uvec2 texel = uvec2(clamp((oct * 0.5 + 0.5) * 8.0, vec2(0.0), vec2(7.0)));
                        uint depthIndex = pidx * 128u + texel.y * 8u + texel.x;
                        float mean = ddgiDepth.values[depthIndex];
                        // Stored value is variance, NOT a second moment.
                        float variance = max(ddgiDepth.values[depthIndex + 64u], 0.0001);
                        float beyond = max(distanceToProbe - mean, 0.0);
                        float visibility = clamp(2.0 * variance / (variance + beyond * beyond), 0.2, 1.0);
                        // A borrowed origin/SH is not an independent measurement.
                        visibility *= relocated.w > 0.75 ? 1.0 : (relocated.w > 0.0 ? 0.5 : 0.0);
                        if (auditCardSlot != 0xFFFFFFFFu) {
                            uint ordinal = uint(z * 4 + y * 2 + x);
                            audit_ddgi[auditCardSlot][ordinal][0] = vec4(anchor, relocated.w);
                            audit_ddgi[auditCardSlot][ordinal][1] = vec4(distanceToProbe, mean, variance, float(pidx));
                            audit_ddgi[auditCardSlot][ordinal][2] = vec4(w, visibility, 0.0, float(texel.y * 8u + texel.x));
                        }
                        w *= visibility;
                    }

                    // Full L0-L2 evaluation, canonical basis (matches
                    // DDGIUpdateIrradiance's projection).
                    vec3 sh0v = ddgiIrr.ddgi_irradiance_vec4[pidx * 9u + 0u].xyz;
                    vec3 sh1v = ddgiIrr.ddgi_irradiance_vec4[pidx * 9u + 1u].xyz;
                    vec3 sh2v = ddgiIrr.ddgi_irradiance_vec4[pidx * 9u + 2u].xyz;
                    vec3 sh3v = ddgiIrr.ddgi_irradiance_vec4[pidx * 9u + 3u].xyz;
                    vec3 sh4v = ddgiIrr.ddgi_irradiance_vec4[pidx * 9u + 4u].xyz;
                    vec3 sh5v = ddgiIrr.ddgi_irradiance_vec4[pidx * 9u + 5u].xyz;
                    vec3 sh6v = ddgiIrr.ddgi_irradiance_vec4[pidx * 9u + 6u].xyz;
                    vec3 sh7v = ddgiIrr.ddgi_irradiance_vec4[pidx * 9u + 7u].xyz;
                    vec3 sh8v = ddgiIrr.ddgi_irradiance_vec4[pidx * 9u + 8u].xyz;
                    float dx = rayDir.x, dy = rayDir.y, dz = rayDir.z;
                    vec3 irr = sh0v * 0.282095
                             + sh1v * (-0.488603 * dy)
                             + sh2v * ( 0.488603 * dz)
                             + sh3v * (-0.488603 * dx)
                             + sh4v * ( 1.092548 * dy * dx)
                             + sh5v * (-1.092548 * dy * dz)
                             + sh6v * ( 0.315392 * (3.0 * dz * dz - 1.0))
                             + sh7v * (-1.092548 * dx * dz)
                             + sh8v * ( 0.546274 * (dx * dx - dy * dy));
                    if (global.hint_params.w > 0.5 && auditCardSlot != 0xFFFFFFFFu)
                        audit_ddgi[auditCardSlot][uint(z * 4 + y * 2 + x)][2].z =
                            dot(max(irr, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
                    acc += max(irr, vec3(0.0)) * w;
                    wsum += w;
                }
                if (wsum > 0.0 || global.hint_params.w > 0.5) {
                    radiance = acc / max(wsum, 0.0001);
                    // Mode 1 only changes neighbour selection. Mode 2 also
                    // preserves attenuation erased by normalized interpolation.
                    if (global.hint_params.w > 1.5)
                        radiance *= clamp(wsum / max(unoccludedWsum, 0.0001), 0.0, 1.0);
                    // [③卫生] NaN/Inf 消毒 + 64 上限。
                    if (any(isnan(radiance)) || any(isinf(radiance))) radiance = vec3(0.0);
                    radiance = min(radiance, vec3(64.0));
                    cosTheta = max(dot(probeNormal, rayDir), 0.0);
                    ddgiOk = true;
                }
            }
        }
        if (!ddgiOk) {
            // Phase 1.3（R3）: 第四套（残存的）硬编码渐变 → 共享
            // EvaluateSkyBase × SkyColor 档位门——world-fallback miss 与
            // far-cache/可见天空/DDGI 同源同值（天空单一事实源）。
            float skyWeight = max(dot(probeNormal, rayDir), 0.0);
            if (skyWeight > 0.0) {
                radiance = EvaluateSkyBase(rayDir) * global.sky_params.xyz;
                cosTheta = skyWeight;
            } else {
                // [F1-a 2026-09-20] 同 far-cache 尾：下行失败射线 →
                // RadianceCascade 低频有界回退（min(级联, 天空×k)）。
                // [E0-I K-3] 同 far-cache 尾计数。
                bool servedF1a = false;
                if (global.sky_params.w > 0.0 && global.ddgi_fb[1].w > 0.5 && global.cache_params.w > 0.5) {
                    float ddgiSpanF = max(max(global.ddgi_fb[1].x, global.ddgi_fb[1].y),
                                          global.ddgi_fb[1].z) * global.ddgi_fb[0].w;
                    float cExtentF = max(ddgiSpanF * 2.0, 1.0);
                    vec3 cOrgF = global.ddgi_fb[0].xyz - vec3(cExtentF * 0.25);
                    vec3 cgpF = (probePos - cOrgF) / (cExtentF / 32.0);
                    if (all(greaterThanEqual(cgpF, vec3(0.0))) && all(lessThan(cgpF, vec3(32.0)))) {
                        ivec3 ctF = clamp(ivec3(floor(cgpF)), ivec3(0), ivec3(31));
                        vec4 cL0F = texelFetch(radianceCascadeL0, ctF, 0);
                        if (cL0F.a > 0.5 && any(greaterThan(cL0F.rgb, vec3(0.0)))) {
                            vec3 fb = 0.282095 * cL0F.rgb;
                            if (any(isnan(fb)) || any(isinf(fb))) fb = vec3(0.0);   // [③卫生]
                            vec3 cap = EvaluateSkyBase(rayDir) * global.sky_params.xyz * global.sky_params.w;
                            radiance = min(fb, cap);
                            cosTheta = max(dot(probeNormal, rayDir), 0.0);
                            servedF1a = true;
                        }
                    }
                }
                atomicAdd(fail_stats[servedF1a ? 6u : 5u], 1u);
            }
        }
        // Diagnostic-only subtypes preserve the original four-way branch
        // totals while identifying the provenance of the bright fallback.
        spgiStatRecord(probeIdx, ddgiOk ? 4u : 5u, radiance, cosTheta);
        if (hit.w == 2.0) spgiStatRecord(probeIdx, 6u, radiance, hit.x);
    }

    if (auditCardSlot != 0xFFFFFFFFu) {
            uint slot = auditCardSlot;
            audit_samples[slot][0] = vec4(origin + rayDir * max(hit.x, 0.0), hit.x);
            audit_samples[slot][1] = vec4(probePos, float(probeIdx));
            float reason = hit.w == 2.0 ? float(scRejectReason)
                         : (hit.w == 1.0 ? -1.0 : (hit.w == 3.0 ? -3.0 : -4.0));
            audit_samples[slot][2] = vec4(rayDir, reason);
            audit_samples[slot][3] = vec4(float(auditEvalCount), float(auditBounds),
                                          float(auditOrient), hit.w == 2.0 ? hit.z : -1.0);
    }

    // w carries the SH-projection weight: cosθ × importance factor (F2).
    // B5: the sign is source reliability, not merely the SDF march result.
    // A rejected SC candidate and a far-cache stop both use borrowed world
    // radiance, so treating hit.w==2/3 as a measured hit made hitRatio and
    // SPGI confidence stay high even when most rays were fallback.
    const bool geoHit = statBranch <= 1u;
    // P1: fallback/DDGI/miss 分支统一记为 3（含 w==2 校验失败→世界回退）
    spgiStatRecord(probeIdx, statBranch, radiance, cosTheta);
    // [E0-I R4 Debug A/B/C（能量-排查 §5.5）] 分通路隔离：归因统计已按原始
    // radiance 记账（同跑读回 fill/transport 各自份额），写出的探针场按
    // mode 置零对应分支——
    //   mode 4 = fill-only：HZB/SC 命中（branch 0/1）→ 0，保留 far-cache/
    //            miss 天空链（含 w==2 校验失败的世界回退，branch 3）；
    //   mode 5 = transport-only：far-cache/miss（branch 2/3）→ 0，保留
    //            HZB/SC。
    if (global.diag_params.x > 3.5 && global.diag_params.x < 4.5) {
        if (statBranch <= 1u) radiance = vec3(0.0);
    } else if (global.diag_params.x > 4.5 && global.diag_params.x < 5.5) {
        if (statBranch >= 2u) radiance = vec3(0.0);
    }
    if (global.diag_params.x > 0.5) {
        vec4 clip = global.view_projection * vec4(probePos, 1.0);
        if (clip.w > 0.0) {
            vec2 uv = vec2(clip.x / clip.w * 0.5 + 0.5, 0.5 - clip.y / clip.w * 0.5);
            const vec4 boxes[6] = vec4[6](
                vec4(0.46,0.26,0.60,0.44), vec4(0.00,0.42,0.22,0.78),
                vec4(0.80,0.42,1.00,0.78), vec4(0.42,0.50,0.58,0.75),
                vec4(0.44,0.10,0.55,0.22), vec4(0.30,0.88,0.70,1.00));
            uint category = statBranch <= 1u ? 2u : 3u;
            if (useWorldFallback && hit.w == 2.0)
                category = hit.x <= global.sdf_voxel_sizes[0].x * 0.5 ? 0u : 1u;
            float lum = clamp(dot(radiance, vec3(0.2126,0.7152,0.0722)), 0.0, 64.0);
            for (uint r = 0u; r < 6u; ++r) {
                if (all(greaterThanEqual(uv, boxes[r].xy)) && all(lessThan(uv, boxes[r].zw))) {
                    atomicAdd(roi_stats[r][category].x, 1u);
                    atomicAdd(roi_stats[r][category].y, uint(lum * 64.0));
                    atomicAdd(roi_stats[r][category].z, uint(lum * max(cosTheta,0.0) * 64.0));
                    atomicAdd(roi_stats[r][category].w, uint(clamp(cosTheta,0.0,1.0) * 256.0));
                }
            }
        }
    }
    probeRadiance.data[global_id] = vec4(radiance, geoHit ? cosTheta * invNq : -cosTheta * invNq);
}
