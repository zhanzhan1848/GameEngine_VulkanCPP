#version 450 core
// [WRC] WRCTraceSDF — World Space Radiance Cache split-trace pass 1.
// Entry point: wrc_trace_sdf
//
// WRC 是独立代码域（设计文档 §1 命名公约）：与 DDGI 同构、互不包含。
// 纯 cache 语义：本 pass 只负责"trace GlobalSDF 得到每方向命中距离"，
// radiance 解析在 WRCTraceFinalize（SC 采样/天空契约）。
//
// 每探针 K=64 个固定 Fibonacci 球面方向（独立实现，非 ProbeSampleLib——
// WRC 的方向集是 cache 的存储坐标系，固定不变使 EMA 收敛有意义）。
// 1 group = 1 probe，64 lanes 恰好 1 方向/lane。
//
// Phase 4 零穿越命中判定（移植 DDGI Phase 4 原则，wrc 前缀重实现）：
// signed 场下步进从正距离跨到非正距离即保证存在表面穿越，5 次二分收敛。
//
// Flat bindings:
//   0..2 = SampledImage (3D)          SDF cascades
//   3    = UniformBuffer              WRCVolumeData
//   4    = StorageBuffer (write)      hit_distance[] (per update-slot × dir)
//   5    = StorageBuffer (readonly)   probe_update_list[]

#extension GL_EXT_samplerless_texture_functions : enable

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture3D sdf_cascade_0;
layout(set = 0, binding = 1) uniform texture3D sdf_cascade_1;
layout(set = 0, binding = 2) uniform texture3D sdf_cascade_2;

layout(set = 0, binding = 3, std140) uniform WRCVolumeDataBlock {
    vec4  ProbeOrigin;              //   0: xyz origin, w spacing
    uvec4 ProbeCounts;              //  16: xyz counts, w = signedSDF
    uvec4 ProbeMeta;                //  32: x = K, y = total, z = rays, w = updateCount
    vec4  TraceParams;              //  48: x = rayMax, y = alpha, z = frame, w = warmup
    vec4  SdfOrigins[3];            //  64
    vec4  SdfVoxelSizes[3];         // 112
    vec4  SdfExtents[3];            // 160
    uvec4 SdfResolutionsAndCount;   // 208
    vec4  LightDirection;           // 224
    vec4  LightColor;               // 240
    vec4  SkyColor;                 // 256: xyz sky, w = tier gate
    uvec4 SCParams;                 // 272: x = lookupCount, y = atlasSize, z = gridValid, w = debug
} volume;

layout(set = 0, binding = 4) writeonly buffer HitDistanceBuf {
    float hit_distance[];
} hd;

layout(set = 0, binding = 5, std430) readonly buffer ProbeUpdateBuf {
    uint probe_update_list[];
} pul;

// ----------------------------------------------------------------------------
// Fibonacci sphere (fixed direction set — the cache's storage coordinates).
// ----------------------------------------------------------------------------
vec3 wrcSampleDirection(uint k, uint count) {
    const float PHI = 3.883222077450933;   // (sqrt(5)+1)*pi... golden angle = acos stuff
    // Standard Fibonacci sphere: y in (1-2*(k+0.5)/N), golden-angle azimuth.
    float y = 1.0 - 2.0 * (float(k) + 0.5) / float(count);
    float r = sqrt(max(1.0 - y * y, 0.0));
    float ga = 2.399963229728653;          // golden angle (rad)
    float a = ga * float(k);
    return vec3(cos(a) * r, y, sin(a) * r);
}

bool isInsideCascade(vec3 pos, vec3 origin, vec3 extent) {
    vec3 local = pos - origin;
    return local.x >= 0.0 && local.x < extent.x &&
           local.y >= 0.0 && local.y < extent.y &&
           local.z >= 0.0 && local.z < extent.z;
}

float sampleSDFCascade(texture3D sdfTexture, vec3 worldPos,
                       vec3 cascadeOrigin, vec3 cascadeExtent, uint resolution) {
    vec3 uvw = (worldPos - cascadeOrigin) / cascadeExtent;
    if (uvw.x < 0.0 || uvw.x > 1.0 ||
        uvw.y < 0.0 || uvw.y > 1.0 ||
        uvw.z < 0.0 || uvw.z > 1.0) {
        return 1.0e10;
    }
    // 手写三线性（同 DDGITraceSDF 的薄墙修复——cache 与被缓存对象共用同一
    // SDF 真值层；采样算法属于共享设施，语义注释见 DDGI 侧）。
    vec3 p = uvw * float(resolution) - 0.5;
    ivec3 base = ivec3(floor(p));
    vec3 f = p - vec3(base);
    ivec3 resI = ivec3(int(resolution) - 1);
    ivec3 c0 = clamp(base, ivec3(0), resI);
    ivec3 c1 = clamp(base + ivec3(1), ivec3(0), resI);
    float d000 = texelFetch(sdfTexture, ivec3(c0.x, c0.y, c0.z), 0).r;
    float d100 = texelFetch(sdfTexture, ivec3(c1.x, c0.y, c0.z), 0).r;
    float d010 = texelFetch(sdfTexture, ivec3(c0.x, c1.y, c0.z), 0).r;
    float d110 = texelFetch(sdfTexture, ivec3(c1.x, c1.y, c0.z), 0).r;
    float d001 = texelFetch(sdfTexture, ivec3(c0.x, c0.y, c1.z), 0).r;
    float d101 = texelFetch(sdfTexture, ivec3(c1.x, c0.y, c1.z), 0).r;
    float d011 = texelFetch(sdfTexture, ivec3(c0.x, c1.y, c1.z), 0).r;
    float d111 = texelFetch(sdfTexture, ivec3(c1.x, c1.y, c1.z), 0).r;
    return mix(mix(mix(d000, d100, f.x), mix(d010, d110, f.x), f.y),
               mix(mix(d001, d101, f.x), mix(d011, d111, f.x), f.y), f.z);
}

float sampleBestSDF(vec3 pos) {
    uint cc = volume.SdfResolutionsAndCount.w;
    if (cc > 0u && isInsideCascade(pos, volume.SdfOrigins[0].xyz, volume.SdfExtents[0].xyz)) {
        return sampleSDFCascade(sdf_cascade_0, pos, volume.SdfOrigins[0].xyz,
                                volume.SdfExtents[0].xyz, volume.SdfResolutionsAndCount.x);
    } else if (cc > 1u && isInsideCascade(pos, volume.SdfOrigins[1].xyz, volume.SdfExtents[1].xyz)) {
        return sampleSDFCascade(sdf_cascade_1, pos, volume.SdfOrigins[1].xyz,
                                volume.SdfExtents[1].xyz, volume.SdfResolutionsAndCount.y);
    } else if (cc > 2u && isInsideCascade(pos, volume.SdfOrigins[2].xyz, volume.SdfExtents[2].xyz)) {
        return sampleSDFCascade(sdf_cascade_2, pos, volume.SdfOrigins[2].xyz,
                                volume.SdfExtents[2].xyz, volume.SdfResolutionsAndCount.z);
    }
    return 1.0e10;
}

// ----------------------------------------------------------------------------
// Main
// ----------------------------------------------------------------------------
void wrc_trace_sdf() {
    uint tid      = gl_LocalInvocationID.y * 8u + gl_LocalInvocationID.x;  // 0..63
    uint group_id = gl_WorkGroupID.x;

    if (group_id >= volume.ProbeMeta.w) return;   // updateCount
    if (tid >= volume.ProbeMeta.x) return;        // K

    uint probeIdx = pul.probe_update_list[group_id];
    if (probeIdx >= volume.ProbeMeta.y) return;

    uvec3 counts = volume.ProbeCounts.xyz;
    uint pz  = probeIdx / (counts.x * counts.y);
    uint rem = probeIdx % (counts.x * counts.y);
    uint py  = rem / counts.x;
    uint px  = rem % counts.x;
    vec3 probePos = volume.ProbeOrigin.xyz + vec3(float(px), float(py), float(pz)) * volume.ProbeOrigin.w;

    // A2 入几何排除的数据源：lane 0 把探针起点的 SDF 距离写到 hit 缓冲尾部
    //（updateCount*K + group_id 槽），update 端按 skin 阈值置 in-geometry 位。
    if (tid == 0u) {
        float d0 = sampleBestSDF(probePos);
        hd.hit_distance[volume.ProbeMeta.w * volume.ProbeMeta.x + group_id] =
            (d0 >= 1.0e9) ? 1.0e9f : d0;
    }

    vec3 rayDir = wrcSampleDirection(tid, volume.ProbeMeta.x);

    float t = 0.0;
    // -1 = 步数耗尽（密闭，黑）；-2 = 越出 RayMaxDistance（真逃逸 → 天空契约）。
    float hitDistance = -1.0;

    float hitThreshold = max(volume.SdfVoxelSizes[0].x * 1.25, 0.45);
    float minStep      = volume.SdfVoxelSizes[0].x * 0.25;
    uint coarsest      = min(2u, volume.SdfResolutionsAndCount.w - 1u);
    float fallbackStride = volume.SdfExtents[coarsest].x * 0.1;

    const uint MAX_SDF_STEPS = 48u;
    float prevD = 3.4e38;
    float prevT = 0.0;
    bool clearedSkin = false;
    const bool signedCoarseField = volume.ProbeCounts.w != 0u;

    for (uint step = 0u; step < MAX_SDF_STEPS; ++step) {
        vec3 pos = probePos + rayDir * t;
        float d = sampleBestSDF(pos);

        if (d >= 1.0e9) {
            t += fallbackStride;
            if (t > volume.TraceParams.x) { hitDistance = -2.0; break; }
            continue;
        }

        // Phase 4 零穿越命中（signed 粗场）——thin-wall tunneling 根治。
        if (signedCoarseField && clearedSkin && d <= 0.0 && prevD > 0.0 && prevD < 1.0e9) {
            float tLo = prevT;
            float tHi = t;
            for (int b = 0; b < 5; ++b) {
                float tMid = 0.5 * (tLo + tHi);
                float dMid = sampleBestSDF(probePos + rayDir * tMid);
                if (dMid <= 0.0) { tHi = tMid; } else { tLo = tMid; }
            }
            hitDistance = tHi;
            break;
        }

        if (d < hitThreshold) {
            if (!clearedSkin) {
                t += max(d, minStep);
                if (t > volume.TraceParams.x) { hitDistance = -2.0; break; }
                continue;
            }
            hitDistance = t;
            break;
        }
        clearedSkin = true;

        // 埋没探针判定（A2 入几何排除）：起点就在 hit 带内且无法离肤 ——
        // 用「首步仍在肤内 + 从未 clearedSkin」在循环外由距离守卫承担；
        // 这里只做常规推进（远场 1.5× overstep，近场 2-voxel 封顶）。
        float advance;
        if (d > 6.0 && d >= prevD) {
            advance = d * 1.5;
        } else {
            advance = clamp(d, minStep, max(volume.SdfVoxelSizes[0].x * 2.0, 0.20));
        }
        prevD = d;
        prevT = t;
        t += advance;
        if (t > volume.TraceParams.x) { hitDistance = -2.0; break; }
    }

    hd.hit_distance[group_id * volume.ProbeMeta.x + tid] = hitDistance;
}
