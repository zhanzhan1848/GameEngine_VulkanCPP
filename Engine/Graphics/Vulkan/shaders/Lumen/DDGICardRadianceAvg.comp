#version 450 core
// Vulkan Lumen DDGI Card Radiance Avg — GLSL port of DDGICardRadianceAvg.metal.
// Entry point: ddgi_card_radiance_avg
//   (glslangValidator --source-entrypoint main -e ddgi_card_radiance_avg)
//
// Samples a 4x4 block grid across each card's area in the Surface Cache
// Lighting Atlas. Each block samples a 2x2 texel footprint and writes a
// coverage-weighted average radiance. The w component carries the fraction of
// the block's samples with measured surface validity, including valid black.
// Explicit legacy policy alone preserves the old nonzero-energy gate.
//
// Dispatch: (CardCount * 16, 1, 1), threadGroupSize = (64, 1, 1)
//
// Flat bindings (Vulkan forbids Metal's overlapping texture/buffer namespaces):
//   binding 0 = SampledImage lighting_atlas (texture2D, texelFetch)
//   binding 1 = UniformBuffer   SurfaceCacheParams (via SurfaceCacheData.glsl)
//   binding 2 = readonly buffer SurfaceCacheCard cards[] (std430 SSBO)
//   binding 3 = buffer vec4     card_radiance[] (16 blocks/card;
//                                               xyz=avg radiance, w=coverage)
//   binding 4 = SampledImage measured albedo/payload
//   binding 5 = SampledImage measured depth

#extension GL_EXT_samplerless_texture_functions : enable

#include "SurfaceCacheData.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// --------------------------------------------------------------------------------
// Bindings (flat — see header)
// --------------------------------------------------------------------------------
layout(set = 0, binding = 0) uniform texture2D lighting_atlas;
layout(set = 0, binding = 4) uniform texture2D albedo_atlas;
layout(set = 0, binding = 5) uniform texture2D depth_atlas;

layout(set = 0, binding = 1, std140) uniform ParamBlock {
    SurfaceCacheParams params;
} pb;

layout(set = 0, binding = 2, std430) readonly buffer CardBuffer {
    SurfaceCacheCard cards[];
};

// One vec4 per card block: xyz = average radiance, w = coverage fraction
// (0..1) of sampled texels with measured surface validity. Flattened index is
// card_index * 16 + block_y * 4 + block_x.
layout(set = 0, binding = 3, std430) buffer CardRadianceBuffer {
    vec4 card_radiance[];
};

// --------------------------------------------------------------------------------
// Main
// --------------------------------------------------------------------------------
void ddgi_card_radiance_avg() {
    uint gid = gl_GlobalInvocationID.x;
    uint cardIndex = gid / 16u;
    uint blockIndex = gid % 16u;
    if (cardIndex >= pb.params.max_cards) return;

    SurfaceCacheCard card = cards[cardIndex];
    if (card.resolution == 0u) {
        card_radiance[gid] = vec4(0.0, 0.0, 0.0, 0.0);
        return;
    }

    uint blockX = blockIndex % 4u;
    uint blockY = blockIndex / 4u;
    // Each block covers one quarter of the card dimension and takes 2x2
    // samples. Coverage follows actual surface validity, not radiance energy.
    float res = float(card.resolution);
    vec3 sum = vec3(0.0);
    float valid = 0.0;
    for (uint j = 0u; j < 2u; ++j) {
        for (uint i = 0u; i < 2u; ++i) {
            ivec2 uv = ivec2(
                int(float(card.atlas_offset_x) + res * (float(blockX * 2u + i) + 0.5) / 8.0),
                int(float(card.atlas_offset_y) + res * (float(blockY * 2u + j) + 0.5) / 8.0));
            vec3 r = texelFetch(lighting_atlas, uv, 0).xyz;
            bool legacySurface = (pb.params._pad & 1u) != 0u;
            vec4 albedo = texelFetch(albedo_atlas, uv, 0);
            float depth = texelFetch(depth_atlas, uv, 0).r;
            uint payload = uint(round(clamp(albedo.a, 0.0, 1.0) * 255.0));
            bool measuredSurface = (payload & 128u) != 0u &&
                !isnan(depth) && !isinf(depth) && depth >= 0.0 &&
                !any(isnan(albedo)) && !any(isinf(albedo)) &&
                !any(isnan(r)) && !any(isinf(r));
            if (legacySurface ? dot(r, r) > 1e-6 : measuredSurface) {
                sum += r;
                valid += 1.0;
            }
        }
    }

    if (valid > 0.0) {
        card_radiance[gid] = vec4(sum / valid, valid / 4.0);
    } else {
        card_radiance[gid] = vec4(0.0, 0.0, 0.0, 0.0);
    }
}
