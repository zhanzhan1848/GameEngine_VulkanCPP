#version 450 core
// T5.1: SPGI hybrid trace — far-field GlobalSDF march (dispatch 2b).
// Entry point: screen_probe_trace_sdf
// (glslangValidator --source-entrypoint main -e screen_probe_trace_sdf)
//
// Pure texture3D + probe-buffer reads (mirrors the proven ddgi_trace_sdf
// split pattern): no texture2D in this kernel. Rays already resolved by the
// HZB near-field kernel (hit_buffer.w == 1.0) are skipped.
//
// Flat descriptor bindings:
//   binding 0-2 = SampledImage  sdf0/sdf1/sdf2 (texture3D, R32F)
//   binding 3   = StorageBuffer(ro) probePositions
//   binding 4   = StorageBuffer(ro) probeNormals
//   binding 5   = StorageBuffer     hit_buffer (vec4 per ray, read-write)
//   binding 6   = UniformBuffer    ScreenProbeGlobalData
//
// hit_buffer encoding: x = hit distance, yz = hit UV, w = source
//   (0 = miss, 1 = HZB hit [untouched here], 2 = SDF hit,
//    3 = far-cache early-out [F1: march hit the budget, query DDGI at stop])

#extension GL_EXT_samplerless_texture_functions : enable
#extension GL_GOOGLE_include_directive : require

// Shared shader library (axis refactor X1): SDF cascade sampling + relaxed
// march and Fibonacci + TBN direction generation live in ShaderLib/.
#include "ShaderLib/TraceLib.glsl"
#include "ShaderLib/EncodeLib.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture3D sdf0;
layout(set = 0, binding = 1) uniform texture3D sdf1;
layout(set = 0, binding = 2) uniform texture3D sdf2;

layout(set = 0, binding = 3) readonly buffer ProbePositionsBuf {
    vec4 data[];
} probePositions;
layout(set = 0, binding = 4) readonly buffer ProbeNormalsBuf {
    vec4 data[];
} probeNormals;
layout(set = 0, binding = 5) buffer HitBufferBuf {
    vec4 data[];
} hit_buffer;
layout(set = 0, binding = 6, std140) uniform GlobalData {
    mat4 view_projection;
    mat4 inv_view_projection;
    vec4 camera_position;
    vec4 grid_params;
    vec4 trace_params;
    vec4 sdf_origins[3];
    vec4 sdf_voxel_sizes[3];
    vec4 sdf_extents[3];
    vec4 sdf_resolutions;
    vec4 surface_cache_params;
    vec4 ddgi_fb[2];
    vec4 hzb_params;
    vec4 cache_params;   // F1: x = far_cache_start (0 off); F2: y = importance (0/1)
    vec4 hint_params;    // G2 A/B: x = 三线性梯度 hint（PRIMAL_SPGI_TRILINEAR_HINT）
} global;

// F2 (M7): previous frame's final probe SH — importance-resampling proposal.
layout(set = 0, binding = 7, std430) readonly buffer ImportanceSHBlock {
    vec4 data[];
} importanceSH;

// ----------------------------------------------------------------------------
// T4.3 二批: per-mesh detail SDF slots (mirror of DDGITraceSDF.comp — distance
// refinement only; screen probes carry their own GBuffer normals). Decode
// contract: signed (params.z=1) d = unorm*2*max_dim − max_dim, legacy unsigned
// d = unorm*max_dim; max_dim = padded bounds max extent / 1.4.
// ----------------------------------------------------------------------------
layout(set = 0, binding = 8, std140) uniform DetailSDFTable {
    vec4  header;                 // x = active slot count (0..4)
    mat4  inv_world[4];           // world → mesh-local
    vec4  normal_matrix[4][3];    // unused here (distance-only refine)
    vec4  bounds_min[4];
    vec4  bounds_max[4];
    vec4  params[4];              // resolution, max_dim, signed, voxel_size
} dtable;
layout(set = 0, binding = 9)  uniform texture3D detail_sdf_0;
layout(set = 0, binding = 10) uniform texture3D detail_sdf_1;
layout(set = 0, binding = 11) uniform texture3D detail_sdf_2;
layout(set = 0, binding = 12) uniform texture3D detail_sdf_3;

float detailSampleRaw(texture3D tex, vec3 bounds_min, vec3 extent, float res, vec3 local) {
    vec3 uvw = (local - bounds_min) / max(extent, vec3(1e-6));
    if (uvw.x < 0.0 || uvw.x > 1.0 || uvw.y < 0.0 || uvw.y > 1.0 || uvw.z < 0.0 || uvw.z > 1.0) {
        return 1.0;   // outside → decoded as +max_dim (far)
    }
    vec3 p = uvw * res - 0.5;
    ivec3 base = ivec3(floor(p));
    vec3 f = p - vec3(base);
    ivec3 resI = ivec3(int(res) - 1);
    ivec3 c0 = clamp(base, ivec3(0), resI);
    ivec3 c1 = clamp(base + ivec3(1), ivec3(0), resI);
    float d000 = texelFetch(tex, ivec3(c0.x, c0.y, c0.z), 0).r;
    float d100 = texelFetch(tex, ivec3(c1.x, c0.y, c0.z), 0).r;
    float d010 = texelFetch(tex, ivec3(c0.x, c1.y, c0.z), 0).r;
    float d110 = texelFetch(tex, ivec3(c1.x, c1.y, c0.z), 0).r;
    float d001 = texelFetch(tex, ivec3(c0.x, c0.y, c1.z), 0).r;
    float d101 = texelFetch(tex, ivec3(c1.x, c0.y, c1.z), 0).r;
    float d011 = texelFetch(tex, ivec3(c0.x, c1.y, c1.z), 0).r;
    float d111 = texelFetch(tex, ivec3(c1.x, c1.y, c1.z), 0).r;
    return mix(mix(mix(d000, d100, f.x), mix(d010, d110, f.x), f.y),
               mix(mix(d001, d101, f.x), mix(d011, d111, f.x), f.y), f.z);
}

float detailSampleK(uint k, vec3 local) {
    vec3 bmin = dtable.bounds_min[k].xyz;
    vec3 ext = dtable.bounds_max[k].xyz - bmin;
    float res = dtable.params[k].x;
    if (k == 0u) return detailSampleRaw(detail_sdf_0, bmin, ext, res, local);
    if (k == 1u) return detailSampleRaw(detail_sdf_1, bmin, ext, res, local);
    if (k == 2u) return detailSampleRaw(detail_sdf_2, bmin, ext, res, local);
    return detailSampleRaw(detail_sdf_3, bmin, ext, res, local);
}

float detailDecode(uint k, float raw) {
    float max_dim = dtable.params[k].y;
    if (dtable.params[k].z > 0.5) return raw * 2.0 * max_dim - max_dim;
    return raw * max_dim;
}

// Distance-only refinement of the coarse GlobalSDF hit (same algorithm as the
// DDGI trace's refine; normal output omitted). Returns true when refined.
bool detailSDFRefine(vec3 rayOrigin, vec3 rayDir, inout float t) {
    uint count = uint(dtable.header.x);
    if (count == 0u) return false;
    vec3 hitPos = rayOrigin + rayDir * t;

    int best = -1;
    float bestAbs = 3.4e38;
    for (uint k = 0u; k < count; ++k) {
        if (any(lessThan(hitPos, dtable.bounds_min[k].xyz)) ||
            any(greaterThan(hitPos, dtable.bounds_max[k].xyz))) continue;
        vec3 local = (dtable.inv_world[k] * vec4(hitPos, 1.0)).xyz;
        float d = detailDecode(k, detailSampleK(k, local));
        float a = abs(d);
        if (a < bestAbs) { bestAbs = a; best = int(k); }
    }
    if (best < 0) return false;
    const uint bk = uint(best);
    const float localVoxel = max(dtable.params[bk].w, 1e-5);
    const bool signedField = dtable.params[bk].z > 0.5;

    float fBest = bestAbs;
    float tBest = t;
    if (signedField) {
        float tLo = t, tHi = t;
        bool haveLo = false, haveHi = false;
        for (int i = -5; i <= 5; ++i) {
            float ti = t + float(i) * localVoxel;
            float fi = detailDecode(bk, detailSampleK(bk, (dtable.inv_world[bk] * vec4(rayOrigin + rayDir * ti, 1.0)).xyz));
            if (fi < 0.0 && (!haveLo || ti > tLo)) { tLo = ti; haveLo = true; }
            if (fi >= 0.0 && (!haveHi || ti < tHi)) { tHi = ti; haveHi = true; }
            if (abs(fi) < fBest) { fBest = abs(fi); tBest = ti; }
        }
        if (haveLo && haveHi) {
            for (int it = 0; it < 5; ++it) {
                float tm = 0.5 * (tLo + tHi);
                float fm = detailDecode(bk, detailSampleK(bk, (dtable.inv_world[bk] * vec4(rayOrigin + rayDir * tm, 1.0)).xyz));
                if (fm < 0.0) tLo = tm; else tHi = tm;
            }
            tBest = 0.5 * (tLo + tHi);
        }
    } else {
        for (int i = 1; i <= 6; ++i) {
            float ti = t + float(i) * 0.5 * localVoxel;
            float fi = detailDecode(bk, detailSampleK(bk, (dtable.inv_world[bk] * vec4(rayOrigin + rayDir * ti, 1.0)).xyz));
            if (abs(fi) < fBest) { fBest = abs(fi); tBest = ti; } else break;
        }
    }
    t = tBest;
    return true;
}

// fibonacciDirection / orientAroundNormalTBN (was orientAroundNormal),
// sampleSDFCascade / sampleBestSDF and the relaxed march moved to
// ShaderLib/{EncodeLib,TraceLib}.glsl (axis refactor X1).
//
// NOTE (X1): the old local sampleSDFCascade divided uvw by sdf_origins[c].w,
// which the C++ UBO upload (FieldView::WriteSDFToScreenProbe) sets to 0.0 —
// every cascade sample returned 1e10 and every ray reported "miss". The
// TraceLib version uses sdf_extents[c].xyz like the monolithic
// ScreenProbeTraceRays kernel, restoring a real far-field trace.

// G2: 三线性 SDF 采样（仅供中心差分梯度）——最近点采样把粗体素场台阶化，
// 三线性给出连续场。8 fetch/次，仅 hint 启用时调用。
float sampleSDFTrilin(texture3D tex, vec3 pos, vec3 origin, vec3 extent, uint res) {
    vec3 uvw = (pos - origin) / extent;
    if (uvw.x < 0.0 || uvw.x > 1.0 || uvw.y < 0.0 || uvw.y > 1.0 ||
        uvw.z < 0.0 || uvw.z > 1.0) return 1.0e10;
    vec3 p = clamp(uvw, vec3(0.0), vec3(1.0)) * vec3(float(res)) - 0.5;
    ivec3 c0 = ivec3(floor(p));
    vec3 f = fract(p);
    ivec3 c1 = min(c0 + ivec3(1), ivec3(int(res) - 1));
    c0 = max(c0, ivec3(0));
    float v000 = texelFetch(tex, c0, 0).r;
    float v100 = texelFetch(tex, ivec3(c1.x, c0.y, c0.z), 0).r;
    float v010 = texelFetch(tex, ivec3(c0.x, c1.y, c0.z), 0).r;
    float v110 = texelFetch(tex, ivec3(c1.x, c1.y, c0.z), 0).r;
    float v001 = texelFetch(tex, ivec3(c0.x, c0.y, c1.z), 0).r;
    float v101 = texelFetch(tex, ivec3(c1.x, c0.y, c1.z), 0).r;
    float v011 = texelFetch(tex, ivec3(c0.x, c1.y, c1.z), 0).r;
    float v111 = texelFetch(tex, ivec3(c1.x, c1.y, c1.z), 0).r;
    return mix(mix(mix(v000, v100, f.x), mix(v010, v110, f.x), f.y),
               mix(mix(v001, v101, f.x), mix(v011, v111, f.x), f.y), f.z);
}

float sampleBestSDFTrilinear(vec3 pos) {
    uint cc = uint(global.sdf_resolutions.w);
    if (cc > 0u)
        return sampleSDFTrilin(sdf0, pos, global.sdf_origins[0].xyz,
                               global.sdf_extents[0].xyz,
                               uint(global.sdf_resolutions.x));
    return 1.0e10;
}

void screen_probe_trace_sdf() {
    uint global_id = gl_GlobalInvocationID.x;
    uint gridW = uint(global.grid_params.x);
    uint gridH = uint(global.grid_params.y);
    uint raysPerProbe = uint(global.grid_params.w);
    uint totalRays = gridW * gridH * raysPerProbe;
    if (global_id >= totalRays) return;

    // HZB kernel already resolved this ray — keep its result.
    if (global.hzb_params.z > 0.0 && hit_buffer.data[global_id].w == 1.0) return;

    vec4 posData = probePositions.data[global_id / raysPerProbe];
    if (posData.w <= 0.0) {
        hit_buffer.data[global_id] = vec4(-1.0, 0.0, 0.0, 0.0);
        return;
    }
    vec3 probeNormal = normalize(probeNormals.data[global_id / raysPerProbe].xyz);
    vec3 probePos = posData.xyz;

    uint probeIdx = global_id / raysPerProbe;
    uint rayIdx = global_id % raysPerProbe;
    vec3 rayDir;
    float invNq;   // unused here; Finalize owns the importance weight
    if (global.cache_params.y > 0.5) {
        // F2 (M7) 形态 c: importance resampling against the previous frame's
        // final SH (4 reads). Every direction consumer regenerates identically.
        uint hb = probeIdx * 4u;
        vec4 h0 = importanceSH.data[hb + 0u];
        vec4 h1 = importanceSH.data[hb + 1u];
        vec4 h2 = importanceSH.data[hb + 2u];
        vec4 h3 = importanceSH.data[hb + 3u];
        rayDir = spgiImportanceDirection(rayIdx, raysPerProbe, probeIdx,
                                         global.camera_position.w, probeNormal,
                                         h0.rgb, h1.rgb, h2.rgb, h3.rgb, invNq);
        rayDir = orientAroundNormalTBN(rayDir, probeNormal);
    } else {
        rayDir = fibonacciDirection(rayIdx, raysPerProbe);
        rayDir = spgiJitterRotation(probeIdx, global.camera_position.w) * rayDir;
        rayDir = orientAroundNormalTBN(rayDir, probeNormal);
    }
    // Origin-bias AB: keep the ray just outside the receiver surface while
    // avoiding a full two-voxel jump across thin shells (the 2x baseline is
    // backed up in /tmp for comparison). Finalize must use the same origin.
    vec3 origin = probePos + probeNormal * global.sdf_voxel_sizes[0].x * 0.25;

    // F1 (M7): cap the march at far_cache_start_distance — UE world-probe
    // semantics. Unresolved rays become far-cache queries (w = 3) evaluated
    // at the stop point by Finalize instead of marching the full 50 units.
    float cacheStart = global.cache_params.x;
    float marchDist = (cacheStart > 0.0)
        ? min(global.trace_params.x, cacheStart)
        : global.trace_params.x;

    // Relaxed sphere march (TraceLib): 32 steps, hitThreshold = voxel0 * 0.5,
    // minStep = voxel0 * 0.25, d * 1.2 overstep when far — same march the
    // monolithic ScreenProbeTraceRays kernel runs.
    SDFTraceResult res = traceSDF_relaxed(origin, rayDir, marchDist,
                                          sdf0, sdf1, sdf2,
                                          global.sdf_origins, global.sdf_extents,
                                          global.sdf_voxel_sizes,
                                          uint(global.sdf_resolutions.w));

    if (res.hit) {
        // T4.3 二批: refine the coarse hit distance against detail slots.
        float t = res.distance;
        detailSDFRefine(origin, rayDir, t);

        // G2（volume-gi-repair-audit §6；2026-09-16）: SDF 命中点梯度法线，
        // 八面体编码进 hit_buffer.y（SDF 命中的 yz 原本恒 0 未用；HZB 命中
        // 的 yz 是 UV，w 区分）。粗 march 的 stop 点带 ±voxel0×0.5 位置误差
        // （detail slot 未启用时无 refine），Finalize 的 SC card 候选校验用
        // 它做**朝向一致性**身份门——±2m 误差带内平行近邻面（拱腹 vs 受光
        // 外墙）无法靠位置区分，但法线朝向类可分。
        vec3 hitPos = origin + rayDir * t;
        vec3 gNormal = vec3(0.0);
        {
            float h = max(global.sdf_voxel_sizes[0].x, 1e-4);
            float dx = sampleBestSDF(hitPos + vec3(h, 0, 0), sdf0, sdf1, sdf2,
                                     global.sdf_origins, global.sdf_extents,
                                     uint(global.sdf_resolutions.w))
                     - sampleBestSDF(hitPos - vec3(h, 0, 0), sdf0, sdf1, sdf2,
                                     global.sdf_origins, global.sdf_extents,
                                     uint(global.sdf_resolutions.w));
            float dy = sampleBestSDF(hitPos + vec3(0, h, 0), sdf0, sdf1, sdf2,
                                     global.sdf_origins, global.sdf_extents,
                                     uint(global.sdf_resolutions.w))
                     - sampleBestSDF(hitPos - vec3(0, h, 0), sdf0, sdf1, sdf2,
                                     global.sdf_origins, global.sdf_extents,
                                     uint(global.sdf_resolutions.w));
            float dz = sampleBestSDF(hitPos + vec3(0, 0, h), sdf0, sdf1, sdf2,
                                     global.sdf_origins, global.sdf_extents,
                                     uint(global.sdf_resolutions.w))
                     - sampleBestSDF(hitPos - vec3(0, 0, h), sdf0, sdf1, sdf2,
                                     global.sdf_origins, global.sdf_extents,
                                     uint(global.sdf_resolutions.w));
            gNormal = normalize(vec3(dx, dy, dz) + vec3(1e-6));
            // 三线性版本（hint_params.x = PRIMAL_SPGI_TRILINEAR_HINT）：最近
            // 点采样在 4m 体素上量化 ±2m，梯度台阶化导致薄几何处朝向类错误
            // （拱腹 hint 侧向 → 正确卡片被朝向门误拒）。三线性连续插值给
            // 出平滑梯度，与最近点梯度 mix 0.75。
            if (global.hint_params.x > 0.5) {
                float tdx = sampleBestSDFTrilinear(hitPos + vec3(h, 0, 0))
                          - sampleBestSDFTrilinear(hitPos - vec3(h, 0, 0));
                float tdy = sampleBestSDFTrilinear(hitPos + vec3(0, h, 0))
                          - sampleBestSDFTrilinear(hitPos - vec3(0, h, 0));
                float tdz = sampleBestSDFTrilinear(hitPos + vec3(0, 0, h))
                          - sampleBestSDFTrilinear(hitPos - vec3(0, 0, h));
                vec3 tn = normalize(vec3(tdx, tdy, tdz) + vec3(1e-6));
                gNormal = normalize(mix(gNormal, tn, 0.75f));
            }
        }
        // packSnorm2x16(octEncode) → 一枚 u32；长度 <0.5 表示退化（级联外/
        // 零梯度），消费端以此判断"无朝向 hint"。
        vec2 oct = octEncode(gNormal);   // 返回 [0,1]^2
        vec2 octS = clamp(oct * 2.0 - 1.0, vec2(-1.0), vec2(1.0));
        hit_buffer.data[global_id] = vec4(t,
                                          uintBitsToFloat(packSnorm2x16(octS)),
                                          0.0, 2.0);
    } else if (cacheStart > 0.0) {
        // F1 far-cache: x = travelled distance (stop point = origin + dir * x).
        hit_buffer.data[global_id] = vec4(res.distance, 0.0, 0.0, 3.0);
    } else {
        hit_buffer.data[global_id] = vec4(-1.0, 0.0, 0.0, 0.0);
    }
}
