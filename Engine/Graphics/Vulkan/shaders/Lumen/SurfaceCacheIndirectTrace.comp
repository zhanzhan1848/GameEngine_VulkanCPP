#version 450 core
// Vulkan Lumen Surface Cache Indirect Trace — GLSL port of SurfaceCacheIndirectTrace.metal.
// Entry point: surface_cache_indirect_trace  (glslangValidator -e surface_cache_indirect_trace)
//
// SDF cone/ray trace per probe to populate ray_hits buffer.
// ThreadGroupSize: (8, 8, 1)
//
// Flat descriptor bindings:
//   binding 0 = StorageImage(r32f)   depth_atlas       (readonly, imageLoad)
//   binding 1 = StorageImage(rg16f)  normal_atlas      (readonly, imageLoad)
//   binding 2 = texture3D            sdf0              (samplerless, texelFetch nearest)
//   binding 3 = texture3D            sdf1              (samplerless, texelFetch nearest)
//   binding 4 = texture3D            sdf2              (samplerless, texelFetch nearest)
//   binding 5 = UniformBuffer        GlobalShaderData  (480B, inline)
//   binding 6 = UniformBuffer        IndirectTraceParams
//   binding 7 = StorageBuffer        cards[]           (SurfaceCacheCard, std430)
//   binding 8 = StorageBuffer        ray_hits[]        (ProbeRayHit, read-write, std430)

#extension GL_EXT_samplerless_texture_functions : enable

#include "SurfaceCacheData.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// --------------------------------------------------------------------------------
// Bindings (flat)
// --------------------------------------------------------------------------------
layout(set = 0, binding = 0, r32f)  readonly uniform image2D depth_atlas;
layout(set = 0, binding = 1, rg16f) readonly uniform image2D normal_atlas;

layout(set = 0, binding = 2) uniform texture3D sdf0;
layout(set = 0, binding = 3) uniform texture3D sdf1;
layout(set = 0, binding = 4) uniform texture3D sdf2;

// T3.2 (D7): cascade-0 conservative min-mip 链（DispatchMipChain 产出）。
// 槽位缺失时 CPU 回绑 sdf0 本体 → textureSize 对比相等 → cone 检测自门控关闭。
layout(set = 0, binding = 9)  uniform texture3D sdf0_mip0;
layout(set = 0, binding = 10) uniform texture3D sdf0_mip1;
layout(set = 0, binding = 11) uniform texture3D sdf0_mip2;

// GlobalShaderData UBO — 480 bytes, mirrors C++ RHIShaderCommon.h.
// Declared inline (not via #include RHIShaderTypes.glsl) to avoid the awk
// inliner's source-dir-relative path resolution limitation with "../" prefixes.
layout(set = 0, binding = 5, std140) uniform GDBlock {
    mat4  view;
    mat4  projection;
    mat4  invProjection;
    mat4  viewProjection;
    mat4  previousViewProjection;
    mat4  invViewProjection;
    vec4  cameraPositionAndViewWidth;
    vec4  cameraDirectionAndViewHeight;
    uint  numDirectionalLights;
    uint  numPunctualLights;
    float deltaTime;
    float frameCount;
    uint  renderMode;
    uint  enableIBL;
    uint  enableDDGI;
    uint  _pad_before_jitter;
    vec2  jitterOffset;
    float debug_directLightBoost;
    float debug_iblStrength;
    float debug_ddgiIndirectWeight;
    float debug_exposure;
    float _pad_after_debug_0;
    float _pad_after_debug_1;
} gd;

struct IndirectTraceParams {
    SurfaceCacheParams sc_params;
    uint tile_size;
    uint rays_per_probe;
    uint frame_index;
    float near_distance;
    float max_ray_distance;
    // C3.5 slice 2: stride amortization (C++ IndirectTraceParamsGPU
    // refresh_stride/refresh_phase — lands in the old std140 padding slots).
    // refresh_stride 0/1 = trace every tile every frame; otherwise only tiles
    // with probe_idx % stride == phase march this frame (phase = frame%stride).
    uint refresh_stride;
    uint refresh_phase;
    vec4 sdf_origins[3];
    vec4 sdf_voxel_sizes[3];
    vec4 sdf_extents[3];
    uint sdf_resolutions[3];
    uint sdf_cascade_count;
};

layout(set = 0, binding = 6, std140) uniform IndirectTraceParamsBlock {
    IndirectTraceParams params;
} itp;

layout(set = 0, binding = 7, std430) readonly buffer CardsBlock {
    SurfaceCacheCard data[];
} cards;

// ProbeRayHit — two vec4s (32 bytes) per hit.
//   hit_position_dist.xyz = position, .w = hit_distance
//   hit_type_pad.x = hit_type (0=near, 1=far, 2=sky)
struct ProbeRayHit {
    vec4 hit_position_dist;
    uvec4 hit_type_pad;
};

layout(set = 0, binding = 8, std430) buffer RayHitsBlock {
    ProbeRayHit data[];
} ray_hits;

// --------------------------------------------------------------------------------
// Helpers
// --------------------------------------------------------------------------------
uint findOwningCard(uvec2 uv, int count) {
    // Apple Silicon: cap device reads to ~24 to stay within limits
    uint limit = min(uint(count), 24u);
    for (uint i = 0u; i < limit; ++i) {
        if (uv.x >= cards.data[i].atlas_offset_x &&
            uv.x <  cards.data[i].atlas_offset_x + cards.data[i].resolution &&
            uv.y >= cards.data[i].atlas_offset_y &&
            uv.y <  cards.data[i].atlas_offset_y + cards.data[i].resolution)
            return i;
    }
    return uint(count);
}

// Nearest-sample SDF from a 3D texture at normalized uvw (samplerless texelFetch).
// uvw==1 lands exactly on coord==size — clamp the INTEGER coord to size-1
// (plan §三.E 边界漏洞；Shadow 孪生早已夹取，此处补齐半开域语义).
float sampleSDFNearest(texture3D sdf, vec3 uvw) {
    ivec3 size = textureSize(sdf, 0);
    ivec3 coord = ivec3(clamp(uvw, vec3(0.0), vec3(1.0)) * vec3(size));
    return texelFetch(sdf, clamp(coord, ivec3(0), size - ivec3(1)), 0).r;
}

// ============================================================================
// T3.2 (D7): cone-width-aware cascade sampling primitives — GLSL twin of
// SDFTraceCommon.metal's sampleSDFCascadeMip / coneMipFrac. texel-read manual
// trilinear (R32F is not filterable). Both return LOWER-bound distances; the
// cone hit test stays conservative. min-mip 是保守下界（≤ 真距离）——正确用途
// 是"宽 footprint 内是否有表面"的命中检测，不是步进加速（路线图架构结论）。
// ============================================================================
float sampleSDFCascadeMipGLSL(texture3D mipTex, vec3 worldPos,
                              vec3 cascadeOrigin, vec3 cascadeExtent) {
    vec3 uvw = (worldPos - cascadeOrigin) / cascadeExtent;
    if (any(lessThan(uvw, vec3(0.0))) || any(greaterThan(uvw, vec3(1.0)))) return 1e10;
    ivec3 size = textureSize(mipTex, 0);
    vec3 p = clamp(uvw, vec3(0.0), vec3(1.0)) * vec3(size) - 0.5;
    ivec3 base = ivec3(clamp(floor(p), vec3(0.0), vec3(size) - 1.0));
    vec3 f = fract(p);
    ivec3 c1 = min(base + ivec3(1), size - ivec3(1));
    float d000 = texelFetch(mipTex, ivec3(base.x, base.y, base.z), 0).r;
    float d100 = texelFetch(mipTex, ivec3(c1.x,  base.y, base.z), 0).r;
    float d010 = texelFetch(mipTex, ivec3(base.x, c1.y,  base.z), 0).r;
    float d110 = texelFetch(mipTex, ivec3(c1.x,  c1.y,  base.z), 0).r;
    float d001 = texelFetch(mipTex, ivec3(base.x, base.y, c1.z), 0).r;
    float d101 = texelFetch(mipTex, ivec3(c1.x,  base.y, c1.z), 0).r;
    float d011 = texelFetch(mipTex, ivec3(base.x, c1.y,  c1.z), 0).r;
    float d111 = texelFetch(mipTex, ivec3(c1.x,  c1.y,  c1.z), 0).r;
    return mix(mix(mix(d000, d100, f.x), mix(d010, d110, f.x), f.y),
               mix(mix(d001, d101, f.x), mix(d011, d111, f.x), f.y), f.z);
}

// footprint → mip level（mip_textures[L] = 2^(L+1)× 粗于基础层）。
float coneMipLevelGLSL(float footprint, float voxelSize, float maxMip) {
    return floor(clamp(log2(max(footprint / (voxelSize * 2.0), 1.0)), 0.0, maxMip - 1.0));
}

// T3.3 消费者：cone 命中检测——march 耗尽后，用 min-mip 判定"该方向宽
// footprint 内是否有表面"；有 → 记 far 遮挡（不累积天空 radiance）。
bool coneHitOccluded(texture3D mip0, texture3D mip1, texture3D mip2,
                     vec3 probePos, vec3 rayDir, float travelled, float maxDist,
                     float rays) {
    int baseRes = textureSize(sdf0, 0).x;
    int m0Res = textureSize(mip0, 0).x;
    if (baseRes <= 0 || m0Res <= 0 || m0Res >= baseRes) return false;  // 链不存在
    vec3 org = itp.params.sdf_origins[0].xyz;
    vec3 ext = itp.params.sdf_extents[0].xyz;

    // ray-AABB slab：采样 t 钳制进 [tEnter, tExit] ∩ [0, min(travelled, maxDist)]。
    // 耗尽射线的端点通常在体积外，不钳制则读到 1e10 哨兵、检测永不触发。
    vec3 invD = mix(vec3(1e8), 1.0 / rayDir, greaterThan(abs(rayDir), vec3(1e-8)));
    vec3 t0s = (org - probePos) * invD;
    vec3 t1s = (org + ext - probePos) * invD;
    vec3 tsm = min(t0s, t1s), tbg = max(t0s, t1s);
    float tEnter = max(max(tsm.x, tsm.y), max(tsm.z, 0.0));
    float tExit = min(min(tbg.x, tbg.y), tbg.z);
    if (tExit <= tEnter) return false;               // 射线不穿体积
    float sampleT = min(min(travelled, maxDist), tExit);
    if (sampleT <= tEnter) return false;             // 体积内交点段为空
    vec3 samplePos = probePos + rayDir * sampleT;

    const float rayAngle = sqrt(12.566371 / max(rays, 1.0));  // ≈sqrt(4π/N) cosine 半角
    float footprint = sampleT * rayAngle;
    if (footprint <= 0.0) return false;
    float voxel0 = ext.x / float(baseRes);
    float level = coneMipLevelGLSL(footprint, voxel0, 3.0);
    float mipD;
    if (level < 0.5) {
        mipD = sampleSDFCascadeMipGLSL(mip0, samplePos, org, ext);
    } else if (level < 1.5) {
        if (textureSize(mip1, 0).x >= baseRes) return false;  // 链比请求层级短
        mipD = sampleSDFCascadeMipGLSL(mip1, samplePos, org, ext);
    } else {
        if (textureSize(mip2, 0).x >= baseRes) return false;
        mipD = sampleSDFCascadeMipGLSL(mip2, samplePos, org, ext);
    }
    return mipD < footprint * 0.5;
}

// Apple Silicon: else-if cascade selection = 1 texture3D read per step (not 3)
// 2026-09-10 C3.5 slice 1: drop the ×sdf_extents multiplier — the GlobalSDF
// voxelization stores RAW METERS (GlobalSDFVoxelizationGLSL.comp imageStores
// min_dist unscaled; DDGITraceSDF's sampler reads .r directly as meters too).
// The old ×extent made every d value ~42× too large and the march dimensionally
// meaningless.
float sampleSDF(vec3 pos) {
    if (itp.params.sdf_cascade_count > 0u) {
        vec3 local_p = (pos - itp.params.sdf_origins[0].xyz) / itp.params.sdf_extents[0].xyz;
        vec3 uvw = local_p * 0.5 + 0.5;
        if (uvw.x >= 0.0 && uvw.x <= 1.0 && uvw.y >= 0.0 && uvw.y <= 1.0 && uvw.z >= 0.0 && uvw.z <= 1.0)
            return sampleSDFNearest(sdf0, uvw);
    }
    if (itp.params.sdf_cascade_count > 1u) {
        vec3 local_p = (pos - itp.params.sdf_origins[1].xyz) / itp.params.sdf_extents[1].xyz;
        vec3 uvw = local_p * 0.5 + 0.5;
        if (uvw.x >= 0.0 && uvw.x <= 1.0 && uvw.y >= 0.0 && uvw.y <= 1.0 && uvw.z >= 0.0 && uvw.z <= 1.0)
            return sampleSDFNearest(sdf1, uvw);
    }
    if (itp.params.sdf_cascade_count > 2u) {
        vec3 local_p = (pos - itp.params.sdf_origins[2].xyz) / itp.params.sdf_extents[2].xyz;
        vec3 uvw = local_p * 0.5 + 0.5;
        if (uvw.x >= 0.0 && uvw.x <= 1.0 && uvw.y >= 0.0 && uvw.y <= 1.0 && uvw.z >= 0.0 && uvw.z <= 1.0)
            return sampleSDFNearest(sdf2, uvw);
    }
    return 1e6;
}

// --------------------------------------------------------------------------------
void surface_cache_indirect_trace()
{
    uint probe_x = gl_GlobalInvocationID.x;
    uint probe_y = gl_GlobalInvocationID.y;
    if (itp.params.tile_size == 0u) return;
    uint tiles_x = itp.params.sc_params.atlas_size / itp.params.tile_size;
    uint probe_idx = probe_y * tiles_x + probe_x;
    // C3.5 slice 2: stride amortization — non-refreshed tiles exit before the
    // march. Over `refresh_stride` frames every tile is traced exactly once.
    if (itp.params.refresh_stride > 1u &&
        (probe_idx % itp.params.refresh_stride) != itp.params.refresh_phase) return;

    uvec2 tile_origin = uvec2(probe_x * itp.params.tile_size + itp.params.tile_size / 2u,
                              probe_y * itp.params.tile_size + itp.params.tile_size / 2u);
    if (tile_origin.x >= itp.params.sc_params.atlas_size || tile_origin.y >= itp.params.sc_params.atlas_size) return;

    float depth = imageLoad(depth_atlas, ivec2(tile_origin)).r;
    if (depth <= 0.0) return;

    vec2 enc_n = imageLoad(normal_atlas, ivec2(tile_origin)).rg;
    vec3 probe_normal = octDecode(enc_n);

    // Find owning card for correct world position
    uint card_idx = findOwningCard(tile_origin, int(itp.params.sc_params.max_cards));
    if (card_idx >= itp.params.sc_params.max_cards) return;
    vec3 probe_pos = cardTexelToWorld(tile_origin, depth, cards.data[card_idx]);

    uint rays = itp.params.rays_per_probe;
    // 2026-09-10 C3.5 slice 1: real march parameters. The stub used 4 steps
    // with hitThreshold = cascade extent × 0.5 (21 m) — every ray "hit"
    // instantly and far hits resolved to the Phase-A 0.02 placeholder.
    // DDGI-style band from the finest cascade voxel, 32 steps, and a normal
    // offset so tiles starting ON a surface don't self-hit.
    float voxel0 = itp.params.sdf_extents[0].x / max(float(itp.params.sdf_resolutions[0]), 1.0);
    float hitThreshold = max(voxel0 * 1.25, 0.30);
    float minStep = voxel0 * 0.25;
    const uint kMaxSDFSteps = 32u;
    // Origin clearance must EXCEED hitThreshold — a start point inside the
    // hit band registers an instant t=0 self-hit (the tile reads its own
    // texel, and the "transport" degenerates into self-feedback).
    vec3 ray_origin = probe_pos + probe_normal * (hitThreshold + 0.05);
    for (uint r = 0u; r < rays; ++r) {
        float r1 = hash(vec2(float(probe_idx * rays + r), float(itp.params.frame_index)));
        float r2 = hash(vec2(float(itp.params.frame_index), float(probe_idx * rays + r))) * 2.0 * 3.14159265;
        float sin_t = sqrt(r1);
        float cos_t = sqrt(1.0 - r1);
        vec3 local_dir = vec3(cos_t * cos(r2), cos_t * sin(r2), sin_t);

        vec3 up = abs(probe_normal.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
        vec3 tangent = normalize(cross(up, probe_normal));
        vec3 bitangent = cross(probe_normal, tangent);
        vec3 ray_dir = normalize(tangent * local_dir.x + bitangent * local_dir.y + probe_normal * local_dir.z);

        float t = 0.0;
        bool hit = false;
        vec3 hit_pos = vec3(0.0);

        for (uint step = 0u; step < kMaxSDFSteps; ++step) {
            vec3 p = ray_origin + ray_dir * t;
            float d = sampleSDF(p);

            if (d < hitThreshold) { hit = true; hit_pos = p; break; }
            if (t > itp.params.max_ray_distance) break;

            // Relaxed advancement: overstep when far, conservative when close
            float advance;
            if (d > hitThreshold * 4.0) {
                advance = d * 1.2;
            } else {
                advance = max(d, minStep);
            }
            t += advance;
        }

        uint hit_idx = probe_idx * rays + r;
        // T3.2 (D7) → T3.3 消费者: march 耗尽（原判 sky）时做 cone 命中检测
        // ——宽 footprint 内 min-mip 报表面 → far 遮挡（不累积天空 radiance）。
        if (!hit && coneHitOccluded(sdf0_mip0, sdf0_mip1, sdf0_mip2,
                                    probe_pos, ray_dir, t, itp.params.max_ray_distance,
                                    float(rays))) {
            hit = true;
            hit_pos = probe_pos + ray_dir * min(t, itp.params.max_ray_distance);
        }
        ray_hits.data[hit_idx].hit_position_dist.w = t;
        if (hit && t < itp.params.near_distance) {
            ray_hits.data[hit_idx].hit_type_pad.x = 0u;
            ray_hits.data[hit_idx].hit_position_dist.xyz = hit_pos;
        } else if (hit) {
            ray_hits.data[hit_idx].hit_type_pad.x = 1u;
            ray_hits.data[hit_idx].hit_position_dist.xyz = hit_pos;
        } else {
            ray_hits.data[hit_idx].hit_type_pad.x = 2u;
            ray_hits.data[hit_idx].hit_position_dist.xyz = vec3(0.0);
        }
    }
}
