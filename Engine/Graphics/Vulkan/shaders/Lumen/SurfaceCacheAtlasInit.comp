#version 450 core
#extension GL_GOOGLE_include_directive : require
// Vulkan SurfaceCache AtlasInit — initializes the complete allocation invalid
// before real card capture. No card-dispatch upload is needed for production.
// SurfaceCacheParams._pad bit0 preserves the old per-card diagnostic dispatch.
//
// Entry point: surface_cache_atlas_init
// Dispatch: 1D, atlas width*height threads (legacy: per-card total_texels).
//
// Flat bindings:
//   0 = StorageImage(rgba8)  albedo_atlas   (write)
//   1 = StorageImage(rg16f)  normal_atlas   (write)
//   2 = StorageImage(r32f)   depth_atlas    (write)
//   3 = StorageImage(rgba16f) emissive_atlas (write)
//   4 = UniformBuffer        FlattenedLightingParams (for card_dispatch)
//   5 = readonly buffer      CardDispatchInfo card_dispatch[] (std430)
//   6 = buffer              triangle identity atlas (invalid clear)

#include "SurfaceCacheData.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8)  writeonly uniform image2D albedo_atlas;
layout(set = 0, binding = 1, rg16f)  writeonly uniform image2D normal_atlas;
layout(set = 0, binding = 2, r32f)   writeonly uniform image2D depth_atlas;
layout(set = 0, binding = 3, rgba16f) writeonly uniform image2D emissive_atlas;

layout(set = 0, binding = 4, std140) uniform ParamBlock {
    FlattenedLightingParams params;
} pb;

layout(set = 0, binding = 5, std430) readonly buffer CardDispatchBuf {
    CardDispatchInfo dispatch[];
} cd;

layout(set=0,binding=6,std430) buffer AtlasTriangles { uint data[]; } atlasTriangles;

void surface_cache_atlas_init() {
    uint tid = gl_GlobalInvocationID.x;
    const bool legacySurface = (pb.params.sc_params._pad & 1u) != 0u;
    ivec2 dims = imageSize(depth_atlas);
    ivec2 atlas_uv;
    if (legacySurface) {
        if (tid >= pb.params.total_texels) return;
        uint lo = 0u;
        uint hi = pb.params.card_count;
        while (lo < hi) {
            uint mid = (lo + hi) >> 1u;
            if (cd.dispatch[mid].texel_offset + cd.dispatch[mid].texel_count <= tid)
                lo = mid + 1u;
            else
                hi = mid;
        }
        if (lo >= pb.params.card_count) return;
        uint local_texel = tid - cd.dispatch[lo].texel_offset;
        uint res = cd.dispatch[lo].resolution;
        atlas_uv = ivec2(int(cd.dispatch[lo].atlas_offset_x + local_texel % res),
                         int(cd.dispatch[lo].atlas_offset_y + local_texel / res));
    } else {
        if (tid >= uint(dims.x) * uint(dims.y)) return;
        atlas_uv = ivec2(int(tid % uint(dims.x)), int(tid / uint(dims.x)));
    }

    atlasTriangles.data[uint(atlas_uv.y)*uint(imageSize(depth_atlas).x)+uint(atlas_uv.x)]=0xffffffffu;

    // [P0 有效性种子 2026-09-20] 未捕获 texel 显式无效：alpha=0（LightEval
    // 门跳过，不为幽灵表面算光照）、depth=-1（查询契约 depth<0 直接拒绝）。
    // 旧种子 alpha=1/depth=0.5 伪造"卡平面前 0.5m 的灰色表面"——恰落在
    // 0.9 查询容差带内被当合法测量接受（均匀灰填充源之一）。CardFill 每帧
    // 用 SDF 命中回填几何 texel（alpha=1），card-view 捕获再覆盖为真实
    // 材质；种子只需保证 atlas 非垃圾，不必伪造测量。
    imageStore(albedo_atlas,   atlas_uv, vec4(0.0, 0.0, 0.0, 0.0));
    imageStore(normal_atlas,   atlas_uv, vec4(0.5, 0.5, 0.0, 1.0));
    imageStore(depth_atlas,    atlas_uv, vec4(-1.0, 0.0, 0.0, 1.0));
    imageStore(emissive_atlas, atlas_uv, legacySurface ? vec4(0.0, 0.0, 0.0, 1.0) : vec4(0.0));
}
