// ----------------------------------------------------------------------------
// Helpers (copied from DDGITraceRays.comp)
// ----------------------------------------------------------------------------

// ddgiRayDirection moved to ShaderLib/ProbeSampleLib.glsl (ddgiSampleRayDirection)
// — single source shared with the trace side.

uvec3 ddgiProbeGridCoord(uint probeIdx, uvec3 counts) {
    uint pz  = probeIdx / (counts.x * counts.y);
    uint rem = probeIdx % (counts.x * counts.y);
    uint py  = rem / counts.x;
    uint px  = rem % counts.x;
    return uvec3(px, py, pz);
}

vec3 ddgiProbeWorldPos(uvec3 gc, vec3 origin, float spacing) {
    return origin + vec3(float(gc.x), float(gc.y), float(gc.z)) * spacing;
}

// Manual bilinear over the lighting atlas (samplerless, clamp-to-edge).
vec3 sampleAtlasBilinear(vec2 uvPx) {
    float atlasSize = float(volume.SCAtlasSize);
    vec2 coord = clamp(uvPx, vec2(0.0), vec2(atlasSize - 1.0)) - 0.5;
    ivec2 base = ivec2(int(floor(coord.x)), int(floor(coord.y)));
    vec2 f = clamp(fract(coord), vec2(0.0), vec2(1.0));
    int maxC = int(atlasSize) - 1;

    vec3 c00 = texelFetch(lighting_atlas, clamp(base,                ivec2(0), ivec2(maxC)), 0).rgb;
    vec3 c10 = texelFetch(lighting_atlas, clamp(base + ivec2(1, 0),  ivec2(0), ivec2(maxC)), 0).rgb;
    vec3 c01 = texelFetch(lighting_atlas, clamp(base + ivec2(0, 1),  ivec2(0), ivec2(maxC)), 0).rgb;
    vec3 c11 = texelFetch(lighting_atlas, clamp(base + ivec2(1, 1),  ivec2(0), ivec2(maxC)), 0).rgb;

    return c00 * (1.0 - f.x) * (1.0 - f.y)
         + c10 * f.x * (1.0 - f.y)
         + c01 * (1.0 - f.x) * f.y
         + c11 * f.x * f.y;
}

// Screen-space radiance sampling at a world-space hit position (Mode 11
// approach): project to screen, sample prev_frame_color which has real
// material colors + lighting variation. This gives DDGI colored bounce
// light (warm reds from brick, cool grays from stone) instead of the
// uniform pale yellow the SC atlas produces while its Capture coverage
// is still ~0.1%.
// A projected point is usable only if raster depth represents the same
// surface. Reject sky, offscreen, and occluded hits before reading any color.
// The 0.15 world-unit limit is conservative: coarse SDF hits with larger
// position error must use world-space lighting instead of borrowing a pixel.
bool projectVisibleHit(vec3 hitPos, mat4 viewProjection, mat4 inverseVP,
                       texture2D depthTexture, out ivec2 texel, out uint reject) {
    reject=10u; // Behind camera.
    vec4 clip = viewProjection * vec4(hitPos, 1.0);
    if (clip.w <= 0.0) return false;
    vec3 ndc = clip.xyz / clip.w;
    reject=11u; // Outside view frustum.
    if (any(lessThan(ndc, vec3(-1.0, -1.0, 0.0))) ||
        any(greaterThan(ndc, vec3(1.0)))) return false;
    ivec2 dims = textureSize(depthTexture, 0);
    vec2 uv = vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
    texel = clamp(ivec2(uv * vec2(dims)), ivec2(0), dims - 1);
    float depth = texelFetch(depthTexture, texel, 0).r;
    reject=12u; // Sky/invalid raster depth.
    if (depth >= 1.0 || depth < 0.0) return false;
    vec2 center = (vec2(texel) + 0.5) / vec2(dims);
    vec4 surface = inverseVP * vec4(center.x * 2.0 - 1.0,
                                    1.0 - center.y * 2.0, depth, 1.0);
    reject=13u; // Invalid reconstruction homogeneous coordinate.
    if (abs(surface.w) < 1e-6) return false;
    reject=14u; // Raster surface differs from the coarse SDF hit point.
    return distance(surface.xyz / surface.w, hitPos) <= vp.screenValidity.z;
}

bool samplePrevColor(vec3 hitPos, out vec3 radiance) {
    radiance = vec3(0.0);
    if (vp.screenValidity.y < 0.5) return false;
    ivec2 texel;
    uint reject;
    if (!projectVisibleHit(hitPos, vp.radianceViewProjection,
                           vp.inverseRadianceViewProjection, radiance_depth, texel,reject)) return false;
    if (any(notEqual(textureSize(prev_frame_color, 0), textureSize(radiance_depth, 0)))) return false;
    radiance = texelFetch(prev_frame_color, texel, 0).rgb;
    if (any(isnan(radiance)) || any(isinf(radiance))) return false;
    radiance = max(radiance, vec3(0.0));
    return true; // Valid black is a measurement, not a missing sample.
}

vec3 sampleHitAlbedo(vec3 hitPos, out uint source) {
    source=1u; // Screen resources unavailable: uniform volume fallback.
    if (vp.screenValidity.x < 0.5) return volume.Albedo.xyz;
    ivec2 texel;
    if (!projectVisibleHit(hitPos, vp.viewProjection, vp.inverseViewProjection,
                           screen_depth, texel,source)) return volume.Albedo.xyz;
    source=3u; // GBuffer/depth dimensions mismatch.
    if (any(notEqual(textureSize(gbuffer_albedo, 0), textureSize(screen_depth, 0)))) return volume.Albedo.xyz;
    source=4u; // Depth-validated screen material.
    return clamp(texelFetch(gbuffer_albedo, texel, 0).rgb, vec3(0.0), vec3(1.0));
}

// ----------------------------------------------------------------------------
// Tetrahedral 4-probe SH interpolation (from DDGITraceRays.comp)
// Phase 1b: L2 常量随 shDot9 展开撤销（→ EvalLib 单源）；L0/L1 留给 shDot4。
// ----------------------------------------------------------------------------
const float _C0 = 0.282095;
const float _C1 = 0.488603;

struct TetraResult {
    uint pi[4];
    float bw[4];
};

TetraResult tetrahedral(vec3 gp, uvec3 gd) {
    TetraResult r;
    uvec3 b0 = clamp(uvec3(floor(gp)), uvec3(0u), gd - 1u);
    uvec3 b1 = min(b0 + 1u, gd - 1u);
    uint gx  = gd.x;
    uint gxy = gd.x * gd.y;

    uint p[8];
    p[0] = b0.x + b0.y * gx + b0.z * gxy;
    p[1] = b1.x + b0.y * gx + b0.z * gxy;
    p[2] = b0.x + b1.y * gx + b0.z * gxy;
    p[3] = b1.x + b1.y * gx + b0.z * gxy;
    p[4] = b0.x + b0.y * gx + b1.z * gxy;
    p[5] = b1.x + b0.y * gx + b1.z * gxy;
    p[6] = b0.x + b1.y * gx + b1.z * gxy;
    p[7] = b1.x + b1.y * gx + b1.z * gxy;

    float fx = fract(gp.x);
    float fy = fract(gp.y);
    float fz = fract(gp.z);

    if (fx >= fy && fy >= fz) {
        r.pi[0]=p[0]; r.pi[1]=p[1]; r.pi[2]=p[3]; r.pi[3]=p[7];
        r.bw[0]=1.0-fx; r.bw[1]=fx-fy; r.bw[2]=fy-fz; r.bw[3]=fz;
    } else if (fx >= fz && fz >= fy) {
        r.pi[0]=p[0]; r.pi[1]=p[1]; r.pi[2]=p[5]; r.pi[3]=p[7];
        r.bw[0]=1.0-fx; r.bw[1]=fx-fz; r.bw[2]=fz-fy; r.bw[3]=fy;
    } else if (fy >= fx && fx >= fz) {
        r.pi[0]=p[0]; r.pi[1]=p[2]; r.pi[2]=p[3]; r.pi[3]=p[7];
        r.bw[0]=1.0-fy; r.bw[1]=fy-fx; r.bw[2]=fx-fz; r.bw[3]=fz;
    } else if (fy >= fz && fz >= fx) {
        r.pi[0]=p[0]; r.pi[1]=p[2]; r.pi[2]=p[6]; r.pi[3]=p[7];
        r.bw[0]=1.0-fy; r.bw[1]=fy-fz; r.bw[2]=fz-fx; r.bw[3]=fx;
    } else if (fz >= fx && fx >= fy) {
        r.pi[0]=p[0]; r.pi[1]=p[4]; r.pi[2]=p[5]; r.pi[3]=p[7];
        r.bw[0]=1.0-fz; r.bw[1]=fz-fx; r.bw[2]=fx-fy; r.bw[3]=fy;
    } else {
        r.pi[0]=p[0]; r.pi[1]=p[4]; r.pi[2]=p[6]; r.pi[3]=p[7];
        r.bw[0]=1.0-fz; r.bw[1]=fz-fy; r.bw[2]=fy-fx; r.bw[3]=fx;
    }
    for (uint i = 0u; i < 4u; i++) r.bw[i] = max(r.bw[i], 0.0);
    return r;
}

vec3 shDot4(vec3 c[4], vec3 d) {
    return c[0] * _C0
         + c[1] * (-_C1 * d.y)
         + c[2] * ( _C1 * d.z)
         + c[3] * (-_C1 * d.x);
}

// Full L0-L2 evaluation with the canonical basis (matches
// DDGIUpdateIrradiance's projection). The old 4-coefficient evaluation left
// the directional colour detail the SC path now projects into bands 4-8
// unread. Phase 1b: 展开 → EvalLib 单源（radiance 语义，纯 Σc_iY_i）。
vec3 shDot9(vec3 c[9], vec3 d) {
    return evalProbeRadianceSH9(c, d);
}

// Previous-frame probe irradiance at a world position (multi-bounce feedback).
// This is the self-circulating term: L_i_prev sampled at the hit position
// carries the previous frame's accumulated GI (which includes earlier bounces'
// albedo colors). Each frame adds one more bounce, each tinted by the
// surface's albedo — producing colored multi-bounce GI.
vec3 samplePrevProbeGrid(vec3 pos, vec3 N) {
    vec3 origin = volume.ProbeOrigin.xyz;
    float spacing = volume.ProbeSpacing;
    uvec3 counts = volume.ProbeCounts.xyz;
    vec3 gp = (pos - origin) / spacing;
    vec3 gridMax = vec3(float(counts.x - 1u), float(counts.y - 1u), float(counts.z - 1u));
    if (any(lessThan(gp, vec3(0.0))) || any(greaterThan(gp, gridMax))) {
        return vec3(0.0);
    }
    TetraResult tet = tetrahedral(gp, counts);
    vec3 result = vec3(0.0);
    float totalWeight = 0.0;
    // irradiance_history: vec4[9] per probe (16B-stride structured elements).
    for (uint p = 0u; p < 4u; p++) {
        if (tet.bw[p] < 0.001) continue;
        uint base = tet.pi[p] * 9u;
        vec3 sh[9];
        for (uint i = 0u; i < 9u; i++) {
            sh[i] = ih.irradiance_history[base + i].xyz;
        }
        // Opt-in corrected diffuse history: EvalLib returns E(N)/pi.
        // Convolve BEFORE interpolation (linear); positivity AFTER it.
        vec3 irradiance = volume.SkyColor.w>1.5
            ? evalProbeIrradianceSH9(sh,N) : shDot9(sh, N);
        result += irradiance * tet.bw[p];
        totalWeight += tet.bw[p];
    }
    if (totalWeight > 0.0) {
        vec3 value=result/totalWeight;
        return volume.SkyColor.w>1.5?max(value,vec3(0.0)):value;
    }
    return vec3(0.0);
}

// ----------------------------------------------------------------------------
// Main
// ----------------------------------------------------------------------------

void ddgi_trace_finalize() {
    uint tid      = gl_LocalInvocationID.y * 8u + gl_LocalInvocationID.x;
    // One group per probe — must match DDGITraceSDF (see the note there).
    // gl_GlobalInvocationID.x mixed the ray-lane x into the probe index, so
    // only 16 of 128 rays per probe were ever finalized (stale -1 elsewhere).
    uint group_id = gl_WorkGroupID.x;

    // ---- Phase 0 removed (T1.3): card lookup now goes through the uniform
    //      grid — no cooperative preload, no barrier, no shared memory. ----

    if (group_id >= volume.ProbeUpdateCount) return;
    if (tid >= volume.RaysPerProbe) return;

    uint probeIdx = pul.probe_update_list[group_id];
    if (probeIdx >= volume.ProbeCountTotal) return;

    // T8.13 P2: lane-strided ray loop (mirrors DDGITraceSDF).
    for (uint rayId = tid; rayId < volume.RaysPerProbe; rayId += 64u) {
    uint globalRayIdx = group_id * volume.RaysPerProbe + rayId;
    float hitDistance = hd.hit_distance[globalRayIdx];

    uvec3 counts = volume.ProbeCounts.xyz;
    uvec3 gc = ddgiProbeGridCoord(probeIdx, counts);
    vec3 probePos = ddgiProbeWorldPos(gc, volume.ProbeOrigin.xyz, volume.ProbeSpacing);
    // P0 坐标契约：射线起点 = TraceSDF 本帧发布的有效（重定位后）起点。
    // 首帧该 probe 尚未被 trace（w=0）时回退逻辑格点——与旧行为一致。
    // DDGI_LEGACY_CONSUMERS=1（编译期变体，-DDDGI_LEGACY_CONSUMERS，C++ 侧
    // 按 env 选择 bytecode）：归因 A/B——消费端回到旧原格点行为（缓冲仍写）。
    vec3 rayOrigin = probePos;
#ifndef DDGI_LEGACY_CONSUMERS
    if (robuf.relocated_origin[probeIdx].w > 0.5) {
        rayOrigin = robuf.relocated_origin[probeIdx].xyz;
    }
#endif
    vec3 rayDir = ddgiSampleRayDirection(rayId, volume.RaysPerProbe,
                                         volume.FrameIndex,
                                         uint(volume.RaySampleMode),
                                         (volume.LightDirection.xyz[0]*volume.LightDirection.xyz[0] + volume.LightDirection.xyz[1]*volume.LightDirection.xyz[1] + volume.LightDirection.xyz[2]*volume.LightDirection.xyz[2] > 1e-8 ? normalize(-volume.LightDirection.xyz) : vec3(0.0, -1.0, 0.0))).xyz;

#if defined(DDGI_ANALYTIC_FIRST_RHO_VARIANT) && DDGI_ANALYTIC_FIRST_RHO_VARIANT
    const float analyticRhoMode = volume.SdfExtents[1].w;
    const bool analyticRhoAudit = (analyticRhoMode == 3.0 || analyticRhoMode == 4.0 ||
                                   analyticRhoMode == 6.0 || analyticRhoMode == 7.0) &&
                                  volume.Albedo.w > 0.5;
    const bool analyticScFirstAudit = analyticRhoMode == 7.0 && analyticRhoAudit;
    const bool analyticRhoApply = analyticRhoMode == 1.0 || analyticRhoMode == 3.0;
    const bool analyticPositionApply = analyticRhoMode == 5.0 || analyticRhoMode == 6.0;
    bool analyticPositionApplied = false;
    const uint analyticRhoBase = 16u * globalRayIdx;
    const vec4 analyticRhoOriginalHN = hnb.hit_normal[globalRayIdx];
    DDGIAnalyticFirstRhoResult analyticRho;
    ddgiAnalyticFirstRhoClear(analyticRho);
    uint analyticRhoPath = 0u; // 1=SC, 2=prev-screen, 3=analytic, 4=miss
    uint analyticRhoAlbedoSource = 0u;
    if (analyticRhoAudit) {
        analytic_rho_audit.records[analyticRhoBase + 0u] =
            vec4(rayOrigin, uintBitsToFloat(((volume.FrameIndex & 65535u) << 16u) | (probeIdx + 1u)));
        analytic_rho_audit.records[analyticRhoBase + 1u] =
            vec4(rayDir, float(rayId + 1u));

        analytic_rho_audit.records[analyticRhoBase + 14u] =
            hnb.hit_normal[globalRayIdx];
    }
#endif

    // Record the exact origin/direction used by Finalize.  The fourth lane
    // carries a frameLo16/probePlus1Lo16 word and rayId+1 for joins;
    // xyz remains the unmodified shader value. This is diagnostic-only.
    if (volume.Albedo.w > 0.5) {
        uint sourceBase = 5u * volume.ProbeCountTotal * volume.RaysPerProbe +
                          4u * globalRayIdx;
        hnb.hit_normal[sourceBase + 2u] = vec4(rayOrigin, uintBitsToFloat(((volume.FrameIndex & 65535u) << 16u) | (probeIdx + 1u)));
        hnb.hit_normal[sourceBase + 3u] = vec4(rayDir, float(rayId + 1u));
    }

    vec4 result = vec4(vec3(0.0), -1.0);   // default = exhausted miss（黑，非天空）
    bool analyticAudit=volume.SdfVoxelSizes[0].w>.5;
    uint auditBase=volume.ProbeCountTotal*volume.RaysPerProbe+4u*globalRayIdx;
    if (analyticAudit) {
        hnb.hit_normal[auditBase]=vec4(0.0);
        hnb.hit_normal[auditBase+1u]=vec4(0.0);
        hnb.hit_normal[auditBase+2u]=vec4(0.0);
    }
    // Query-source audit is an exact host-latched Vulkan diagnostic.  Keep
    // all initialization inside this guard so the incumbent N/5N/9N storage
    // and writes remain untouched when it is disabled.
    bool querySourceAudit = volume.SdfExtents[2].w > 0.5;
    uint queryAuditBase = 9u * volume.ProbeCountTotal * volume.RaysPerProbe +
                          18u * globalRayIdx;
    uint querySelectedCard = 0u;
    float queryBestKey = 1e30;
    uint queryCell = 0xFFFFFFFFu;
    if (querySourceAudit) {
        vec3 queryHeaderPos = rayOrigin; // Hit branch records the actual reused hitPos below.
        uint queryStamp = ((volume.FrameIndex & 65535u) << 16u) | (probeIdx + 1u);
        hnb.hit_normal[queryAuditBase] =
            vec4(queryHeaderPos, uintBitsToFloat(queryStamp));
        hnb.hit_normal[queryAuditBase + 1u] =
            vec4(1e30, 0.0, uintBitsToFloat(0xFFFFFFFFu), float(rayId + 1u));
        for (uint i = 0u; i < 16u; ++i) {
            hnb.hit_normal[queryAuditBase + 2u + i] =
                vec4(0.0, 1e30, 0.0, uintBitsToFloat(0xFFFFFFFFu));
        }
    }
#ifdef DDGI_PATH_DEBUG
    uint dbgPath = 0u;  // 1=SC atlas 2=prev-screen 3=analytic (miss stays 0)
    uint dbgSCReject = 0u; // dominant failed SC stage; 8=no cell, 9=empty cell
    uint dbgCardIdx = 0u;
    uvec2 dbgAtlasTexel = uvec2(0u);
#endif

    if (hitDistance >= 0.0) {
        // ---- Hit: SC-first radiance hierarchy ----
        // 1. Surface Cache lighting atlas — the cached final lighting; its own
        //    feedback already accumulates multi-bounce light, so no extra
        //    albedo × L_i_prev term is added on this path (that would count
        //    the same bounce twice).
        // 2. Depth-validated screen radiance, including valid black.
        // 3. Sky + world-probe bounce as the last resort.
        vec3 hitPos = rayOrigin + rayDir * hitDistance;
        if (querySourceAudit) {
            uint queryStamp = ((volume.FrameIndex & 65535u) << 16u) | (probeIdx + 1u);
            hnb.hit_normal[queryAuditBase] = vec4(hitPos, uintBitsToFloat(queryStamp));
        }
        result.w = hitDistance;

        // T4.3: real gradient normal when the detail-SDF refinement ran;
        // -rayDir fake otherwise (bit-identical default behavior).
        vec3 N = -rayDir;
        {
            const vec4 hn = hnb.hit_normal[globalRayIdx];
            if (hn.w > 0.5 && dot(hn.xyz, hn.xyz) > 0.25) {
                N = normalize(hn.xyz);
            }
        }
        uint albedoSource;
        vec3 materialPos=hitPos;
        bool materialProjected=false;
        if (analyticAudit && volume.SdfExtents[0].w>.5) {
            vec4 projected=hnb.hit_normal[auditBase+3u];
            if (projected.w>.5) {
                materialPos=projected.xyz;
                materialProjected=true;
            }
        }
        vec3 albedo = sampleHitAlbedo(materialPos,albedoSource);
        // A failed projected lookup must not discard a previously valid
        // original material measurement. No visibility tolerance relaxation.
        if (materialProjected && albedoSource!=4u)
            albedo=sampleHitAlbedo(hitPos,albedoSource);
#if defined(DDGI_ANALYTIC_FIRST_RHO_VARIANT) && DDGI_ANALYTIC_FIRST_RHO_VARIANT
        analyticRhoAlbedoSource = albedoSource;
#endif
#if defined(DDGI_ANALYTIC_FIRST_RHO_VARIANT) && DDGI_ANALYTIC_FIRST_RHO_VARIANT
        analyticRhoAlbedoSource = albedoSource;
#endif

        bool scUsed = false;
#if defined(DDGI_ANALYTIC_FIRST_RHO_VARIANT) && DDGI_ANALYTIC_FIRST_RHO_VARIANT
        bool analyticRhoPrevUsed = false;
#endif
        {
            uint deviceReads = 0u;
            const uint kMaxDeviceReads = 16u;
            SCGridParams gp = scGridLoad();
            uint cell = scGridCellIndex(gp, hitPos);
            if (cell != 0xFFFFFFFFu) {
                if (querySourceAudit) queryCell = cell;
                uint begin = scgo.sc_grid_offsets[16u + cell];
                uint end   = scgo.sc_grid_offsets[17u + cell];
#ifdef DDGI_PATH_DEBUG
                if (begin == end) dbgSCReject = 9u;
                uint failCount[8];
                for (uint i = 0u; i < 8u; ++i) failCount[i] = 0u;
#endif
                // C (plan §三.C): unified query contract over ALL candidates —
                // replaces the T3.4 plane test's extent-proportional
                // single-sided tolerance (0.35×extent accepted captures metres
                // in front of interior hits on big AABB cards), the
                // first-pass-accept break (card-list-order dependent), and the
                // >0 luminance gate (valid black was rejected). Candidates now
                // validate capture depth, side orientation vs the incoming
                // ray, decomposed along/perp error, and the min-key match
                // wins. See SurfaceCacheData.glsl::scQueryCardCandidate.
                float bestKey = 1e30;
                for (uint gi = begin; gi < end && deviceReads < kMaxDeviceReads; ++gi) {
                    uint cardIdx = scgc.sc_grid_cards[gi];
                    if (cardIdx >= 4096u) continue;
                    SurfaceCacheCard card = cd.card_data[cardIdx];
                    uint queryCandidateSlot = deviceReads;
                    ++deviceReads;
                    vec3 scRadiance;
                    float key = 1e30;
                    uint reject = 0u;
                    bool accepted;
#ifdef DDGI_PATH_DEBUG
                    // PATH_DEBUG already uses the diagnostic wrapper and
                    // emits the existing path/card labels.  Query audit
                    // reuses this same invocation and only adds the raw
                    // per-candidate record below.
                    accepted = scQueryCardCandidateDbg(card, hitPos, -rayDir,
                                                       max(volume.SdfVoxelSizes[0].x * 1.25, 0.45),
                                                       0.0, depth_atlas, lighting_atlas,
                                                       vec3(0.0), scRadiance, key, reject);
                    if (!accepted && reject < 8u) failCount[reject]++;
#else
                    if (querySourceAudit) {
                        // The debug wrapper is the same query algorithm with
                        // an outReject result.  Calling it only for this
                        // diagnostic avoids inventing a second predicate while
                        // keeping the production wrapper on the default path.
                        accepted = scQueryCardCandidateDbg(card, hitPos, -rayDir,
                                                           max(volume.SdfVoxelSizes[0].x * 1.25, 0.45),
                                                           0.0, depth_atlas, lighting_atlas,
                                                           vec3(0.0), scRadiance, key, reject);
                    } else {
                        accepted = scQueryCardCandidate(card, hitPos, -rayDir,
                                                        max(volume.SdfVoxelSizes[0].x * 1.25, 0.45),
                                                        depth_atlas, lighting_atlas,
                                                        vec3(0.0), scRadiance, key);
                    }
#endif
                    if (querySourceAudit) {
                        uint packedTexel = 0xFFFFFFFFu;
                        vec2 candidateUV;
                        if (volume.SCAtlasSize > 0u &&
                            worldToCardUVMarginPad(hitPos, card, candidateUV,
                                1.0 / float(max(card.resolution, 1u)), 0.0) &&
                            !any(isnan(candidateUV)) && !any(isinf(candidateUV))) {
                            uvec2 texel = uvec2(clamp(candidateUV, vec2(0.0),
                                vec2(card.atlas_offset_x + card.resolution - 1u,
                                     card.atlas_offset_y + card.resolution - 1u)));
                            packedTexel = texel.y * volume.SCAtlasSize + texel.x;
                        }
                        hnb.hit_normal[queryAuditBase + 2u + queryCandidateSlot] =
                            vec4(float(cardIdx + 1u), key, float(reject),
                                 uintBitsToFloat(packedTexel));
                    }
                    if (accepted) {
                        if (key < bestKey) {
                            bestKey = key;
                            result.xyz = scRadiance;
                            scUsed = true;
                            if (querySourceAudit) {
                                queryBestKey = key;
                                querySelectedCard = cardIdx + 1u;
                            }
#ifdef DDGI_PATH_DEBUG
                            dbgPath = 1u;
                            dbgCardIdx = cardIdx;
                            vec2 dbgUV;
                            if (worldToCardUVMarginPad(hitPos, card, dbgUV,
                                    1.0 / float(max(card.resolution, 1u)), 0.0)) {
                                dbgAtlasTexel = uvec2(clamp(dbgUV, vec2(0.0),
                                    vec2(card.atlas_offset_x + card.resolution - 1u,
                                         card.atlas_offset_y + card.resolution - 1u)));
                            }
#endif
                        }
                    }
                }
#ifdef DDGI_PATH_DEBUG
                if (!scUsed && deviceReads > 0u) {
                    uint most = 0u;
                    for (uint reason = 1u; reason <= 6u; ++reason) {
                        if (failCount[reason] > most) {
                            most = failCount[reason];
                            dbgSCReject = reason;
                        }
                    }
                    if (most == 0u) dbgSCReject = 10u;
                }
#endif
            } else {
#ifdef DDGI_PATH_DEBUG
                dbgSCReject = 8u;
#endif
            }
        }
        if (querySourceAudit) {
            // Publish the actual min-key winner only after the complete
            // production candidate loop.  A miss keeps the initialized
            // selected=0/key=1e30/cell=0xffffffff header above.
            hnb.hit_normal[queryAuditBase + 1u] =
                vec4(queryBestKey, float(querySelectedCard),
                     uintBitsToFloat(queryCell), float(rayId + 1u));
        }
        // Diagnostic-only source witness for rays that actually selected SC.
        // Reuse the already-bound native BVH/material/texture path; no sampled
        // first-point radiance replaces the incumbent SC result.
#if defined(DDGI_ANALYTIC_FIRST_RHO_VARIANT) && DDGI_ANALYTIC_FIRST_RHO_VARIANT
        if (analyticScFirstAudit && scUsed) {
            DDGIFirstSurfaceHit scFirst = ddgiFirstSurfaceTrace(
                rayOrigin, rayDir, 0.0, volume.RayMaxDistance);
            analyticRho = ddgiAnalyticFirstRhoEvaluate(
                scFirst, rayOrigin, rayDir, hitDistance, albedo, false);
        }
#endif
#if defined(DDGI_ANALYTIC_FIRST_RHO_VARIANT) && DDGI_ANALYTIC_FIRST_RHO_VARIANT
        if (scUsed) analyticRhoPath = 1u;
#endif
        if (!scUsed) {
            vec3 prevRadiance;
            if (samplePrevColor(hitPos, prevRadiance)) {
                // Screen radiance already includes this surface's material
                // response. Adding another albedo-colored source creates energy.
                // Phase 1.4（R4）: 过亮惩罚——prev-screen 是含直射 ×50 单位的
                // 上一帧融合色，无惩罚回喂探针 = 直射绕过遮挡二次入账（历史
                // 上还叠加了 ×3 融合增益）。对齐 SPGI finalize / SSGI 的
                // 1/(1+max(lum-1,0)·2)：直射热点被压回间接量级。
                float prevLum = dot(prevRadiance, vec3(0.2126, 0.7152, 0.0722));
                prevRadiance *= 1.0 / (1.0 + max(prevLum - 1.0, 0.0) * 2.0);
                result.xyz = prevRadiance;
#if defined(DDGI_ANALYTIC_FIRST_RHO_VARIANT) && DDGI_ANALYTIC_FIRST_RHO_VARIANT
                analyticRhoPrevUsed = true;
                analyticRhoPath = 2u;
#endif
#ifdef DDGI_PATH_DEBUG
                dbgPath = 2u;
#endif
            } else {
                vec3 historyPos = hitPos;
#if defined(DDGI_ANALYTIC_FIRST_RHO_VARIANT) && DDGI_ANALYTIC_FIRST_RHO_VARIANT
                analyticRho.old_rho = albedo;
                if (albedoSource == 11u || albedoSource == 14u) {
                    DDGIFirstSurfaceHit rhoFirst = ddgiFirstSurfaceTrace(
                        rayOrigin, rayDir, 0.0, volume.RayMaxDistance);
                    analyticRho = ddgiAnalyticFirstRhoEvaluate(
                        rhoFirst, rayOrigin, rayDir, hitDistance, albedo,
                        analyticRhoApply);
                    if (analyticRho.status == DDGI_RHO_STATUS_ACCEPTED)
                        albedo = analyticRho.sample_rho;
                    if (analyticPositionApply &&
                        analyticRho.status == DDGI_RHO_STATUS_CONTROL &&
                        analyticRho.first_t > hitDistance + DDGI_RHO_RESIDUAL_GATE) {
                        historyPos = rayOrigin + rayDir * analyticRho.first_t;
                        analyticPositionApplied = true;
                    }
                } else {
                    analyticRho.status = DDGI_RHO_STATUS_SOURCE;
                }
#endif
                vec3 L_i_prev = samplePrevProbeGrid(historyPos, N);
                // Analytic: sky floor + single diffuse bounce.
                // C3.1: the old unshadowed E_direct here injected sunlight
                // through walls for every ray whose SC/prev-screen lookups
                // failed — this path must only fill "black", never "bright".
                // E_sky stays as a dim environmental floor (×0.3).
                // Phase 2.1（本方案）: 反馈回路物理化——旧手工系数 0.70 删除，
                // 改为扩散一跳 L_bounce = (ρ/π)·E_prev。samplePrevProbeGrid
                // 返回未乘 π 的 SH 辐亮度评估，故 E_prev = π·L_i_prev；回路
                // 稳态增益 = ρ（材质反照率，<1 保证几何收敛），不再有手工
                // 常数。（scsupply0 A/B 已证旧 0.70 回路把天空地板能量泵满
                // 封闭区——SC=0 后上拱仍 54.7 vs 参考 18.9。）
                float NdotUp = max(0.0, N.y);
                vec3 E_sky = volume.SkyColor.xyz * (0.5 + 0.5 * NdotUp) * 0.3;
                const float PI_VAL = 3.14159265358979;
                // Opt-in diagnostic only: SkyColor.w is set by the Vulkan
                // host for the analytic history diagnostics. Default0 retains exact
                // legacy one-hop history; no SC/direct/escape changes.
                // mode1 removes history; mode2 keeps rho*E/pi instead of
                // rho*L(N). PI here cancels the common /PI below exactly once.
                vec3 historyBounce=volume.SkyColor.w>.5 && volume.SkyColor.w<1.5
                    ?vec3(0.0):PI_VAL*L_i_prev;
                result.xyz = (albedo / PI_VAL) * (E_sky + historyBounce);
                if (analyticAudit) {
                    hnb.hit_normal[auditBase]=vec4(albedo,float(albedoSource));
                    hnb.hit_normal[auditBase+1u]=vec4((albedo/PI_VAL)*E_sky,1.0);
                    hnb.hit_normal[auditBase+2u]=vec4((albedo/PI_VAL)*historyBounce,1.0);
                }
#ifdef DDGI_PATH_DEBUG
                dbgPath = 3u;
#endif
#if defined(DDGI_ANALYTIC_FIRST_RHO_VARIANT) && DDGI_ANALYTIC_FIRST_RHO_VARIANT
                analyticRhoPath = 3u;
#endif
            }
        }
    } else if (hitDistance <= -1.5) {
#if defined(DDGI_ANALYTIC_FIRST_RHO_VARIANT) && DDGI_ANALYTIC_FIRST_RHO_VARIANT
        analyticRhoPath = 4u;
#endif
        // GI 根治 Phase 3.1 修复：逃逸射线的 w 编码对齐 Metal（-2）——旧实现
        // 只写 .xyz，w 保持默认 -1，update 端无法区分"逃逸（露天）"与
        // "步数耗尽（密闭）"，openSky 统计恒 0。天空能量值不变（xyz 仍由
        // EvaluateSkyBase × SkyColor 提供），只是分类位恢复正确。
        result.w = hitDistance;
        // 逃逸（越出 RayMaxDistance）——真正面向天空的射线，吃天空色。
        // P1.2: 共享 EvaluateSkyBase（与可见天空同源同色）。P0 校准：改乘
        // SkyColor.xyz——旧实现只乘 x 通道当强度门，逃逸射线拿到的是灰天空，
        // 与下方 SC-miss 回退路径的暖色 E_sky（×xyz）在同一探针网格里拼出
        // 灰/暖色块。两处统一为同一天空色度，能量仍由 SkyColor 档位控制。
        // 漫反射探针不含日晕热点（直射阳光由 SC 单独供给，防重复计能）。
        // Scene-wide lower environment boundary ablation. Zero suppression
        // preserves the old full-sphere horizon environment exactly. Only
        // escaping downward rays change; no probe-ID/height rejection and
        // no changes to visible sky, SC hits or analytic history transport.
        float lowerEnvScale = rayDir.y < 0.0
            ? 1.0 - clamp(volume.SdfOrigins[0].w, 0.0, 1.0) : 1.0;
        result.xyz = EvaluateSkyBase(rayDir) * volume.SkyColor.xyz * lowerEnvScale;
    } else {
#if defined(DDGI_ANALYTIC_FIRST_RHO_VARIANT) && DDGI_ANALYTIC_FIRST_RHO_VARIANT
        analyticRhoPath = 4u;
#endif
        // ---- Miss（步数耗尽）：仅回退探针周边 SC 卡，不再兜底天空 ----
        // P0 坐标契约：卡片查询同样从有效起点出发——耗尽射线物理上是从
        // 重定位后的位置爬行失败，周边卡片的语义以该位置为准。
        uint deviceReads = 0u;
        const uint kMaxMissReads = 8u;
        bool found = false;
        SCGridParams gp = scGridLoad();
        uint cell = scGridCellIndex(gp, rayOrigin);
        if (cell != 0xFFFFFFFFu) {
            uint begin = scgo.sc_grid_offsets[16u + cell];
            uint end   = scgo.sc_grid_offsets[17u + cell];
            for (uint gi = begin; gi < end && deviceReads < kMaxMissReads; ++gi) {
                uint cardIdx = scgc.sc_grid_cards[gi];
                if (cardIdx >= 4096u) continue;
                SurfaceCacheCard card = cd.card_data[cardIdx];
                ++deviceReads;

                vec2 atlasUV;
                if (worldToCardUV(rayOrigin, card, atlasUV)) {
                    vec3 missRadiance = sampleAtlasBilinear(atlasUV);
                    // Only accept card light that actually has energy — in
                    // shadowed arcades the atlas is still converging and a
                    // black card must not override the sky term; try the
                    // next covering card instead.
                    if (dot(missRadiance, missRadiance) > 0.0001) {
                        result.xyz = missRadiance;
                        found = true;
                        break;
                    }
                }
            }
        }
        if (!found) result.xyz = vec3(0.0);
    }

    // Write at ABSOLUTE probe index (remap from update-slot is intentional).
#ifdef DDGI_PATH_DEBUG
    // Preserve the geometric distance for the depth-moment pass.  The old
    // 40+k*0.001 tag made every hit look 40 m away and invalidated any
    // path-debug capture's visibility feedback.  Two low mantissa bits carry
    // the path ID; bits 2..5 record the dominant SC reject stage.  The six
    // mantissa bits perturb distance by <8 ppm, diagnostic builds only.
    if (result.w >= 0.0) {
        uint bits = floatBitsToUint(result.w);
        result.w = uintBitsToFloat((bits & ~63u) | (dbgSCReject << 2u) | dbgPath);
    }
    // Debug-only provenance: 12 low mantissa bits of RGB identify the winning
    // card and atlas texel. This changes radiance by <0.05%, never production.
    if (dbgPath == 1u) {
        result.x = uintBitsToFloat((floatBitsToUint(result.x) & ~4095u) | dbgCardIdx);
        result.y = uintBitsToFloat((floatBitsToUint(result.y) & ~4095u) | dbgAtlasTexel.x);
        result.z = uintBitsToFloat((floatBitsToUint(result.z) & ~4095u) | dbgAtlasTexel.y);
    }
#endif
#if defined(DDGI_ANALYTIC_FIRST_RHO_VARIANT) && DDGI_ANALYTIC_FIRST_RHO_VARIANT
    if (analyticRhoAudit) {
        if (analyticRhoPath == 0u) {
            analyticRhoPath = (hitDistance >= 0.0) ? 1u : 4u;
            if (analyticRho.status == DDGI_RHO_STATUS_NONE)
                analyticRho.status = DDGI_RHO_STATUS_PATH;
        }
        analytic_rho_audit.records[analyticRhoBase + 2u] =
            vec4(analyticRho.triangle_id, uintBitsToFloat(analyticRho.instance_id),
                 uintBitsToFloat(analyticRhoAlbedoSource), hitDistance);
        analytic_rho_audit.records[analyticRhoBase + 14u] = analyticRhoOriginalHN;
        analytic_rho_audit.records[analyticRhoBase + 15u] =
            vec4(uintBitsToFloat(analyticRho.first_status), analyticRho.first_residual,
                 uintBitsToFloat(analyticRho.material_flags),
                 analyticPositionApplied ? 2.0 : (analyticRhoApply ? 1.0 : 0.0));
        analytic_rho_audit.records[analyticRhoBase + 3u] =
            vec4(analyticRho.first_t, analyticRho.bary);
        analytic_rho_audit.records[analyticRhoBase + 4u] =
            vec4(uintBitsToFloat(analyticRho.material_id),
                 uintBitsToFloat(analyticRho.status),
                 uintBitsToFloat(analyticRho.triangle_flags),
                 uintBitsToFloat(analyticRho.mapped_material));
        analytic_rho_audit.records[analyticRhoBase + 5u] =
            vec4(analyticRho.old_rho, float(analyticRhoPath));
        analytic_rho_audit.records[analyticRhoBase + 6u] =
            vec4(analyticRho.sample_rho, analyticRho.residual);
        analytic_rho_audit.records[analyticRhoBase + 7u] = analyticRho.sample_rgba;
        analytic_rho_audit.records[analyticRhoBase + 8u] =
            vec4(analyticRho.tint, uintBitsToFloat(analyticRho.cluster_material));
        analytic_rho_audit.records[analyticRhoBase + 9u] =
            vec4(analyticRho.uv, analyticRho.uv_scale);
        analytic_rho_audit.records[analyticRhoBase + 10u] = analyticRho.texel00;
        analytic_rho_audit.records[analyticRhoBase + 11u] = analyticRho.texel10;
        analytic_rho_audit.records[analyticRhoBase + 12u] = analyticRho.texel01;
        analytic_rho_audit.records[analyticRhoBase + 13u] = analyticRho.texel11;
    }
#endif
    rb.ray_buffer[probeIdx * volume.RaysPerProbe + rayId] = result;
    } // T8.13 P2 stride loop
}
