SCGridParams scGridLoad() {
    return scGridDecode(
        uvec4(scgo.sc_grid_offsets[0], scgo.sc_grid_offsets[1],
              scgo.sc_grid_offsets[2], scgo.sc_grid_offsets[3]),
        uvec4(scgo.sc_grid_offsets[4], scgo.sc_grid_offsets[5],
              scgo.sc_grid_offsets[6], scgo.sc_grid_offsets[7]),
        uvec4(scgo.sc_grid_offsets[8], scgo.sc_grid_offsets[9],
              scgo.sc_grid_offsets[10], scgo.sc_grid_offsets[11]));
