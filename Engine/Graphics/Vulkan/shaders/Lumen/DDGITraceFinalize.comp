    uint probe_update_list[];
} pul;

layout(set = 0, binding = 4) writeonly buffer RayBuffer {
    vec4 ray_buffer[];   // xyz = radiance, w = hit_distance (negative = miss)
} rb;

layout(set = 0, binding = 5, std430) readonly buffer CardLookupBuf {
    SurfaceCacheCardLookup card_lookups[];
} cl;

layout(set = 0, binding = 6, std430) readonly buffer CardDataBuf {
