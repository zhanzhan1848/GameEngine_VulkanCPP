#version 450 core
#extension GL_GOOGLE_include_directive : require
bool scGeometryNonzeroEnabled=false;
#define SC_GEO_NONZERO_ONLY scGeometryNonzeroEnabled
#include "GeometryFirstHit.glsl"
layout(local_size_x=8) in;
layout(set=0,binding=0,std430) readonly buffer Queries { vec4 values[]; } queries;
layout(set=0,binding=1,std430) writeonly buffer Results { vec4 values[]; } results;
void main() {
    uint i=gl_GlobalInvocationID.x; if(i>=queries.values.length()/2u) return;
    vec4 o=queries.values[2u*i], d=queries.values[2u*i+1u];
    scGeometryNonzeroEnabled=false;
    float t;uint owner,triangle;int status=geometryFirstHit(o.xyz,d.xyz,o.w,d.w,t,owner,triangle);
    scGeometryNonzeroEnabled=true;
    float alternateT;uint alternateOwner,alternateTriangle;
    int alternateStatus=geometryFirstHit(o.xyz,d.xyz,o.w,d.w,alternateT,alternateOwner,alternateTriangle);
    // Analytic fixtures are checked by the host; both paths must also retain
    // exact status/identity/t bits, including zero-axis and nonfinite fallback.
    if(alternateStatus!=status || alternateOwner!=owner || alternateTriangle!=triangle ||
       floatBitsToUint(alternateT)!=floatBitsToUint(t))status=-99;
    results.values[i]=vec4(t,float(owner),float(status),uintBitsToFloat(triangle));
}
