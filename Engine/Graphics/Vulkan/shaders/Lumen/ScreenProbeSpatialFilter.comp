#version 450 core
// Vulkan Lumen Screen Probe GI — Bilateral spatial filter on probe SH
// coefficients. Hand-written GLSL port of ScreenProbeSpatialFilter.metal
// (entry: screen_probe_spatial_filter).
//
// Cross-pattern 5-probe bilateral blur: center + 4 cardinal neighbors.
// Smooths probe grid boundaries while preserving edges at depth discontinuities.
//
// ThreadGroupSize: (64, 1, 1), 1D dispatch.
//
// Flat descriptor bindings:
//   binding 0 = SSBO read   inputSH[]   (4 vec4 per probe, interleaved)
//   binding 1 = SSBO write  outputSH[]  (4 vec4 per probe, interleaved)
//   binding 2 = SSBO read   probePos[]  (bilateral weighting)
//   binding 3 = UBO         { uint totalProbes; uint gridW; float sigma; uint pad; } (16B)

#extension GL_EXT_samplerless_texture_functions : enable

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// --------------------------------------------------------------------------------
// Bindings (flat)
// --------------------------------------------------------------------------------
layout(set = 0, binding = 0, std430) readonly buffer InputSHBlock {
    vec4 data[];
} inputSH;

layout(set = 0, binding = 1, std430) buffer OutputSHBlock {
    vec4 data[];
} outputSH;

layout(set = 0, binding = 2, std430) readonly buffer ProbePosBlock {
    vec4 data[];
} probePos;

layout(set = 0, binding = 3, std140) uniform SpatialConstantsBlock {
    uint  totalProbes;
    uint  gridW;
    float sigma;    // bilateral spatial sigma (world-space)
    uint  pad;
} params;

// Vulkan-only mode7 spatial connection inputs. All are bound to valid
// descriptors in legacy mode too; params.pad gates every additional read.
layout(set=0,binding=4,std430) readonly buffer ProbeNormalBlock { vec4 data[]; } probeNormal;
// 48B nodes/triangles, 64B instances; mirrors GeometryFirstHit.h.
struct GeometryNode { vec4 lo; vec4 hi; uvec4 links; };
struct GeometryTriangle { vec4 a; vec4 e1; vec4 e2; };
struct GeometryInstance { vec4 inverse0; vec4 inverse1; vec4 inverse2; uvec4 identity; };
layout(set=0,binding=5,std430) readonly buffer GeometryTop { GeometryNode data[]; } geometryTop;
layout(set=0,binding=6,std430) readonly buffer GeometryBottom { GeometryNode data[]; } geometryBottom;
layout(set=0,binding=7,std430) readonly buffer GeometryTriangles { GeometryTriangle data[]; } geometryTriangles;
layout(set=0,binding=8,std430) readonly buffer GeometryInstances { GeometryInstance data[]; } geometryInstances;
// Compensated difference of products prevents skinny-triangle normals from
// losing their small component. No shaderFloat64 capability is required.
float geometryDifferenceOfProducts(float a,float b,float c,float d) {
    precise float cd=c*d;
    precise float error=fma(-c,d,cd);
    precise float difference=fma(a,b,-cd);
    return difference+error;
}
vec3 geometryTriangleNormal(vec3 a,vec3 b) {
    return vec3(geometryDifferenceOfProducts(a.y,b.z,a.z,b.y),
                geometryDifferenceOfProducts(a.z,b.x,a.x,b.z),
                geometryDifferenceOfProducts(a.x,b.y,a.y,b.x));
}
bool geometryBox(GeometryNode n,vec3 o,vec3 d,float nearT,float farT) {
    for(uint k=0u;k<3u;++k) {
        if(d[k]==0.) { if(o[k]<n.lo[k] || o[k]>n.hi[k]) return false; }
        else { float a=(n.lo[k]-o[k])/d[k], b=(n.hi[k]-o[k])/d[k]; nearT=max(nearT,min(a,b)); farT=min(farT,max(a,b)); if(nearT>farT) return false; }
    } return true;
}
#ifndef SC_GEO_NONZERO_ONLY
#define SC_GEO_NONZERO_ONLY false
#endif
// This is exactly the original nonzero-axis branch, in the same axis order.
// Only finite directions with all three components nonzero use it.
bool geometryBoxNonzero(GeometryNode n,vec3 o,vec3 d,float nearT,float farT) {
    for(uint k=0u;k<3u;++k) {
        float a=(n.lo[k]-o[k])/d[k], b=(n.hi[k]-o[k])/d[k];
        nearT=max(nearT,min(a,b)); farT=min(farT,max(a,b)); if(nearT>farT)return false;
    } return true;
}
// -1 unknown, 0 segment miss, 1 first geometric triangle. Material and
// captured surface qualification are checked separately; never skip it.
int geometryFirstHit(vec3 o,vec3 d,float nearT,float farT,out float bestT,out uint owner,out uint bestPrimitive,out vec3 firstN,out vec3 firstA,out vec3 firstE1,out vec3 firstE2) {
    bool topNonzero=SC_GEO_NONZERO_ONLY && all(notEqual(d,vec3(0))) && !any(isnan(d)) && !any(isinf(d));
    firstN=vec3(0);firstA=vec3(0);firstE1=vec3(0);firstE2=vec3(0);bestT=farT; owner=0u; bestPrimitive=0xffffffffu; bool found=false;
    uint ts[64]; uint tp=1u; ts[0]=0u;
    while(tp!=0u) {
        uint at=ts[--tp]; if(at>=geometryTop.data.length()) return -1;
        GeometryNode n=geometryTop.data[at];bool topHit;
        if(topNonzero)topHit=geometryBoxNonzero(n,o,d,nearT,bestT);else topHit=geometryBox(n,o,d,nearT,bestT);
        if(!topHit)continue;
        if(n.links.w==0u) { if(tp+2u>64u) return -1; ts[tp++]=n.links.x; ts[tp++]=n.links.y; continue; }
        if(n.links.z>=geometryInstances.data.length()) return -1;
        GeometryInstance inst=geometryInstances.data[n.links.z];
        vec3 lo=vec3(dot(inst.inverse0,vec4(o,1)),dot(inst.inverse1,vec4(o,1)),dot(inst.inverse2,vec4(o,1)));
        // Do not normalize: inverse scaling must preserve world ray parameter.
        vec3 ld=vec3(dot(inst.inverse0.xyz,d),dot(inst.inverse1.xyz,d),dot(inst.inverse2.xyz,d));
        if(any(isnan(lo))||any(isinf(lo))||any(isnan(ld))||any(isinf(ld))) return -1;
        bool bottomNonzero=SC_GEO_NONZERO_ONLY && all(notEqual(ld,vec3(0)));
        uint bs[64]; uint bp=1u; bs[0]=inst.identity.x;
        while(bp!=0u) {
            at=bs[--bp]; if(at>=geometryBottom.data.length()) return -1;
            GeometryNode b=geometryBottom.data[at];bool bottomHit;
            if(bottomNonzero)bottomHit=geometryBoxNonzero(b,lo,ld,nearT,bestT);else bottomHit=geometryBox(b,lo,ld,nearT,bestT);
            if(!bottomHit)continue;
            if(b.links.w==0u) { if(bp+2u>64u) return -1; bs[bp++]=b.links.x; bs[bp++]=b.links.y; continue; }
            if(b.links.z>geometryTriangles.data.length() || b.links.w>geometryTriangles.data.length()-b.links.z) return -1;
            for(uint i=0u;i<b.links.w;++i) {
                GeometryTriangle tri=geometryTriangles.data[b.links.z+i];
                vec3 p=cross(ld,tri.e2.xyz); float det=dot(tri.e1.xyz,p);
                if(det==0.) continue;
                vec3 v=lo-tri.a.xyz; float u=dot(v,p)/det;
                if(u<0. || u>1.) continue;
                vec3 q=cross(v,tri.e1.xyz); float bary=dot(ld,q)/det;
                // Barycentrics decide containment; solve t from the plane.
                // The triple product e2 dot ((origin-a) cross e1) suffers
                // cancellation on long thin triangles even for interior hits.
                vec3 normal=geometryTriangleNormal(tri.e1.xyz,tri.e2.xyz);
                float planeDet=dot(ld,normal);
                if(planeDet==0.) return -1;
                float t=dot(tri.a.xyz-lo,normal)/planeDet;
                if(isnan(t)||isinf(t)||isnan(bary)||isinf(bary)||isnan(u)||isinf(u)) return -1;
                if(bary<0. || u+bary>1. || t<nearT || t>bestT) continue;
                uint primitive=floatBitsToUint(tri.a.w);
                if(found && t==bestT && (inst.identity.y>owner || (inst.identity.y==owner && primitive>=bestPrimitive))) continue;
                owner=inst.identity.y; bestPrimitive=primitive; bestT=t; found=true;
                bool identity=all(equal(inst.inverse0,vec4(1,0,0,0))) && all(equal(inst.inverse1,vec4(0,1,0,0))) && all(equal(inst.inverse2,vec4(0,0,1,0)));
                firstN=identity?normalize(normal):vec3(0);firstA=tri.a.xyz;firstE1=tri.e1.xyz;firstE2=tri.e2.xyz;
            }
        }
    } return found?1:0;
}


bool measuredSpatialConnection(uint center, uint neighbor, vec3 p, vec3 q) {
    if ((params.pad & 2u) == 0u) return false; // absent scene epoch, keep center
    vec3 n=probeNormal.data[center].xyz, m=probeNormal.data[neighbor].xyz;
    if(any(isnan(n))||any(isinf(n))||any(isnan(m))||any(isinf(m))||
       dot(n,n)<0.25||dot(m,m)<0.25) return false;
    n=normalize(n);m=normalize(m);
    if(dot(n,m)<0.5) return false;
    // Finite surface bias avoids endpoint self intersections; neither a
    // distance Gaussian nor a plane heuristic is accepted as visibility.
    vec3 a=p+n*0.01,b=q+m*0.01,delta=b-a;
    float distance=length(delta);
    if(isnan(distance)||isinf(distance)||distance<=0.002) return false;
    float t;uint owner,primitive;vec3 gn,ga,ge1,ge2;
    int outcome=geometryFirstHit(a,delta/distance,0.001,distance-0.001,
        t,owner,primitive,gn,ga,ge1,ge2);
    // A triangle or an unsupported traversal conservatively rejects mixing.
    // We do not skip a material or pretend an unknown first surface is open.
    return outcome==0;
}

// --------------------------------------------------------------------------------
// Main
// --------------------------------------------------------------------------------
void screen_probe_spatial_filter() {
    uint global_id = gl_GlobalInvocationID.x;

    if (global_id >= params.totalProbes) return;

    uint gx = global_id % params.gridW;
    uint gy = global_id / params.gridW;

    // Read center probe position
    vec4 centerPosData = probePos.data[global_id];

    // If center probe is inactive, output zeros
    if (centerPosData.w <= 0.0 || ((params.pad & 1u) != 0u &&
        (any(isnan(centerPosData)) || any(isinf(centerPosData))))) {
        uint base = global_id * 4u;
        outputSH.data[base + 0u] = vec4(0.0);
        outputSH.data[base + 1u] = vec4(0.0);
        outputSH.data[base + 2u] = vec4(0.0);
        outputSH.data[base + 3u] = vec4(0.0);
        return;
    }

    // Read center SH
    uint centerBase = global_id * 4u;
    vec3 centerSH[4];
    for (int b = 0; b < 4; b++) {
        centerSH[b] = inputSH.data[centerBase + uint(b)].rgb;
    }

    bool finiteCenter = true;
    if ((params.pad & 1u) != 0u)
        for(int b=0;b<4;++b) finiteCenter = finiteCenter &&
            !any(isnan(inputSH.data[centerBase+uint(b)])) && !any(isinf(inputSH.data[centerBase+uint(b)]));
    // Check if center SH is valid
    if (inputSH.data[centerBase + 0u].w <= 0.0 || !finiteCenter) {
        // Invalid center: output zeros
        outputSH.data[centerBase + 0u] = vec4(0.0);
        outputSH.data[centerBase + 1u] = vec4(0.0);
        outputSH.data[centerBase + 2u] = vec4(0.0);
        outputSH.data[centerBase + 3u] = vec4(0.0);
        return;
    }

    vec3 centerPos = centerPosData.xyz;
    float invTwoSigmaSq = 1.0 / (2.0 * params.sigma * params.sigma);

    // Cardinal neighbor offsets (cross pattern)
    ivec2 offsets[4];
    offsets[0] = ivec2(-1,  0);  // left
    offsets[1] = ivec2( 1,  0);  // right
    offsets[2] = ivec2( 0, -1);  // up
    offsets[3] = ivec2( 0,  1);  // down

    // Accumulate filtered SH + confidence.
    // Center-weighted: center weight = 2.0 (strong self-preservation).
    vec3 filteredSH[4] = vec3[4](
        centerSH[0] * 2.0,
        centerSH[1] * 2.0,
        centerSH[2] * 2.0,
        centerSH[3] * 2.0
    );
    float totalWeight = 2.0;  // center weight = 2.0
    float centerConf = inputSH.data[centerBase + 0u].w;
    float filteredConf = centerConf * 2.0;  // center weight = 2.0

    for (int n = 0; n < 4; n++) {
        int nx = int(gx) + offsets[n].x;
        int ny = int(gy) + offsets[n].y;

        // Bounds check
        if (nx < 0 || nx >= int(params.gridW) || ny < 0) continue;
        if (uint(ny) * params.gridW + uint(nx) >= params.totalProbes) continue;

        uint nidx = uint(ny) * params.gridW + uint(nx);

        // Check neighbor active
        vec4 neighborPosData = probePos.data[nidx];
        if (neighborPosData.w <= 0.0) continue;

        // Check neighbor SH valid
        uint neighborBase = nidx * 4u;
        if (inputSH.data[neighborBase + 0u].w <= 0.0) continue;

        if ((params.pad & 1u) != 0u) {
            bool finiteNeighbor = !any(isnan(neighborPosData)) && !any(isinf(neighborPosData));
            for(int b=0;b<4;++b) finiteNeighbor = finiteNeighbor &&
                !any(isnan(inputSH.data[neighborBase+uint(b)])) && !any(isinf(inputSH.data[neighborBase+uint(b)]));
            if(!finiteNeighbor) continue;
        }
        if ((params.pad & 1u) != 0u &&
            !measuredSpatialConnection(global_id,nidx,centerPos,neighborPosData.xyz)) continue;

        // Bilateral weight based on world-space distance
        vec3 delta = centerPos - neighborPosData.xyz;
        float dist2 = dot(delta, delta);
        float w = exp(-dist2 * invTwoSigmaSq);

        // Read and accumulate neighbor SH
        for (int b = 0; b < 4; b++) {
            filteredSH[b] += inputSH.data[neighborBase + uint(b)].rgb * w;
        }
        // Accumulate confidence from neighbor
        filteredConf += inputSH.data[neighborBase + 0u].w * w;
        totalWeight += w;
    }

    // Normalize and write output
    float invWeight = 1.0 / totalWeight;
    uint outBase = global_id * 4u;
    outputSH.data[outBase + 0u] = vec4(filteredSH[0] * invWeight, filteredConf * invWeight);
    outputSH.data[outBase + 1u] = vec4(filteredSH[1] * invWeight, 1.0);
    outputSH.data[outBase + 2u] = vec4(filteredSH[2] * invWeight, 1.0);
    outputSH.data[outBase + 3u] = vec4(filteredSH[3] * invWeight, 1.0);
}
