#version 450 core
#extension GL_GOOGLE_include_directive : require
// DDGIUpdateDepth.comp — Vulkan Lumen hand-written GLSL port of
// DDGIUpdateDepth.wgsl. Entry point: ddgi_update_depth
//   (glslangValidator --source-entrypoint main -e ddgi_update_depth)
//
// Bins ray hit distances for one probe into 64 (8x8) octahedral texels,
// computes mean + variance per texel, applies a temporal EMA with a
// history buffer, and writes the result.
//
// The octahedral binning re-derives each ray's direction from its index, so it
// MUST use the same sampler as DDGITraceRays/SDF or hit distances land in
// wrong texels (especially under jitter/cosine modes).
#include "ShaderLib/ProbeSampleLib.glsl"
//
// Buffer layout per probe: 128 floats
//   Indices [0..63]:   mean distance per octahedral texel
//   Indices [64..127]: variance per octahedral texel
//   Index: probeIdx*128 + texelIdx (mean) / probeIdx*128 + 64 + texelIdx (var)
//
// Why GLSL (not naga-compiled WGSL): the WGSL DDGIVolumeData uniform struct
// contains array<vec4<f32>, 3> fields (SdfOrigins/VoxelSizes/Extents). naga
// emits these as spvUnsafeArray, which MoltenVK cannot consume inside a uniform
// struct. GLSL std140 handles vec4[3] natively. Same pattern as SSAOTrace.comp
// and DDGIGIGather.comp.
//
// Flat descriptor bindings (matches LumenDDGIPass.cpp:413-419 Vulkan branch):
//   binding 0 = UniformBuffer        GlobalShaderData
//   binding 1 = UniformBuffer        DDGIVolumeData
//   binding 2 = StorageBuffer (ro)   ray_buffer
//   binding 3 = StorageBuffer (ro)   depth_history
//   binding 4 = StorageBuffer (rw)   depth_output
//   binding 5 = StorageBuffer (ro)   probe_update_list

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// ----------------------------------------------------------------------------
// Bindings (flat — see header)
// ----------------------------------------------------------------------------

// GlobalShaderData UBO — mirrors C++ RHIShaderCommon.h / WGSL GlobalShaderData.
layout(set = 0, binding = 0, std140) uniform GlobalShaderData {
    mat4 View;
    mat4 Projection;
    mat4 InvProjection;
    mat4 ViewProjection;
    mat4 PreviousViewProjection;
    mat4 InvViewProjection;
    vec4 CameraPositionAndViewWidth;
    vec4 CameraDirectionAndViewHeight;
    uint NumDirectionalLights;
    float DeltaTime;
    float FrameCount;
    uint  _padding;
} globalData;

// DDGIVolumeData UBO — byte-for-byte match with C++ LumenDDGIPass.h.
// The C++ struct is 336 bytes (extends to Albedo @ 320); this shader only
// references fields through LightColor @ 288. Trailing bytes are uploaded
// but not read — Vulkan allows a UBO block to be smaller than the bound
// buffer as long as accessed offsets are in-bounds.
layout(set = 0, binding = 1, std140) uniform DDGIVolumeData {
    vec4  ProbeOrigin;              //   0
    float ProbeSpacing;             //  16
    float _pad_before_counts_0;     //  20
    float _pad_before_counts_1;     //  24
    float _pad_before_counts_2;     //  28
    uvec4 ProbeCounts;              //  32
    uint  RaysPerProbe;             //  48
    uint  ProbeCountTotal;          //  52
    float IrradianceBlurSigma;      //  56
    float DepthBlurSigma;           //  60
    float DeltaTime;                //  64
    uint  FrameIndex;               //  68
    float RayMaxDistance;           //  72
    float ProbeHysteresis;          //  76
    float TemporalAlpha;            //  80
    uint  ProbeUpdateCount;         //  84
    uint  SCLookupCount;            //  88  (Surface Cache card lookup count)
    uint  SCAtlasSize;              //  92  (Surface Cache lighting atlas size)
    int   ProbeRelocationShiftX;    //  96
    int   ProbeRelocationShiftY;    // 100
    int   ProbeRelocationShiftZ;    // 104
    int   RaySampleMode;            // 108 — ray sampler mode (ProbeSampleLib)
    vec4  SdfOrigins[3];            // 112
    vec4  SdfVoxelSizes[3];         // 160
    vec4  SdfExtents[3];            // 208
    uvec4 SdfResolutionsAndCount;   // 256
    vec4  LightDirection;           // 272
    vec4  LightColor;               // 288
} volume;

// DDGIRayData — storage buffer element. Packed as vec4 (16B stride).
struct DDGIRayData {
    vec4 radiance_and_dist;  // xyz = radiance, w = hit_distance
};

layout(set = 0, binding = 2) readonly buffer RayBuffer {
    DDGIRayData ray_buffer[];
};
layout(set = 0, binding = 3) readonly buffer DepthHistory {
    float depth_history[];
};
layout(set = 0, binding = 4) buffer DepthOutput {
    float depth_output[];
};
layout(set = 0, binding = 5) readonly buffer ProbeUpdateList {
    uint probe_update_list[];
};
layout(set = 0, binding = 6) readonly buffer DepthOnlyHits {
    float depth_only_hits[];
};
#ifdef DDGI_DEPTH_PROVENANCE
// Diagnostic sidecar mirrors depth history slot identity, NOT inferred from
// the moments. Per cell: H/E/X counts + observation stamp; last H/E/X/sample
// stamps. All stamps are volume.FrameIndex+1 (zero=never observed).
layout(set=0,binding=7) readonly buffer ProvenanceHistory { uvec4 provenance_history[]; };
layout(set=0,binding=8) buffer ProvenanceOutput { uvec4 provenance_output[]; };
#endif

// ----------------------------------------------------------------------------
// Constants
// ----------------------------------------------------------------------------
const uint DDGI_DEPTH_RES    = 8u;
const uint DDGI_DEPTH_TEXELS = 64u;  // DDGI_DEPTH_RES * DDGI_DEPTH_RES

// ----------------------------------------------------------------------------
// Helpers (verbatim from DDGIUpdateIrradiance.comp / WGSL)
// ----------------------------------------------------------------------------

// Fibonacci sphere ray direction
// ddgiRayDirection moved to ShaderLib/ProbeSampleLib.glsl (ddgiSampleRayDirection)
// — single source shared with the trace shaders and UpdateIrradiance.

// Sphere direction -> octahedral UV in [0,1]^2.
// WGSL select(a, b, c) returns (c ? b : a) — same as GLSL mix(a, b, float(c)).
// Here we use bvec2 comparison -> mix via componentwise bool->float.
vec2 octahedralEncode(vec3 d) {
    float l1norm = abs(d.x) + abs(d.y) + abs(d.z);
    vec2 uv = d.xy / l1norm;
    if (d.z < 0.0) {
        vec2 s = mix(vec2(-1.0), vec2(1.0), vec2(greaterThanEqual(uv.xy, vec2(0.0))));
        uv = (1.0 - abs(uv.yx)) * s;
    }
    return uv * 0.5 + 0.5;
}

// ----------------------------------------------------------------------------
// Main Kernel: ddgi_update_depth
// ----------------------------------------------------------------------------
void ddgi_update_depth() {
    uint gid = gl_GlobalInvocationID.x;

    if (gid >= volume.ProbeUpdateCount) {
        return;
    }

    uint probeIdx = probe_update_list[gid];

    // -----------------------------------------------------------------------
    // Accumulate per-texel mean + variance from all rays (octahedral binning)
    // -----------------------------------------------------------------------

    uint texels = DDGI_DEPTH_TEXELS;
    float sumDist[64];
    float sumDistSq[64];
    uint  rayCountArr[64];
#ifdef DDGI_DEPTH_PROVENANCE
    uvec3 observed[64];
#endif
    for (uint t = 0u; t < texels; t++) {
        sumDist[t]   = 0.0;
        sumDistSq[t] = 0.0;
        rayCountArr[t] = 0u;
#ifdef DDGI_DEPTH_PROVENANCE
        observed[t]=uvec3(0u);
#endif
    }

    uint res = DDGI_DEPTH_RES;

    for (uint r = 0u; r < volume.RaysPerProbe; r++) {
        DDGIRayData ray = ray_buffer[probeIdx * volume.RaysPerProbe + r];

        // Production skips negative rays for moments; diagnostic counts them
        // independently, preserving escape vs exhausted/unknown semantics.
#ifndef DDGI_DEPTH_PROVENANCE
        if (ray.radiance_and_dist.w < 0.0) {
            continue;
        }
#endif

        // Compute ray direction and map to octahedral texel — same sampler the
        // trace side used for this ray index.
        vec3 rayDir = ddgiSampleRayDirection(r, volume.RaysPerProbe,
                                             volume.FrameIndex,
                                             uint(volume.RaySampleMode),
                                             (volume.LightDirection.xyz[0]*volume.LightDirection.xyz[0] + volume.LightDirection.xyz[1]*volume.LightDirection.xyz[1] + volume.LightDirection.xyz[2]*volume.LightDirection.xyz[2] > 1e-8 ? normalize(-volume.LightDirection.xyz) : vec3(0.0, -1.0, 0.0))).xyz;
        vec2 uv = octahedralEncode(rayDir);
        uvec2 texel = uvec2(clamp(uint(uv.x * float(res)), 0u, res - 1u),
                            clamp(uint(uv.y * float(res)), 0u, res - 1u));
        uint texelIdx = texel.y * res + texel.x;

#ifdef DDGI_DEPTH_PROVENANCE
        float measured=ray.radiance_and_dist.w;
        if (measured>=0.0) observed[texelIdx].x++;
        else if (measured<=-1.5) observed[texelIdx].y++;
        else observed[texelIdx].z++;
        if (measured<0.0) continue;
#endif

        float dist = ray.radiance_and_dist.w;
        sumDist[texelIdx]   = sumDist[texelIdx] + dist;
        sumDistSq[texelIdx] = sumDistSq[texelIdx] + dist * dist;
        rayCountArr[texelIdx] = rayCountArr[texelIdx] + 1u;
    }

    // Mode 5 measures previously empty bins independently, preserving every
    // legacy measured bin and all radiance/PDF/SH. -1 (step exhaustion) is
    // unknown, NOT sky; only -2 (true escape) becomes max-distance evidence.
    if (volume.RaySampleMode == 5) {
        uint extraBase = volume.ProbeCountTotal * volume.RaysPerProbe + gid * 128u;
        for (uint cell = 0u; cell < texels; ++cell) {
            if (rayCountArr[cell] != 0u) continue;
            for (uint sampleIdx = 0u; sampleIdx < 2u; ++sampleIdx) {
                float distance = depth_only_hits[extraBase + cell * 2u + sampleIdx];
#ifdef DDGI_DEPTH_PROVENANCE
                if (distance>=0.0) observed[cell].x++;
                else if (distance==-2.0) observed[cell].y++;
                else observed[cell].z++;
#endif
                if (distance == -2.0) distance = volume.RayMaxDistance;
                if (distance < 0.0) continue;
                sumDist[cell] += distance;
                sumDistSq[cell] += distance * distance;
                rayCountArr[cell] += 1u;
            }
        }
    }

    // Diagnostic mode 4 keeps the legacy ray set/SH projection intact. Track
    // directions with both hits and misses so genuine open-sky bins retain
    // their history; only bins never visited by any ray may borrow a depth.
    uint sampledArr[64];
    if (volume.RaySampleMode == 4) {
        for (uint t = 0u; t < texels; ++t) sampledArr[t] = 0u;
        for (uint r = 0u; r < volume.RaysPerProbe; ++r) {
            vec3 rayDir = ddgiSampleRayDirection(r, volume.RaysPerProbe,
                                                 volume.FrameIndex, 4u,
                                                 vec3(0.0, -1.0, 0.0)).xyz;
            vec2 uv = octahedralEncode(rayDir);
            uvec2 cell = uvec2(clamp(uint(uv.x * float(res)), 0u, res - 1u),
                               clamp(uint(uv.y * float(res)), 0u, res - 1u));
            sampledArr[cell.y * res + cell.x] = 1u;
        }
    }

    // -----------------------------------------------------------------------
    // Temporal filter with history and write output
    // -----------------------------------------------------------------------

    uint floatsPerProbe = texels * 2u;  // 128
    uint probeBase = probeIdx * floatsPerProbe;

    // Smooth alpha ramp for depth
    const float rampFrames = 60.0;
    float t = clamp(float(max(volume.FrameIndex, 1u) - 1u) / rampFrames, 0.0, 1.0);
    float alpha = mix(1.0, volume.DepthBlurSigma, t);

    for (uint texelIdx = 0u; texelIdx < texels; texelIdx++) {
        uint meanIdx = probeBase + texelIdx;
        uint varIdx  = probeBase + texels + texelIdx;
#ifdef DDGI_DEPTH_PROVENANCE
        uint provenanceIdx=(probeIdx*64u+texelIdx)*2u;
        uint stamp=volume.FrameIndex+1u;
        uvec4 old=provenance_history[provenanceIdx+1u];
        uvec3 counts=observed[texelIdx];
        provenance_output[provenanceIdx]=uvec4(counts,stamp);
        provenance_output[provenanceIdx+1u]=uvec4(
            counts.x>0u?stamp:old.x,counts.y>0u?stamp:old.y,
            counts.z>0u?stamp:old.z,any(greaterThan(counts,uvec3(0u)))?stamp:old.w);
#endif

        // No hit: retain the measured open-sky history. Mode 4 separately
        // repairs only directions the fixed 128-ray lattice never sampled.
        if (rayCountArr[texelIdx] == 0u) {
            if (volume.RaySampleMode == 4 && sampledArr[texelIdx] == 0u) {
                uint nearest = texels;
                uint bestDist2 = 0xffffffffu;
                for (uint candidate = 0u; candidate < texels; ++candidate) {
                    if (sampledArr[candidate] == 0u) continue;
                    int dx = int(candidate % res) - int(texelIdx % res);
                    int dy = int(candidate / res) - int(texelIdx / res);
                    uint dist2 = uint(dx * dx + dy * dy);
                    if (dist2 < bestDist2) { bestDist2 = dist2; nearest = candidate; }
                }
                if (nearest < texels) {
                    // A sampled miss legitimately represents open space; its
                    // existing mean (normally max distance) is not replaced.
                    if (rayCountArr[nearest] == 0u) {
                        depth_output[meanIdx] = depth_history[probeBase + nearest];
                        depth_output[varIdx] = depth_history[probeBase + texels + nearest];
                    } else {
                        float mean = sumDist[nearest] / float(rayCountArr[nearest]);
                        float variance = abs(sumDistSq[nearest] / float(rayCountArr[nearest]) - mean * mean);
                        if (rayCountArr[nearest] < 4u)
                            variance = max(variance, volume.ProbeSpacing * volume.ProbeSpacing * 0.1);
                        depth_output[meanIdx] = mean;
                        depth_output[varIdx] = max(variance, 0.001);
                    }
                    continue;
                }
            }
            depth_output[meanIdx] = depth_history[meanIdx];
            depth_output[varIdx]  = depth_history[varIdx];
            continue;
        }

        float mean = sumDist[texelIdx] / float(rayCountArr[texelIdx]);
        float variance = abs(sumDistSq[texelIdx] / float(rayCountArr[texelIdx]) - mean * mean);

        // Few samples: inflate variance to avoid overconfidence
        if (rayCountArr[texelIdx] < 4u) {
            variance = max(variance, volume.ProbeSpacing * volume.ProbeSpacing * 0.1);
        }
        variance = max(variance, 0.001);

        // Exponential moving average
        depth_output[meanIdx] = mix(depth_history[meanIdx], mean, alpha);
        depth_output[varIdx]  = mix(depth_history[varIdx], variance, alpha);
    }
}
