#version 450 core
// Vulkan Lumen Screen Probe GI — Change-penalizing temporal accumulation.
// Hand-written GLSL port of ScreenProbeTemporal.metal (entry: screen_probe_temporal).
//
// Core principle: penalize change, don't reward stability.
//   - Base alpha = slow accumulation (0.1)
//   - High gradient (|current - history|) -> faster adaptation (trust current)
//   - Low confidence -> reset history (clear bad data)
//   - Disocclusion -> reset history
//   - History clamping + gradient limiter prevent energy explosion
//
// ThreadGroupSize: (64, 1, 1), 1D dispatch.
//
// Flat descriptor bindings:
//   binding 0 = SSBO read   currentSH[]       (4 vec4 per probe)
//   binding 1 = SSBO read   historySH[]       (prev frame temporal output)
//   binding 2 = SSBO read   currentPositions[]
//   binding 3 = SSBO read   historyPositions[]
//   binding 4 = SSBO write  outputSH[]
//   binding 5 = UBO         TemporalConstants (32B)
//   binding 6 = SSBO read   currentNormals[]
//   binding 7 = SSBO read   historyNormals[]

#extension GL_EXT_samplerless_texture_functions : enable
#extension GL_GOOGLE_include_directive : require

// Shared shader library (axis refactor X1): previous-frame reprojection
// lives in ShaderLib/TemporalLib.glsl.
#include "ShaderLib/TemporalLib.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// --------------------------------------------------------------------------------
// Bindings (flat)
// --------------------------------------------------------------------------------
layout(set = 0, binding = 0, std430) readonly buffer CurrentSHBlock {
    vec4 data[];
} currentSH;

layout(set = 0, binding = 1, std430) readonly buffer HistorySHBlock {
    vec4 data[];
} historySH;

layout(set = 0, binding = 2, std430) readonly buffer CurrentPositionsBlock {
    vec4 data[];
} currentPositions;

layout(set = 0, binding = 3, std430) readonly buffer HistoryPositionsBlock {
    vec4 data[];
} historyPositions;

layout(set = 0, binding = 4, std430) buffer OutputSHBlock {
    vec4 data[];
} outputSH;

layout(set = 0, binding = 5, std140) uniform TemporalConstantsBlock {
    mat4  prev_view_projection;  // T5.2: previous frame VP for reprojection
    uint  totalProbes;
    float baseAlpha;        // base blend alpha (e.g. 0.1)
    float posThreshold;     // world-space distance threshold for disocclusion
    float normalThreshold;  // normal dot-product threshold (reject if below)
    float clampScale;       // history clamp range relative to current
    float maxGradient;      // maximum SH change per frame (gradient limiter)
    uint  gridW;            // T5.2: probe grid dims for prev-cell lookup
    uint  gridH;
    float mode;             // F3 (M7): 0=EMA (default), 1=EMAVarianceClamp, 2=Reprojection
    float _pad0;
} params;

layout(set = 0, binding = 6, std430) readonly buffer CurrentNormalsBlock {
    vec4 data[];
} currentNormals;

layout(set = 0, binding = 7, std430) readonly buffer HistoryNormalsBlock {
    vec4 data[];
} historyNormals;

// --------------------------------------------------------------------------------
// Main
// --------------------------------------------------------------------------------
void screen_probe_temporal() {
    uint global_id = gl_GlobalInvocationID.x;

    if (global_id >= params.totalProbes) return;

    // If current probe is inactive, zero output
    vec4 curPos = currentPositions.data[global_id];
    if (curPos.w <= 0.0) {
        uint base = global_id * 4u;
        outputSH.data[base + 0u] = vec4(0.0);
        outputSH.data[base + 1u] = vec4(0.0);
        outputSH.data[base + 2u] = vec4(0.0);
        outputSH.data[base + 3u] = vec4(0.0);
        return;
    }

    uint base = global_id * 4u;

    // Read current SH and probe confidence (multi-factor from Average)
    vec4 curSH0 = currentSH.data[base + 0u];
    float probeConfidence = curSH0.w;

    if (probeConfidence <= 0.0) {
        // No valid rays -> output zeros
        outputSH.data[base + 0u] = vec4(0.0);
        outputSH.data[base + 1u] = vec4(0.0);
        outputSH.data[base + 2u] = vec4(0.0);
        outputSH.data[base + 3u] = vec4(0.0);
        return;
    }

    // =================================================================
    // T5.2 velocity reprojection: find this probe's history in the
    // PREVIOUS frame's screen grid instead of the same cell (which is a
    // different world location once the camera moves). Neighbors pass the
    // same world-position/normal disocclusion tests the same-cell path used.
    // =================================================================
    vec4 histSH[4];
    float histW = 0.0;
    bool historyValid = false;
    {
        // T5.2 reprojection via TemporalLib: clip -> ndc -> Y-flipped UV.
        vec4 rp = reprojectPrevUV(curPos.xyz, params.prev_view_projection);
        if (rp.w > 0.0) {
            vec2 prevUV = rp.xy;
            if (all(greaterThanEqual(prevUV, vec2(0.0))) && all(lessThanEqual(prevUV, vec2(1.0)))) {
                vec2 cellF = prevUV * vec2(params.gridW, params.gridH) - 0.5;
                ivec2 c0 = ivec2(floor(cellF));
                vec2 fr = fract(cellF);
                vec4 curNorm = currentNormals.data[global_id];
                for (int b = 0; b < 4; ++b) histSH[b] = vec4(0.0);

                for (int dy = 0; dy <= 1; ++dy)
                for (int dx = 0; dx <= 1; ++dx) {
                    ivec2 c = c0 + ivec2(dx, dy);
                    if (c.x < 0 || c.y < 0 || c.x >= int(params.gridW) || c.y >= int(params.gridH)) continue;
                    uint hIdx = uint(c.y) * params.gridW + uint(c.x);
                    vec4 hPos = historyPositions.data[hIdx];
                    if (hPos.w <= 0.0) continue;
                    // World-space consistency: history must describe this surface.
                    if (distance(curPos.xyz, hPos.xyz) > params.posThreshold) continue;
                    vec4 hNorm = historyNormals.data[hIdx];
                    if (hNorm.w > 0.0 && curNorm.w > 0.0 &&
                        dot(normalize(curNorm.xyz), normalize(hNorm.xyz)) < params.normalThreshold) continue;
                    uint hb = hIdx * 4u;
                    if (historySH.data[hb].w <= 0.0) continue;  // invalid history entry
                    float w = ((dx == 0) ? (1.0 - fr.x) : fr.x)
                            * ((dy == 0) ? (1.0 - fr.y) : fr.y);
                    for (int b = 0; b < 4; ++b)
                        histSH[b] += historySH.data[hb + uint(b)] * w;
                    histW += w;
                }
                if (histW > 0.001) {
                    historyValid = true;
                    for (int b = 0; b < 4; ++b) histSH[b] /= histW;
                }
            }
        }
    }

    // If no valid history -> use current directly (no blending)
    if (!historyValid) {
        for (int b = 0; b < 4; b++) {
            vec4 cur = currentSH.data[base + uint(b)];
            outputSH.data[base + uint(b)] = (b == 0) ? vec4(cur.rgb, probeConfidence)
                                                     : vec4(cur.rgb, cur.w);
        }
        return;
    }

    // =================================================================
    // Low confidence -> reset history (clear bad accumulated data)
    // =================================================================
    if (probeConfidence < 0.05) {
        for (int b = 0; b < 4; b++) {
            vec4 cur = currentSH.data[base + uint(b)];
            outputSH.data[base + uint(b)] = (b == 0) ? vec4(cur.rgb, probeConfidence)
                                                     : vec4(cur.rgb, cur.w);
        }
        return;
    }

    // =================================================================
    // F3 (M7) EMAVarianceClamp (mode 1): clamp the reprojected history L0
    // into the current frame's neighborhood statistics AABB (SVGF lineage,
    // TemporalLib::varianceClampAABB — mean ± clampScale·σ + floor), then
    // shrink the L1 bands by the same per-channel factor (sign preserved).
    // Stats over self + horizontal neighbors' L0: 2 extra reads — budget
    // 31/32 worst case.
    // =================================================================
    if (params.mode > 0.5 && params.mode < 1.5) {
        vec3 sum = curSH0.rgb;
        vec3 sumSq = curSH0.rgb * curSH0.rgb;
        float n = 1.0;
        uint gx = global_id % params.gridW;
        if (gx > 0u) {
            vec4 v = currentSH.data[(global_id - 1u) * 4u];
            if (v.w > 0.0) { sum += v.rgb; sumSq += v.rgb * v.rgb; n += 1.0; }
        }
        if (gx + 1u < params.gridW) {
            vec4 v = currentSH.data[(global_id + 1u) * 4u];
            if (v.w > 0.0) { sum += v.rgb; sumSq += v.rgb * v.rgb; n += 1.0; }
        }
        vec3 mean = sum / n;
        vec3 sigma = sqrt(max(sumSq / n - mean * mean, vec3(0.0)));
        vec3 cl0;
        varianceClampAABB(histSH[0].rgb, mean, sigma, params.clampScale, cl0);
        vec3 shrink = clamp(abs(cl0) / max(abs(histSH[0].rgb), vec3(1e-4)),
                            vec3(0.0), vec3(1.0));
        histSH[0].rgb = cl0;
        histSH[1].rgb *= shrink;
        histSH[2].rgb *= shrink;
        histSH[3].rgb *= shrink;
    }

    // =================================================================
    // Compute per-probe gradient (how much SH changed)
    // =================================================================
    vec3 diff0 = curSH0.rgb - histSH[0].rgb;
    float gradient = length(diff0);

    // =================================================================
    // Change-penalizing blend:
    //   High gradient -> high alpha -> trust current (adapt to change)
    //   Low gradient -> base alpha -> slow accumulation
    // =================================================================
    float changeAlpha = clamp(gradient / params.maxGradient, 0.0, 1.0);
    float alpha = max(params.baseAlpha, changeAlpha);

    // =================================================================
    // Blend 4 SH coefficients with clamping + gradient limiter
    // =================================================================
    for (int b = 0; b < 4; b++) {
        vec4 cur = currentSH.data[base + uint(b)];
        vec4 hist = histSH[b];

        // F3 mode 2 (Reprojection): pure bilinear history reuse — skip the
        // relative clamp and gradient limiter to isolate reprojection quality.
        vec3 clampedHist = hist.rgb;
        if (params.mode < 1.5) {
            // Clamp history to prevent energy drift
            vec3 curAbs = max(abs(cur.rgb), vec3(0.1));
            vec3 lo = cur.rgb - params.clampScale * curAbs;
            vec3 hi = cur.rgb + params.clampScale * curAbs;
            clampedHist = clamp(hist.rgb, lo, hi);

            // Gradient limiter: cap per-frame change
            vec3 diff = cur.rgb - clampedHist;
            float diffLen = length(diff);
            if (diffLen > params.maxGradient && diffLen > 0.001) {
                cur.rgb = clampedHist + normalize(diff) * params.maxGradient;
            }
        }

        // Blend
        vec3 blended = mix(clampedHist, cur.rgb, alpha);
        outputSH.data[base + uint(b)] = (b == 0) ? vec4(blended, probeConfidence)
                                                 : vec4(blended, cur.w);
    }
}
