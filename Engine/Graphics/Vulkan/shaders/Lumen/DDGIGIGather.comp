#version 450 core
// Vulkan Lumen GIGather — GLSL port of DDGIGIGather.metal (8-probe trilinear + L2 SH + cross bilateral).
// Entry point: ddgi_gi_gather  (glslangValidator --source-entrypoint main -e ddgi_gi_gather)
//
// Phase 2 of Vulkan Lumen port (decision D7: hand-written GLSL replicating Metal 13-binding,
// including static probe support). See Docs/2026-08-09-vulkan-lumen-gi-port-design.md §5.3.
//
// T6.3 sub-A (probe_vis 数据面): binding 6 的 ProbeCounts UBO 扩到 48B,新增
// debugVis.x = GIDebug().probe_vis 模式(0=Off 零变化)。!=Off 时 Phase 1 输出
// 调试可视化色(probe SH L0 / octahedral 深度 / confidence),spec 输出清零。
// T3.6/D1 (flat-buffer): binding 17 = 单 SSBO,所有 volume 的探针数据顺序
// 拼接([header 256B][vol0][vol1]...,描述符绑 offset 256 跳过头部)、
// binding 18 = FlatVolumeCB(origin/spacing + counts/probeOffset ×4 + count)。
// 逐像素选择"包含该点且 spacing 最细"的 volume(平局取低索引 → near 优先),
// 经 probeOffset 索引 flat 数组——不依赖 descriptor indexing,Metal 同构。
// 原 15/16 far 双槽与 legacy 两槽路径删除(T4.4/T5.5 行为由 sel==0/sel>0
// 分支等价承接)。
//
// Flat descriptor bindings:
//   binding 0  = SampledDepthImage  gbuffer_depth
//   binding 1  = SampledImage       gbuffer_normal
//   binding 2  = StorageImage(rgba16f) output_tex  (half-res GI)
//   binding 3  = SampledImage       history_tex    (temporal)
//   binding 4  = UniformBuffer      invViewProj + cameraPos (5 vec4 = 80B)
//   binding 5  = UniformBuffer      probeOriginSpacing (origin.xyz + spacing.w)
//   binding 6  = UniformBuffer      probeCounts (xyz) + cameraPosMirror + debugVis
//   binding 7  = StorageBuffer(ro)  staticSkySH (9 float3)
//   binding 8  = StorageBuffer(ro)  staticSkyFactor (float per probe)
//   binding 9  = UniformBuffer      staticProbeParams (StaticProbeData)
//   binding 10 = StorageBuffer(ro)  confidenceBuffer
//   binding 11 = StorageBuffer(ro)  irradianceBuffer (9 float3 per probe)
//   binding 12 = StorageBuffer(ro)  ddgiDepthBuffer (128 floats per probe)
//   binding 13 = SampledImage       gbuffer_orm (r=AO, g=Roughness, b=Metallic)
//   binding 14 = StorageImage(rgba16f) spec_output_tex (half-res glossy:
//                                    RGB = SH(R) lobe radiance, A = NdotV)
//   binding 17 = StorageBuffer(ro)  flatIrradiance (T3.6/D1: 全部 volume 的
//                                    9 vec4/probe 探针顺序拼接,offset 256 起)
//   binding 18 = UniformBuffer      FlatVolumeCB (T3.6/D1: originSpacing[4] +
//                                    countsOffset[4] + meta.x=count)

#extension GL_EXT_samplerless_texture_functions : enable
#extension GL_GOOGLE_include_directive : require

// Shared shader library (axis refactor X1): SH9 evaluation lives in
// ShaderLib/EncodeLib.glsl. Constants are float32-identical to the previous
// inline bodies. The SH expansions inside the trilinear loops stay inline
// (they share precomputed axis products across two evaluations).
#include "ShaderLib/EncodeLib.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// --------------------------------------------------------------------------------
// Bindings (flat 0..12)
// --------------------------------------------------------------------------------
layout(set = 0, binding = 0) uniform texture2D gbuffer_depth;
layout(set = 0, binding = 1) uniform texture2D gbuffer_normal;
layout(set = 0, binding = 2, rgba16f) writeonly uniform image2D output_tex;
layout(set = 0, binding = 3) uniform texture2D history_tex; // unused (temporal disabled)

layout(set = 0, binding = 4, std140) uniform ViewCB {
    vec4 viewRows[4];  // invViewProj as 4 vec4 rows (column-major matrix)
    vec4 cameraPos;    // world-space camera position (T4.3 glossy reflections)
};
layout(set = 0, binding = 5, std140) uniform ProbeOriginSpacing {
    vec4 probeOriginSpacing;  // xyz=origin, w=spacing
};
layout(set = 0, binding = 6, std140) uniform ProbeCounts {
    vec4 probeCounts;  // xyz=counts, w=unused
    // T6.3 sub-A: binding 6 扩到 48B。中间槽位镜像 CPU 侧 camera_pos 字段
    // (GIGatherCB offset 96 — shader binding 4 的 80B range 不覆盖它,仅占位
    // 保证 debugVis 落在 CPU offset 112),第三个 vec4 = debugVis。
    vec4 cameraPosMirror;  // 占位(未读)
    vec4 debugVis;         // x = probe_vis 模式 (0=Off,1=IrradianceAtlas,
                           //      2=DepthAtlas,3=Confidence)
};

layout(set = 0, binding = 7) readonly buffer StaticSkySHBuf {
    vec4 staticSkySH[9];  // 9 SH coeffs (rgb stored as xyz of vec4)
};
layout(set = 0, binding = 8) readonly buffer StaticSkyFactorBuf {
    float staticSkyFactor[];
};

struct GPUStaticProbeData {
    vec4  gridOrigin;     // xyz origin, w spacing
    uvec3 gridCounts;
    float _pad0;
    vec4  skySH[9];
};

layout(set = 0, binding = 9, std140) uniform StaticProbeCB {
    GPUStaticProbeData staticProbe;
};

layout(set = 0, binding = 10) readonly buffer ConfidenceBuf {
    float confidenceBuffer[];
};
layout(set = 0, binding = 11) readonly buffer IrradianceBuf {
    vec4 irradianceBuffer[];  // 9 vec4 per probe (rgb in xyz)
};
layout(set = 0, binding = 12) readonly buffer DDGIDepthBuf {
    float ddgiDepthBuffer[];
};
layout(set = 0, binding = 13) uniform texture2D gbuffer_orm;
layout(set = 0, binding = 14, rgba16f) writeonly uniform image2D spec_output_tex;
// T3.6/D1: 15/16（far 双槽）与 17 array[4]（descriptor indexing）删除。
// flat 路径：17 = 单 SSBO，所有 volume 的 9-vec4/probe 探针数据顺序拼接
//（描述符绑 offset 256 跳过头部，此处即纯探针数组）；18 = FlatVolumeCB
//（origin/spacing + counts/probeOffset ×4 + meta.x=count）。
layout(set = 0, binding = 17) readonly buffer FlatIrradianceBuf {
    vec4 flatIrradiance[];  // 9 vec4 per probe，volume v 的探针 0 位于
                            // uint(fvCountsOffset[v].w)
};
layout(set = 0, binding = 18, std140) uniform FlatVolumeCB {
    vec4 fvOriginSpacing[4];   // xyz = origin, w = spacing（0 = 未用槽）
    vec4 fvCountsOffset[4];    // xyz = counts, w = flat SSBO probe 偏移
    vec4 fvMeta;               // x = 有效 volume 数（0 = 防御 dim ambient）
};

// --------------------------------------------------------------------------------
// Constants
// --------------------------------------------------------------------------------
#define TG_PROBE_COUNT 8
#define SH_COEFF_COUNT 9
#define TILE_SIZE 8
#define DEPTH_RES 8
#define DEPTH_TEXELS 64
#define DEPTH_FLOATS_PER_PROBE 128u

// DDGIVolumeData stores RADIANCE SH (mcWeight = 4π/N, no cosine projection), so
// the plain SH9 evaluation below reconstructs directional mean radiance L̄(N).
// Screen consumers need cosine-weighted irradiance E(N) = π·L̄ for the isotropic
// term — this constant supplies the missing factor at the diffuse output only.
//
// PAIRED CHANGE (keep both in sync): the probe trace chain shades hits with
// ddgi_light_color, which the CPU divides by π in the same commit. That keeps
// the SC↔probe feedback loop's absolute drive unchanged, so only the screen-end
// scale is corrected. NEVER apply this factor inside
// SurfaceCacheLightEval.comp::gatherProbeIrradiance — its loop gain budget
// (collection ≤ 0.85 × albedo < 1) was calibrated without it and a boost there
// diverges high-albedo walls within minutes (see that file, gather clamp note).
const float PROBE_SH_RAD_TO_IRRAD = 3.14159265;

// --------------------------------------------------------------------------------
// Shared memory (threadgroup)
// --------------------------------------------------------------------------------
struct TGProbe {
    vec3 sh[SH_COEFF_COUNT];
};
shared TGProbe tg_probes[TG_PROBE_COUNT];
shared float tg_depth_map[TG_PROBE_COUNT * DEPTH_FLOATS_PER_PROBE];
shared uvec3 tg_cellMin;
shared bool tg_cellFound;
shared uint tg_probe_idx[TG_PROBE_COUNT];
shared uint tg_probe_depth_base[TG_PROBE_COUNT];
shared float tg_skyFactor[TG_PROBE_COUNT];
shared vec3 tg_indirect[TILE_SIZE * TILE_SIZE];
shared float tg_pixelDepth[TILE_SIZE * TILE_SIZE];

// --------------------------------------------------------------------------------
// Helpers (ported from DDGIGIGather.metal)
// --------------------------------------------------------------------------------
vec2 gatherOctEncode(vec3 d) {
    float l1norm = abs(d.x) + abs(d.y) + abs(d.z);
    vec2 uv = d.xy / l1norm;
    if (d.z < 0.0) {
        uv = (1.0 - abs(uv.yx)) * mix(vec2(-1.0), vec2(1.0), greaterThanEqual(uv.xy, vec2(0.0)));
    }
    return uv * 0.5 + 0.5;
}

vec2 sampleOctDepthTG(int probeOffset, vec3 dir) {
    vec2 uv = gatherOctEncode(dir);
    ivec2 texel = ivec2(clamp(uint(uv.x * float(DEPTH_RES)), 0u, uint(DEPTH_RES - 1)),
                         clamp(uint(uv.y * float(DEPTH_RES)), 0u, uint(DEPTH_RES - 1)));
    int idx = texel.y * DEPTH_RES + texel.x;
    int base = probeOffset;
    return vec2(tg_depth_map[base + idx],
                tg_depth_map[base + int(DEPTH_TEXELS) + idx]);
}

// N-volume selection cannot use the tile-shared depth cache because each
// pixel may select a different volume/cell.  Volume 0 is the canonical near
// volume and its depth atlas is bound at binding 12, so sample it directly to
// retain DDGI visibility and normal weighting on the descriptor-indexed path.
vec2 sampleNearProbeDepth(uint probeIdx, vec3 dir) {
    vec2 uv = gatherOctEncode(dir);
    uvec2 texel = uvec2(clamp(uint(uv.x * float(DEPTH_RES)), 0u, uint(DEPTH_RES - 1)),
                        clamp(uint(uv.y * float(DEPTH_RES)), 0u, uint(DEPTH_RES - 1)));
    uint octIdx = texel.y * uint(DEPTH_RES) + texel.x;
    uint base = probeIdx * DEPTH_FLOATS_PER_PROBE;
    return vec2(ddgiDepthBuffer[base + octIdx],
                ddgiDepthBuffer[base + uint(DEPTH_TEXELS) + octIdx]);
}

vec3 evalSH9Shared(int probeIdx, vec3 d) {
    vec3 sh[9];
    for (int i = 0; i < 9; ++i) sh[i] = tg_probes[probeIdx].sh[i];
    return evalSH9(sh, d);
}

vec3 shDot9Float4(vec4 sh[9], vec3 d) {
    vec3 sh3[9];
    for (int i = 0; i < 9; ++i) sh3[i] = sh[i].xyz;
    return evalSH9(sh3, d);
}

float visibilityWeight(float distToProbe, float mean, float variance, float spacing) {
    float dist = max(distToProbe - mean, 0.0);
    if (variance < 0.0001) return 1.0;
    float cheb = variance / (variance + dist * dist);
    return clamp(max(cheb * 2.0, 0.2), 0.0, 1.0);
}

// Probe-position spheres (ProbeVisMode 4, SPGI_PROBE_VIS=4): DDA the near
// grid along the camera ray and ray-sphere test each probe center
// (r = 0.4×spacing). Colour = SH L0 luminance heat ramp; probes whose
// octahedral depth map reads ≈0 toward all sampled directions (sitting inside
// geometry, tracing nothing but wall interior) get the red burial tint.
// Scene occlusion is intentionally OFF — seeing probes through walls is the
// diagnostic point. Bounded at 96 DDA cells.
vec3 visProbePositions(vec2 uv) {
    mat4 invVP = mat4(viewRows[0], viewRows[1], viewRows[2], viewRows[3]);
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    vec4 farH = invVP * vec4(ndc, 0.999, 1.0);
    vec3 ro = cameraPos.xyz;
    vec3 rd = farH.xyz / farH.w - ro;
    float rdLen = length(rd);
    if (rdLen < 1e-5) return vec3(0.03, 0.03, 0.035);
    rd /= rdLen;

    vec3 vorg = probeOriginSpacing.xyz;
    float sp = max(probeOriginSpacing.w, 0.01);
    vec3 counts = vec3(probeCounts.xyz);
    float rad = 0.4 * sp;  // 0.4×spacing: ~40% solid-angle coverage per shell so
                           // the lattice reads at hallway distances (0.2 was too
                           // sparse — most rays slipped between spheres)

    // Bounding slab over all probe spheres
    vec3 bmin = vorg - vec3(rad);
    vec3 bmax = vorg + (counts - 1.0) * sp + vec3(rad);
    vec3 inv = 1.0 / rd;
    vec3 t0s = (bmin - ro) * inv;
    vec3 t1s = (bmax - ro) * inv;
    vec3 tsm = min(t0s, t1s), tbg = max(t0s, t1s);
    float tEnter = max(max(tsm.x, tsm.y), tsm.z);
    float tExit = min(min(min(tbg.x, tbg.y), tbg.z), rdLen);
    if (tExit < max(tEnter, 0.0)) return vec3(0.03, 0.03, 0.035);
    float t = max(tEnter, 0.0) + 1e-4;

    // Amanatides & Woo over the probe lattice (cell = probe index)
    ivec3 cell = clamp(ivec3(floor((ro + rd * t - vorg) / sp)), ivec3(0), ivec3(counts) - ivec3(1));
    ivec3 stp = ivec3(sign(rd));
    vec3 tDelta = abs(inv) * sp;
    vec3 nextB = vorg + (vec3(cell) + max(vec3(stp), 0.0)) * sp;
    vec3 tMax = (nextB - ro) * inv;
    for (int a = 0; a < 3; ++a)
        if (stp[a] == 0) tMax[a] = 1e30;

    float bestT = -1.0;
    ivec3 bestCell = ivec3(0);
    for (int it = 0; it < 96; ++it) {
        if (any(lessThan(cell, ivec3(0))) || any(greaterThanEqual(vec3(cell), counts))) break;
        vec3 center = vorg + vec3(cell) * sp;
        vec3 oc = ro - center;
        float b = dot(oc, rd);
        float c = dot(oc, oc) - rad * rad;
        float disc = b * b - c;
        if (disc > 0.0) {
            float th = -b - sqrt(disc);
            if (th > 0.0 && th <= tExit && (bestT < 0.0 || th < bestT)) {
                bestT = th;
                bestCell = cell;
            }
        }
        if (tMax.x < tMax.y) {
            if (tMax.x < tMax.z) { t = tMax.x; cell.x += stp.x; tMax.x += tDelta.x; }
            else                 { t = tMax.z; cell.z += stp.z; tMax.z += tDelta.z; }
        } else {
            if (tMax.y < tMax.z) { t = tMax.y; cell.y += stp.y; tMax.y += tDelta.y; }
            else                 { t = tMax.z; cell.z += stp.z; tMax.z += tDelta.z; }
        }
        if (t > tExit || (bestT > 0.0 && t > bestT)) break;
    }
    if (bestT < 0.0) {
        // Canary backplate: dim magenta wash proves the mode-4 path reached the
        // shader (fusion suppresses ~1.0-level debug colors via
        // max(ddgiBase, spgiTarget) — a flat change here is still visible).
        return vec3(0.10, 0.02, 0.10);
    }

    uint pIdx = uint(bestCell.x) + uint(bestCell.y) * uint(counts.x)
              + uint(bestCell.z) * uint(counts.x) * uint(counts.y);
    vec3 L0 = irradianceBuffer[pIdx * 9u].xyz;
    float lum = dot(L0, vec3(0.2126, 0.7152, 0.0722));

    // Burial probe: 4 octahedral taps — a probe inside solid geometry records
    // ≈0 mean depth toward every direction.
    vec3 tapDirs[4] = vec3[4](vec3(1, 0, 0), vec3(-1, 0, 0), vec3(0, 0, 1), vec3(0, 0, -1));
    float meanD = 0.0;
    for (int k = 0; k < 4; ++k) meanD += sampleNearProbeDepth(pIdx, tapDirs[k]).x;
    meanD *= 0.25;
    bool buried = meanD < 0.25 * sp;

    float e = clamp(log2(1.0 + lum) / 6.0, 0.0, 1.0);
    vec3 heat = mix(vec3(0.02, 0.08, 0.20), vec3(0.10, 0.85, 0.35), e);
    heat = mix(heat, vec3(1.0, 0.95, 0.45), smoothstep(0.55, 1.0, e));
    if (buried) heat = mix(heat, vec3(1.0, 0.12, 0.08), 0.85);

    vec3 n = (ro + rd * bestT - (vorg + vec3(bestCell) * sp)) / rad;
    float shade = 0.35 + 0.65 * max(dot(n, normalize(vec3(0.4, 0.8, 0.3))), 0.0);
    // ×6 punch-through: fusion computes indirect = albedo × (0.7·ddgi mixed
    // against SPGI by max()) × ao — at ~1.0 the spheres ghost. At ~6 they
    // survive as saturated (still hue-distinct) markers on tone-mapped output.
    return heat * shade * 6.0;
}

// --------------------------------------------------------------------------------
// Main
// --------------------------------------------------------------------------------
void ddgi_gi_gather() {
    uvec2 tid = gl_GlobalInvocationID.xy;
    uvec2 tidInGroup = gl_LocalInvocationID.xy;
    uvec2 groupSize = gl_WorkGroupSize.xy;

    ivec2 outSize = imageSize(output_tex);
    uint width = uint(outSize.x);
    uint height = uint(outSize.y);
    uint localIdx = tidInGroup.y * groupSize.x + tidInGroup.x;

    // Phase 0: cooperative loading setup
    bool inBounds = (tid.x < width && tid.y < height);
    float depth = 0.0;
    vec2 uv = vec2(0.0);
    vec3 worldPos = vec3(0.0);
    vec3 normal = vec3(0.0, 1.0, 0.0);
    vec3 gp = vec3(0.0);
    bool isActive = false;

    if (inBounds) {
        uv = (vec2(tid) + 0.5) / vec2(width, height);
        // GBuffer is full-res, GIGather output is half-res. Use UV-based texelFetch
        // with full-res dimensions to sample the correct GBuffer pixel.
        ivec2 fullResSize = textureSize(gbuffer_depth, 0);
        ivec2 fullTexel = ivec2(vec2(fullResSize) * uv);
        depth = texelFetch(gbuffer_depth, fullTexel, 0).r;
        if (depth < 1.0) {
            // Reconstruct invViewProj from 4 vec4 rows (column-major)
            mat4 invVP = mat4(viewRows[0], viewRows[1], viewRows[2], viewRows[3]);
            vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
            vec4 worldPosH = invVP * vec4(ndc, depth, 1.0);
            worldPos = worldPosH.xyz / worldPosH.w;

            ivec2 fullNormSize = textureSize(gbuffer_normal, 0);
            ivec2 fullNormTexel = ivec2(vec2(fullNormSize) * uv);
            vec3 n = texelFetch(gbuffer_normal, fullNormTexel, 0).xyz;
            n = normalize(n * 2.0 - 1.0);
            // GLSL has no isnormal() on vec3; check components
            if (!isnan(n.x) && !isnan(n.y) && !isnan(n.z))
                normal = n;

            vec3 origin = probeOriginSpacing.xyz;
            float spacing = probeOriginSpacing.w;
            gp = (worldPos - origin) / spacing;

            vec3 gridMax = vec3(probeCounts.x - 1.0, probeCounts.y - 1.0, probeCounts.z - 1.0);
            isActive = all(greaterThanEqual(gp, vec3(0.0))) && all(lessThanEqual(gp, gridMax));
        }
    }

    // Determine grid cell from first isActive thread
    if (localIdx == 0u) {
        tg_cellFound = false;
        tg_cellMin = uvec3(0u);
    }
    barrier();

    if (localIdx < 8u && isActive && !tg_cellFound) {
        tg_cellMin = uvec3(clamp(floor(gp), vec3(0.0),
                                vec3(probeCounts.x - 1.0, probeCounts.y - 1.0, probeCounts.z - 1.0)));
        tg_cellFound = true;
    }
    barrier();

    uvec3 counts = uvec3(probeCounts.xyz);

    // Phase 0a: compute probe indices + depth offsets
    if (localIdx < 8u) {
        uint cx = (localIdx & 1u) != 0u ? min(tg_cellMin.x + 1u, counts.x - 1u) : tg_cellMin.x;
        uint cy = (localIdx & 2u) != 0u ? min(tg_cellMin.y + 1u, counts.y - 1u) : tg_cellMin.y;
        uint cz = (localIdx & 4u) != 0u ? min(tg_cellMin.z + 1u, counts.z - 1u) : tg_cellMin.z;
        uint pIdx = cx + cy * counts.x + cz * counts.x * counts.y;
        tg_probe_idx[localIdx] = pIdx;
        tg_probe_depth_base[localIdx] = pIdx * DEPTH_FLOATS_PER_PROBE;
    }
    barrier();

    // Phase 0b: cooperative irradiance load (72 float3 = 72 vec4 slots, 9 per probe × 8 probes)
    {
        uint probe = localIdx / 9u;
        uint shIdx = localIdx % 9u;
        if (probe < TG_PROBE_COUNT) {
            uint pIdx = tg_probe_idx[probe];
            tg_probes[probe].sh[shIdx] = irradianceBuffer[pIdx * 9u + shIdx].xyz;
        }
    }
    // Second load: threads 0-7 load [63..71] — but 63/9=7,sh0 already loaded by thread 63.
    // Metal loads 64..71 which is probe 7 sh 1-8. Thread 63 (64-1) loads probe 7 sh 0.
    // GLSL: threads 0-7 load probe 7 sh 1-8 (indices 64..71 → probe 64/9=7, sh 64%9=1..8)
    if (localIdx < 8u) {
        uint idx = 64u + localIdx;
        uint probe = idx / 9u;
        uint shIdx = idx % 9u;
        if (probe < uint(TG_PROBE_COUNT) && shIdx < uint(SH_COEFF_COUNT)) {
            uint pIdx = tg_probe_idx[probe];
            tg_probes[probe].sh[shIdx] = irradianceBuffer[pIdx * 9u + shIdx].xyz;
        }
        tg_skyFactor[localIdx] = staticSkyFactor[tg_probe_idx[localIdx]];
    }
    barrier();

    // Phase 0c: cooperative depth load (1024 floats / 64 threads = 16 per thread)
    for (uint j = 0u; j < 16u; ++j) {
        uint linearIdx = localIdx * 16u + j;
        uint probe = linearIdx / DEPTH_FLOATS_PER_PROBE;
        uint offsetInProbe = linearIdx % DEPTH_FLOATS_PER_PROBE;
        float val = ddgiDepthBuffer[tg_probe_depth_base[probe] + offsetInProbe];
        tg_depth_map[probe * DEPTH_FLOATS_PER_PROBE + offsetInProbe] = val;
    }
    barrier();

    // Phase 1: per-pixel output. 三条互斥路由:
    //   (A) probe_vis 调试可视化(T6.3 sub-A)—— debugVis.x > 0.5;
    //   (B) flat-buffer 多 volume gather(T3.6/D1)—— fvMeta.x > 0.5
    //       (sel==0 近场数学 / sel>0 远场数学;两槽 legacy 已删除)。
    if (inBounds && debugVis.x > 0.5) {
        // ====================================================================
        // (A) probe 调试可视化 — GIDebug().probe_vis 数据面(T6.3 sub-A)。
        // 输出替换 gather 结果:近场网格内按模式可视化;网格外 mode 1 用远场
        // volume 的 L0;其余 dim 背板。spec 输出清零(调试模式无光泽意义)。
        // ====================================================================
        int visMode = int(debugVis.x + 0.5);  // 1/2/3/4
        vec3 vis = vec3(0.03, 0.03, 0.035);
        if (visMode == 4) {
            // ProbePositions (M8/T8.3): probe 格点球体位置可视化 —— 绿→黄 =
            // L0 能量, 红染 = 埋没(全向平均深度≈0)。穿墙可见, 用于定位
            // 3m 网格下埋进拱廊墙体的 probe。
            vis = visProbePositions(uv);
        } else if (depth < 1.0) {
            uvec3 countsV = uvec3(probeCounts.xyz);
            if (isActive) {
                uvec3 b0 = clamp(uvec3(floor(gp)), uvec3(0u), countsV - 1u);
                uvec3 b1 = min(b0 + 1u, countsV - 1u);
                vec3 fracGp = fract(gp);
                float fx = fracGp.x, fy = fracGp.y, fz = fracGp.z;
                float tw[8];
                tw[0] = (1.0 - fx) * (1.0 - fy) * (1.0 - fz);
                tw[1] = fx           * (1.0 - fy) * (1.0 - fz);
                tw[2] = (1.0 - fx) * fy           * (1.0 - fz);
                tw[3] = fx           * fy           * (1.0 - fz);
                tw[4] = (1.0 - fx) * (1.0 - fy) * fz;
                tw[5] = fx           * (1.0 - fy) * fz;
                tw[6] = (1.0 - fx) * fy           * fz;
                tw[7] = fx           * fy           * fz;
                uvec3 pc[8];
                pc[0] = uvec3(b0.x, b0.y, b0.z); pc[1] = uvec3(b1.x, b0.y, b0.z);
                pc[2] = uvec3(b0.x, b1.y, b0.z); pc[3] = uvec3(b1.x, b1.y, b0.z);
                pc[4] = uvec3(b0.x, b0.y, b1.z); pc[5] = uvec3(b1.x, b0.y, b1.z);
                pc[6] = uvec3(b0.x, b1.y, b1.z); pc[7] = uvec3(b1.x, b1.y, b1.z);
                if (visMode == 1) {
                    // IrradianceAtlas: 8 probe 三线性加权的 SH L0(band-0 均值)。
                    vec3 sh0 = vec3(0.0);
                    float wsum = 0.0;
                    for (int p = 0; p < 8; ++p) {
                        if (tw[p] < 0.01) continue;
                        uint pIdx = pc[p].x + pc[p].y * countsV.x + pc[p].z * countsV.x * countsV.y;
                        sh0 += irradianceBuffer[pIdx * 9u].xyz * tw[p];
                        wsum += tw[p];
                    }
                    if (wsum > 0.0) sh0 /= wsum;
                    vis = sh0 * 0.28209479;  // SH_C0 → 方向平均辐亮度
                } else if (visMode == 2) {
                    // DepthAtlas: 最近 probe 的 octahedral 平均深度(沿法线方向
                    // 采样 8x8 深度图 mean 通道)。/25 = 可视化曝光。
                    uvec3 np = clamp(uvec3(floor(gp + 0.5)), uvec3(0u), countsV - 1u);
                    uint pIdx = np.x + np.y * countsV.x + np.z * countsV.x * countsV.y;
                    vec2 ouv = gatherOctEncode(normal);
                    ivec2 texel = ivec2(clamp(uint(ouv.x * float(DEPTH_RES)), 0u, uint(DEPTH_RES - 1)),
                                        clamp(uint(ouv.y * float(DEPTH_RES)), 0u, uint(DEPTH_RES - 1)));
                    float meanDepth = ddgiDepthBuffer[pIdx * DEPTH_FLOATS_PER_PROBE
                                                      + uint(texel.y * DEPTH_RES + texel.x)];
                    vis = vec3(clamp(meanDepth / 25.0, 0.0, 1.0));
                } else {
                    // Confidence: 8 probe 三线性加权的 confidence 灰度。
                    float conf = 0.0;
                    float wsum = 0.0;
                    for (int p = 0; p < 8; ++p) {
                        if (tw[p] < 0.01) continue;
                        uint pIdx = pc[p].x + pc[p].y * countsV.x + pc[p].z * countsV.x * countsV.y;
                        // 4 floats/probe (rayHitRatio, ?, ?, convergence);
                        // slot 3 is the same convergence DDGIUpdateIrradiance
                        // publishes and the SC bootstrap gates on.
                        conf += confidenceBuffer[pIdx * 4u + 3u] * tw[p];
                        wsum += tw[p];
                    }
                    vis = vec3(clamp(conf / max(wsum, 1e-4), 0.0, 1.0));
                }
            } else if (visMode == 1 && fvMeta.x > 1.5 && fvOriginSpacing[1].w > 0.0) {
                // 近场网格外、far volume（flat vols[1]）内:L0 三线性(与 gather
                // 远场同几何)。T3.6/D1: 读 flat SSBO 而非已删除的 far 双槽。
                vec3 fgp = (worldPos - fvOriginSpacing[1].xyz) / fvOriginSpacing[1].w;
                vec3 fcounts = fvCountsOffset[1].xyz;
                uint foff = uint(fvCountsOffset[1].w);
                vec3 fgridMax = fcounts - 1.0;
                if (all(greaterThanEqual(fgp, vec3(0.0))) && all(lessThanEqual(fgp, fgridMax))) {
                    uvec3 fb0 = clamp(uvec3(floor(fgp)), uvec3(0u), uvec3(fcounts) - 1u);
                    uvec3 fb1 = min(fb0 + 1u, uvec3(fcounts) - 1u);
                    vec3 ffrac = fract(fgp);
                    float ffx = ffrac.x, ffy = ffrac.y, ffz = ffrac.z;
                    float ftw[8];
                    ftw[0] = (1.0 - ffx) * (1.0 - ffy) * (1.0 - ffz);
                    ftw[1] = ffx           * (1.0 - ffy) * (1.0 - ffz);
                    ftw[2] = (1.0 - ffx) * ffy           * (1.0 - ffz);
                    ftw[3] = ffx           * ffy           * (1.0 - ffz);
                    ftw[4] = (1.0 - ffx) * (1.0 - ffy) * ffz;
                    ftw[5] = ffx           * (1.0 - ffy) * ffz;
                    ftw[6] = (1.0 - ffx) * ffy           * ffz;
                    ftw[7] = ffx           * ffy           * ffz;
                    uvec3 fpc[8];
                    fpc[0] = uvec3(fb0.x, fb0.y, fb0.z); fpc[1] = uvec3(fb1.x, fb0.y, fb0.z);
                    fpc[2] = uvec3(fb0.x, fb1.y, fb0.z); fpc[3] = uvec3(fb1.x, fb1.y, fb0.z);
                    fpc[4] = uvec3(fb0.x, fb0.y, fb1.z); fpc[5] = uvec3(fb1.x, fb0.y, fb1.z);
                    fpc[6] = uvec3(fb0.x, fb1.y, fb1.z); fpc[7] = uvec3(fb1.x, fb1.y, fb1.z);
                    vec3 sh0 = vec3(0.0);
                    float wsum = 0.0;
                    for (int p = 0; p < 8; ++p) {
                        if (ftw[p] < 0.01) continue;
                        uint pIdx = fpc[p].x + fpc[p].y * uint(fcounts.x)
                                  + fpc[p].z * uint(fcounts.x) * uint(fcounts.y);
                        sh0 += flatIrradiance[(foff + pIdx) * 9u].xyz * ftw[p];
                        wsum += ftw[p];
                    }
                    if (wsum > 0.0) sh0 /= wsum;
                    vis = sh0 * 0.28209479;
                }
            }
        }
        imageStore(output_tex, ivec2(tid), vec4(vis, 1.0));
        imageStore(spec_output_tex, ivec2(tid), vec4(0.0));
    } else if (fvMeta.x > 0.5) {
        // ====================================================================
        // (B) flat-buffer 多 volume gather（T3.6/D1，取代 descriptor-indexing
        // N-volume 与 legacy 两槽双路径）。逐像素选择"包含该点且 spacing 最细"
        // 的 volume（平局取低索引 → near=volume 0 优先），经 probeOffset 索引
        // 单一 flat SSBO。selected == 0 时与原近场路径同数学（含 R lobe spec
        // 输出 + 深度图可见性/法线加权）；否则与原远场路径同数学（spec 清零）。
        // 天空/网外像素与原路径相同的 dim ambient。
        // ====================================================================
        if (inBounds && depth < 1.0) {
            int sel = -1;
            float selSpacing = 0.0;
            int nvolCount = int(fvMeta.x);
            for (int v = 0; v < nvolCount; ++v) {
                if (fvOriginSpacing[v].w <= 0.0) continue;  // spacing=0 = 未用槽
                vec3 gpv = (worldPos - fvOriginSpacing[v].xyz) / fvOriginSpacing[v].w;
                vec3 gridMax = fvCountsOffset[v].xyz - 1.0;
                if (all(greaterThanEqual(gpv, vec3(0.0))) && all(lessThanEqual(gpv, gridMax))) {
                    if (sel < 0 || fvOriginSpacing[v].w < selSpacing) {
                        sel = v;
                        selSpacing = fvOriginSpacing[v].w;
                    }
                }
            }
            if (sel >= 0) {
                uint volOff = uint(fvCountsOffset[sel].w);
                vec3 gpn = (worldPos - fvOriginSpacing[sel].xyz) / fvOriginSpacing[sel].w;
                uvec3 ncounts = uvec3(fvCountsOffset[sel].xyz);
                uvec3 b0 = clamp(uvec3(floor(gpn)), uvec3(0u), ncounts - 1u);
                uvec3 b1 = min(b0 + 1u, ncounts - 1u);
                vec3 fracGp = fract(gpn);
                float fx = fracGp.x, fy = fracGp.y, fz = fracGp.z;

                float tw[8];
                tw[0] = (1.0 - fx) * (1.0 - fy) * (1.0 - fz);
                tw[1] = fx           * (1.0 - fy) * (1.0 - fz);
                tw[2] = (1.0 - fx) * fy           * (1.0 - fz);
                tw[3] = fx           * fy           * (1.0 - fz);
                tw[4] = (1.0 - fx) * (1.0 - fy) * fz;
                tw[5] = fx           * (1.0 - fy) * fz;
                tw[6] = (1.0 - fx) * fy           * fz;
                tw[7] = fx           * fy           * fz;

                uvec3 pc[8];
                pc[0] = uvec3(b0.x, b0.y, b0.z); pc[1] = uvec3(b1.x, b0.y, b0.z);
                pc[2] = uvec3(b0.x, b1.y, b0.z); pc[3] = uvec3(b1.x, b1.y, b0.z);
                pc[4] = uvec3(b0.x, b0.y, b1.z); pc[5] = uvec3(b1.x, b0.y, b1.z);
                pc[6] = uvec3(b0.x, b1.y, b1.z); pc[7] = uvec3(b1.x, b1.y, b1.z);

                // SH reconstruction coefficients — 与 legacy 路径同值。
                const float SH_C0   = 0.28209479;
                const float SH_C1   = 0.48860251;
                const float SH_C2_0 = 1.09254843;  // xy
                const float SH_C2_1 = 0.31539157;  // 3zz-1
                const float SH_C2_2 = 0.54627421;  // xx-yy
                float nx = normal.x, ny = normal.y, nz = normal.z;
                float nxy = nx*ny, nyz = ny*nz, nzx = nz*nx;
                float nxx = nx*nx, nyy = ny*ny, nzz = nz*nz;

                // sel==0(近场)时与 legacy 相同的 R lobe 输入。
                vec3 V = normalize(cameraPos.xyz - worldPos);
                float NdotV = clamp(dot(normal, V), 0.05, 1.0);
                vec3 R = reflect(-V, normal);
                float rx = R.x, ry = R.y, rz = R.z;
                float rxy = rx*ry, ryz = ry*rz, rzx = rz*rx;
                float rxx = rx*rx, ryy = ry*ry, rzz = rz*rz;

                vec3 result = vec3(0.0);
                float totalW = 0.0;
                vec3 lowFrequencyGI = vec3(0.0);
                float lowFrequencyW = 0.0;
                vec3 reflResult = vec3(0.0);
                vec3 bestIrr = vec3(0.0);
                vec3 bestRefl = vec3(0.0);
                float bestBaseWeight = -1.0;
                vec3 biasedPos = worldPos + normal * selSpacing * 0.05;

                for (int p = 0; p < 8; ++p) {
                    if (tw[p] < 0.01) continue;
                    uint pIdx = pc[p].x + pc[p].y * ncounts.x + pc[p].z * ncounts.x * ncounts.y;
                    vec3 sh[9];
                    // T3.6/D1: flat SSBO 索引——volume 偏移 + volume 内探针索引。
                    for (int i = 0; i < 9; ++i)
                        sh[i] = flatIrradiance[(volOff + pIdx) * 9u + uint(i)].xyz;
                    // Must exactly match DDGIUpdateIrradiance's real-SH basis.
                    // The previous Vulkan N-volume path swapped coefficients
                    // 6/7 and omitted four signs, cancelling directional GI.
                    vec3 irr = sh[0] * SH_C0
                             + sh[1] * (-SH_C1 * 0.6666667 * ny)   // B4: A1 = 2π/3 (÷π ⇒ ×2/3)
                             + sh[2] * ( SH_C1 * 0.6666667 * nz)
                             + sh[3] * (-SH_C1 * 0.6666667 * nx)
                             + sh[4] * ( SH_C2_0 * 0.25 * nxy)   // B4: A2 = π/4 (÷π ⇒ ×1/4)
                             + sh[5] * (-SH_C2_0 * 0.25 * nyz)
                             + sh[6] * ( SH_C2_1 * 0.25 * (3.0*nzz - 1.0))
                             + sh[7] * (-SH_C2_0 * 0.25 * nzx)
                             + sh[8] * (SH_C2_2 * 0.25 * (nxx - nyy));

                    float w = tw[p];
                    // Buried-probe gate for the low-frequency average (near
                    // volume only). A probe inside the wall records near-zero
                    // octahedral mean depth toward every direction; at raw
                    // trilinear weight its black SH diluted lit texels through
                    // the 55% low-frequency blend (the patchy dark bands next
                    // to walls/columns). The continuous ramp keeps the
                    // anti-black-cell role on thin geometry intact.
                    float burial = 1.0;
                    // Only the near volume currently exposes a depth atlas.
                    // Restore the visibility/normal terms used by the original
                    // Metal/Dawn gather so irradiance cannot leak through walls
                    // as probe-sized white cells.
                    if (sel == 0) {
                        vec3 probePos = fvOriginSpacing[sel].xyz
                                      + vec3(pc[p]) * selSpacing;
                        vec3 toProbeVec = probePos - biasedPos;
                        float distToProbe = length(toProbeVec);
                        vec3 toProbe = toProbeVec / max(distToProbe, 1e-5);
                        // Keep the visibility test continuous.  A zero normal
                        // term rejects all eight probes near thin/two-sided
                        // geometry and produces probe-sized unlit cells.
                        float normalWeight = mix(
                            0.2, 1.0,
                            clamp((dot(normal, toProbe) + 0.5) / 0.7, 0.0, 1.0));
                        vec3 fromProbe = -toProbe;
                        vec2 depthMV = sampleNearProbeDepth(pIdx, fromProbe);
                        float insidePenalty = 1.0;
                        if (depthMV.x < selSpacing * 0.2) {
                            insidePenalty = mix(
                                0.2, 1.0,
                                smoothstep(0.0, 0.2, depthMV.x / selSpacing));
                            burial = mix(
                                0.1, 1.0,
                                smoothstep(0.0, 0.2, depthMV.x / selSpacing));
                        }
                        // T8.10: bounded rejection — visibility floors raised
                        // (cheby 0.2→0.45, normal 0.2→0.5). Full rejection ate
                        // real cross-nave lobes on hall-facing receivers (+1.2
                        // A/B with a healthy field); leak safety stays via the
                        // gates plus the 55% low-frequency mix.
                        float nwSoft = max(normalWeight, 0.40); // T8.10c leak tighten
                        float vw = visibilityWeight(distToProbe, depthMV.x, depthMV.y, selSpacing);
                        vw = max(vw, 0.38); // T8.10c leak tighten
                        w *= nwSoft * vw * insidePenalty;
                    }

                    // Preserve a low-frequency trilinear component before
                    // depth/normal rejection. Thin cloth, railings and arches
                    // otherwise reject the neighbouring probes that carry
                    // their coloured bounce and collapse to black. The
                    // visibility-filtered result remains dominant below.
                    // Buried probes are excluded from this component — their
                    // SH is wall interior, not a legitimate low-frequency
                    // source.
                    lowFrequencyGI += irr * tw[p] * burial;
                    lowFrequencyW += tw[p] * burial;

                    if (tw[p] > bestBaseWeight) {
                        bestBaseWeight = tw[p];
                        bestIrr = irr;
                    }
                    result += irr * w;
                    totalW += w;

                    if (sel == 0) {
                        // Same coefficients along R — no extra device reads.
                        vec3 reflIrr = sh[0] * SH_C0
                                     + sh[1] * (-SH_C1 * ry)
                                     + sh[2] * ( SH_C1 * rz)
                                     + sh[3] * (-SH_C1 * rx)
                                     + sh[4] * ( SH_C2_0 * rxy)
                                     + sh[5] * (-SH_C2_0 * ryz)
                                     + sh[6] * ( SH_C2_1 * (3.0*rzz - 1.0))
                                     + sh[7] * (-SH_C2_0 * rzx)
                                     + sh[8] * (SH_C2_2 * (rxx - ryy));
                        reflResult += reflIrr * w;
                        if (tw[p] >= bestBaseWeight) bestRefl = reflIrr;
                    }
                }
                if (totalW > 0.0) {
                    result /= totalW;
                    reflResult /= totalW;
                } else {
                    // Defensive fallback for malformed depth data.  Normal
                    // operation uses the non-zero continuous weights above.
                    result = bestIrr;
                    reflResult = bestRefl;
                }
                if (lowFrequencyW > 0.0) {
                    lowFrequencyGI /= lowFrequencyW;
                    // 65% leak-resistant visibility gather + 35% smooth
                    // low-frequency colour bleeding. Correct vec4 probe
                    // strides and the removed screen-space box blur prevent
                    // this component from recreating the former white grid.
                    result = mix(lowFrequencyGI, result, 0.45);  // thin-geometry probes get Chebyshev-rejected; 55% low-freq keeps near-light bounce
                }
                // Specular keeps RADIANCE units (reflection lobe sampling is not
                // cosine-projected) and blends against the uncorrected result,
                // preserving the pre-fix scale of the glossy chain.
                vec3 radBase = max(result, vec3(0.05, 0.05, 0.06));  // sky-leak ambient floor
                vec3 diffOut = max(radBase * PROBE_SH_RAD_TO_IRRAD, vec3(0.05, 0.05, 0.06));
                imageStore(output_tex, ivec2(tid), vec4(diffOut, 1.0));

                if (sel == 0) {
                    // Glossy output(与 legacy 近场一致):RGB = lobe radiance,
                    // A = NdotV(DFG 在 FusionComposite)。
                    ivec2 fullOrmTexel = ivec2(vec2(textureSize(gbuffer_orm, 0)) * uv);
                    float roughness = clamp(texelFetch(gbuffer_orm, fullOrmTexel, 0).g, 0.04, 1.0);
                    vec3 specIrr = mix(reflResult, radBase, roughness * roughness);
                    imageStore(spec_output_tex, ivec2(tid), vec4(specIrr, NdotV));
                } else {
                    imageStore(spec_output_tex, ivec2(tid), vec4(0.0));
                }
            } else {
                // Outside all volumes: dim ambient (legacy parity).
                imageStore(output_tex, ivec2(tid), vec4(0.03, 0.03, 0.035, 1.0));
                imageStore(spec_output_tex, ivec2(tid), vec4(0.0));
            }
        } else {
            // Sky / no-depth pixels: legacy parity dim ambient.
            imageStore(output_tex, ivec2(tid), vec4(0.03, 0.03, 0.035, 1.0));
            imageStore(spec_output_tex, ivec2(tid), vec4(0.0));
        }
    } else {
        // T3.6/D1: legacy 两槽路径已删除。fvMeta.x==0（flat 未上传——
        // GIGatherModule 拿不到 volume 数据时的防御分支）→ dim ambient。
        imageStore(output_tex, ivec2(tid), vec4(0.03, 0.03, 0.035, 1.0));
        imageStore(spec_output_tex, ivec2(tid), vec4(0.0));
    }
}
