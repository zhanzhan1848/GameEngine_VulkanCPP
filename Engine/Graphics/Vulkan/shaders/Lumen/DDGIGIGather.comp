#version 450 core
// Vulkan Lumen GIGather — GLSL port of DDGIGIGather.metal (8-probe trilinear + L2 SH + cross bilateral).
// Entry point: ddgi_gi_gather  (glslangValidator --source-entrypoint main -e ddgi_gi_gather)
//
// Phase 2 of Vulkan Lumen port (decision D7: hand-written GLSL replicating Metal 13-binding,
// including static probe support). See Docs/2026-08-09-vulkan-lumen-gi-port-design.md §5.3.
//
// Flat descriptor bindings:
//   binding 0  = SampledDepthImage  gbuffer_depth
//   binding 1  = SampledImage       gbuffer_normal
//   binding 2  = StorageImage(rgba16f) output_tex  (half-res GI)
//   binding 3  = SampledImage       history_tex    (temporal)
//   binding 4  = UniformBuffer      invViewProj + cameraPos (5 vec4 = 80B)
//   binding 5  = UniformBuffer      probeOriginSpacing (origin.xyz + spacing.w)
//   binding 6  = UniformBuffer      probeCounts (xyz)
//   binding 7  = StorageBuffer(ro)  staticSkySH (9 float3)
//   binding 8  = StorageBuffer(ro)  staticSkyFactor (float per probe)
//   binding 9  = UniformBuffer      staticProbeParams (StaticProbeData)
//   binding 10 = StorageBuffer(ro)  confidenceBuffer
//   binding 11 = StorageBuffer(ro)  irradianceBuffer (9 float3 per probe)
//   binding 12 = StorageBuffer(ro)  ddgiDepthBuffer (128 floats per probe)
//   binding 13 = SampledImage       gbuffer_orm (r=AO, g=Roughness, b=Metallic)
//   binding 14 = StorageImage(rgba16f) spec_output_tex (half-res glossy:
//                                    RGB = SH(R) lobe radiance, A = NdotV)
//   binding 15 = UniformBuffer      farVolume (T4.4: origin.xyz+spacing.w,
//                                    counts.xyz+enabled.w)
//   binding 16 = StorageBuffer(ro)  farIrradianceBuffer (9 vec4 per probe)

#extension GL_EXT_samplerless_texture_functions : enable
#extension GL_GOOGLE_include_directive : require

// Shared shader library (axis refactor X1): SH9 evaluation lives in
// ShaderLib/EncodeLib.glsl. Constants are float32-identical to the previous
// inline bodies. The SH expansions inside the trilinear loops stay inline
// (they share precomputed axis products across two evaluations).
#include "ShaderLib/EncodeLib.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// --------------------------------------------------------------------------------
// Bindings (flat 0..12)
// --------------------------------------------------------------------------------
layout(set = 0, binding = 0) uniform texture2D gbuffer_depth;
layout(set = 0, binding = 1) uniform texture2D gbuffer_normal;
layout(set = 0, binding = 2, rgba16f) writeonly uniform image2D output_tex;
layout(set = 0, binding = 3) uniform texture2D history_tex; // unused (temporal disabled)

layout(set = 0, binding = 4, std140) uniform ViewCB {
    vec4 viewRows[4];  // invViewProj as 4 vec4 rows (column-major matrix)
    vec4 cameraPos;    // world-space camera position (T4.3 glossy reflections)
};
layout(set = 0, binding = 5, std140) uniform ProbeOriginSpacing {
    vec4 probeOriginSpacing;  // xyz=origin, w=spacing
};
layout(set = 0, binding = 6, std140) uniform ProbeCounts {
    vec4 probeCounts;  // xyz=counts, w=unused
};

layout(set = 0, binding = 7) readonly buffer StaticSkySHBuf {
    vec4 staticSkySH[9];  // 9 SH coeffs (rgb stored as xyz of vec4)
};
layout(set = 0, binding = 8) readonly buffer StaticSkyFactorBuf {
    float staticSkyFactor[];
};

struct GPUStaticProbeData {
    vec4  gridOrigin;     // xyz origin, w spacing
    uvec3 gridCounts;
    float _pad0;
    vec4  skySH[9];
};

layout(set = 0, binding = 9, std140) uniform StaticProbeCB {
    GPUStaticProbeData staticProbe;
};

layout(set = 0, binding = 10) readonly buffer ConfidenceBuf {
    float confidenceBuffer[];
};
layout(set = 0, binding = 11) readonly buffer IrradianceBuf {
    vec4 irradianceBuffer[];  // 9 vec4 per probe (rgb in xyz)
};
layout(set = 0, binding = 12) readonly buffer DDGIDepthBuf {
    float ddgiDepthBuffer[];
};
layout(set = 0, binding = 13) uniform texture2D gbuffer_orm;
layout(set = 0, binding = 14, rgba16f) writeonly uniform image2D spec_output_tex;
layout(set = 0, binding = 15, std140) uniform FarVolumeCB {
    vec4 farOriginSpacing;  // xyz = origin, w = spacing (T4.4)
    vec4 farCountsEnabled;  // xyz = counts, w = enabled flag
};
layout(set = 0, binding = 16) readonly buffer FarIrradianceBuf {
    vec4 farIrradianceBuffer[];  // 9 vec4 per probe
};

// --------------------------------------------------------------------------------
// Constants
// --------------------------------------------------------------------------------
#define TG_PROBE_COUNT 8
#define SH_COEFF_COUNT 9
#define TILE_SIZE 8
#define DEPTH_RES 8
#define DEPTH_TEXELS 64
#define DEPTH_FLOATS_PER_PROBE 128u

// --------------------------------------------------------------------------------
// Shared memory (threadgroup)
// --------------------------------------------------------------------------------
struct TGProbe {
    vec3 sh[SH_COEFF_COUNT];
};
shared TGProbe tg_probes[TG_PROBE_COUNT];
shared float tg_depth_map[TG_PROBE_COUNT * DEPTH_FLOATS_PER_PROBE];
shared uvec3 tg_cellMin;
shared bool tg_cellFound;
shared uint tg_probe_idx[TG_PROBE_COUNT];
shared uint tg_probe_depth_base[TG_PROBE_COUNT];
shared float tg_skyFactor[TG_PROBE_COUNT];
shared vec3 tg_indirect[TILE_SIZE * TILE_SIZE];
shared float tg_pixelDepth[TILE_SIZE * TILE_SIZE];

// --------------------------------------------------------------------------------
// Helpers (ported from DDGIGIGather.metal)
// --------------------------------------------------------------------------------
vec2 gatherOctEncode(vec3 d) {
    float l1norm = abs(d.x) + abs(d.y) + abs(d.z);
    vec2 uv = d.xy / l1norm;
    if (d.z < 0.0) {
        uv = (1.0 - abs(uv.yx)) * mix(vec2(-1.0), vec2(1.0), greaterThanEqual(uv.xy, vec2(0.0)));
    }
    return uv * 0.5 + 0.5;
}

vec2 sampleOctDepthTG(int probeOffset, vec3 dir) {
    vec2 uv = gatherOctEncode(dir);
    ivec2 texel = ivec2(clamp(uint(uv.x * float(DEPTH_RES)), 0u, uint(DEPTH_RES - 1)),
                         clamp(uint(uv.y * float(DEPTH_RES)), 0u, uint(DEPTH_RES - 1)));
    int idx = texel.y * DEPTH_RES + texel.x;
    int base = probeOffset;
    return vec2(tg_depth_map[base + idx],
                tg_depth_map[base + int(DEPTH_TEXELS) + idx]);
}

vec3 evalSH9Shared(int probeIdx, vec3 d) {
    vec3 sh[9];
    for (int i = 0; i < 9; ++i) sh[i] = tg_probes[probeIdx].sh[i];
    return evalSH9(sh, d);
}

vec3 shDot9Float4(vec4 sh[9], vec3 d) {
    vec3 sh3[9];
    for (int i = 0; i < 9; ++i) sh3[i] = sh[i].xyz;
    return evalSH9(sh3, d);
}

float visibilityWeight(float distToProbe, float mean, float variance, float spacing) {
    float dist = max(distToProbe - mean, 0.0);
    if (variance < 0.0001) return 1.0;
    float cheb = variance / (variance + dist * dist);
    return clamp(max(cheb * 2.0, 0.2), 0.0, 1.0);
}

// --------------------------------------------------------------------------------
// Main
// --------------------------------------------------------------------------------
void ddgi_gi_gather() {
    uvec2 tid = gl_GlobalInvocationID.xy;
    uvec2 tidInGroup = gl_LocalInvocationID.xy;
    uvec2 groupSize = gl_WorkGroupSize.xy;

    ivec2 outSize = imageSize(output_tex);
    uint width = uint(outSize.x);
    uint height = uint(outSize.y);
    uint localIdx = tidInGroup.y * groupSize.x + tidInGroup.x;

    // Phase 0: cooperative loading setup
    bool inBounds = (tid.x < width && tid.y < height);
    float depth = 0.0;
    vec2 uv = vec2(0.0);
    vec3 worldPos = vec3(0.0);
    vec3 normal = vec3(0.0, 1.0, 0.0);
    vec3 gp = vec3(0.0);
    bool isActive = false;

    if (inBounds) {
        uv = (vec2(tid) + 0.5) / vec2(width, height);
        // GBuffer is full-res, GIGather output is half-res. Use UV-based texelFetch
        // with full-res dimensions to sample the correct GBuffer pixel.
        ivec2 fullResSize = textureSize(gbuffer_depth, 0);
        ivec2 fullTexel = ivec2(vec2(fullResSize) * uv);
        depth = texelFetch(gbuffer_depth, fullTexel, 0).r;
        if (depth < 1.0) {
            // Reconstruct invViewProj from 4 vec4 rows (column-major)
            mat4 invVP = mat4(viewRows[0], viewRows[1], viewRows[2], viewRows[3]);
            vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
            vec4 worldPosH = invVP * vec4(ndc, depth, 1.0);
            worldPos = worldPosH.xyz / worldPosH.w;

            ivec2 fullNormSize = textureSize(gbuffer_normal, 0);
            ivec2 fullNormTexel = ivec2(vec2(fullNormSize) * uv);
            vec3 n = texelFetch(gbuffer_normal, fullNormTexel, 0).xyz;
            n = normalize(n * 2.0 - 1.0);
            // GLSL has no isnormal() on vec3; check components
            if (!isnan(n.x) && !isnan(n.y) && !isnan(n.z))
                normal = n;

            vec3 origin = probeOriginSpacing.xyz;
            float spacing = probeOriginSpacing.w;
            gp = (worldPos - origin) / spacing;

            vec3 gridMax = vec3(probeCounts.x - 1.0, probeCounts.y - 1.0, probeCounts.z - 1.0);
            isActive = all(greaterThanEqual(gp, vec3(0.0))) && all(lessThanEqual(gp, gridMax));
        }
    }

    // Determine grid cell from first isActive thread
    if (localIdx == 0u) {
        tg_cellFound = false;
        tg_cellMin = uvec3(0u);
    }
    barrier();

    if (localIdx < 8u && isActive && !tg_cellFound) {
        tg_cellMin = uvec3(clamp(floor(gp), vec3(0.0),
                                vec3(probeCounts.x - 1.0, probeCounts.y - 1.0, probeCounts.z - 1.0)));
        tg_cellFound = true;
    }
    barrier();

    uvec3 counts = uvec3(probeCounts.xyz);

    // Phase 0a: compute probe indices + depth offsets
    if (localIdx < 8u) {
        uint cx = (localIdx & 1u) != 0u ? min(tg_cellMin.x + 1u, counts.x - 1u) : tg_cellMin.x;
        uint cy = (localIdx & 2u) != 0u ? min(tg_cellMin.y + 1u, counts.y - 1u) : tg_cellMin.y;
        uint cz = (localIdx & 4u) != 0u ? min(tg_cellMin.z + 1u, counts.z - 1u) : tg_cellMin.z;
        uint pIdx = cx + cy * counts.x + cz * counts.x * counts.y;
        tg_probe_idx[localIdx] = pIdx;
        tg_probe_depth_base[localIdx] = pIdx * DEPTH_FLOATS_PER_PROBE;
    }
    barrier();

    // Phase 0b: cooperative irradiance load (72 float3 = 72 vec4 slots, 9 per probe × 8 probes)
    {
        uint probe = localIdx / 9u;
        uint shIdx = localIdx % 9u;
        if (probe < TG_PROBE_COUNT) {
            uint pIdx = tg_probe_idx[probe];
            tg_probes[probe].sh[shIdx] = irradianceBuffer[pIdx * 9u + shIdx].xyz;
        }
    }
    // Second load: threads 0-7 load [63..71] — but 63/9=7,sh0 already loaded by thread 63.
    // Metal loads 64..71 which is probe 7 sh 1-8. Thread 63 (64-1) loads probe 7 sh 0.
    // GLSL: threads 0-7 load probe 7 sh 1-8 (indices 64..71 → probe 64/9=7, sh 64%9=1..8)
    if (localIdx < 8u) {
        uint idx = 64u + localIdx;
        uint probe = idx / 9u;
        uint shIdx = idx % 9u;
        if (probe < uint(TG_PROBE_COUNT) && shIdx < uint(SH_COEFF_COUNT)) {
            uint pIdx = tg_probe_idx[probe];
            tg_probes[probe].sh[shIdx] = irradianceBuffer[pIdx * 9u + shIdx].xyz;
        }
        tg_skyFactor[localIdx] = staticSkyFactor[tg_probe_idx[localIdx]];
    }
    barrier();

    // Phase 0c: cooperative depth load (1024 floats / 64 threads = 16 per thread)
    for (uint j = 0u; j < 16u; ++j) {
        uint linearIdx = localIdx * 16u + j;
        uint probe = linearIdx / DEPTH_FLOATS_PER_PROBE;
        uint offsetInProbe = linearIdx % DEPTH_FLOATS_PER_PROBE;
        float val = ddgiDepthBuffer[tg_probe_depth_base[probe] + offsetInProbe];
        tg_depth_map[probe * DEPTH_FLOATS_PER_PROBE + offsetInProbe] = val;
    }
    barrier();

    // Phase 1: per-pixel trilinear interpolation
    if (inBounds && !isActive) {
        // T4.4 two-stage: outside the near grid, try the far coarse volume
        // before falling back to dim ambient.
        bool farHit = false;
        if (farCountsEnabled.w > 0.5 && depth < 1.0) {
            vec3 fgp = (worldPos - farOriginSpacing.xyz) / farOriginSpacing.w;
            vec3 fcounts = farCountsEnabled.xyz;
            vec3 fgridMax = fcounts - 1.0;
            if (all(greaterThanEqual(fgp, vec3(0.0))) && all(lessThanEqual(fgp, fgridMax))) {
                uvec3 fb0 = clamp(uvec3(floor(fgp)), uvec3(0u), uvec3(fcounts) - 1u);
                uvec3 fb1 = min(fb0 + 1u, uvec3(fcounts) - 1u);
                vec3 ffrac = fract(fgp);
                float ffx = ffrac.x, ffy = ffrac.y, ffz = ffrac.z;

                float ftw[8];
                ftw[0] = (1.0 - ffx) * (1.0 - ffy) * (1.0 - ffz);
                ftw[1] = ffx           * (1.0 - ffy) * (1.0 - ffz);
                ftw[2] = (1.0 - ffx) * ffy           * (1.0 - ffz);
                ftw[3] = ffx           * ffy           * (1.0 - ffz);
                ftw[4] = (1.0 - ffx) * (1.0 - ffy) * ffz;
                ftw[5] = ffx           * (1.0 - ffy) * ffz;
                ftw[6] = (1.0 - ffx) * ffy           * ffz;
                ftw[7] = ffx           * ffy           * ffz;

                uvec3 fpc[8];
                fpc[0] = uvec3(fb0.x, fb0.y, fb0.z); fpc[1] = uvec3(fb1.x, fb0.y, fb0.z);
                fpc[2] = uvec3(fb0.x, fb1.y, fb0.z); fpc[3] = uvec3(fb1.x, fb1.y, fb0.z);
                fpc[4] = uvec3(fb0.x, fb0.y, fb1.z); fpc[5] = uvec3(fb1.x, fb0.y, fb1.z);
                fpc[6] = uvec3(fb0.x, fb1.y, fb1.z); fpc[7] = uvec3(fb1.x, fb1.y, fb1.z);

                const float SH_C0   = 0.28209479;
                const float SH_C1   = 0.48860251;
                const float SH_C2_0 = 1.09254843;
                const float SH_C2_1 = 0.31539157;
                const float SH_C2_2 = 0.54627421;
                float nx = normal.x, ny = normal.y, nz = normal.z;
                float nxy = nx*ny, nyz = ny*nz, nzx = nz*nx;
                float nxx = nx*nx, nyy = ny*ny, nzz = nz*nz;

                vec3 fresult = vec3(0.0);
                float ftotalW = 0.0;
                for (int p = 0; p < 8; ++p) {
                    if (ftw[p] < 0.01) continue;
                    uint pIdx = fpc[p].x + fpc[p].y * uint(fcounts.x) + fpc[p].z * uint(fcounts.x) * uint(fcounts.y);
                    vec3 sh[9];
                    for (int i = 0; i < 9; ++i)
                        sh[i] = farIrradianceBuffer[pIdx * 9u + uint(i)].xyz;
                    vec3 irr = sh[0] * SH_C0
                             + sh[1] * (SH_C1 * ny)
                             + sh[2] * (SH_C1 * nz)
                             + sh[3] * (SH_C1 * nx)
                             + sh[4] * (SH_C2_0 * nxy)
                             + sh[5] * (SH_C2_0 * nyz)
                             + sh[6] * (SH_C2_0 * nzx)
                             + sh[7] * (SH_C2_1 * (3.0*nzz - 1.0))
                             + sh[8] * (SH_C2_2 * (nxx - nyy));
                    fresult += irr * ftw[p];
                    ftotalW += ftw[p];
                }
                if (ftotalW > 0.0) {
                    fresult /= ftotalW;
                    fresult = max(fresult, vec3(0.02, 0.02, 0.025));
                    imageStore(output_tex, ivec2(tid), vec4(fresult, 1.0));
                    imageStore(spec_output_tex, ivec2(tid), vec4(0.0));
                    farHit = true;
                }
            }
        }
        if (!farHit) {
            // Outside both grids: dim ambient.
            imageStore(output_tex, ivec2(tid), vec4(0.03, 0.03, 0.035, 1.0));
            imageStore(spec_output_tex, ivec2(tid), vec4(0.0));
        }
    }

    if (isActive) {
        // Direct trilinear interpolation — no cooperative loading.
        // Each thread independently reads irradiance_buffer for its 8 surrounding probes.
        uvec3 b0 = clamp(uvec3(floor(gp)), uvec3(0u), counts - 1u);
        uvec3 b1 = min(b0 + 1u, counts - 1u);
        vec3 fracGp = fract(gp);
        float fx = fracGp.x, fy = fracGp.y, fz = fracGp.z;

        float tw[8];
        tw[0] = (1.0 - fx) * (1.0 - fy) * (1.0 - fz);
        tw[1] = fx           * (1.0 - fy) * (1.0 - fz);
        tw[2] = (1.0 - fx) * fy           * (1.0 - fz);
        tw[3] = fx           * fy           * (1.0 - fz);
        tw[4] = (1.0 - fx) * (1.0 - fy) * fz;
        tw[5] = fx           * (1.0 - fy) * fz;
        tw[6] = (1.0 - fx) * fy           * fz;
        tw[7] = fx           * fy           * fz;

        uvec3 pc[8];
        pc[0] = uvec3(b0.x, b0.y, b0.z); pc[1] = uvec3(b1.x, b0.y, b0.z);
        pc[2] = uvec3(b0.x, b1.y, b0.z); pc[3] = uvec3(b1.x, b1.y, b0.z);
        pc[4] = uvec3(b0.x, b0.y, b1.z); pc[5] = uvec3(b1.x, b0.y, b1.z);
        pc[6] = uvec3(b0.x, b1.y, b1.z); pc[7] = uvec3(b1.x, b1.y, b1.z);

        // SH reconstruction coefficients
        // Full SH9 reconstruction coefficients (L0+L1+L2)
        const float SH_C0   = 0.28209479;
        const float SH_C1   = 0.48860251;
        const float SH_C2_0 = 1.09254843;  // xy
        const float SH_C2_1 = 0.31539157;  // 3zz-1
        const float SH_C2_2 = 0.54627421;  // xx-yy
        float nx = normal.x, ny = normal.y, nz = normal.z;
        float nxy = nx*ny, nyz = ny*nz, nzx = nz*nx;
        float nxx = nx*nx, nyy = ny*ny, nzz = nz*nz;

        vec3 result = vec3(0.0);
        float totalW = 0.0;

        // T4.3 glossy: reflection vector R = reflect(-V, N), evaluated with the
        // same SH9 coefficients. Roughness widens the lobe by blending towards
        // the diffuse reconstruction (cosine-lobe limit at roughness → 1).
        vec3 V = normalize(cameraPos.xyz - worldPos);
        float NdotV = clamp(dot(normal, V), 0.05, 1.0);
        vec3 R = reflect(-V, normal);
        float roughness = 1.0;
        {
            ivec2 fullOrmTexel = ivec2(vec2(textureSize(gbuffer_orm, 0)) * uv);
            roughness = clamp(texelFetch(gbuffer_orm, fullOrmTexel, 0).g, 0.04, 1.0);
        }
        float rx = R.x, ry = R.y, rz = R.z;
        float rxy = rx*ry, ryz = ry*rz, rzx = rz*rx;
        float rxx = rx*rx, ryy = ry*ry, rzz = rz*rz;
        vec3 reflResult = vec3(0.0);

        for (int p = 0; p < 8; ++p) {
            if (tw[p] < 0.01) continue;
            uint pIdx = pc[p].x + pc[p].y * counts.x + pc[p].z * counts.x * counts.y;
            vec3 sh[9];
            for (int i = 0; i < 9; ++i)
                sh[i] = irradianceBuffer[pIdx * 9u + uint(i)].xyz;
            // SH9 reconstruction with cosine-lobe convolution
            vec3 irr = sh[0] * SH_C0
                     + sh[1] * (SH_C1 * ny)
                     + sh[2] * (SH_C1 * nz)
                     + sh[3] * (SH_C1 * nx)
                     + sh[4] * (SH_C2_0 * nxy)
                     + sh[5] * (SH_C2_0 * nyz)
                     + sh[6] * (SH_C2_0 * nzx)
                     + sh[7] * (SH_C2_1 * (3.0*nzz - 1.0))
                     + sh[8] * (SH_C2_2 * (nxx - nyy));
            result += irr * tw[p];
            totalW += tw[p];

            // Same coefficients along R — no extra device reads.
            reflResult += sh[0] * SH_C0
                        + sh[1] * (SH_C1 * ry)
                        + sh[2] * (SH_C1 * rz)
                        + sh[3] * (SH_C1 * rx)
                        + sh[4] * (SH_C2_0 * rxy)
                        + sh[5] * (SH_C2_0 * ryz)
                        + sh[6] * (SH_C2_0 * rzx)
                        + sh[7] * (SH_C2_1 * (3.0*rzz - 1.0))
                        + sh[8] * (SH_C2_2 * (rxx - ryy));
        }
        if (totalW > 0.0) {
            result /= totalW;
            reflResult /= totalW;
        }
        result = max(result, vec3(0.02, 0.02, 0.025));
        imageStore(output_tex, ivec2(tid), vec4(result, 1.0));

        // Glossy output: RGB = lobe radiance, A = NdotV (DFG happens in
        // FusionComposite where albedo/metallic are available).
        vec3 specIrr = mix(reflResult, result, roughness * roughness);
        imageStore(spec_output_tex, ivec2(tid), vec4(specIrr, NdotV));
    }
}
