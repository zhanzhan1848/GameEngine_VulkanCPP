#version 450
#extension GL_GOOGLE_include_directive : require
#include "SurfaceCacheData.glsl"
#include "BoundaryLightingData.glsl"
layout(local_size_x=8) in;
struct SCBoundaryRadianceEntry {vec4 radiance;vec4 indirect;uvec4 identity;uvec4 state;};
struct Query {uvec4 identity;vec4 position;};
struct Result {vec4 radiance;vec4 witness;uvec4 source;vec4 weights;};
layout(set=0,binding=0,std430) readonly buffer Index {uint scBoundaryWords[];};
layout(set=0,binding=1,std430) readonly buffer Queries {Query queries[];};
layout(set=0,binding=2,std430) readonly buffer Points {SCBoundaryLightPoint boundaryPoints[];};
layout(set=0,binding=3,std430) readonly buffer Cache {SCBoundaryRadianceEntry boundaryCache[];};
layout(set=0,binding=4,std430) readonly buffer Cards {SurfaceCacheCard lookupCards[];};
layout(set=0,binding=5,std430) readonly buffer Triangles {uint lookupTriangles[];};
layout(set=0,binding=6) uniform texture2D lookupDepth;
layout(set=0,binding=7) uniform texture2D lookupLighting;
layout(set=0,binding=8,std430) writeonly buffer Results {Result results[];};
bool sourceBinaryInsert=false;
#define SC_SOURCE_BINARY_INSERT sourceBinaryInsert
#include "BoundaryRadianceLookup.glsl"
void main(){uint outputIndex=gl_GlobalInvocationID.x,count=uint(queries.length());if(count==0u || outputIndex>=2u*count || uint(results.length())<2u*count)return;uint i=outputIndex%count;sourceBinaryInsert=outputIndex>=count;
    Query q=queries[i];Result r;r.radiance=vec4(0);r.witness=vec4(0);r.source=uvec4(0xffffffffu);r.weights=vec4(0);
    vec3 value,position,weights;uvec3 source;
    if(scBoundaryRadianceLookup(q.identity.x,q.identity.y,q.identity.z,q.identity.w,q.position.xyz,value,position,source,weights)){
        r.radiance=vec4(value,1);r.witness=vec4(position,1);r.source=uvec4(source,0);r.weights=vec4(weights,length(position-q.position.xyz));}
    results[outputIndex]=r;
}
