#version 450 core
#extension GL_EXT_samplerless_texture_functions : enable
// T3.5 + 2026-09-10 SH-L1 upgrade: Radiance cascade update — inject DDGI
// probe radiance into a 32³ world-space cascade. Each texel = one coarse
// world position; trilinearly samples the 8 nearest DDGI probes and stores
// the aggregated SH L0 + L1 coefficients (4 RGBA16F textures: RGB = raw SH
// coefficient color, A = validity). Far-field rays evaluate directionally
// in ScreenProbeTraceFinalize.comp with the canonical DDGI L0+L1 basis —
// the old 9→1 (DC-only) downgrade is gone; the chain is now DDGI(L2) →
// cascade(L1) → directional query.

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

// bindings 0..3: write images for coefficients [L0, L1x, L1y, L1z]
layout(set = 0, binding = 0, rgba16f) writeonly uniform image3D cascade_out_l0;
layout(set = 0, binding = 1, rgba16f) writeonly uniform image3D cascade_out_l1x;
layout(set = 0, binding = 2, rgba16f) writeonly uniform image3D cascade_out_l1y;
layout(set = 0, binding = 3, rgba16f) writeonly uniform image3D cascade_out_l1z;
// bindings 4..7: previous-frame textures for per-coefficient temporal EMA
layout(set = 0, binding = 4) uniform texture3D cascade_prev_l0;
layout(set = 0, binding = 5) uniform texture3D cascade_prev_l1x;
layout(set = 0, binding = 6) uniform texture3D cascade_prev_l1y;
layout(set = 0, binding = 7) uniform texture3D cascade_prev_l1z;

layout(set = 0, binding = 8, std140) uniform CascadeParams {
    vec4 origin_spacing;
    vec4 counts_enabled;
    vec4 ddgi_origin_spacing;
    vec4 ddgi_counts;
    float temporal_weight;
    float frame_index;
    float pad0;
    float pad1;
} cp;

// DDGI irradiance is the same flat 9-vec4-per-probe storage buffer every
// other consumer binds (ScreenProbeTraceFinalize.comp binding 11 convention).
// Coefficients 0..3 (L0 + L1xyz) live at [pIdx * 9 + 0..3]; the L2 tail
// (coeffs 4..8) is deliberately not propagated into the coarse cascade.
layout(set = 0, binding = 9, std430) readonly buffer DDGIIrradianceBuf {
    vec4 ddgi_irradiance_vec4[];
} ddgiIrr;

void main() {
    uvec3 tid = gl_GlobalInvocationID.xyz;
    if (any(greaterThanEqual(tid, uvec3(32u)))) return;

    // Coefficient register set: rgb = raw SH coefficient, a = validity.
    vec3 sh[4];

    if (cp.counts_enabled.w < 0.5) {
        sh[0] = vec3(0.0); sh[1] = vec3(0.0); sh[2] = vec3(0.0); sh[3] = vec3(0.0);
        imageStore(cascade_out_l0,  ivec3(tid), vec4(sh[0], 1.0));
        imageStore(cascade_out_l1x, ivec3(tid), vec4(sh[1], 1.0));
        imageStore(cascade_out_l1y, ivec3(tid), vec4(sh[2], 1.0));
        imageStore(cascade_out_l1z, ivec3(tid), vec4(sh[3], 1.0));
        return;
    }

    vec3 worldPos = cp.origin_spacing.xyz + (vec3(tid) + 0.5) * cp.origin_spacing.w;

    vec3 gp = (worldPos - cp.ddgi_origin_spacing.xyz) / cp.ddgi_origin_spacing.w;
    vec3 gridMax = vec3(cp.ddgi_counts.xyz) - 1.0;
    if (any(lessThan(gp, vec3(0.0))) || any(greaterThan(gp, gridMax))) {
        // Outside the DDGI volume: keep the legacy sky-floor magnitude. It is
        // stored as a RAW L0 coefficient now, so divide by C0 — the finalize
        // evaluation multiplies by C0 again, netting the same 0.03 radiance.
        const float C0 = 0.28209479;
        sh[0] = vec3(0.03, 0.03, 0.035) / C0;
        sh[1] = vec3(0.0); sh[2] = vec3(0.0); sh[3] = vec3(0.0);
        imageStore(cascade_out_l0,  ivec3(tid), vec4(sh[0], 1.0));
        imageStore(cascade_out_l1x, ivec3(tid), vec4(sh[1], 1.0));
        imageStore(cascade_out_l1y, ivec3(tid), vec4(sh[2], 1.0));
        imageStore(cascade_out_l1z, ivec3(tid), vec4(sh[3], 1.0));
        return;
    }

    vec3 f = clamp(fract(gp), vec3(0.0), vec3(1.0));
    ivec3 b0 = clamp(ivec3(floor(gp)), ivec3(0), ivec3(cp.ddgi_counts.xyz) - 1);
    ivec3 b1 = min(b0 + ivec3(1), ivec3(cp.ddgi_counts.xyz) - 1);

    float w[8];
    w[0] = (1.0-f.x)*(1.0-f.y)*(1.0-f.z);
    w[1] = f.x*(1.0-f.y)*(1.0-f.z);
    w[2] = (1.0-f.x)*f.y*(1.0-f.z);
    w[3] = f.x*f.y*(1.0-f.z);
    w[4] = (1.0-f.x)*(1.0-f.y)*f.z;
    w[5] = f.x*(1.0-f.y)*f.z;
    w[6] = (1.0-f.x)*f.y*f.z;
    w[7] = f.x*f.y*f.z;

    ivec3 pc[8];
    pc[0] = ivec3(b0.x, b0.y, b0.z); pc[1] = ivec3(b1.x, b0.y, b0.z);
    pc[2] = ivec3(b0.x, b1.y, b0.z); pc[3] = ivec3(b1.x, b1.y, b0.z);
    pc[4] = ivec3(b0.x, b0.y, b1.z); pc[5] = ivec3(b1.x, b0.y, b1.z);
    pc[6] = ivec3(b0.x, b1.y, b1.z); pc[7] = ivec3(b1.x, b1.y, b1.z);

    for (int c = 0; c < 4; ++c) sh[c] = vec3(0.0);
    float wsum = 0.0;
    for (int p = 0; p < 8; ++p) {
        if (w[p] < 0.01) continue;
        uint pIdx = uint(pc[p].x) + uint(cp.ddgi_counts.x) * (uint(pc[p].y) + uint(cp.ddgi_counts.y) * uint(pc[p].z));
        uint base = pIdx * 9u;
        for (int c = 0; c < 4; ++c)
            sh[c] += ddgiIrr.ddgi_irradiance_vec4[base + uint(c)].rgb * w[p];
        wsum += w[p];
    }
    if (wsum > 0.0) {
        for (int c = 0; c < 4; ++c) sh[c] /= wsum;
    }

    // Per-coefficient temporal EMA (frame_index >= 2 gating preserved).
    float tw = (cp.frame_index >= 2.0) ? cp.temporal_weight : 0.0;
    vec3 prevL0  = texelFetch(cascade_prev_l0,  ivec3(tid), 0).rgb;
    vec3 prevL1x = texelFetch(cascade_prev_l1x, ivec3(tid), 0).rgb;
    vec3 prevL1y = texelFetch(cascade_prev_l1y, ivec3(tid), 0).rgb;
    vec3 prevL1z = texelFetch(cascade_prev_l1z, ivec3(tid), 0).rgb;
    sh[0] = mix(sh[0], prevL0,  tw);
    sh[1] = mix(sh[1], prevL1x, tw);
    sh[2] = mix(sh[2], prevL1y, tw);
    sh[3] = mix(sh[3], prevL1z, tw);

    imageStore(cascade_out_l0,  ivec3(tid), vec4(sh[0], 1.0));
    imageStore(cascade_out_l1x, ivec3(tid), vec4(sh[1], 1.0));
    imageStore(cascade_out_l1y, ivec3(tid), vec4(sh[2], 1.0));
    imageStore(cascade_out_l1z, ivec3(tid), vec4(sh[3], 1.0));
}
