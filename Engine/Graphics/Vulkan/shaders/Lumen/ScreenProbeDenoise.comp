#version 450 core
// Vulkan Lumen Screen Probe GI — Confidence-weighted bilateral denoise.
// Hand-written GLSL port of ScreenProbeDenoise.metal (entry: screen_probe_denoise).
//
// Light bilateral filter on GI output, using confidence from Gather:
//   - High confidence pixels are trusted (less filtered)
//   - Low confidence pixels borrow from high-confidence neighbors
//   - Geometry constraints (depth + normal) prevent bleeding across edges
//   Weights: depth * normal * spatial (Metal version uses geometry weights
//   only; the confidence channel is passed through for downstream temporal use).
//
// ThreadGroupSize: (8, 8, 1).
//
// Flat descriptor bindings:
//   binding 0 = texture2D         giInput        (sampled, manual bilinear)
//   binding 1 = texture2D         normalTexture  (sampled, manual bilinear)
//   binding 2 = readonly image2D  depthTexture   (r32f, imageLoad)
//   binding 3 = writeonly image2D giOutput       (rgba16f)
//   binding 4 = UBO               DenoiseParams (32B)

#extension GL_EXT_samplerless_texture_functions : enable

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// --------------------------------------------------------------------------------
// Bindings (flat)
// --------------------------------------------------------------------------------
layout(set = 0, binding = 0) uniform texture2D giInput;
layout(set = 0, binding = 1) uniform texture2D normalTexture;
layout(set = 0, binding = 2, r32f) readonly uniform image2D depthTexture;
layout(set = 0, binding = 3, rgba16f) writeonly uniform image2D giOutput;

layout(set = 0, binding = 4, std140) uniform DenoiseParamsBlock {
    float sigma_depth;     // Depth weight sharpness
    float sigma_normal;    // Normal weight power
    float sigma_spatial;   // Gaussian spatial falloff
    float pad1;
    uint  kernel_radius;
    uint  render_width;
    uint  render_height;
    uint  pad2;
} params;

// --------------------------------------------------------------------------------
// Helpers
// --------------------------------------------------------------------------------
vec3 decodeNormal(vec4 encoded) {
    return normalize(encoded.xyz * 2.0 - 1.0);
}

// Manual bilinear RGB sample replicating Metal linear sampler (clamp_to_edge).
vec3 sampleBilinearRGB(texture2D tex, vec2 uv) {
    vec2 size = vec2(textureSize(tex, 0));
    vec2 px = uv * size - 0.5;
    ivec2 p0 = ivec2(floor(px));
    vec2 f = fract(px);

    ivec2 c00 = clamp(p0,               ivec2(0), ivec2(size) - 1);
    ivec2 c10 = clamp(p0 + ivec2(1, 0), ivec2(0), ivec2(size) - 1);
    ivec2 c01 = clamp(p0 + ivec2(0, 1), ivec2(0), ivec2(size) - 1);
    ivec2 c11 = clamp(p0 + ivec2(1, 1), ivec2(0), ivec2(size) - 1);

    vec3 s00 = texelFetch(tex, c00, 0).rgb;
    vec3 s10 = texelFetch(tex, c10, 0).rgb;
    vec3 s01 = texelFetch(tex, c01, 0).rgb;
    vec3 s11 = texelFetch(tex, c11, 0).rgb;

    vec3 a = mix(s00, s10, f.x);
    vec3 b = mix(s01, s11, f.x);
    return mix(a, b, f.y);
}

// Manual bilinear RGBA (used for giInput to preserve the alpha confidence channel).
vec4 sampleBilinearRGBA(texture2D tex, vec2 uv) {
    vec2 size = vec2(textureSize(tex, 0));
    vec2 px = uv * size - 0.5;
    ivec2 p0 = ivec2(floor(px));
    vec2 f = fract(px);

    ivec2 c00 = clamp(p0,               ivec2(0), ivec2(size) - 1);
    ivec2 c10 = clamp(p0 + ivec2(1, 0), ivec2(0), ivec2(size) - 1);
    ivec2 c01 = clamp(p0 + ivec2(0, 1), ivec2(0), ivec2(size) - 1);
    ivec2 c11 = clamp(p0 + ivec2(1, 1), ivec2(0), ivec2(size) - 1);

    vec4 s00 = texelFetch(tex, c00, 0);
    vec4 s10 = texelFetch(tex, c10, 0);
    vec4 s01 = texelFetch(tex, c01, 0);
    vec4 s11 = texelFetch(tex, c11, 0);

    vec4 a = mix(s00, s10, f.x);
    vec4 b = mix(s01, s11, f.x);
    return mix(a, b, f.y);
}

// --------------------------------------------------------------------------------
// Main
// --------------------------------------------------------------------------------
void screen_probe_denoise() {
    uvec2 pixel_pos = gl_GlobalInvocationID.xy;

    uint width = params.render_width;
    uint height = params.render_height;

    if (pixel_pos.x >= width || pixel_pos.y >= height) return;

    vec2 invRes = 1.0 / vec2(width, height);
    vec2 centerUV = (vec2(pixel_pos) + 0.5) * invRes;

    vec4 centerGI     = sampleBilinearRGBA(giInput, centerUV);
    float centerDepth = imageLoad(depthTexture, ivec2(pixel_pos)).r;
    vec3 centerNormal = decodeNormal(vec4(sampleBilinearRGB(normalTexture, centerUV), 0.0));

    // Early out for sky pixels
    if (centerDepth <= 0.0001 || centerDepth >= 0.999) {
        imageStore(giOutput, ivec2(pixel_pos), vec4(0.0, 0.0, 0.0, 0.0));
        return;
    }

    // Early out for zero GI — pass through without filtering
    float centerLum = dot(centerGI.rgb, vec3(0.2126, 0.7152, 0.0722));
    if (centerLum < 0.0001) {
        imageStore(giOutput, ivec2(pixel_pos), centerGI);
        return;
    }

    // Light bilateral filter — geometry weights only, no confidence influence
    uint radius = min(params.kernel_radius, 2u);

    vec3 filteredGI = vec3(0.0);
    float totalWeight = 0.0;

    for (int dy = -int(radius); dy <= int(radius); dy++) {
        for (int dx = -int(radius); dx <= int(radius); dx++) {
            ivec2 samplePos = ivec2(pixel_pos) + ivec2(dx, dy);

            if (samplePos.x < 0 || samplePos.y < 0 ||
                samplePos.x >= int(width) || samplePos.y >= int(height)) {
                continue;
            }

            vec2 sampleUV = (vec2(samplePos) + 0.5) * invRes;
            vec4 sampleGI = sampleBilinearRGBA(giInput, sampleUV);

            float sampleDepth  = imageLoad(depthTexture, samplePos).r;
            vec3 sampleNormal = decodeNormal(vec4(sampleBilinearRGB(normalTexture, sampleUV), 0.0));

            // Depth weight
            float depthDiff = abs(centerDepth - sampleDepth);
            float w_depth = exp(-depthDiff * params.sigma_depth);

            // Normal weight
            float NdotN = max(0.0, dot(centerNormal, sampleNormal));
            float w_normal = pow(NdotN, params.sigma_normal);

            // Gaussian spatial weight
            float spatialDist2 = float(dx * dx + dy * dy);
            float w_spatial = exp(-spatialDist2 / (2.0 * params.sigma_spatial * params.sigma_spatial));

            float weight = w_depth * w_normal * w_spatial;

            filteredGI += sampleGI.rgb * weight;
            totalWeight += weight;
        }
    }

    if (totalWeight > 1e-6) {
        filteredGI /= totalWeight;
    } else {
        filteredGI = centerGI.rgb;
    }

    // Pass through confidence from input (for temporal use downstream)
    imageStore(giOutput, ivec2(pixel_pos), vec4(filteredGI, centerGI.a));
}
