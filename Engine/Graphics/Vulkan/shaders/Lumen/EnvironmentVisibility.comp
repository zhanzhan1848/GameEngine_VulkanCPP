        if(blendQualified){float w=1./(1e-3+key);accum+=value*w;accumWeight+=w;}
    }
    if(blendQualified&&found&&accumWeight>0.)result=accum/accumWeight;
    // Trace-pixel fallback was measured to add 1.16 ms with no change to the
    // reported speckle (same number of rays, different origin), so the target
    // receiver is kept.
    imageStore(outputVisibility,pixel,found?result:mirrorFallback(target));
#else
    if(any(greaterThanEqual(pixel,ivec2(cb.dimensions.zw))))return;
    ivec2 source=traceToSource(pixel);
    Receiver r;
    if(!receiver(source,r)){imageStore(outputVisibility,pixel,vec4(0,0,1,0));return;}
    // Temporal single-ray mode (opt-in per dispatch): one stratum per frame,
    // accumulated over the 3-slot ring. Off by default so every existing
    // contract test keeps the deterministic four-sample output byte-identical.
    if((cb.target.z&1u)==0u){imageStore(outputVisibility,pixel,traceLobe(r,source,0u,4u));return;}
    vec4 current=traceLobe(r,source,cb.policy.w&3u,1u);
    vec4 result=current;
    // Warm up for a full ring before trusting history, and reject every sample
    // whose reprojected source texel does not resolve to the same world point
    // (disocclusion, camera cut, moving occluder).
    if(cb.policy.w>=4u) {
        vec4 clip=cb.prevViewProjection*vec4(r.p,1.);
        if(finite1(clip.w)&&clip.w>1e-6) {
            vec2 ndc=clip.xy/clip.w;
            vec2 uv=vec2(ndc.x*.5+.5,.5-ndc.y*.5);
            ivec2 hp=ivec2(uv*vec2(cb.dimensions.zw));
            if(all(greaterThanEqual(hp,ivec2(0)))&&all(lessThan(hp,ivec2(cb.dimensions.zw)))) {
                vec4 history=texelFetch(halfVisibility,hp,0);
                Receiver hr;
                bool compatible=history.a>=.5&&finite3(history.rgb)&&finite1(history.r)&&
                    receiver(traceToSource(hp),hr)&&
                    distance(hr.p,r.p)<=max(cb.parameters.x,length(cb.camera.xyz-r.p)*.02);
                if(compatible)result=mix(history,current,.25);
            }
        }
    }
    imageStore(outputVisibility,pixel,result);
#endif
}
