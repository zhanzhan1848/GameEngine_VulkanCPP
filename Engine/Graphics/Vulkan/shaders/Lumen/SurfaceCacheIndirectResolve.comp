        vec3 local=vec3(sqrt(1.0-xi.x)*cos(angle),sqrt(1.0-xi.x)*sin(angle),sqrt(xi.x));
        vec3 up=abs(normal.y)<.999?vec3(0,1,0):vec3(1,0,0);vec3 tangent=normalize(cross(up,normal));
        vec3 direction=normalize(tangent*local.x+cross(normal,tangent)*local.y+normal*local.z),radiance=vec3(0);
        bool measured=false;
        if(type==2u){radiance=irp.params.tile_sky_color.w>.5?
            EvaluateSkyBase(direction)*irp.params.tile_sky_color.xyz:irp.params.tile_sky_color.xyz;
            measured=true;++outputValue.counts.z;
        }else if((identity>>3u)!=0u){float cacheT;uint card,rejected;
            vec3 origin=uintBitsToFloat(ray_hits.data[at].hit_type_pad.yzw);
            measured=findGeometryCache(ray_hits.data[at].hit_position_dist.xyz,origin,direction,(identity>>3u)-1u,
                rayTriangles.data[at],radiance,cacheT,card,rejected);
            if(measured)++outputValue.counts.w;
        }
        if(measured && scBoundaryLightFinite(radiance) && all(greaterThanEqual(radiance,vec3(0)))){
            sum+=radiance;++outputValue.counts.y;boundaryContributions[at]=vec4(radiance,1);
        }
    }
    // Same fixed-denominator validity contract as the primary tile estimator.
    bool valid=outputValue.counts.x==rays && outputValue.counts.y>=4u && scBoundaryLightFinite(sum);
    vec3 incident=valid?sum/float(rays):vec3(0);
    outputValue.incident=vec4(incident,valid?1:0);outputValue.outgoing=vec4(incident*point.albedo.xyz,valid?1:0);
    boundaryRadiosity[pidx]=outputValue;
}
#endif
