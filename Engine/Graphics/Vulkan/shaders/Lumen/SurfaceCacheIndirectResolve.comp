#version 450 core
// Vulkan Lumen Surface Cache Indirect Resolve — GLSL port of SurfaceCacheIndirectResolve.metal.
// Entry point: surface_cache_indirect_resolve  (glslangValidator -e surface_cache_indirect_resolve)
//
// Gather ray hits per probe, sample prev_lighting atlas, splat indirect into tile.
// ThreadGroupSize: (8, 8, 1)
//
// Flat descriptor bindings:
//   binding 0 = texture2D             prev_lighting    (samplerless, texelFetch nearest)
//   binding 1 = StorageImage(rgba8)   albedo_atlas     (readonly, imageLoad)
//   binding 2 = texture2D             sky_cubemap      (samplerless, declared/unused dummy)
//   binding 3 = StorageImage(rgba16f) indirect_out     (writeonly, imageStore)
//   binding 4 = UniformBuffer         GlobalShaderData (480B, inline)
//   binding 5 = UniformBuffer         IndirectResolveParams
//   binding 6 = StorageBuffer         lookups[]        (SurfaceCacheCardLookup, std430)
//   binding 7 = StorageBuffer         cards[]          (SurfaceCacheCard, std430)
//   binding 8 = StorageBuffer         ray_hits[]       (ProbeRayHit, readonly, std430)
//   binding 11 = texture2D            depth_atlas      (C: capture validation)
//   binding 12 = image2D              normal_atlas     (C: tile-side orientation)

#extension GL_EXT_samplerless_texture_functions : enable

#include "SurfaceCacheData.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// --------------------------------------------------------------------------------
// Bindings (flat)
// --------------------------------------------------------------------------------
layout(set = 0, binding = 0) uniform texture2D prev_lighting;
layout(set = 0, binding = 1, rgba8) readonly uniform image2D albedo_atlas;
layout(set = 0, binding = 2) uniform texture2D sky_cubemap;   // unused/dummy in Metal
layout(set = 0, binding = 3, rgba16f) writeonly uniform image2D indirect_out;

// GlobalShaderData UBO — 480 bytes, mirrors C++ RHIShaderCommon.h.
// Declared inline (not via #include RHIShaderTypes.glsl) to avoid the awk
// inliner's source-dir-relative path resolution limitation with "../" prefixes.
layout(set = 0, binding = 4, std140) uniform GDBlock {
    mat4  view;
    mat4  projection;
    mat4  invProjection;
    mat4  viewProjection;
    mat4  previousViewProjection;
    mat4  invViewProjection;
    vec4  cameraPositionAndViewWidth;
    vec4  cameraDirectionAndViewHeight;
    uint  numDirectionalLights;
    uint  numPunctualLights;
    float deltaTime;
    float frameCount;
    uint  renderMode;
    uint  enableIBL;
    uint  enableDDGI;
    uint  _pad_before_jitter;
    vec2  jitterOffset;
    float debug_directLightBoost;
    float debug_iblStrength;
    float debug_ddgiIndirectWeight;
    float debug_exposure;
    float _pad_after_debug_0;
    float _pad_after_debug_1;
} gd;

struct IndirectResolveParams {
    SurfaceCacheParams sc_params;
    uint tile_size;
    uint rays_per_probe;
    float temporal_weight;
    uint frame_index;
    uint lookup_count;
    // B (plan §三.B): mirrors the trace refresh amortization — C++
    // IndirectResolveParamsGPU fields at offsets 68/72.
    uint refresh_stride;
    uint refresh_phase;
    // C (plan §三.C): the trace's SDF hit band (max(voxel×1.25, 0.30)) —
    // along-axis tolerance floor for capture validation. Offset 76.
    float hit_band;
};

layout(set = 0, binding = 5, std140) uniform IndirectResolveParamsBlock {
    IndirectResolveParams params;
} irp;

layout(set = 0, binding = 6, std430) readonly buffer LookupsBlock {
    SurfaceCacheCardLookup data[];
} lookups;

layout(set = 0, binding = 7, std430) readonly buffer CardsBlock {
    SurfaceCacheCard data[];
} cards;

// ProbeRayHit — two vec4s (32 bytes) per hit (matches IndirectTrace).
//   hit_position_dist.xyz = position, .w = hit_distance
//   hit_type_pad.x = hit_type (0=near, 1=far, 2=sky, 3=cone-occluded, ≥4=INVALID)
struct ProbeRayHit {
    vec4 hit_position_dist;
    uvec4 hit_type_pad;
};

layout(set = 0, binding = 9) uniform texture2D prev_indirect_out;   // T3.3 temporal EMA
layout(set = 0, binding = 11) uniform texture2D depth_atlas;    // C: capture validation
layout(set = 0, binding = 12) uniform texture2D normal_atlas;  // C: orientation (sampled, twin parity)
layout(set = 0, binding = 8, std430) readonly buffer RayHitsBlock {
    ProbeRayHit data[];
} ray_hits;

// B (plan §三.B): per-tile validity bitmask (1 bit per tile, packed u32).
// Written by this shader for tiles whose hits were consumed while CURRENT;
// read to decide whether a non-refreshed tile may carry its history. A clear
// bit = never-traced (or post-reset): the tile's texels must be explicit
// zeros (validity A=0), not stale hits reinterpreted as measurements.
layout(set = 0, binding = 10, std430) buffer TileValidBlock {
    uint data[];
} tile_valid;

// --------------------------------------------------------------------------------
void surface_cache_indirect_resolve()
{
    uint probe_x = gl_GlobalInvocationID.x;
    uint probe_y = gl_GlobalInvocationID.y;
    uint tiles_x = irp.params.sc_params.atlas_size / irp.params.tile_size;
    uint probe_idx = probe_y * tiles_x + probe_x;

    uint rays = irp.params.rays_per_probe;
    uint tile_size = irp.params.tile_size;
    uvec2 tile_origin = uvec2(probe_x * tile_size, probe_y * tile_size);

    if (tile_origin.x >= irp.params.sc_params.atlas_size || tile_origin.y >= irp.params.sc_params.atlas_size) return;

    // B (plan §三.B): is this tile part of THIS frame's refresh phase? The
    // trace skipped tiles outside the phase (early-out before the march), so
    // their ray_hits are stale by definition and must not be consumed.
    const bool refreshed = irp.params.refresh_stride <= 1u ||
                           (probe_idx % irp.params.refresh_stride) == irp.params.refresh_phase;
    const uint tvWord = probe_idx >> 5u;
    const uint tvBit = 1u << (probe_idx & 31u);
    const bool tileWasValid = (tile_valid.data[tvWord] & tvBit) != 0u;

    // C (plan §三.C): the tile receiver normal — regeneration seed for the
    // per-ray direction (must match the trace's generation exactly; the
    // contract's orientation test needs the PER-HIT facing -rayDir, not the
    // tile's own normal: a tile's rays mostly hit surfaces facing back).
    vec2 enc_n = texelFetch(normal_atlas, ivec2(tile_origin + tile_size / 2u), 0).rg;
    vec3 probe_normal = octDecode(enc_n);

    vec3 tileRayDir = vec3(0.0, -1.0, 0.0);   // C: regenerated per ray below
    vec3 indirect = vec3(0.0);
    float total_weight = 0.0;

    if (refreshed) {
    for (uint r = 0u; r < rays; ++r) {
        uint hit_idx = probe_idx * rays + r;
        vec3 hit_pos = ray_hits.data[hit_idx].hit_position_dist.xyz;
        uint hit_type = ray_hits.data[hit_idx].hit_type_pad.x;
        vec3 radiance = vec3(0.0);

        // D (plan §三.D): hit_type 3 = cone-occluded — the min-mip test only
        // proves an occluder inside the ray's wide footprint, NOT a surface
        // position. Conservative response: the ray counts toward the tile
        // average with ZERO radiance — it must not collect sky (the occluder
        // blocks it) and must not fetch an exact SC color at a fabricated
        // position (the old code stitched one from a mismatched origin).
        // hit_type ≥ 4 is the INVALID sentinel (unwritten/garbage slot):
        // skipped entirely so a partially-written tile synthesises nothing.
        if (hit_type == 3u) {
            indirect += vec3(0.0);
            total_weight += 1.0;
            continue;
        }
        if (hit_type >= 4u) continue;

        // 2026-09-10 C3.5 slice 1: near AND far hits both resolve through the
        // atlas — the card lookup is position-based and works at any distance.
        // C (plan §三.C): unified query contract over ALL bucket candidates —
        // capture validity, side orientation, decomposed along/perp error,
        // min-key selection. The old first-worldToCardUV-hit-accept took
        // whichever card the AABB loop found first, with no captured-depth
        // check at all. Valid black is accepted; an exhausted search keeps
        // the legacy dim placeholder.
        if (hit_type == 0u || hit_type == 1u) {
            // Regenerate this ray's direction exactly as the trace does
            // (same hash sequence, same tangent frame) — the orientation
            // test needs the direction the hit ARRIVED from.
            {
                float r1 = hash(vec2(float(probe_idx * rays + r), float(irp.params.frame_index)));
                float r2 = hash(vec2(float(irp.params.frame_index), float(probe_idx * rays + r))) * 2.0 * 3.14159265;
                float sin_t = sqrt(r1);
                float cos_t = sqrt(1.0 - r1);
                vec3 local_dir = vec3(cos_t * cos(r2), cos_t * sin(r2), sin_t);
                vec3 up = abs(probe_normal.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
                vec3 tangent = normalize(cross(up, probe_normal));
                vec3 bitangent = cross(probe_normal, tangent);
                tileRayDir = normalize(tangent * local_dir.x + bitangent * local_dir.y + probe_normal * local_dir.z);
            }
            bool found = false;
            float bestKey = 1e30;
            for (uint li = 0u; li < irp.params.lookup_count && !found; ++li) {
                vec3 mn = lookups.data[li].aabb_min.xyz;
                vec3 mx = lookups.data[li].aabb_max.xyz;
                if (hit_pos.x < mn.x || hit_pos.x > mx.x ||
                    hit_pos.y < mn.y || hit_pos.y > mx.y ||
                    hit_pos.z < mn.z || hit_pos.z > mx.z) continue;
                for (uint ci = lookups.data[li].card_start;
                     ci < lookups.data[li].card_start + lookups.data[li].card_count; ++ci) {
                    vec3 cand; float key;
                    if (scQueryCardCandidate(cards.data[ci], hit_pos, -tileRayDir,
                                             max(irp.params.hit_band, 0.15),
                                             depth_atlas, prev_lighting, cand, key)) {
                        if (key < bestKey) { bestKey = key; radiance = cand; found = true; }
                    }
                }
            }
            if (!found) {
                radiance = vec3(0.02, 0.02, 0.03);
            }
        } else {
            // Sky — same tier as DDGITraceFinalize's escape
            // (DDGI_SKY_COLOR × SkyColor.x with the 0.4 default intensity).
            radiance = vec3(2.75, 2.88, 3.00) * 0.4;
        }

        indirect += radiance;
        total_weight += 1.0;
    }
    }

    if (total_weight > 0.0) indirect /= total_weight;

    // B: this tile's ray_hits were consumed while CURRENT — from now on its
    // history is legitimate carry data. Non-refreshed tiles keep whatever
    // validity they had (their hits were not touched).
    if (refreshed && (tile_valid.data[tvWord] & tvBit) == 0u) {
        tile_valid.data[tvWord] |= tvBit;
    }

    // T3.3: temporal accumulation — the trace ray directions are frame-hashed
    // (blue-noise-ish), so per-frame tile estimates carry visible variance.
    // EMA against the previous frame's slot: weight comes from the resolve
    // params (0.9 ⇒ ~10-frame convergence). invVP check: first frames
    // (frame_index < 2) write directly — no history exists yet.
    const float tw = clamp(irp.params.temporal_weight, 0.0, 0.95);
    const bool hasHistory = irp.params.frame_index >= 2u;

    for (uint dy = 0u; dy < tile_size; ++dy) {
        for (uint dx = 0u; dx < tile_size; ++dx) {
            uvec2 texel = tile_origin + uvec2(dx, dy);
            if (texel.x >= irp.params.sc_params.atlas_size || texel.y >= irp.params.sc_params.atlas_size) continue;

            // B: a tile outside this frame's refresh phase contributes no new
            // estimate. With a set validity bit its history is carried
            // verbatim (the EMA implies the stored value already includes the
            // albedo product); a cleared bit means never-traced/post-reset —
            // explicit zeros with validity A=0 so LightEval skips the term
            // instead of reading stale or uninitialized slots as black light.
            if (!refreshed) {
                if (tileWasValid && hasHistory) {
                    vec3 prev = texelFetch(prev_indirect_out, ivec2(texel), 0).rgb;
                    imageStore(indirect_out, ivec2(texel), vec4(prev, 1.0));
                } else {
                    imageStore(indirect_out, ivec2(texel), vec4(0.0));
                }
                continue;
            }

            vec3 albedo = imageLoad(albedo_atlas, ivec2(texel)).rgb;
            vec3 current = indirect * albedo;
            if (hasHistory && tw > 0.0) {
                vec3 prev = texelFetch(prev_indirect_out, ivec2(texel), 0).rgb;
                current = mix(current, prev, tw);
            }
            imageStore(indirect_out, ivec2(texel), vec4(current, 1.0));
        }
    }
}
