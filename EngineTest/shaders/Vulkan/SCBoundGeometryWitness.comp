#version 450 core
#extension GL_GOOGLE_include_directive : require
#ifdef SC_BOUND_SURFACE
#extension GL_EXT_samplerless_texture_functions : require
#include "../../../Engine/Graphics/Vulkan/shaders/Lumen/SurfaceCacheData.glsl"
layout(set=0,binding=2,std430) readonly buffer CardData { SurfaceCacheCard data[]; } cards;
layout(set=0,binding=3,std430) readonly buffer LookupData { SurfaceCacheCardLookup data[]; } lookup;
layout(set=0,binding=4) uniform texture2D depth_atlas;
layout(set=0,binding=5) uniform texture2D lighting_atlas;
#include "../../../Engine/Graphics/Vulkan/shaders/Lumen/DDGIMeasuredOwnerCandidate.glsl"
#endif
layout(local_size_x=8,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer Queries { uvec4 header; vec4 rays[]; } query;
layout(set=0,binding=1,std430) writeonly buffer Results { vec4 records[]; } result;
// The live SC buffers use the canonical production layout and closest helper.
#include "../../../Engine/Graphics/Vulkan/shaders/Lumen/GeometryFirstHit.glsl"
#include "../../../Engine/Graphics/Vulkan/shaders/Lumen/DDGIMeasuredFirstHit.glsl"
void main(){
    uint index=gl_GlobalInvocationID.x,count=query.header.x & 0x7fffffffu;
    bool compareDDGI=(query.header.x & 0x80000000u)!=0u;
    if(index>=count)return;
    vec4 origin=query.rays[index*2u],direction=query.rays[index*2u+1u];
    float t=direction.w;uint owner=0xffffffffu,primitive=0xffffffffu;
    bool valid=!any(isnan(origin))&&!any(isinf(origin))&&!any(isnan(direction))&&!any(isinf(direction))&&
        abs(dot(direction.xyz,direction.xyz)-1.0)<=2e-5&&origin.w>=0.&&direction.w>origin.w;
    int status=valid?geometryFirstHit(origin.xyz,direction.xyz,origin.w,direction.w,t,owner,primitive):-1;
    uint base=index*4u;
    result.records[base]=origin;result.records[base+1u]=direction;
    result.records[base+2u]=vec4(float(status),t,uintBitsToFloat(owner),uintBitsToFloat(primitive));
    result.records[base+3u]=vec4(uintBitsToFloat(index),uintBitsToFloat(query.header.y),uintBitsToFloat(query.header.z),uintBitsToFloat(query.header.w));
    if(compareDDGI) {
        float dist; uint hitOwner,hitPrimitive;
        vec3 normal,a,e1,e2;
        int outcome=geometryFirstHit(origin.xyz,direction.xyz,origin.w,direction.w,
            dist,hitOwner,hitPrimitive,normal,a,e1,e2);
        uint tail=count*4u+index*2u;
        result.records[tail]=vec4(float(outcome),dist,uintBitsToFloat(hitOwner),uintBitsToFloat(hitPrimitive));
        result.records[tail+1u]=vec4(normal,0.);
#ifdef SC_BOUND_SURFACE
        // The production owner directory maps an instance to at most 16
        // inspected owner cards. Read the same card ranges and the live atlases.
        uint bestCard=0xffffffffu, seen=0u, accepted=0u, deepestReject=0u;
        float bestKey=1e30;
        vec3 light=vec3(0);
        if(outcome==1 && hitOwner<uint(lookup.data.length())) {
            uint first=lookup.data[hitOwner]._pad0, end=lookup.data[hitOwner]._pad1;
            if(first<=end && end<=uint(cards.data.length())) {
                for(uint ci=first; ci<end && seen<16u; ++ci) {
                    SurfaceCacheCard card=cards.data[ci];
                    if(card.mesh_instance_id!=hitOwner) continue;
                    ++seen;
                    vec3 candidate; float key; uint reject;
                    if(ddgiMeasuredOwnerCandidate(card,hitOwner,true,origin.xyz+dist*direction.xyz,
                            normal,direction.xyz,candidate,key,reject)) {
                        ++accepted;
                        if(key<bestKey) { bestKey=key; bestCard=ci; light=candidate; }
                    } else deepestReject=max(deepestReject,reject);
                }
            }
        }
        uint surface=count*6u+index*2u;
        result.records[surface]=vec4(light,uintBitsToFloat(bestCard));
        result.records[surface+1u]=uintBitsToFloat(uvec4(seen,accepted,deepestReject,index));
#endif
    }
}
