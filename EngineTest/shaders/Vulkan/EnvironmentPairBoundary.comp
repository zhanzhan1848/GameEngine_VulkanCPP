 Result a=scalar(i,stats.retry0[0],stats.retry1[0]),b=scalar(i+1u,stats.retry0[1],stats.retry1[1]);result[i]=a;result[i+1u]=b;stats.nodes=p.nodeLoads+a.top+a.bottom+b.top+b.bottom;stats.instances=p.instanceLoads+a.instances+b.instances;stats.triangles=p.triangleLoads+a.triangles+b.triangles;stats.kind=3u;pairStats[ix]=stats;return;
