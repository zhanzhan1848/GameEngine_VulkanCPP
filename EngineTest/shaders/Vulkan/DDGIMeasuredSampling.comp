#version 450 core
#extension GL_GOOGLE_include_directive : require
// Include the production sampler; never keep a test-side implementation copy.
#include "ShaderLib/ProbeSampleLib.glsl"
layout(local_size_x=128, local_size_y=1, local_size_z=1) in;
struct Sample { vec4 direction_pdf; uvec4 identity; };
layout(set=0,binding=0,std430) writeonly buffer Results { Sample samples[]; };
void main() {
    uint ray=gl_GlobalInvocationID.x, frame=gl_GlobalInvocationID.y;
    if (ray>=128u || frame>=64u) return;
    vec4 s=ddgiSampleRayDirection(ray,128u,frame,7u,vec3(0.0,1.0,0.0));
    vec2 oct=s.xy/(abs(s.x)+abs(s.y)+abs(s.z));
    if (s.z<0.0)
        oct=(1.0-abs(oct.yx))*mix(vec2(-1.0),vec2(1.0),greaterThanEqual(oct,vec2(0.0)));
    uvec2 cell=min(uvec2((oct*0.5+0.5)*8.0),uvec2(7u));
    samples[frame*128u+ray].direction_pdf=s;
    samples[frame*128u+ray].identity=uvec4(cell.y*8u+cell.x,ray,frame,7u);
}
