#version 450
// VT M2.7: 系统级页表更新 CS — 6 元组条目,RGBA 四通道一次写(每通道一层)
layout(local_size_x = 64) in;

layout(set = 0, binding = 0, rgba32ui) uniform uimage2D vtPageTable;
layout(set = 0, binding = 1) readonly buffer Entries {
    uint data[];   // [count, (ptX, ptY, vR, vG, vB, vA) * count]
} entries;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint count = entries.data[0];
    if (i >= count) return;
    uint ptX = entries.data[1 + i * 6 + 0];
    uint ptY = entries.data[1 + i * 6 + 1];
    uvec4 val = uvec4(entries.data[1 + i * 6 + 2], entries.data[1 + i * 6 + 3],
              entries.data[1 + i * 6 + 4], entries.data[1 + i * 6 + 5]);
    imageStore(vtPageTable, ivec2(int(ptX), int(ptY)), val);
}
